              "back"
            ]
          },
          {
            "label": "1¼ somersault (450°)",
            "rotation": {
              "min": 5,
              "max": 5
            }
          }
        ],
        [
          {
            "label": "Full somersault (360°) with at least a full twist (360°)",
            "rotation": {
              "min": 4,
              "max": 4
            },
            "twist": {
              "min": 2
            }
          }
        ]
      ]
    },
    {
      "type": "count",
      "label": "No somersault over 630° (disqualification)",
