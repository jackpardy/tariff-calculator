package views

import "context"

// One link for a person with several roles (ADR 0010): tabs above every page
// a personal link opens, one for each of the person's roles, and the place on
// their details where they add their other links and take them off.

// RoleTab is one of a person's roles, as a tab above their pages.
type RoleTab struct {
	Label, Href string
	Current     bool
	Kind        string // the role: store's RoleMember, RoleCoach and the rest
}

type rolesKey struct{}

// WithRoles keeps the person's roles for the page, so the layout shows them
// whatever page it is.
func WithRoles(ctx context.Context, tabs []RoleTab) context.Context {
	return context.WithValue(ctx, rolesKey{}, tabs)
}

// rolesOf are the roles kept for the page, if any.
func rolesOf(ctx context.Context) []RoleTab {
	tabs, _ := ctx.Value(rolesKey{}).([]RoleTab)
	return tabs
}

// roleTabs are the person's roles, when they have more than one.
templ roleTabs(tabs []RoleTab) {
	if len(tabs) > 1 {
		<nav class="role-tabs mb-3" aria-label="Your roles">
			<div class="tabs is-toggle is-small mb-0">
				<ul>
					for _, t := range tabs {
						<li class={ "role-tab", templ.KV("is-active", t.Current) }>
							<a href={ templ.SafeURL(t.Href) } aria-current?={ t.Current }>{ t.Label }</a>
						</li>
					}
				</ul>
			</div>
		</nav>
	}
}

// OtherLinks are a person's other roles, on their details, each to take off,
// and the form to add another link.
type OtherLinks struct {
	Add    string // where a pasted link posts
	Remove string // where taking one off posts
	Roles  []OtherRole
}

// OtherRole is one of the person's other roles.
type OtherRole struct {
	Label string // e.g. "Comp sec of UCD"
	Kind  string // posted back with ID to take it off
	ID    string
}

// TieView is someone whose own link opens a shared link's pages, because
// they added it to their page.
type TieView struct {
	ID, Name, Since string
	What            string // which link, where there are several: "" for the only one
}

// tiesBox lists who opens these pages from their own link, for the shared
// link's holder to see and remove.
templ tiesBox(remove string, ties []TieView, none string) {
	// Rows of a list under a small label, as the helpers' links are, not a
	// card of its own (rendering.md, "Settings and forms on a page").
	<div class="comp-ties mb-4" id="ties">
		<p class="label is-small mb-1">Opened from people's own links</p>
		if len(ties) == 0 {
			<p class="help">No one yet. { none }</p>
		} else {
			<p class="help mb-2">These people added a link to their own page, so it opens these pages from there. Replacing or removing the link ends it for them.</p>
			<ul>
				for _, t := range ties {
					<li class="comp-other-link">
						<span>
							<strong>{ t.Name }</strong>
							<span class="has-text-grey is-size-7">
								if t.What != "" {
									{ t.What } ·
								}
								since { t.Since }
							</span>
						</span>
						<form method="post" action={ templ.SafeURL(remove) } class="is-inline">
							<input type="hidden" name="id" value={ t.ID }/>
							<button class="button is-small is-text has-text-danger" type="submit" aria-label={ "Stop " + t.Name + "'s link opening these pages" }>Remove</button>
						</form>
					</li>
				}
			</ul>
		}
	</div>
}

// otherLinksBox lists the person's other roles and adds more: a section
// with a plain heading, the roles as rows, and the form to add another
// opening from a button (rendering.md, "Settings and forms on a page").
templ otherLinksBox(o OtherLinks) {
	<section class="comp-other-links mt-5" id="other-links">
		<h2 class="title is-5 mb-2">Your other links</h2>
		if len(o.Roles) == 0 {
			<p class="is-size-7 mb-3">If you have another link of your own here (as a club member, a coach, a club's competition secretary, for a competition you entered on your own or one you help run), add it. Then this link opens all of them, with a tab for each.</p>
		} else {
			<p class="is-size-7 mb-2">This link also opens these, with a tab for each:</p>
			<ul class="mb-3">
				for _, r := range o.Roles {
					<li class="comp-other-link">
						<span>{ r.Label }</span>
						<form method="post" action={ templ.SafeURL(o.Remove) } class="is-inline">
							<input type="hidden" name="kind" value={ r.Kind }/>
							<input type="hidden" name="id" value={ r.ID }/>
							<button class="button is-small is-text" type="submit">Undo</button>
						</form>
					</li>
				}
			</ul>
		}
		@opens("", "", "Add a link", false) {
			<form method="post" action={ templ.SafeURL(o.Add) }>
				<label class="label is-small" for="other-link">Your other link</label>
				<div class="field has-addons">
					<div class="control is-expanded">
						<input class="input is-small" id="other-link" name="link" required placeholder="Paste the link" autocomplete="off"/>
					</div>
					<div class="control">
						<button class="button is-small is-link" type="submit">Add</button>
					</div>
				</div>
				<p class="help">Only add links that are yours. A shared link, such as a club's comp sec link, opens from here, but never opens this page.</p>
			</form>
		}
	</section>
}

// coachesToo says the person whose page this is has a coach's role too.
func coachesToo(ctx context.Context) bool {
	for _, t := range rolesOf(ctx) {
		if t.Kind == "coach" {
			return true
		}
	}
	return false
}

// SameLinkPage asks before adding another person's own link to a page: a
// member who pastes their coach's link would become their coach.
type SameLinkPage struct {
	Link, Add, Back string
	Yours, Theirs   string // the names on this page's link and on the pasted one
	What            string // the pasted link's role, e.g. "Coach at UCD, as Declan Ward"
}

// SameLink asks whether the pasted link is really the person's own.
templ SameLink(p SameLinkPage) {
	@competitionLayout("Is this you?") {
		<h1 class="title is-4">Is { p.Theirs } you?</h1>
		<div class="box">
			<p class="mb-2">That link is { p.What }. This page is { p.Yours }'s.</p>
			<p class="mb-3">Adding it makes you and { p.Theirs } one person: either link opens both pages, and the club sees { p.Yours } as { p.Theirs } too. Only add it if it's yours. To follow someone, such as your coach, you don't need their link.</p>
			<form method="post" action={ templ.SafeURL(p.Add) } class="buttons">
				<input type="hidden" name="link" value={ p.Link }/>
				<input type="hidden" name="sure" value="1"/>
				<button class="button is-small is-link" type="submit">It's mine: add it</button>
				<a class="button is-small" href={ templ.SafeURL(p.Back) }>Cancel</a>
			</form>
		</div>
	}
}
