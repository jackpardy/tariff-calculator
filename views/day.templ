package views

import (
	"crypto/rand"
	"net/url"
	"strconv"
	"strings"

	"tariffCalculator/static"
)

// DayPage is the "On the day" page: for one day of the published timetable,
// each area's flights with when they were planned and when they really
// started and finished, and how late the area is running.
type DayPage struct {
	Base        string
	Competition CompetitionSummary
	Menu []MenuSection
	Notice      string
	Day         int    // the day shown, by index
	Area        string // the area whose page this is; "" for the overview of every area
	AllAreas    string // the overview, from an area's page
	Days        []DayTab
	Areas       []DayArea
	Scratched   []DayScratched // scratched gymnasts who officiate or compete that day
	Correct     bool           // this link can put a flight's times right
	DayName     string         // the day shown, e.g. "Saturday", for the times put right
	DayDate     string         // its date, e.g. "Saturday 27 February 2027"
	People      bool           // this link opens people's pages: names link to them
}

// DayScratched is a scratched gymnast who also holds seats that day, or is
// in other flights, and whom the organisers haven't been told is still here.
type DayScratched struct {
	Name        string
	Person      string   // their key, to clear a warning
	Officiating []string // their seats, e.g. "Panel 2 · BUCS L4 · Execution judge"
	Competing   []string // their other entries, e.g. "Tumbling Novice · flight 1 of 2 · Track 1 · 14:00"
	WhatIf      string   // the "what if they leave" page for them; "" if this link can't use it
}

// DayTab is a day to switch to.
type DayTab struct {
	Name, Link string
	Active     bool
}

// DayArea is an area's flights that day, and how it's running.
type DayArea struct {
	ID      string // the id of its block on the page
	Name    string
	Link    string // its own page, where its marshal works
	Status  string // e.g. "Running 15 min late", "On time"; "" for nothing recorded yet
	Late    bool   // running behind
	Early   bool   // running ahead
	Since   string // what it's measured from, e.g. "Finished BUCS L3 at 10:40"
	WhatIf  string // where to see the rest of the day if it's late; "" for none
	Flights []DayFlight
	// Breaks are its blocked time that day (lunch, awards, an event taking
	// entries on the day), as the timetable plans them.
	Breaks []DayBreak
}

// DayBreak is an area's blocked time on the day: what, when, and for an
// event with a panel, who's on it.
type DayBreak struct {
	Name, Times string
	Officials   []string
}

// DayFlight is a flight on the day: planned, and as it happened.
type DayFlight struct {
	Key, Name string
	ID        string // the id of its box on the page
	Planned   string // e.g. "09:30–10:40"
	Started   string // when it started, "" if not yet
	Finished  string
	Who       string // who last marked it
	CanStart  bool   // not started yet
	CanFinish bool   // started, not finished
	Undo      string // what Undo takes back: undo-finish or undo-start; "" for nothing
	Gymnasts  []DayGymnast
	Seats     []DaySeat // its panel's seats, filled or not
	Up        *DayUp // who's up now, for the marshal to tap on; nil unless it's running or yet to start
}

// DayUp is who's up now in a flight that's running: who's on (or, before the
// marshal's first tap, who's first), for Next gymnast and Back.
type DayUp struct {
	Waiting   bool   // the flight hasn't started: hidden until Started is tapped without signal (taps.js)
	Tapped    bool   // the marshal has tapped Next gymnast at least once
	Entry     string // the gymnast shown, by entry, and which routine (Round, 1 or 2); "" before the first tap:
	Round     string // posted back, so the same tap sent twice moves once
	Name      string // "" when nobody is left to compete
	No        int    // their running number
	Club      string
	Routine   string // e.g. "Set", "Voluntary" or "2nd routine"
	Scratched bool   // scratched since the marshal reached them
	Last      bool   // the flight's last routine: Finished comes next
	CanBack   bool
	Next      string // who's next and their routine, "" for none
	NotHere   bool   // who's on hasn't been checked in
}

// DayNotify is the Notify form beside someone who isn't here; Person is ""
// for none.
type DayNotify struct {
	Person string // their key
	As     string // "official" or "gymnast"
	Club   bool   // they belong to a club, so "Their club" is offered
}

// DaySeat is a seat in a flight's panel check-in: its official, or no one
// (Person "").
type DaySeat struct {
	Person, Name, Role string
	State              string // "here", "missing" or "" for not marked
	Who                string // who marked them
	CanHere            bool
	CanMissing         bool
	CanClear           bool
	WhatIf             string // the "what if they leave" page for a missing official; "" if this link can't use it
	Notify             DayNotify
}

// DayGymnast is a gymnast in a flight's check-in.
type DayGymnast struct {
	FlightGymnast
	Entry       string
	Person      string // their person key, for their page
	State       string // "here", "scratched" or "" for not marked
	Who         string // who marked them
	CanHere     bool
	CanScratch  bool
	CanClear    bool
	Notify      DayNotify
	Routines    string // what their two routines are called, e.g. "Set|Voluntary", for who's up without signal
}

// Day is the on-the-day page.
templ Day(p DayPage) {
	@competitionLayout("On the day · " + p.Competition.Name) {
		<h1 class="title is-4">On the day</h1>
		// The day shown, not the competition's dates.
		<p class="subtitle is-6">
			{ p.Competition.Name } ·
			if p.DayDate != "" {
				{ p.DayDate }
			} else {
				{ p.Competition.Date }
			}
		</p>
		@pageMenu(p.Menu)
		// Taps kept on this phone until the signal is back (static/js/taps.js).
		<div id="day-taps" class="notification is-warning is-light comp-day-taps" aria-live="polite" hidden></div>
		<div id="day-notice" class="comp-day-notice" aria-live="polite">
			if p.Notice != "" {
				@notice(p.Notice)
			}
		</div>
		if len(p.Days) > 1 {
			<div class="tabs is-small comp-day-tabs">
				<ul>
					for _, d := range p.Days {
						<li class={ templ.KV("is-active", d.Active) }><a href={ templ.SafeURL(d.Link) }>{ d.Name }</a></li>
					}
				</ul>
			</div>
		}
		if p.Area != "" {
			@backLink(p.AllAreas, "All areas")
		}
		if n := dayNames(p); n > 0 {
			@listTools(ListTools{ID: "day-areas", Noun: "names", Total: n})
		}
		<div id="day-warnings">
			for _, s := range p.Scratched {
				<div class="notification is-warning is-light">
					<p><strong>{ s.Name } is scratched</strong></p>
					if len(s.Officiating) > 0 {
						<p class="mt-2">But officiates:</p>
						for _, d := range s.Officiating {
							<p>{ d }</p>
						}
						if s.WhatIf != "" {
							<p><a class="comp-tap-link" href={ templ.SafeURL(s.WhatIf) }>What if they leave</a></p>
						}
						@stillHereForm(p, s, "officiating", "Still officiating")
					}
					if len(s.Competing) > 0 {
						<p class="mt-2">But is still entered in:</p>
						for _, d := range s.Competing {
							<p>{ d }</p>
						}
						@stillHereForm(p, s, "competing", "Still competing")
					}
				</div>
			}
		</div>
		if len(p.Areas) == 0 {
			<div class="notification is-light">No flights on this day.</div>
		}
		if p.Area == "" {
			<div class="columns is-multiline" id="day-areas" data-day-page>
				for _, a := range p.Areas {
					// At most three areas side by side, so a name and its buttons fit.
					<div class="column is-half-tablet is-one-third-desktop" data-list-group>
						@dayAreaCard(p, a)
					</div>
				}
			</div>
		} else {
			<div id="day-areas" data-day-page>
				for _, a := range p.Areas {
					@dayAreaPage(p, a)
				}
			</div>
		}
		// Keeps taps made without signal and sends them later; loaded by the
		// time competitions.js runs dayPage, once the page has loaded.
		<script defer src={ static.URL("js/taps.js") }></script>
	}
}

// dayNames counts the day's check-in rows, gymnasts' and officials', which
// "Find a name" searches.
func dayNames(p DayPage) int {
	n := 0
	for _, a := range p.Areas {
		for _, f := range a.Flights {
			n += len(f.Gymnasts) + seatCount(f.Seats).Of
		}
	}
	return n
}

// areaState is how an area is running, for its chip: running late needs
// looking at; on time or early, measured from times marked today, is fine;
// otherwise (times marked on another date) it isn't measured.
func areaState(a DayArea) State {
	switch {
	case a.Late:
		return Attention
	case a.Since != "":
		return Done
	}
	return NotYet
}

// flightState is a flight's state and its label: not started, under way
// (running late if its area is), or finished.
func flightState(a DayArea, f DayFlight) (State, string) {
	switch {
	case f.Finished != "":
		return Done, "Finished"
	case f.Started != "" && a.Late:
		return Attention, "Running late"
	case f.Started != "":
		return InProgress, "Under way"
	}
	return NotYet, "Not started"
}

// checkinState is a gymnast's or official's check-in, and its label.
func checkinState(state string) (State, string) {
	switch state {
	case "here":
		return Done, "Here"
	case "scratched":
		return Stopped, "Scratched"
	case "missing":
		return Stopped, "Missing"
	}
	return NotYet, "Not yet"
}

// checkCount is a flight's check-in, or its panel's, counted: of the
// people, how many are here and how many out (OutWord: scratched or
// missing); and, for a panel, how many seats have no one.
type checkCount struct {
	Of, Here, Out, Empty int
	OutWord              string
}

func checkinCount(gs []DayGymnast) checkCount {
	c := checkCount{Of: len(gs), OutWord: "scratched"}
	for _, g := range gs {
		switch g.State {
		case "here":
			c.Here++
		case "scratched":
			c.Out++
		}
	}
	return c
}

func seatCount(ss []DaySeat) checkCount {
	c := checkCount{OutWord: "missing"}
	for _, s := range ss {
		switch {
		case s.Person == "":
			c.Empty++
			continue
		case s.State == "here":
			c.Here++
		case s.State == "missing":
			c.Out++
		}
		c.Of++
	}
	return c
}

// countChips shows a check-in's counts: how many are here (done once
// everyone is here or scratched; an official missing leaves their seat to
// fill, so a panel is done only with everyone here), how many out, and the
// seats that need someone.
templ countChips(c checkCount) {
	{{ missing := c.OutWord == "missing" && c.Out > 0 }}
	if c.Of > 0 {
		switch {
			case missing:
				@StateChip(Attention, strconv.Itoa(c.Here)+" of "+strconv.Itoa(c.Of)+" here")
			case c.Here+c.Out == c.Of:
				@StateChip(Done, strconv.Itoa(c.Here)+" of "+strconv.Itoa(c.Of)+" here")
			default:
				@StateChip(NotYet, strconv.Itoa(c.Here)+" of "+strconv.Itoa(c.Of)+" here")
		}
	}
	if missing {
		@StateChip(Attention, strconv.Itoa(c.Out)+" "+c.OutWord)
	} else if c.Out > 0 {
		@StateChip(Stopped, strconv.Itoa(c.Out)+" "+c.OutWord)
	}
	if c.Empty > 0 {
		@StateChip(Attention, Count(c.Empty, "seat needs someone", "seats need someone"))
	}
}

// stillHereForm is the button that clears a kind of scratch warning: the
// person is still here for it.
templ stillHereForm(p DayPage, s DayScratched, kind, label string) {
	<form method="post" action={ templ.SafeURL(p.Base + "/day/clear") } class="mt-1" data-tap={ "clear:" + s.Person + ":" + kind }>
		<input type="hidden" name="person" value={ s.Person }/>
		<input type="hidden" name="kind" value={ kind }/>
		@dayFields(p)
		<button class="button is-small" type="submit">{ label }</button>
	</form>
}

// dayArea is one area's header and flights, in a block with an id so the page
// can swap in a fresh copy of it (static/js/competitions.js, dayPage). The
// currentFlight is the flight an area is on, by index: the first not
// finished; -1 when every one is.
func currentFlight(a DayArea) int {
	for i, f := range a.Flights {
		if f.Finished == "" {
			return i
		}
	}
	return -1
}

// dayAreaStatus is how an area is running, and from what, with where to see
// the rest of the day if it's late.
templ dayAreaStatus(a DayArea) {
	// Nothing started: its flight says so ("Not started"), not the area too.
	if a.Status != "" {
		<p class="mb-2 comp-area-status">
			@StateChip(areaState(a), a.Status)
			if a.Since != "" {
				<span class="is-size-7 has-text-grey">{ a.Since }</span>
			}
		</p>
	}
	if a.WhatIf != "" {
		<p class="is-size-7 mb-3"><a class="comp-tap-link" href={ templ.SafeURL(a.WhatIf) }>What if: see the rest of the day</a></p>
	}
	if len(a.Breaks) > 0 {
		<ul class="is-size-7 mb-3 comp-day-breaks">
			for _, b := range a.Breaks {
				<li>
					<strong>{ b.Name }</strong> { b.Times }
					if len(b.Officials) > 0 {
						<span class="has-text-grey">· { strings.Join(b.Officials, ", ") }</span>
					}
				</li>
			}
		</ul>
	}
}

// dayAreaCard is an area on the overview: how it's running, the flight it's
// on with who's up and the counts, the one tap that comes next, and its own
// page, where everything else is. Its people are there for Find a name, shown
// only when it finds them.
templ dayAreaCard(p DayPage, a DayArea) {
	<div class="box comp-day-area comp-day-card" id={ a.ID }>
		<h2 class="title is-5 mb-1"><a href={ templ.SafeURL(a.Link) }>{ a.Name }</a></h2>
		@dayAreaStatus(a)
		if cur := currentFlight(a); cur < 0 {
			<p class="mb-2">
				@StateChip(Done, "Finished for the day")
			</p>
		} else {
			@dayCardFlight(p, a, a.Flights[cur])
			if cur+1 < len(a.Flights) {
				<p class="is-size-7 has-text-grey mt-2">Next: { a.Flights[cur+1].Name } · { a.Flights[cur+1].Planned }</p>
			}
		}
		<p class="mt-3"><a class="button is-small comp-day-open" href={ templ.SafeURL(a.Link) }>Open { a.Name } →</a></p>
		<details class="comp-day-people" data-list-group>
			<summary>People</summary>
			for _, f := range a.Flights {
				for _, g := range f.Gymnasts {
					<a class="comp-day-person" href={ templ.SafeURL(a.Link + "#" + f.ID) } { ListRow{Name: g.Name}.Attrs()... }>
						{ g.Name }
						<span class="has-text-grey is-size-7">{ f.Name }</span>
					</a>
				}
				for _, st := range f.Seats {
					if st.Person != "" {
						<a class="comp-day-person" href={ templ.SafeURL(a.Link + "#" + f.ID) } { ListRow{Name: st.Name}.Attrs()... }>
							{ st.Name }
							<span class="has-text-grey is-size-7">{ st.Role } · { f.Name }</span>
						</a>
					}
				}
			}
		</details>
	</div>
}

// dayCardFlight is the flight an area is on, on its card: who's up, the
// counts, and the one tap that comes next (Started, Next gymnast, or
// Finished once the last routine is on).
templ dayCardFlight(p DayPage, a DayArea, f DayFlight) {
	<div class="comp-day-card-flight">
		<p class="mb-1"><strong>{ f.Name }</strong> @StateChip(flightState(a, f))</p>
		<p class="is-size-7 has-text-grey mb-2">
			if f.Started != "" {
				Started { f.Started } · planned { f.Planned }
			} else {
				Planned { f.Planned }
			}
		</p>
		if f.Up != nil && !f.Up.Waiting && f.Up.Name != "" {
			<p class="mb-2">
				<span class="is-size-7 has-text-grey">
					if f.Up.Tapped {
						On now
					} else {
						First up
					}
				</span>
				@runNo(f.Up.No)
				<strong>{ f.Up.Name }</strong>
				<span class="is-size-7">{ f.Up.Routine }</span>
			</p>
		}
		<p class="is-size-7 mb-3">
			if len(f.Gymnasts) > 0 {
				Check-in
				@countChips(checkinCount(f.Gymnasts))
			}
			if len(f.Seats) > 0 {
				<span class="ml-2">Panel</span>
				@countChips(seatCount(f.Seats))
			}
		</p>
		switch {
			case f.CanStart:
				@dayFlightForm(p, f, false)
			case f.CanFinish && f.Up != nil && f.Up.Name != "" && !f.Up.Last:
				<div class="comp-up">
					@dayUpForm(p, f, true)
				</div>
			case f.CanFinish:
				@dayFlightForm(p, f, false)
		}
	</div>
}

// dayAreaPage is an area's own page, where its marshal works: the flight
// it's on in full (Started at the top, then who's up, check-in and the
// panel, and Finished at the bottom), then its later flights and those
// finished, each opening to the same.
templ dayAreaPage(p DayPage, a DayArea) {
	<div class="comp-day-area" id={ a.ID } data-list-group>
		<h2 class="title is-4 mb-1">{ a.Name }</h2>
		@dayAreaStatus(a)
		if cur := currentFlight(a); cur >= 0 {
			<div class="box comp-flight comp-day-now" id={ a.Flights[cur].ID } data-list-group>
				<p class="mb-1"><strong>{ a.Flights[cur].Name }</strong> @StateChip(flightState(a, a.Flights[cur]))</p>
				@dayFlightTimes(a.Flights[cur])
				@dayFlightBody(p, a.Flights[cur], true)
			</div>
			if cur+1 < len(a.Flights) {
				<h3 class="title is-6 mt-5 mb-2">Later on { a.Name }</h3>
				for _, f := range a.Flights[cur+1:] {
					@dayOtherFlight(p, a, f)
				}
			}
			if cur > 0 {
				<h3 class="title is-6 mt-5 mb-2">Finished</h3>
				for _, f := range a.Flights[:cur] {
					@dayOtherFlight(p, a, f)
				}
			}
		} else {
			<p class="mb-3">
				@StateChip(Done, "Finished for the day")
			</p>
			for _, f := range a.Flights {
				@dayOtherFlight(p, a, f)
			}
		}
	</div>
}

// dayOtherFlight is a flight the area isn't on, closed, opening to the same
// as the one it's on.
templ dayOtherFlight(p DayPage, a DayArea, f DayFlight) {
	<details class="box comp-flight comp-day-other" id={ f.ID } data-key={ "flight:" + f.Key } data-list-group>
		<summary>
			<strong>{ f.Name }</strong>
			@StateChip(flightState(a, f))
			<span class="is-size-7 has-text-grey">{ f.Planned }</span>
		</summary>
		<div class="mt-2">
			@dayFlightTimes(f)
			@dayFlightBody(p, f, false)
		</div>
	</details>
}

// dayFlightTimes is when a flight was planned, and started and finished.
templ dayFlightTimes(f DayFlight) {
	<p class="is-size-7 mb-1">Planned { f.Planned }</p>
	<p class="is-size-7 mb-2">
		Started
		if f.Started != "" {
			<strong>{ f.Started }</strong>
		} else {
			—
		}
		· finished
		if f.Finished != "" {
			<strong>{ f.Finished }</strong>
		} else {
			—
		}
		if f.Who != "" && (f.Started != "" || f.Finished != "") {
			<span class="has-text-grey"> · { f.Who }</span>
		}
	</p>
}

// dayFlightBody is a flight's taps and lists, in the order they're used:
// Started at the top until it is, then who's up, check-in and the panel,
// with Finished at the bottom, and putting its times right after that. Open
// shows the lists as they are, for the flight on now; otherwise each opens.
templ dayFlightBody(p DayPage, f DayFlight, open bool) {
	if f.CanStart {
		@dayFlightForm(p, f, true)
	}
	if f.Up != nil {
		@dayUp(p, f)
	}
	if len(f.Gymnasts) > 0 {
		if open {
			<div class="comp-checkin comp-day-section" data-key={ "checkin:" + f.Key } data-list-group>
				<h4 class="comp-day-section-title">
					Check-in
					@countChips(checkinCount(f.Gymnasts))
				</h4>
				@dayCheckinRows(p, f)
			</div>
		} else {
			<details class="comp-checkin mt-2" data-key={ "checkin:" + f.Key } data-list-group>
				<summary class="is-size-7">
					Check-in ·
					@countChips(checkinCount(f.Gymnasts))
				</summary>
				@dayCheckinRows(p, f)
			</details>
		}
	}
	if len(f.Seats) > 0 {
		if open {
			<div class="comp-checkin comp-day-section" data-key={ "panel:" + f.Key } data-list-group>
				<h4 class="comp-day-section-title">
					Panel
					@countChips(seatCount(f.Seats))
				</h4>
				@daySeatRows(p, f)
			</div>
		} else {
			<details class="comp-checkin mt-2" data-key={ "panel:" + f.Key } data-list-group>
				<summary class="is-size-7">
					Panel ·
					@countChips(seatCount(f.Seats))
				</summary>
				@daySeatRows(p, f)
			</details>
		}
	}
	if !f.CanStart && (f.CanFinish || f.Undo != "") && !finishesHere(f) {
		@dayFlightForm(p, f, true)
	}
	if p.Correct {
		@dayCorrect(p, f)
	}
}

// dayFlightForm is a flight's Started, Finished and Undo: one form, so a
// tap kept on the phone shows the next as it will be (taps.js). Undo, which
// takes back the last of them, only where the flight is in full.
templ dayFlightForm(p DayPage, f DayFlight, undo bool) {
	<form method="post" action={ templ.SafeURL(p.Base + "/day/flight") } class="buttons comp-day-flight-taps" data-tap={ "flight:" + f.Key }>
		<input type="hidden" name="flight" value={ f.Key }/>
		@dayFields(p)
		if f.CanStart {
			<button class="button is-primary" type="submit" name="what" value="start">Started</button>
		}
		if f.CanFinish {
			<button class={ "button is-primary", templ.KV("is-medium", finishesHere(f)) } type="submit" name="what" value="finish">Finished</button>
		}
		if undo && f.Undo != "" {
			// Says which, so the same tap sent twice takes back only the one.
			<button class="button is-small" type="submit" name="what" value={ f.Undo }>Undo</button>
		}
	</form>
}

// dayFields are the day shown, and the area whose page it is, which every
// form on the page posts, to come back to the same page.
templ dayFields(p DayPage) {
	<input type="hidden" name="day" value={ strconv.Itoa(p.Day) }/>
	if p.Area != "" {
		<input type="hidden" name="area" value={ p.Area }/>
	}
}

// dayCheckinRows are a flight's gymnasts, to check in.
templ dayCheckinRows(p DayPage, f DayFlight) {
	for _, g := range f.Gymnasts {
		<div class="comp-checkin-row" { ListRow{Name: g.Name}.Attrs()... } data-entry={ g.Entry } data-no={ strconv.Itoa(g.No) } data-club={ g.Club } data-routines={ g.Routines } data-state={ g.State }>
			<span class="comp-checkin-name">
				@runNo(g.No)
				if g.Person != "" && p.People {
					<a class={ templ.KV("comp-scratched", g.State == "scratched") } href={ templ.SafeURL(p.Base + "/people/" + url.PathEscape(g.Person)) }>{ g.Name }</a>
				} else {
					<span class={ templ.KV("comp-scratched", g.State == "scratched") }>{ g.Name }</span>
				}
				<span class="has-text-grey is-size-7">{ g.Club }</span>
				@StateChip(checkinState(g.State))
				if g.Who != "" {
					<span class="has-text-grey is-size-7">{ g.Who }</span>
				}
			</span>
			<form method="post" action={ templ.SafeURL(p.Base + "/day/checkin") } data-tap={ "checkin:" + g.Entry }>
				<input type="hidden" name="entry" value={ g.Entry }/>
				@dayFields(p)
				if g.CanHere {
					<button class="button is-small is-state-done" type="submit" name="status" value="here">Here</button>
				}
				if g.CanScratch {
					<button class="button is-small is-state-stopped" type="submit" name="status" value="scratched">Scratched</button>
				}
				if g.CanClear {
					<button class="button is-small" type="submit" name="status" value="">Clear</button>
				}
			</form>
			if g.Notify.Person != "" {
				@dayNotify(p, f.Key, g.Notify)
			}
		</div>
	}
}

// daySeatRows are a flight's panel, to check in, with the seats no one has.
templ daySeatRows(p DayPage, f DayFlight) {
	for _, s := range f.Seats {
		if s.Person == "" {
			<div class="comp-checkin-row">
				<span class="comp-panel-name">
					<span class="has-text-grey is-size-7">{ s.Role }</span>
					@StateChip(Attention, "Needs someone")
				</span>
			</div>
			continue
		}
		<div class="comp-checkin-row" { ListRow{Name: s.Name}.Attrs()... }>
			<span class="comp-panel-name">
				<span>{ s.Name }</span>
				<span class="has-text-grey is-size-7">{ s.Role }</span>
				@StateChip(checkinState(s.State))
				if s.Who != "" {
					<span class="has-text-grey is-size-7">{ s.Who }</span>
				}
			</span>
			<form method="post" action={ templ.SafeURL(p.Base + "/day/officials") } data-tap={ "official:" + f.Key + ":" + s.Person }>
				<input type="hidden" name="person" value={ s.Person }/>
				<input type="hidden" name="flight" value={ f.Key }/>
				@dayFields(p)
				if s.CanHere {
					<button class="button is-small is-state-done" type="submit" name="status" value="here">Here</button>
				}
				if s.CanMissing {
					<button class="button is-small is-state-stopped" type="submit" name="status" value="missing">Missing</button>
				}
				if s.CanClear {
					<button class="button is-small" type="submit" name="status" value="">Clear</button>
				}
			</form>
			if s.WhatIf != "" {
				<a class="is-size-7 comp-tap-link" href={ templ.SafeURL(s.WhatIf) }>What if they leave</a>
			}
			if s.Notify.Person != "" {
				@dayNotify(p, f.Key, s.Notify)
			}
		</div>
	}
}

// dayCorrect puts a flight's start and finish right, for when the paper
// sheet was used or a tap was wrong.
templ dayCorrect(p DayPage, f DayFlight) {
	<details class="comp-correct mt-2" data-key={ "times:" + f.Key }>
		<summary class="is-size-7">Correct the times</summary>
		<form method="post" action={ templ.SafeURL(p.Base + "/day/times") } class="mt-2">
			<input type="hidden" name="flight" value={ f.Key }/>
			@dayFields(p)
			<div class="comp-correct-times">
				<div class="field mb-0">
					<label class="label is-small" for={ f.ID + "-started" }>Started</label>
					<div class="control">
						<input class="input is-small" type="time" id={ f.ID + "-started" } name="started" value={ f.Started }/>
					</div>
				</div>
				<div class="field mb-0">
					<label class="label is-small" for={ f.ID + "-finished" }>Finished</label>
					<div class="control">
						<input class="input is-small" type="time" id={ f.ID + "-finished" } name="finished" value={ f.Finished }/>
					</div>
				</div>
				<button class="button is-small is-primary" type="submit">Save times</button>
			</div>
			<p class="help">
				Clock times on { p.DayName }. Leave Finished empty if it hasn't finished, or both to clear them. The history says who changed them.
			</p>
		</form>
	</details>
}

// dayUp is who's on in a running flight, big enough to read at arm's length,
// with Next gymnast to tap as each one starts, and Back.
templ dayUp(p DayPage, f DayFlight) {
	<div class="comp-up mb-3" hidden?={ f.Up.Waiting }>
		if f.Up.Name == "" {
			<p class="mb-2">No one left to compete: everyone is scratched.</p>
		} else {
			<p class="is-size-7 has-text-grey mb-0">
				if f.Up.Tapped {
					On now
				} else {
					First up: tap Next gymnast as they start
				}
			</p>
			<p class="is-size-4 has-text-weight-bold mb-0">
				@runNo(f.Up.No)
				<span class={ templ.KV("comp-scratched", f.Up.Scratched) }>{ f.Up.Name }</span>
				if f.Up.Scratched {
					@StateChip(Stopped, "Scratched")
				} else if f.Up.NotHere {
					@StateChip(Attention, "Not checked in")
				}
			</p>
			<p class="mb-2">
				if f.Up.Club != "" {
					<span class="has-text-grey">{ f.Up.Club } · </span>
				}
				<strong>{ f.Up.Routine }</strong>
			</p>
			if f.Up.Next != "" {
				<p class="is-size-7 has-text-grey mb-2">Next: { f.Up.Next }</p>
			}
		}
		if finishesHere(f) {
			// The last routine: Finished takes Next gymnast's place, Back beside it.
			// No Undo here: beside Finished it would take back the flight's start.
			<div class="comp-up-last">
				@dayFlightForm(p, f, false)
				// Back, if there's one to go back to; the form stays either way, for a tap kept on the phone.
				@dayUpForm(p, f, false)
			</div>
			<p class="is-size-7 mt-2">The flight's last routine: tap Finished once it's done.</p>
		} else {
			@dayUpForm(p, f, true)
		}
	</div>
}

// finishesHere reports whether a flight's Finished goes where Next gymnast
// was: its last routine is on.
func finishesHere(f DayFlight) bool {
	return f.CanFinish && f.Up != nil && !f.Up.Waiting && f.Up.Name != "" && f.Up.Last
}

// dayUpForm is Next gymnast (unless next is false: the last routine is on),
// and Back: what's posted is who the page showed, so the same tap sent twice
// moves once.
templ dayUpForm(p DayPage, f DayFlight, next bool) {
	<form method="post" action={ templ.SafeURL(p.Base + "/day/up") } class="buttons mb-0" data-tap={ "up:" + f.Key }>
		<input type="hidden" name="flight" value={ f.Key }/>
		@dayFields(p)
		<input type="hidden" name="entry" value={ f.Up.Entry }/>
		<input type="hidden" name="round" value={ f.Up.Round }/>
		if next {
			<button class="button is-primary is-medium" type="submit" name="what" value="next">Next gymnast</button>
		}
		if f.Up.CanBack {
			<button class="button is-small" type="submit" name="what" value="back">Back</button>
		}
	</form>
}

// dayNotify is the small form that tells someone who isn't here where they
// should be: them, their club's comp sec and coaches, or both.
templ dayNotify(p DayPage, flight string, n DayNotify) {
	<details class="comp-notify" data-key={ "notify:" + n.As + ":" + flight + ":" + n.Person }>
		<summary class="button is-small comp-opens-button">Notify</summary>
		<form method="post" action={ templ.SafeURL(p.Base + "/day/notify") }>
			<input type="hidden" name="person" value={ n.Person }/>
			<input type="hidden" name="flight" value={ flight }/>
			<input type="hidden" name="as" value={ n.As }/>
			@dayFields(p)
			// A new id each time the form is shown, so the same form sent twice sends once.
			<input type="hidden" name="once" value={ rand.Text() }/>
			<label class="checkbox is-size-7"><input type="checkbox" name="them" value="1" checked/> Them</label>
			if n.Club {
				<label class="checkbox is-size-7"><input type="checkbox" name="club" value="1"/> Their club</label>
			}
			<input class="input is-small" type="text" name="note" maxlength="300" placeholder="Extra line (optional)" aria-label="Extra line"/>
			<button class="button is-small is-primary" type="submit">Send</button>
		</form>
	</details>
}
