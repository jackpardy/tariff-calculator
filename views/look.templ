package views

// The small pieces every competition and club page shares, so each looks
// and reads the same wherever it is (knowledge/architecture/ui.md).

// notice says what a change just did ("Saved."): green, with × to put it
// away. Nothing when there's nothing to say.
templ notice(text string) {
	if text != "" {
		<div class="notification is-success is-light comp-notice" role="status">
			@noticeClose()
			{ text }
		</div>
	}
}

// stickyNotice is a notice that stays in sight while the page goes to where
// the change is (the row changed, further down).
templ stickyNotice(text string) {
	if text != "" {
		<div class="notification is-success is-light comp-notice comp-sticky-notice" role="status">
			@noticeClose()
			{ text }
		</div>
	}
}

templ noticeClose() {
	<button class="delete" type="button" aria-label="Dismiss" onclick="this.parentElement.remove()"></button>
}

// backLink is the way back, above a page's heading: an arrow and the name of
// the page it goes to, never just "Back".
templ backLink(href, to string) {
	<p class="comp-back"><a href={ templ.SafeURL(href) }>← { to }</a></p>
}

// emptyLine says there's nothing to show yet, and what brings something:
// one line, the same size and grey on every page.
templ emptyLine(text string) {
	<p class="comp-empty">{ text }</p>
}

// pageHead is a page's heading: the page's name, and under it what it's of
// (the competition's name).
templ pageHead(title, of string) {
	<h1 class="title is-4">{ title }</h1>
	if of != "" {
		<p class="subtitle is-6">{ of }</p>
	}
}

// typeToDelete is the last step of deleting a whole competition or club: the
// word "delete" typed into a box, so it can't happen by accident. Its button
// waits for the word, and the server checks it too (deleteTyped in web).
templ typeToDelete(action, id, what, button string) {
	<form method="post" action={ templ.SafeURL(action) } class="comp-type-delete mb-3">
		<label class="is-size-7" for={ id }>To delete { what }, type <strong>delete</strong>:</label>
		<div class="comp-type-delete-row">
			<input class="input is-small" type="text" id={ id } name="confirm" autocomplete="off" autocapitalize="off" spellcheck="false" required oninput="this.form.querySelector('button').disabled = this.value.trim().toLowerCase() !== 'delete'"/>
			<button class="button is-small is-danger" type="submit" disabled>{ button }</button>
		</div>
	</form>
}

// Ask asks, on the page it was asked from, before a change to one person or
// thing that can't be put back (removing a member, a link, a payment;
// replacing a link): the page again, with a box at its top saying what the
// change does, and the change as posted to make it (anyway=1). A change that
// does a lot at once asks on a page of its own (AskFirst, ChangeCheck); one
// that's easily put back is made, with Undo (ui.md, "Asking first").
type Ask struct {
	Title, Text string
	Action      string      // where the change posts
	Fields      []FormValue // the change as posted, but anyway
	Button      string      // the button that makes it, e.g. "Remove Ann Ryan"
	Back        string      // where Cancel goes
	// Remove is an ask to take something away (a person, a link, a payment):
	// its box has a red edge and its button is red, so it reads as removing.
	Remove bool
}

// askBox is an Ask, at the top of the page. Nothing when there's no ask.
templ askBox(a *Ask) {
	if a != nil {
		<div class={ "notification", "is-warning", "is-light", "comp-ask", templ.KV("is-remove", a.Remove) } id="ask" role="alert">
			<p class="mb-2"><strong>{ a.Title }</strong></p>
			<p class="mb-3">{ a.Text }</p>
			<form method="post" action={ templ.SafeURL(a.Action) } class="buttons">
				for _, v := range a.Fields {
					<input type="hidden" name={ v.Name } value={ v.Value }/>
				}
				<input type="hidden" name="anyway" value="1"/>
				if a.Remove {
					<button class="button is-small is-danger is-outlined" type="submit">{ a.Button }</button>
				} else {
					<button class="button is-small is-primary" type="submit">{ a.Button }</button>
				}
				<a class="button is-small" href={ templ.SafeURL(a.Back) }>Cancel</a>
			</form>
		</div>
	}
}

// Undo takes back a change just made that's easily put back (withdrawing a
// coach's approval): it posts Fields to Action.
type Undo struct {
	Action string
	Fields []FormValue
}

// undoNotice is a notice with Undo in it, for a change made without asking
// because it's easily put back; sticky, it stays in sight as stickyNotice
// does. Without an Undo it's the plain notice.
templ undoNotice(text string, u *Undo, sticky bool) {
	if u == nil && sticky {
		@stickyNotice(text)
	} else if u == nil {
		@notice(text)
	} else if text != "" {
		<div class={ "notification", "is-success", "is-light", "comp-notice", templ.KV("comp-sticky-notice", sticky) } role="status">
			@noticeClose()
			{ text }
			<form method="post" action={ templ.SafeURL(u.Action) } class="is-inline ml-1">
				for _, v := range u.Fields {
					<input type="hidden" name={ v.Name } value={ v.Value }/>
				}
				<button class="button is-small" type="submit">Undo</button>
			</form>
		</div>
	}
}
