package views

import (
	"encoding/json"
	"fmt"
	"math"
	"strconv"
	"strings"

	"tariffCalculator/catalog"
	"tariffCalculator/skills"
)

// SkillForm is the data for the "Add a skill" panel.
type SkillForm struct {
	Editor     SkillEditor
	Categories []catalog.Category // the skill picker's tabs
}

// SkillEditor is the part of the panel the server re-renders as the skill
// changes: the skill card (live summary, shape, label, Add) and the builder
// that adjusts the skill's parameters. A skill being changed in its routine
// card has its shape and label above the search instead (editFields), and
// Update and Cancel on the card's head.
type SkillEditor struct {
	Skill       skills.TrampolineSkill // named and priced
	EditIndex   int                    // index of the routine skill being edited, or -1 when adding
	BuilderOpen bool                   // whether "Build or adjust this skill" is expanded
	// SetRoutine is the compact form building a set routine on the
	// requirements page: Add puts the skill in the set routine.
	SetRoutine bool
	// Follows says why a body-landing tile gave this version of it, e.g.
	// "From seat, after Seat Drop"; "" otherwise.
	Follows string
}

// Editing reports whether the editor is changing a routine skill rather than adding one.
func (e SkillEditor) Editing() bool { return e.EditIndex >= 0 }

// SkillFormView renders the "Add a skill" panel. Every change inside
// #skill-editor posts the whole form to /skill-inputs, which re-renders the
// editor from it, so the card always shows the skill that Add will add.
// Changing a skill in its card, the shape and label come first, under the
// card's head, then the search and the builder: #edit-fields posts its
// changes the same way, and comes back with the editor (SkillInputsView).
templ SkillFormView(f SkillForm) {
	<form id="main-form" class="skill-adder" x-on:submit.prevent>
		if f.Editor.Editing() {
			<div
				id="edit-fields"
				class="edit-fields"
				hx-post="/skill-inputs"
				hx-trigger="change"
				hx-include="#main-form"
				hx-target="#skill-editor"
				hx-sync="#skill-editor:replace"
			>
				@editFields(f.Editor)
			</div>
		}
		@picker(f.Categories)
		// The skill before the place Add (or Update) puts this one, as JSON, for
		// a body-landing tile to take off where it landed.
		<input type="hidden" name="previous_skill" x-bind:value="previousSkill()"/>
		<div
			id="skill-editor"
			hx-post="/skill-inputs"
			hx-trigger="change"
			hx-include="#main-form"
			hx-target="this"
			hx-sync="this:replace"
		>
			@SkillEditorView(f.Editor)
		</div>
	</form>
}

// picker lets the user choose a common skill by category: big buttons, one tab
// per category. Choosing one loads it into the editor (keeping the label and
// edit state), where the card shows it and its shape can be changed. The tab and
// the last pick are kept in the page's Alpine component (pickerTab, picked).
// In the builder, while a card is being changed in place (the form moved into
// it), only the search shows, as "Change to another skill": the tabs are for
// adding.
templ picker(cats []catalog.Category) {
	<div class="picker">
		<label
			class="label"
			for="skill-search"
			if len(cats) > 0 {
				x-text="editingIndex === null ? 'Choose a skill' : 'Change to another skill'"
			}
		>Choose a skill</label>
		// Search by name or FIG notation; while there's a query, its results replace the tabs.
		// Enter searches at once and picks the first result of what's typed now, not of the
		// last search to come back (the typing waits 200 ms before it searches). In a
		// card being changed, Enter puts the focus on the first result instead, and
		// Enter again puts it on the card (searchEnter in app.js).
		<input
			class="input"
			type="search"
			id="skill-search"
			name="q"
			autocomplete="off"
			placeholder="Search, e.g. barani or 8 1 1 <"
			x-model="query"
			hx-get="/skill-search"
			hx-trigger="input changed delay:200ms, search"
			hx-target="#search-results"
			hx-sync="this:replace"
			if len(cats) > 0 {
				x-on:keydown.enter.prevent="searchEnter($el)"
			} else {
				x-on:keydown.enter.prevent="htmx.ajax('GET', '/skill-search?q=' + encodeURIComponent($el.value), { target: '#search-results', swap: 'innerHTML' }).then(() => document.querySelector('#search-results .picker-skill')?.click())"
			}
		/>
		<div
			id="search-results"
			class="picker-results"
			x-show="query.trim() !== ''"
			x-cloak
			if len(cats) > 0 {
				x-on:click="resultChosen($event)"
			}
		></div>
		<div
			class="picker-browse"
			if len(cats) > 0 {
				x-show="editingIndex === null"
			}
		>
			<div class="picker-tabs" role="tablist" aria-label="Skill categories" x-show="query.trim() === ''">
				for _, c := range cats {
					<button
						type="button"
						role="tab"
						class="picker-tab"
						x-bind:class={ fmt.Sprintf("{ 'is-active': pickerTab === '%s' }", c.Key) }
						x-bind:aria-selected={ fmt.Sprintf("pickerTab === '%s'", c.Key) }
						x-on:click={ fmt.Sprintf("pickerTab = '%s'", c.Key) }
					>{ c.Label }</button>
				}
			</div>
			for _, c := range cats {
				<div class="picker-list" role="tabpanel" aria-label={ c.Label } x-show={ fmt.Sprintf("query.trim() === '' && pickerTab === '%s'", c.Key) } x-cloak>
					// Body landings: the drops from the feet, then those from a body
					// landing, each taking off where the skill before it lands (g.Note).
					for _, g := range c.Groups {
						<div class="picker-group" role="group" aria-label={ g.Title }>
							<p class="picker-group-title">{ g.Title }</p>
							if g.Note != "" {
								<p class="picker-group-note">{ g.Note }</p>
							}
							<div class="picker-group-options">
								for _, e := range g.Options {
									<button
										type="button"
										class="picker-option"
										x-bind:class={ fmt.Sprintf("{ 'is-picked': picked === '%s' }", e.ID()) }
										x-on:click={ fmt.Sprintf("picked = '%s'; pickedShape = '%s'", e.ID(), e.Skill.Shape) }
										hx-post="/skill-inputs"
										hx-target="#skill-editor"
										hx-include="#main-form"
										if e.Tile != nil {
											hx-vals={ loadLanding(e.Key) }
										} else {
											hx-vals={ loadCommon(e.Key, e.Skill.Shape) }
										}
									>
										<span class="picker-skill-name">{ e.Label }</span>
										// A tile's tariff depends on the skill before it: the card shows it.
										if e.Tile == nil {
											<span class="picker-skill-tariff">{ fmt.Sprintf("%.1f", e.Skill.Tariff) }</span>
										}
									</button>
								}
							</div>
						</div>
					}
					for _, e := range c.Entries {
						<div class="picker-skill" x-bind:class={ fmt.Sprintf("{ 'is-picked': picked === '%s' }", e.ID()) } data-tariffs={ templ.JSONString(e.ShapeTariffs()) }>
							// The skill in its usual shape...
							<button
								type="button"
								class="picker-skill-main"
								x-on:click={ fmt.Sprintf("picked = '%s'; pickedShape = '%s'", e.ID(), e.Skill.Shape) }
								hx-post="/skill-inputs"
								hx-target="#skill-editor"
								hx-include="#main-form"
								hx-vals={ loadCommon(e.Key, e.Skill.Shape) }
							>
								<span class="picker-skill-name">{ catalog.PickerName(e.Skill) }</span>
								// The base (tuck) tariff, or once picked, the chosen shape's; the shape
								// buttons say how the others differ from it.
								<span class="picker-skill-tariff" x-text={ fmt.Sprintf("boxTariff($el.closest('.picker-skill').dataset.tariffs, '%s', %.1f)", e.ID(), e.BaseTariff()) }>{ fmt.Sprintf("%.1f", e.BaseTariff()) }</span>
							</button>
							// ...or straight away in another shape.
							if options := e.ShapeOptions(); len(options) > 0 {
								<div class="picker-shapes" role="group" aria-label={ "Shape for " + catalog.PickerName(e.Skill) }>
									for _, o := range options {
										<button
											type="button"
											class="picker-shape"
											x-bind:class={ fmt.Sprintf("{ 'is-selected': picked === '%s' && pickedShape === '%s' }", e.ID(), o.Shape) }
											x-on:click={ fmt.Sprintf("picked = '%s'; pickedShape = '%s'", e.ID(), o.Shape) }
											hx-post="/skill-inputs"
											hx-target="#skill-editor"
											hx-include="#main-form"
											hx-vals={ loadCommon(e.Key, o.Shape) }
										>
											<span class="picker-shape-name">{ o.Shape.String() }</span>
											// Against tuck, or against the shape chosen once this box is picked.
											<span class="picker-shape-modifier" x-text={ fmt.Sprintf("shapeModifier($el.closest('.picker-skill').dataset.tariffs, '%s', '%s')", o.Shape, e.ID()) }>
												if o.Modifier > 0 {
													{ fmt.Sprintf("+%.1f", o.Modifier) }
												}
											</span>
										</button>
									}
								</div>
							}
						</div>
					}
				</div>
			}
			<p class="picker-hint">Not listed? Use "Build or adjust this skill" below.</p>
		</div>
	</div>
}

// SearchResults lists the matches for a picker search. Each loads its skill into
// the editor; notation results say which direction they are, since notation
// doesn't record it.
templ SearchResults(query string, results []catalog.Result, reading *skills.TrampolineSkill, tiles []catalog.Entry) {
	// A landing typed ("to feet") first, as its tile: it takes off where the
	// skill before landed (the form's previous_skill), so the card shows the
	// right version.
	if len(tiles) > 0 {
		<div class="picker-list">
			for _, e := range tiles {
				<button type="button" class="picker-skill" hx-post="/skill-inputs" hx-target="#skill-editor" hx-include="#main-form" hx-vals={ loadLanding(e.Key) }>
					<span>
						<span class="picker-skill-name">{ e.Label }</span>
						<span class="picker-skill-meta">from where the skill before lands</span>
					</span>
				</button>
			}
		</div>
	}
	if len(results) == 0 && len(tiles) > 0 {
		// The tiles are the answer.
	} else if len(results) == 0 {
		if reading != nil {
			// FIG notation that no take-off lands: what it says goes into the
			// builder, open, to finish.
			<p class="picker-hint">No skill lands as "{ query }" from any take-off. It's in "Build or adjust this skill" below: set where it takes off and lands.</p>
			<div hidden hx-post="/skill-inputs" hx-target="#skill-editor" hx-include="#main-form" hx-trigger="load" hx-vals={ loadReading(*reading) }></div>
		} else {
			<p class="picker-hint">No skills match "{ query }". Try another name, or build it below.</p>
		}
	} else {
		// FIG notation loads its first reading onto the card as it's typed; one
		// that isn't a named skill opens "Build or adjust" too, to finish it.
		<div class="picker-list">
			for i, r := range results {
				<button
					type="button"
					class="picker-skill"
					hx-post="/skill-inputs"
					hx-target="#skill-editor"
					hx-include="#main-form"
					if i == 0 && r.FromNotation && r.Skill.Name == "Custom Skill" {
						hx-vals={ loadReading(r.Skill) }
					} else {
						hx-vals={ loadSkill(r.Skill) }
					}
					if i == 0 && r.FromNotation {
						hx-trigger="click, load"
					}
				>
					<span>
						// The card's name for it, shape and all, and the rule books' where it differs.
						<span class="picker-skill-name">{ r.Skill.Name }</span>
						<span class="picker-skill-meta">
							if also := catalog.AlsoCalled(r.Skill); also != "" {
								also called { also } ·
							}
							{ r.Skill.FIGNotation() }
							if r.FromNotation {
								· { directionText(r.Skill) } · { r.Skill.TakeoffPosition.String() } → { landingText(r.Skill) }
							}
						</span>
					</span>
					<span class="picker-skill-tariff">{ fmt.Sprintf("%.1f", r.Skill.Tariff) }</span>
				</button>
			}
		</div>
	}
}

// SkillInputsView is the editor re-rendered as the skill changes; changing a
// skill in its card, the shape and label above the search come too, in place
// of the ones there (out of band).
templ SkillInputsView(e SkillEditor) {
	@SkillEditorView(e)
	if e.Editing() {
		<div id="edit-fields" hx-swap-oob="innerHTML">
			@editFields(e)
		</div>
	}
}

// SkillEditorView renders the builder and the skill card for the editor's
// skill. Changing a skill in its card, the card is only a readout of what's
// being built, shown while the builder is open (the routine card's head
// shows the skill otherwise).
templ SkillEditorView(e SkillEditor) {
	<input type="hidden" name="editIndex" value={ strconv.Itoa(e.EditIndex) }/>
	if e.SetRoutine {
		<input type="hidden" name="set_routine" value="1"/>
	}
	<input type="hidden" name="builder_open" value={ boolValue(e.BuilderOpen) }/>
	<details
		id="skill-builder"
		class="skill-builder"
		open?={ e.BuilderOpen }
		x-on:toggle="$el.closest('form').elements.builder_open.value = $el.open ? '1' : ''"
	>
		<summary>Build or adjust this skill</summary>
		@builderFields(e.Skill, e.Editing())
	</details>
	if e.Editing() {
		<div class="skill-card skill-readout">
			@skillCardHead(e.Skill)
		</div>
	} else {
		@editorCard(e)
	}
}

// editFields are the shape and label of a skill being changed in its card,
// and what the card says about it: they sit just under the card's head. The
// label shows on the head as it's typed (readDraft in app.js).
templ editFields(e SkillEditor) {
	if e.Follows != "" {
		<p class="help skill-card-follows">{ e.Follows }</p>
	}
	if e.Skill.LandingPosition() == skills.Invalid {
		<p class="skill-card-problem">This skill can't land like that. Check the direction, somersault and twist.</p>
	}
	@shapeChoice(e.Skill)
	@labelField(e.Skill, true)
}

// editorCard is the live summary of the skill, its shape, an optional label and
// the one button that adds it. On phones it sticks to the bottom of the screen
// while the panel is in view.
templ editorCard(e SkillEditor) {
	<div class="skill-card">
		@skillCardHead(e.Skill)
		if e.Follows != "" {
			<p class="help skill-card-follows">{ e.Follows }</p>
		}
		if e.Skill.LandingPosition() == skills.Invalid {
			<p class="skill-card-problem">This skill can't land like that. Check the direction, somersault and twist.</p>
		}
		@labelField(e.Skill, false)
		// The shape and the main action share a row.
		<div class="skill-card-actions">
			@shapeChoice(e.Skill)
			// Which saved routine the skill goes to: the one on screen unless another
			// is chosen (in Levels mode, the voluntary shown).
			<div class="add-to" x-show="routines.length > 1" x-cloak>
				<label class="add-to-label" for="add-to">Add to</label>
				<div class="select is-small">
					<select id="add-to" x-on:change="addTo = $event.target.value">
						// No routine yet for a level's voluntary: none chosen, rather than the first.
						<option value="" x-show="!addToValue()" x-bind:selected="!addToValue()">Choose a routine...</option>
						<template x-for="t in addTargets()" x-bind:key="t.value">
							<option x-bind:value="t.value" x-bind:selected="t.value === addToValue()" x-text="t.label"></option>
						</template>
					</select>
				</div>
			</div>
			<p class="help mb-1" x-show="!addTarget()" x-cloak>Choose the routine doing this voluntary first (under its tab), or a routine above.</p>
			<button type="button" id="add-btn" class="button is-primary is-fullwidth" x-on:click="addFromForm()" x-bind:disabled={ "busy || !addTarget()" + cantLand(e.Skill) }>
				if e.SetRoutine {
					Add to the set routine
				} else {
					Add to routine
				}
			</button>
		</div>
	</div>
}

// skillCardHead is the skill's name, notation, take-off and landing, and
// tariff, as the skill card shows them (and, changing a skill in its card,
// the routine card's head, read from here: readDraft in app.js).
templ skillCardHead(s skills.TrampolineSkill) {
	<div class="skill-card-head">
		<div>
			<p class="skill-card-name">{ s.Name }</p>
			<p class="skill-card-meta">
				if s.FIGNotation() != "" {
					<span class="skill-card-fig">{ s.FIGNotation() }</span> ·
				}
				{ s.TakeoffPosition.String() } → { landingText(s) }
				// Small and out of the way until it's wanted; a straight jump isn't judged.
				if judged(s) {
					{ " · " }
					<button
						type="button"
						class="judging-link"
						hx-get="/judging"
						hx-include="#main-form"
						hx-target="body"
						hx-swap="beforeend"
						data-judging
					>How it's judged</button>
				}
			</p>
		</div>
		<p class="skill-card-tariff" title="Tariff (difficulty)">{ fmt.Sprintf("%.1f", s.Tariff) }</p>
	</div>
}

// labelField is the skill's optional label, folded away until it's wanted.
// Changing a skill in its card (live), the card's head shows it as it's typed.
templ labelField(s skills.TrampolineSkill, live bool) {
	<details class="skill-card-label" open?={ s.CustomName != "" }>
		<summary>Add a label</summary>
		<input
			class="input is-small"
			type="text"
			id="custom-name"
			name="custom_name"
			maxlength={ strconv.Itoa(skills.MaxCustomNameLength) }
			value={ s.CustomName }
			placeholder="Your own name for this skill (optional)"
			aria-label="Label"
			if live {
				x-on:input="readDraft()"
			}
		/>
	</details>
}

// shapeChoice offers the shapes that make a different skill. When shape doesn't
// matter (twisting jumps, drops, single somersaults with a full twist or more)
// it says so and keeps the current shape in a hidden field.
templ shapeChoice(s skills.TrampolineSkill) {
	if s.ShapeIsRelevant() {
		<div class="segmented" role="radiogroup" aria-label="Shape">
			for _, shape := range shapesFor(s) {
				<label class={ "segment", "shape-segment", templ.KV("is-selected", s.Shape == shape) }>
					// Keeps the picker box this skill came from in step.
					<input type="radio" name="shape" value={ strings.ToLower(shape.String()) } checked?={ s.Shape == shape } x-on:change={ fmt.Sprintf("pickedShape = '%s'", shape) }/>
					{ shape.String() }
					// How this shape's tariff differs from the shape chosen now.
					if diff := shapeDifference(s, shape); diff != "" {
						<span class="segment-modifier">{ diff }</span>
					}
				</label>
			}
		</div>
	} else {
		<input type="hidden" name="shape" value={ strings.ToLower(s.Shape.String()) }/>
	}
}

// shapeDifference is how much more or less the skill would score in shape
// than in its current shape, e.g. "+0.1" or "−0.1"; "" when the same.
func shapeDifference(s skills.TrampolineSkill, shape skills.Shape) string {
	current := s.SetTariff()
	s.Shape = shape
	diff := math.Round((s.SetTariff()-current)*10) / 10
	switch {
	case diff > 0:
		return fmt.Sprintf("+%.1f", diff)
	case diff < 0:
		return fmt.Sprintf("−%.1f", -diff)
	}
	return ""
}

// builderFields are the skill's parameters in plain language.
templ builderFields(s skills.TrampolineSkill, editing bool) {
	<div class="builder-row">
		<label class="builder-label" for="rotation">Somersault</label>
		@stepper("rotation", "rotation", s.Rotation, 0, skills.MaxRotation, "Quarter somersaults")
		<span class="builder-readout">{ somersaultText(s.Rotation) }</span>
	</div>
	<div class="builder-row">
		<span class="builder-label">Direction</span>
		<div class="segmented" role="radiogroup" aria-label="Direction">
			<label class={ "segment", templ.KV("is-selected", !s.Backward) }>
				<input type="radio" name="backward" value="" checked?={ !s.Backward }/>
				Forward
			</label>
			<label class={ "segment", templ.KV("is-selected", s.Backward) }>
				<input type="radio" name="backward" value="on" checked?={ s.Backward }/>
				Backward
			</label>
		</div>
	</div>
	for i, twist := range s.TwistDistribution {
		<div class="builder-row">
			<label class="builder-label" for={ fmt.Sprintf("twist-%d", i+1) }>{ twistLabel(i, len(s.TwistDistribution)) }</label>
			@stepper(fmt.Sprintf("twist-%d", i+1), "twist_distribution[]", twist, 0, 20, fmt.Sprintf("Half twists in phase %d", i+1))
			<span class="builder-readout">{ twistAmountText(twist) }</span>
		</div>
	}
	<div class="builder-row">
		<span class="builder-label">Takes off from</span>
		<div class="segmented" role="radiogroup" aria-label="Takes off from">
			for _, p := range []skills.BodyPosition{skills.Feet, skills.Front, skills.Back, skills.Seat} {
				<label class={ "segment", templ.KV("is-selected", s.TakeoffPosition == p) }>
					<input type="radio" name="takeoff_position" value={ strings.ToLower(p.String()) } checked?={ s.TakeoffPosition == p }/>
					{ p.String() }
				</label>
			}
		</div>
	</div>
	<div class="builder-row">
		<label class="checkbox">
			<input type="checkbox" name="seat_landing" id="seat_landing" checked?={ s.SeatLanding }/>
			Lands on seat
		</label>
	</div>
	// Shape is the card's: it shows only the shapes the skill allows, and what each does to its tariff.
	// (Changing a skill in its card, the shapes are above the search.)
	if editing {
		<p class="builder-readout mt-3">Shape: choose it at the top, under the card's name.</p>
	} else {
		<p class="builder-readout mt-3">Shape: choose it on the card below.</p>
	}
}

// stepper is a number input with − and + buttons, for quarter somersaults and half twists.
templ stepper(id, name string, value, min, max int, label string) {
	<div class="stepper">
		<button type="button" class="button is-small" aria-label={ "Less: " + label } x-on:click={ fmt.Sprintf("step('%s', -1)", id) }>−</button>
		<input
			class="input is-small"
			type="number"
			inputmode="numeric"
			id={ id }
			name={ name }
			min={ strconv.Itoa(min) }
			max={ strconv.Itoa(max) }
			step="1"
			value={ strconv.Itoa(value) }
			aria-label={ label }
			required
		/>
		<button type="button" class="button is-small" aria-label={ "More: " + label } x-on:click={ fmt.Sprintf("step('%s', 1)", id) }>+</button>
	</div>
}

// shapesFor lists the shapes the skill can be done in; straddle only applies to basic jumps.
func shapesFor(s skills.TrampolineSkill) []skills.Shape {
	if s.IsBasicJump() {
		return []skills.Shape{skills.Tuck, skills.Pike, skills.Straddle, skills.Straight}
	}
	return []skills.Shape{skills.Tuck, skills.Pike, skills.Straight}
}

// loadSkill is the hx-vals that loads a skill (e.g. a search result) into the editor.
// cantLand disables Add for a skill that can't land as it's built: added, it
// would interrupt the routine.
func cantLand(s skills.TrampolineSkill) string {
	if s.LandingPosition() == skills.Invalid {
		return " || true"
	}
	return ""
}

// loadReading loads what FIG notation says into the builder, opened, even
// where it can't land as it is.
func loadReading(s skills.TrampolineSkill) string {
	skill, _ := json.Marshal(s)
	b, _ := json.Marshal(map[string]string{"load": "skill", "skill": string(skill), "builder_open": "1"})
	return string(b)
}

func loadSkill(s skills.TrampolineSkill) string {
	skill, _ := json.Marshal(s)
	b, _ := json.Marshal(map[string]string{"load": "skill", "skill": string(skill)})
	return string(b)
}

func directionText(s skills.TrampolineSkill) string {
	if s.Backward {
		return "backward"
	}
	return "forward"
}

// loadCommon is the hx-vals that loads a common skill into the editor.
func loadCommon(key string, shape skills.Shape) string {
	b, _ := json.Marshal(map[string]string{"load": "common", "commonSkillKey": key, "shape": shape.String()})
	return string(b)
}

// loadLanding is the hx-vals that loads a body-landing tile's skill, taking
// off where the skill before it landed (previous_skill, from the form).
func loadLanding(key string) string {
	b, _ := json.Marshal(map[string]string{"load": "landing", "commonSkillKey": key})
	return string(b)
}

func boolValue(b bool) string {
	if b {
		return "1"
	}
	return ""
}

// landingText is where the skill lands, flagging an impossible landing.
func landingText(s skills.TrampolineSkill) string {
	if l := s.LandingPosition(); l != skills.Invalid {
		return l.String()
	}
	return "can't land"
}

// quarters writes a count of quarters as a whole number and a fraction, e.g. 7 -> "1¾".
func quarters(n int) string {
	whole, frac := n/4, []string{"", "¼", "½", "¾"}[n%4]
	if whole == 0 {
		return frac
	}
	return strconv.Itoa(whole) + frac
}

// somersaultText reads a rotation in quarters as somersaults, e.g. 5 -> "1¼ somersaults".
func somersaultText(rotation int) string {
	switch {
	case rotation <= 0:
		return "No somersault"
	case rotation <= 4:
		return quarters(rotation) + " somersault"
	default:
		return quarters(rotation) + " somersaults"
	}
}

// twistAmountText reads half twists as twists, e.g. 3 -> "1½ twists".
func twistAmountText(halfTwists int) string {
	switch {
	case halfTwists <= 0:
		return "No twist"
	case halfTwists <= 2:
		return quarters(halfTwists*2) + " twist"
	default:
		return quarters(halfTwists*2) + " twists"
	}
}

// twistLabel names the twist box for phase i of n: "Half twists" for a single
// phase, otherwise which somersault the twist is in.
func twistLabel(i, n int) string {
	if n == 1 {
		return "Half twists"
	}
	return []string{"1st", "2nd", "3rd", "4th"}[i] + " somersault: half twists"
}
