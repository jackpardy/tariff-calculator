package views

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"tariffCalculator/static"
)

// TimetablePage is the organiser's timetable (ADR 0005 step 4): the setup
// (days, areas, timings, blocked time, rules), the plan and what it falls
// short on, the day-by-area grid to adjust, sheets and publishing.
type TimetablePage struct {
	Base        string
	Competition CompetitionSummary
	Menu        []MenuSection
	Notice      string
	Setup       SetupForm
	Planned     bool
	Stale       bool // the setup changed since planning
	Published   bool
	Changes     bool // the draft differs from what's published
	Report      ReportView
	Days        []DayView
	Unplaced    []TimetableGymnast // entries in no flight
	Moves       []FlightOption     // flights a gymnast can move to
	Places      []FlightOption     // day and area a flight can move to
	Entries     int
	Rota        RotaView
	Version     string // the draft timetable's version, which its forms post back (version)
}

// RotaView is the officials rota's report, and the people who can officiate.
type RotaView struct {
	People   int
	Options  []FlightOption // who can be given a seat
	Short    []string       // seats no one could take, a line a flight
	Empty    int            // seats no one could take, in all
	OwnClub  []string       // e.g. "UCD 4"
	Busiest  []string
	Broken   []string // the organiser's rules about people not kept
	Problems []string // what manual changes broke
	Coaches  []string // coaches needed in two places at once
}

// SeatView is one seat on a flight's panel.
type SeatView struct {
	Role, Person, Name, Club string
	Label                    string // e.g. "Execution judge 3", to choose it by
	Here                     bool   // checked in for the panel on the day
	Missing                  bool   // marked missing for it
	Who                      Role   // who fills it: a gymnast, a club's judge or the organiser's own
}

// SetupForm is the timetable's setup, as the forms show it.
type SetupForm struct {
	Days         []DayForm
	Areas        []AreaForm
	AreaNames    []string
	Timings      []TimingForm
	Rest         int
	RestMust     bool
	Separate     SplitForm
	AcrossBreaks bool // an event can run across a break
	CanSeparate  bool
	Blocks       []string // described
	Rules        []string // described
	Events       []string
	DayNames     []string
	People       []FlightOption // who can officiate, for rules about them
	Roles        []FlightOption
}

// DayForm is one day.
type DayForm struct {
	Name, Start, End string
	Areas            map[string]bool // none ticked: all
}

// AreaForm is one area.
type AreaForm struct {
	Name, Discipline string
}

// TimingForm is a discipline's timings.
type TimingForm struct {
	Key, Name                         string
	PerCompetitor, Between, MaxFlight string
}

// ReportView is what the plan falls short on, and what would fix it.
type ReportView struct {
	Days      []DayFinish
	Unplaced  []string
	Blocks    []string // blocked time that couldn't be placed
	ShortRest []string
	Broken    []string
	Fixes     []FixView
	Problems  []string // what manual changes have broken
	LookAlike []string // names that may be one person entered twice
}

// DayFinish is when a day finishes against its end.
type DayFinish struct {
	Name, Finish, End string
	Spare             int
	FlightsEnd        string // "" for no flights
	Free              int    // minutes after the last flight not blocked off for the whole venue
}

// FixView is a change and whether everything would then fit.
type FixView struct {
	Change string
	Fits   bool
}

// DayView is one day's areas, side by side.
type DayView struct {
	ID, Name string // ID: its heading's id on the page, to jump to
	Areas    []AreaView
}

// AreaView is one area's flights and blocks, in time order.
type AreaView struct {
	ID, Name string // ID: its column's id on the page, to jump to
	Items    []ItemView
}

// ItemView is a flight or blocked time on an area.
type ItemView struct {
	Flight     bool
	Index      int    // the flight's, for its controls
	Discipline string // the flight's, for where its gymnasts can move to
	Name       string
	Start, End string
	Gymnasts   []TimetableGymnast
	Pairs      bool       // synchro: each entry a pair
	Seats      []SeatView // its panel
	InRun      bool       // one of its event's flights: moving it moves them all
	Earlier    bool       // not its event's first flight, so it can go earlier
}

// TimetableGymnast is a gymnast in a running order.
type TimetableGymnast struct {
	FlightGymnast
	ID, Category string
	Moved        string // the event they're entered at now, if not the flight's
	Discipline   string // their entry's, for where they can move to
	Person       string // their person key, for their page on the organiser's timetable
}

// FlightOption is somewhere to move a gymnast or flight to.
type FlightOption struct {
	Value, Label string
	Group        string // a flight's discipline, for a move to offer only its own
}

// CompetitionTimetable is the organiser's timetable page.
templ CompetitionTimetable(p TimetablePage) {
	@competitionLayout("Timetable · " + p.Competition.Name) {
		@fillOptions("move-options", p.Moves)
		@fillOptions("seat-options", p.Rota.Options)
		<script defer src={ static.URL("js/fill.js") }></script>
		<script defer src={ static.URL("js/selectsearch.js") }></script>
		<h1 class="title is-4">Timetable</h1>
		<p class="subtitle is-6">{ p.Competition.Name } · { p.Competition.Date }</p>
		@pageMenu(p.Menu)
		if p.Notice != "" {
			// Stays in sight as the page goes to where the change is.
			<div class="notification is-info is-light comp-sticky-notice"><button class="delete" type="button" aria-label="Dismiss" onclick="this.parentElement.remove()"></button>{ p.Notice }</div>
		}
		if !p.Planned {
			<div class="box">
				<p class="mb-2">
					@StateChip(NotYet, "Not planned yet")
				</p>
				<p class="mb-3">Set up the days and areas, timings, blocked time and your rules, then plan it: every event's flights placed across the days and areas, with officials on every panel.</p>
				<a class="button is-primary" href={ templ.SafeURL(p.Base + "/timetable/setup") }>Go to Setup</a>
			</div>
		} else {
			if p.Stale {
				<div class="notification is-warning is-light">The setup has changed since this was planned. <a href={ templ.SafeURL(p.Base + "/timetable/setup") }>Plan again on Setup</a> to use it.</div>
			}
			@timetableStatus(p)
			<div class="comp-tt-bar" id="timetable-find">
				if n := timetableNames(p); n > 0 {
					@listTools(ListTools{ID: "timetable-flights", Noun: "names", Total: n})
				}
				if len(p.Days) > 0 {
					@timetableJump(p)
				}
			</div>
			<div id="timetable-flights">
				if len(p.Unplaced) > 0 {
					<div class="box" data-list-group>
						<p class="mb-2"><strong>{ gymnastCount(len(p.Unplaced)) } not in a flight</strong> (entered since you planned, or moved out).</p>
						for _, g := range p.Unplaced {
							<div { ListRow{Name: g.Name}.Attrs()... }>
								@moveGymnast(p, g, true)
							</div>
						}
					</div>
				}
				for _, day := range p.Days {
					@timetableDay(p, day)
				}
			</div>
		}
	}
}

// TimetableSetup is the timetable's Setup page: what the timetable is made
// from, and planning it.
templ TimetableSetup(p TimetablePage) {
	@competitionLayout("Timetable setup · " + p.Competition.Name) {
		<h1 class="title is-4">Timetable setup</h1>
		<p class="subtitle is-6">{ p.Competition.Name } · { p.Competition.Date }</p>
		@pageMenu(p.Menu)
		if p.Notice != "" {
			// Stays in sight as the page goes to where the change is.
			<div class="notification is-info is-light comp-sticky-notice"><button class="delete" type="button" aria-label="Dismiss" onclick="this.parentElement.remove()"></button>{ p.Notice }</div>
		}
		if p.Stale {
			<div class="notification is-warning is-light">The setup has changed since the timetable was planned. Plan again to use it.</div>
		}
		<p class="mb-3">What the timetable is made from. Change any of it, then plan.</p>
		@setupSections(p)
		<form method="post" action={ templ.SafeURL(p.Base + "/timetable/plan") } class="my-4">
			<button class="button is-primary" type="submit" onclick={ confirmReplan(p.Planned) }>
				if p.Planned {
					Plan again
				} else {
					Plan
				}
			</button>
			<p class="help">
				Places every event's flights across the days and areas, around blocked time, keeping your rules and never putting anyone in two places at once.
				if p.Planned {
					Planning again starts afresh and loses your changes.
				}
			</p>
		</form>
	}
}

// timetableStatus is where the timetable stands, at the top of its page:
// whether it's published and the buttons for that, the sheets to print, and
// what to look at in the flights and the officials.
templ timetableStatus(p TimetablePage) {
	<div class="box comp-tt-status">
		<div class="comp-tt-publish">
			<div class="comp-tt-state">
				switch {
					case !p.Published:
						@StateChip(NotYet, "Not published")
						<span class="comp-tt-note">Only you see it. Publishing shows clubs, members and gymnasts their flights, and officials their duties.</span>
					case p.Changes:
						@StateChip(Attention, "Changes not published")
						<span class="comp-tt-note">Clubs, gymnasts and officials still see what you last published.</span>
					default:
						@StateChip(Done, "Published")
						<span class="comp-tt-note">Clubs, members and gymnasts see their flights, and officials their duties. What you change here waits until you publish it.</span>
				}
			</div>
			<div class="comp-tt-actions">
				<form method="post" action={ templ.SafeURL(p.Base + "/timetable/publish") } class="comp-tt-publish-form">
					@versionField(p.Version)
					if !p.Published {
						<button class="button is-small is-success" type="submit" name="action" value="publish">Publish</button>
					} else {
						if p.Changes {
							<button class="button is-small is-success" type="submit" name="action" value="publish">Publish changes</button>
							<button class="button is-small" type="submit" name="action" value="discard" onclick="return confirm('Go back to the published timetable, losing your changes since?')">Discard changes</button>
						}
						<button class="button is-small is-text" type="submit" name="action" value="unpublish" onclick="return confirm('Take the timetable down? Clubs, gymnasts and officials stop seeing their flights and duties until you publish again.')">Unpublish</button>
					}
				</form>
				@printMenu(p.Base)
			</div>
		</div>
		@reportView(p.Report)
		@rotaReport(p)
	</div>
}

// printMenu is the timetable's printed sheets, under one button.
templ printMenu(base string) {
	<details class="comp-popup" data-menu>
		<summary class="button is-small comp-opens-button">Print</summary>
		<div class="comp-popup-panel">
			<a href={ templ.SafeURL(base + "/timetable/print?sheet=marshal") }>Marshal sheets</a>
			<a href={ templ.SafeURL(base + "/timetable/print?sheet=judges") }>Chair of judges sheets</a>
			<a href={ templ.SafeURL(base + "/timetable/print?sheet=scores") }>Score sheets</a>
			<a href={ templ.SafeURL(base + "/timetable/print?sheet=rota") }>The officials rota</a>
		</div>
	</details>
}

// timetableDay is a day's areas side by side, each with its flights and
// blocked time.
templ timetableDay(p TimetablePage, day DayView) {
	<section data-list-group>
		<h2 class="title is-5 mt-5 mb-1" id={ day.ID }>{ day.Name }</h2>
		if len(p.Days) > 1 && len(day.Areas) > 1 {
			@areaJump(day)
		}
		// The day's areas side by side, as many as it uses: a row that
		// scrolls sideways when there are more than fit (static/js/tables.js
		// marks the edges), stacked on a phone.
		<div class="comp-tt-areas" style={ fmt.Sprintf("--areas: %d", max(len(day.Areas), 1)) }>
			for _, area := range day.Areas {
				<div class="comp-tt-area" id={ area.ID } data-list-group>
					<h3 class="title is-6">{ area.Name }</h3>
					if len(area.Items) == 0 {
						<p class="has-text-grey is-size-7">Nothing</p>
					}
					for _, it := range area.Items {
						if it.Flight {
							@flightBox(p, it)
						} else {
							@blockBox(p, it)
						}
					}
				</div>
			}
		</div>
	</section>
}

// timetableJump links to each day, on one line beside "Find a name": on a
// phone the flights are a long way down. Each day's areas are linked under
// its heading (areaJump), since days can use different areas; a competition
// of one day links to its areas here instead.
templ timetableJump(p TimetablePage) {
	if len(p.Days) == 1 {
		@areaJump(p.Days[0])
	} else {
		<p class="comp-jump is-size-7">
			for i, d := range p.Days {
				if i > 0 {
					<span>·</span>
				}
				<a href={ templ.SafeURL("#" + d.ID) }>{ d.Name }</a>
			}
		</p>
	}
}

// areaJump links to a day's areas, on one line.
templ areaJump(d DayView) {
	<p class="comp-jump is-size-7">
		for i, a := range d.Areas {
			if i > 0 {
				<span>·</span>
			}
			<a href={ templ.SafeURL("#" + a.ID) }>{ a.Name }</a>
		}
	</p>
}

// timetableNames counts the rows "Find a name" searches: each gymnast in a
// running order or not in a flight, and each official with a seat.
func timetableNames(p TimetablePage) int {
	n := len(p.Unplaced)
	for _, d := range p.Days {
		for _, a := range d.Areas {
			for _, it := range a.Items {
				n += len(it.Gymnasts)
				for _, s := range it.Seats {
					if s.Person != "" {
						n++
					}
				}
			}
		}
	}
	return n
}

script confirmReplan(planned bool) {
	if (planned && !confirm("Plan again from scratch? Your changes to the flights are lost.")) { event.preventDefault(); }
}

// setupSections are the setup's forms, each collapsed.
// versionField carries the version of the draft timetable a form was made
// from, so it's refused if the draft has changed since.
templ versionField(version string) {
	<input type="hidden" name="version" value={ version }/>
}

templ setupSections(p TimetablePage) {
	@changeLine("Days and areas", Count(len(p.Setup.Days), "day", "days")+", "+Count(len(p.Setup.Areas), "area", "areas"), !p.Planned) {
		<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/days") } class="mt-3">
			@versionField(p.Version)
			<p class="label is-small">Days: each finishes by its end, a strict end</p>
			for i, d := range p.Setup.Days {
				<div class="comp-setup-row">
					<input class="input is-small" name={ fmt.Sprintf("day-%d-name", i) } value={ d.Name } aria-label="Day" required/>
					<input class="input is-small" type="time" name={ fmt.Sprintf("day-%d-start", i) } value={ d.Start } aria-label="Starts"/>
					<input class="input is-small" type="time" name={ fmt.Sprintf("day-%d-end", i) } value={ d.End } aria-label="Ends by"/>
					<span class="is-size-7 has-text-grey">areas:</span>
					for _, a := range p.Setup.AreaNames {
						<label class="checkbox is-size-7"><input type="checkbox" name={ fmt.Sprintf("day-%d-area", i) } value={ a } checked?={ d.Areas[a] }/> { a }</label>
					}
					<button class="button is-small is-text has-text-danger" type="submit" name="remove" value={ strconv.Itoa(i) }>Remove</button>
				</div>
			}
			<p class="help">Tick a day's areas if it doesn't use them all (a half day, say).</p>
			<div class="buttons mt-2">
				<button class="button is-small" type="submit">Save days</button>
				<button class="button is-small" type="submit" name="add" value="1">Add a day</button>
			</div>
		</form>
		<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/areas") } class="mt-4">
			@versionField(p.Version)
			<p class="label is-small">Areas: each named, as many of each as the venue has (trampoline panels also run synchro), in the order the timetable, On the day and the venue screen show them</p>
			for i, a := range p.Setup.Areas {
				<div class="comp-setup-row">
					<button class="button is-small" type="submit" name="up" value={ strconv.Itoa(i) } disabled?={ i == 0 } aria-label={ "Move " + a.Name + " earlier" }>↑</button>
					<input class="input is-small" name={ fmt.Sprintf("area-%d-name", i) } value={ a.Name } aria-label="Area" required/>
					<div class="select is-small">
						<select name={ fmt.Sprintf("area-%d-discipline", i) } aria-label="Discipline">
							<option value="trampoline" selected?={ a.Discipline == "" }>Trampoline and synchro</option>
							<option value="tumbling" selected?={ a.Discipline == "tumbling" }>Tumbling</option>
							<option value="dmt" selected?={ a.Discipline == "dmt" }>DMT</option>
						</select>
					</div>
					<button class="button is-small is-text has-text-danger" type="submit" name="remove" value={ strconv.Itoa(i) }>Remove</button>
				</div>
			}
			<div class="buttons mt-2">
				<button class="button is-small" type="submit">Save areas</button>
				<button class="button is-small" type="submit" name="add" value="1">Add an area</button>
			</div>
		</form>
	}
	@changeLine("Timings and rest", timingsNow(p), false) {
		<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/timings") } class="mt-3">
			@versionField(p.Version)
			<div class="table-container">
				<table class="table is-narrow comp-stack">
					<thead><tr><th></th><th>Minutes per competitor</th><th>Minutes between flights</th><th>Largest flight</th></tr></thead>
					<tbody>
						for _, t := range p.Setup.Timings {
							<tr>
								<td>{ t.Name }</td>
								<td data-label="Minutes per competitor"><input class="input is-small comp-num" type="number" step="0.5" min="0.5" name={ "per-" + t.Key } value={ t.PerCompetitor } aria-label={ t.Name + " minutes per competitor" }/></td>
								<td data-label="Minutes between flights"><input class="input is-small comp-num" type="number" min="0" name={ "between-" + t.Key } value={ t.Between } aria-label={ t.Name + " minutes between flights" }/></td>
								<td data-label="Largest flight"><input class="input is-small comp-num" type="number" min="1" name={ "max-" + t.Key } value={ t.MaxFlight } aria-label={ t.Name + " largest flight" }/></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="help mb-3">Minutes per competitor cover all their turns (both rounds; a pair, for synchro). Between flights is each flight's warm-up and changeover.</p>
			<div class="comp-setup-row">
				<label class="label is-small mb-0" for="setup-rest">Rest between a person's turns</label>
				<input class="input is-small comp-num" id="setup-rest" type="number" min="0" name="rest" value={ strconv.Itoa(p.Setup.Rest) }/>
				<span class="is-size-7">minutes,</span>
				<label class="radio is-size-7"><input type="radio" name="restMust" value="0" checked?={ !p.Setup.RestMust }/> prefer</label>
				<label class="radio is-size-7"><input type="radio" name="restMust" value="1" checked?={ p.Setup.RestMust }/> must</label>
			</div>
			if p.Setup.CanSeparate {
				@splitFields("separate", "separateLevel", "Men's and women's flights", "Events ranking men and women separately can still fly together, e.g. a small one.", p.Setup.Separate)
			}
			<button class="button is-small" type="submit">Save</button>
		</form>
	}
	@changeLine("Blocked time", listSummary(p.Setup.Blocks, "None: lunch, awards and events taking entries on the day go here"), false) {
		<div class="mt-3">
			<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/blocks") } class="comp-setup-row mb-3">
				@versionField(p.Version)
				<input type="hidden" name="breaks" value="1"/>
				<label class="checkbox is-size-7"><input type="checkbox" name="across" value="1" checked?={ p.Setup.AcrossBreaks }/> Events can run across breaks: an event pauses for one on its area and finishes afterwards, its panel breaking too. Otherwise each event is all before a break or all after it.</label>
				<button class="button is-small" type="submit">Save</button>
			</form>
			for i, b := range p.Setup.Blocks {
				<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/blocks") } class="comp-setup-row">
					@versionField(p.Version)
					<span>{ b }</span>
					<button class="button is-small is-text has-text-danger" type="submit" name="remove" value={ strconv.Itoa(i) }>Remove</button>
				</form>
			}
			<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/blocks") } class="mt-2">
				@versionField(p.Version)
				<div class="comp-setup-row">
					<input class="input is-small" name="name" placeholder="e.g. Lunch" aria-label="Name" required/>
					<input class="input is-small comp-num" type="number" min="5" name="minutes" placeholder="mins" aria-label="Minutes" required/>
					<div class="select is-small">
						<select name="day" aria-label="Day">
							for i, d := range p.Setup.DayNames {
								<option value={ strconv.Itoa(i) }>{ d }</option>
							}
						</select>
					</div>
				</div>
				<div class="comp-setup-row">
					<span class="is-size-7">at</span>
					<input class="input is-small" type="time" name="at" aria-label="Fixed time"/>
					<span class="is-size-7">or anywhere between</span>
					<input class="input is-small" type="time" name="from" aria-label="Window from"/>
					<span class="is-size-7">and</span>
					<input class="input is-small" type="time" name="to" aria-label="Window to"/>
				</div>
				<div class="comp-setup-row">
					<span class="is-size-7">on</span>
					for _, a := range p.Setup.AreaNames {
						<label class="checkbox is-size-7"><input type="checkbox" name="area" value={ a }/> { a }</label>
					}
					<span class="is-size-7 has-text-grey">(none ticked: every area)</span>
				</div>
				<div class="comp-setup-row">
					<span class="is-size-7">officials it needs (an ad hoc event, say):</span>
					<input class="input is-small comp-num" type="number" min="0" max="20" name="chair" placeholder="0" aria-label="Chairs"/>
					<span class="is-size-7">chair,</span>
					<input class="input is-small comp-num" type="number" min="0" max="20" name="judges" placeholder="0" aria-label="Judges"/>
					<span class="is-size-7">judges,</span>
					<input class="input is-small comp-num" type="number" min="0" max="20" name="recorder" placeholder="0" aria-label="Recorders"/>
					<span class="is-size-7">recorder,</span>
					<input class="input is-small comp-num" type="number" min="0" max="20" name="marshal" placeholder="0" aria-label="Marshals"/>
					<span class="is-size-7">marshal</span>
				</div>
				<button class="button is-small" type="submit" name="add" value="1">Add</button>
			</form>
		</div>
	}
	@changeLine("Your rules", listSummary(p.Setup.Rules, "None: what happens where, and the officials' rules"), false) {
		<div class="mt-3">
			for i, r := range p.Setup.Rules {
				<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/rules") } class="comp-setup-row">
					@versionField(p.Version)
					<span>{ r }</span>
					<button class="button is-small is-text has-text-danger" type="submit" name="remove" value={ strconv.Itoa(i) }>Remove</button>
				</form>
			}
			<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/rules") } class="mt-2">
				@versionField(p.Version)
				<div class="comp-setup-row">
					<div class="select is-small">
						<select name="event" aria-label="Event">
							for _, e := range p.Setup.Events {
								<option value={ e }>{ e }</option>
							}
						</select>
					</div>
					<div class="select is-small">
						<select name="kind" aria-label="Rule">
							<option value="area">on area</option>
							<option value="day">on day</option>
							<option value="before">before</option>
							<option value="apart">not at the same time as</option>
						</select>
					</div>
					<div class="select is-small">
						<select name="area" aria-label="Area">
							for _, a := range p.Setup.AreaNames {
								<option value={ a }>{ a }</option>
							}
						</select>
					</div>
					<div class="select is-small">
						<select name="day" aria-label="Day">
							for i, d := range p.Setup.DayNames {
								<option value={ strconv.Itoa(i) }>{ d }</option>
							}
						</select>
					</div>
					<div class="select is-small">
						<select name="event2" aria-label="Other event">
							for _, e := range p.Setup.Events {
								<option value={ e }>{ e }</option>
							}
						</select>
					</div>
				</div>
				<div class="comp-setup-row">
					<label class="radio is-size-7"><input type="radio" name="must" value="0" checked/> prefer</label>
					<label class="radio is-size-7"><input type="radio" name="must" value="1"/> must</label>
					<button class="button is-small" type="submit" name="add" value="1">Add</button>
				</div>
				<p class="help">The area, day or other event used is the one the rule needs. A must is never broken; a prefer is kept where it can be.</p>
			</form>
			if len(p.Setup.People) > 0 {
				<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/rules") } class="mt-4">
					@versionField(p.Version)
					<p class="label is-small">Officials: who does what</p>
					<div class="comp-setup-row">
						<div class="select is-small">
							<select name="person" aria-label="Person">
								for _, o := range p.Setup.People {
									<option value={ o.Value }>{ o.Label }</option>
								}
							</select>
						</div>
						<div class="select is-small">
							<select name="kind" aria-label="Rule about them">
								<option value="role">is</option>
								<option value="off">doesn't officiate at</option>
								<option value="hours">officiates only, on</option>
							</select>
						</div>
						<div class="select is-small">
							<select name="role" aria-label="Role">
								for _, ro := range p.Setup.Roles {
									<option value={ ro.Value }>{ ro.Label }</option>
								}
							</select>
						</div>
						<div class="select is-small">
							<select name="event" aria-label="At event">
								<option value="">any event</option>
								for _, e := range p.Setup.Events {
									<option value={ e }>{ e }</option>
								}
							</select>
						</div>
					</div>
					<div class="comp-setup-row">
						<div class="select is-small">
							<select name="day" aria-label="Day">
								for i, d := range p.Setup.DayNames {
									<option value={ strconv.Itoa(i) }>{ d }</option>
								}
							</select>
						</div>
						<span class="is-size-7">from</span>
						<input class="input is-small" type="time" name="from" aria-label="From"/>
						<span class="is-size-7">until</span>
						<input class="input is-small" type="time" name="to" aria-label="Until"/>
					</div>
					<div class="comp-setup-row">
						<label class="radio is-size-7"><input type="radio" name="must" value="0" checked/> prefer</label>
						<label class="radio is-size-7"><input type="radio" name="must" value="1"/> must</label>
						<button class="button is-small" type="submit" name="add" value="1">Add</button>
					</div>
					<p class="help">E.g. Mary is Chair of judges at Elite Women; Tom doesn't officiate at any event; Ann officiates only on Saturday from 12:00. "Is" needs an event; hours use the day and times.</p>
				</form>
			} else {
				<p class="help mt-3">Rules about officials appear here once people have offered to officiate (see Officials).</p>
			}
		</div>
	}
}

// rotaReport is how the officials rota went.
templ rotaReport(p TimetablePage) {
	<div class="comp-tt-check">
		<div class="comp-tt-check-row">
			<p class="comp-tt-check-head">
				<strong>Officials</strong>
				if p.Rota.People == 0 {
					@StateChip(NotYet, "No one has offered yet")
				} else if len(p.Rota.Short) == 0 {
					@StateChip(Done, "Every seat filled")
				} else {
					@StateChip(Attention, Count(p.Rota.Empty, "seat empty", "seats empty")+", on "+Count(len(p.Rota.Short), "panel", "panels"))
				}
				<span class="comp-tt-note">{ strconv.Itoa(p.Rota.People) } can officiate</span>
			</p>
			<form method="post" action={ templ.SafeURL(p.Base + "/timetable/officials") }>
				@versionField(p.Version)
				<button class="button is-small" type="submit" name="action" value="rota" onclick={ confirmRota() }>Assign officials again</button>
			</form>
		</div>
		if p.Rota.People == 0 {
			<p class="help">Clubs send their members' offers with their entries, and you can add people on the Officials page.</p>
		}
		@problemsList("Seats no one could take", p.Rota.Short)
		@problemsList("Problems from changes made by hand", p.Rota.Problems)
		@problemsList("Your rules about officials not kept", p.Rota.Broken)
		@problemsList("Coaches needed in two places", p.Rota.Coaches)
		@problemsList("Judging their own club's gymnasts, times by club", p.Rota.OwnClub)
		@problemsList("Busiest officials", p.Rota.Busiest)
	</div>
}

script confirmRota() {
	if (!confirm("Assign every panel again? Your changes to the officials are lost.")) { event.preventDefault(); }
}

templ reportView(r ReportView) {
	<div class="comp-tt-check">
		<p class="comp-tt-check-head">
			<strong>Flights</strong>
			switch {
				case len(r.Unplaced) > 0 || len(r.Blocks) > 0:
					@StateChip(Attention, Count(len(r.Unplaced)+len(r.Blocks), "thing doesn't fit", "things don't fit"))
				// Everything fits, but changes made by hand broke something: not all well.
				case len(r.Problems) > 0:
					@StateChip(Attention, Count(len(r.Problems), "problem from changes", "problems from changes"))
				default:
					@StateChip(Done, "Everything fits")
			}
		</p>
		<ul class="comp-tt-days">
			for _, d := range r.Days {
				<li>
					<strong>{ d.Name }</strong>
					if d.FlightsEnd == "" {
						no flights
					} else {
						flights end { d.FlightsEnd },
					}
					finishes { d.Finish } of { d.End } · { durationWord(d.Free) } free after flights
				</li>
			}
		</ul>
		if len(r.Unplaced) > 0 || len(r.Blocks) > 0 {
			<div class="notification is-warning is-light mt-2 mb-2">
				<p><strong>Doesn't fit:</strong> { joinNames(append(r.Unplaced, r.Blocks...)) }.</p>
				if len(r.Fixes) > 0 {
					<p class="mt-2">What each change would do:</p>
					<ul>
						for _, f := range r.Fixes {
							<li>
								if f.Fits {
									✓ { f.Change }: everything fits
								} else {
									✗ { f.Change }: still doesn't fit
								}
							</li>
						}
					</ul>
				}
			</div>
		}
		@problemsList("Problems from changes made by hand", r.Problems)
		@problemsList("Less rest than wanted", r.ShortRest)
		@problemsList("Preferences not met", r.Broken)
		if len(r.LookAlike) > 0 {
			@problemsList("Names that look like the same person (if so, they're planned as two people: make the names match)", r.LookAlike)
		}
	</div>
}

// newBreaks is what a change would break that isn't broken now
// (competitions.NewBreaks): open, not folded, as it's what to weigh.
templ newBreaks(items []string) {
	if len(items) > 0 {
		<div class="notification is-warning is-light comp-new-breaks">
			<p class="mb-1"><strong>This would break { Count(len(items), "thing", "things") } that hold now:</strong></p>
			<ul>
				for _, it := range items[:min(len(items), 6)] {
					<li>{ it }</li>
				}
			</ul>
			// A long list folds after the first few.
			if len(items) > 6 {
				<details class="mt-1">
					<summary class="is-size-7">{ strconv.Itoa(len(items) - 6) } more</summary>
					<ul>
						for _, it := range items[6:] {
							<li>{ it }</li>
						}
					</ul>
				</details>
			}
		</div>
	}
}

templ problemsList(title string, items []string) {
	if len(items) > 0 {
		<details class="mt-2">
			<summary class="is-size-7"><strong>{ title }</strong> ({ strconv.Itoa(len(items)) })</summary>
			<ul class="is-size-7 mt-1">
				for _, it := range items {
					<li>{ it }</li>
				}
			</ul>
		</details>
	}
}

func joinNames(names []string) string {
	out := ""
	for i, n := range names {
		if i > 0 {
			out += ", "
		}
		out += n
	}
	return out
}

templ flightBox(p TimetablePage, f ItemView) {
	<div class="box comp-flight" data-list-group>
		<p class="mb-1"><strong>{ f.Name }</strong></p>
		<p class="is-size-7 has-text-grey mb-2">Warm-up { f.Start } · finishes about { f.End } · { flightCount(len(f.Gymnasts), f.Pairs) }</p>
		<ol class="comp-order">
			for _, g := range f.Gymnasts {
				<li value={ strconv.Itoa(g.No) } { ListRow{Name: g.Name}.Attrs()... }>
					// Their page, with everything they're doing.
					if g.Person != "" {
						<a href={ templ.SafeURL(p.Base + "/people/" + url.PathEscape(g.Person)) }>{ g.Name }</a>
					} else {
						{ g.Name }
					}
					<span class="has-text-grey is-size-7 comp-nowrap">{ g.Club }</span>
					if g.Moved != "" {
						@StateChip(Attention, "Now "+g.Moved)
					}
				</li>
			}
		</ol>
		if len(f.Seats) > 0 {
			@seatsEditor(p, f, "flight")
		}
		// Its two buttons side by side; one opened takes the width.
		<div class="comp-flight-moves">
		if len(f.Gymnasts) > 0 {
			// One form for the flight, choosing who, rather than a Move on
			// every gymnast.
			@opens("", "", "Move a gymnast", false) {
				@moveFromFlight(p, f)
			}
		}
		// The flight's own changes, rarer than a gymnast's, under one button.
		@opens("", "", "Move or redraw", false) {
			<form method="post" action={ templ.SafeURL(p.Base + "/timetable/flight") } class="comp-tt-actions">
				@versionField(p.Version)
				<input type="hidden" name="flight" value={ strconv.Itoa(f.Index) }/>
				<div class="buttons mb-2">
					<button class="button is-small is-light" type="submit" name="action" value="redraw">Redraw order</button>
					if f.Earlier {
						<button class="button is-small is-light" type="submit" name="action" value="earlier">Earlier</button>
					}
				</div>
				<div class="comp-flight-actions">
					<label class="is-size-7" for={ fmt.Sprintf("flight-%d-to", f.Index) }>
						if f.InRun {
							Move the event to
						} else {
							Move to
						}
					</label>
					<div class="select is-small">
						<select name="to" id={ fmt.Sprintf("flight-%d-to", f.Index) }>
							for _, o := range p.Places {
								<option value={ o.Value }>{ o.Label }</option>
							}
						</select>
					</div>
					if f.InRun {
						<button class="button is-small" type="submit" name="action" value="move">Move event</button>
					} else {
						<button class="button is-small" type="submit" name="action" value="move">Move</button>
					}
				</div>
			</form>
		}
		</div>
	</div>
}

// blockBox is blocked time on an area, with its panel if it needs one.
templ blockBox(p TimetablePage, b ItemView) {
	<div class="box comp-block" data-list-group>
		<strong>{ b.Name }</strong> <span class="has-text-grey is-size-7">{ b.Start }–{ b.End }</span>
		if len(b.Seats) > 0 {
			@seatsEditor(p, b, "block")
		}
	</div>
}

// seatsEditor lists a panel's seats, with a form to give one to someone.
templ seatsEditor(p TimetablePage, it ItemView, field string) {
	<details class="comp-panel mt-2" data-list-group>
		<summary class="is-size-7"><strong>Panel</strong> { seatsSummary(it.Seats) }</summary>
		<ul class="is-size-7 mt-1">
			for _, s := range it.Seats {
				<li { seatRow(s)... }>
					{ s.Role }:
					if s.Person == "" {
						@StateChip(Attention, "No one")
					} else {
						{ s.Name } <span class="has-text-grey">{ s.Club }</span>
						@WhoChip(s.Who, "")
					}
				</li>
			}
		</ul>
		<form method="post" action={ templ.SafeURL(p.Base + "/timetable/officials") } class="comp-flight-actions">
			@versionField(p.Version)
			<input type="hidden" name="action" value="seat"/>
			<input type="hidden" name={ field } value={ strconv.Itoa(it.Index) }/>
			<div class="select is-small">
				<select name="seat" aria-label={ "Seat on " + it.Name }>
					for i, s := range it.Seats {
						<option value={ strconv.Itoa(i) }>{ s.Label }</option>
					}
				</select>
			</div>
			<div class="select is-small">
				<select name="person" aria-label={ "Person for " + it.Name } data-fill="seat-options" data-search-select="Search people">
					<option value="" disabled selected>Choose a person</option>
					<option value="">No one</option>
				</select>
			</div>
			<button class="button is-small" type="submit">Set</button>
		</form>
		if it.InRun {
			<p class="help">A seat is the event's: the change goes on its other flights that had the same person.</p>
		}
	</details>
}

// fillOptions is a long list of choices, once for the page: the flights a
// gymnast can move to, and the people who can take a seat. Each dropdown
// marked data-fill with its id fills from it when opened
// (static/js/fill.js), where repeating the lists in every dropdown made the
// timetable page several megabytes.
templ fillOptions(id string, options []FlightOption) {
	<template id={ id }>
		for _, o := range options {
			if id == "move-options" {
				<option value={ o.Value } data-group={ o.Group }>{ o.Label }</option>
			} else {
				<option value={ o.Value }>{ o.Label }</option>
			}
		}
	</template>
}

// moveGymnast moves a gymnast not in a flight into one. Its list of flights
// is filled from fillOptions when the dropdown is opened.
templ moveGymnast(p TimetablePage, g TimetableGymnast, named bool) {
	<form method="post" action={ templ.SafeURL(p.Base + "/timetable/entry") } class="comp-move-form">
		@versionField(p.Version)
		<input type="hidden" name="entry" value={ g.ID }/>
		if named {
			<span class="is-size-7">{ g.Name } <span class="has-text-grey">{ g.Club } { g.Category }</span></span>
		}
		<div class="select is-small">
			<select name="to" aria-label={ "Flight for " + g.Name } data-fill="move-options" data-group={ g.Discipline }>
				<option value="" disabled selected>Choose a flight</option>
				<option value="">Take out of the timetable</option>
			</select>
		</div>
		<button class="button is-small" type="submit">Move</button>
	</form>
}

// moveFromFlight moves one of a flight's gymnasts (chosen) to another flight,
// or out of the timetable, posting as moveGymnast does. Its list of flights is
// filled from fillOptions when it opens.
templ moveFromFlight(p TimetablePage, f ItemView) {
	<form method="post" action={ templ.SafeURL(p.Base + "/timetable/entry") } class="comp-move-form">
		@versionField(p.Version)
		<div class="select is-small">
			<select name="entry" aria-label={ "Who to move from " + f.Name }>
				<option value="" disabled selected>Choose a gymnast</option>
				for _, g := range f.Gymnasts {
					<option value={ g.ID }>{ strconv.Itoa(g.No) }. { g.Name }</option>
				}
			</select>
		</div>
		<div class="select is-small">
			// Only flights of its own discipline, and not this one.
			<select name="to" aria-label={ "Flight to move them to, from " + f.Name } data-fill="move-options" data-group={ f.Discipline } data-except={ strconv.Itoa(f.Index) }>
				<option value="" disabled selected>Choose a flight</option>
				<option value="">Take out of the timetable</option>
			</select>
		</div>
		<button class="button is-small" type="submit">Move</button>
	</form>
}

// seatRow is a seat's row for "Find a name": none for an empty seat.
func seatRow(s SeatView) templ.Attributes {
	if s.Person == "" {
		return nil
	}
	return ListRow{Name: s.Name}.Attrs()
}

// seatsSummary says how full a panel is, e.g. "· 9 of 11 seats filled".
func seatsSummary(seats []SeatView) string {
	n := 0
	for _, s := range seats {
		if s.Person != "" {
			n++
		}
	}
	return fmt.Sprintf("· %d of %d seats filled", n, len(seats))
}

// panelLine lists a panel for a sheet, e.g. "Chair of judges: Mary (UCD) ·
// Execution judge: …".
func panelLine(seats []SeatView) string {
	out := ""
	for i, s := range seats {
		if i > 0 {
			out += " · "
		}
		name := "—"
		if s.Person != "" {
			name = s.Name
			if s.Club != "" {
				name += " (" + s.Club + ")"
			}
		}
		out += s.Role + ": " + name
		switch {
		case s.Here && s.Person != "":
			out += " ✓"
		case s.Missing && s.Person != "":
			out += " ✕ missing"
		}
	}
	return out
}

func gymnastCount(n int) string {
	if n == 1 {
		return "1 gymnast"
	}
	return fmt.Sprintf("%d gymnasts", n)
}

// Placement is where an attendee competes, on a published timetable.
type Placement struct {
	Flight, Panel, Time string
}

// placementLine says where a gymnast competes, once the timetable is published.
templ placementLine(p *Placement) {
	if p != nil {
		<div class="notification is-info is-light">
			<p><strong>{ p.Flight }</strong> · { p.Panel } · warm-up { p.Time }</p>
		</div>
	}
}

templ runNo(n int) {
	if n > 0 {
		<span class="comp-run-no" title="Running number">{ strconv.Itoa(n) }</span>
	}
}

// timingsNow says, in a line, how long each discipline's competitors and
// changeovers take, and the rest between a person's turns.
func timingsNow(p TimetablePage) string {
	var each []string
	for _, t := range p.Setup.Timings {
		each = append(each, t.Name+" "+t.PerCompetitor)
	}
	rest := "preferred"
	if p.Setup.RestMust {
		rest = "a must"
	}
	return strings.Join(each, ", ") + fmt.Sprintf(" min a competitor; %d min rest between turns, %s", p.Setup.Rest, rest)
}

// listSummary is a setup section's line: what's in it, the first few by
// name (each item's words before " · "), and how many more; none when empty.
func listSummary(items []string, none string) string {
	if len(items) == 0 {
		return none
	}
	var names []string
	for _, it := range items[:min(len(items), 3)] {
		name, _, _ := strings.Cut(it, " · ")
		names = append(names, name)
	}
	out := strings.Join(names, "; ")
	if more := len(items) - len(names); more > 0 {
		out += fmt.Sprintf(" and %d more", more)
	}
	return out
}

// ChangeCheckPage asks before a manual change to the timetable that would
// break something that holds now (roadmap 9): what it breaks, fixes to
// choose instead, and the change anyway.
type ChangeCheckPage struct {
	Base        string
	Competition CompetitionSummary
	Menu        []MenuSection
	What        string      // the change, e.g. "Move BUCS L5 Men to Saturday · Panel 2"
	Breaks      []string    // what it would break
	Action      string      // where the change posts
	Fields      []FormValue // the change as posted, to make it anyway
	Fixes       []ChangeFix
	Back        string // the timetable, where it was asked from
}

// ChangeFix is another change that does what was meant without breaking
// anything: what it is, and the fields that make it.
type ChangeFix struct {
	Label  string
	Fields []FormValue
}

// ChangeCheck is the page.
templ ChangeCheck(p ChangeCheckPage) {
	@competitionLayout("Before you change it · " + p.Competition.Name) {
		<h1 class="title is-4">Before you change it</h1>
		<p class="subtitle is-6">{ p.Competition.Name }</p>
		@pageMenu(p.Menu)
		<p class="mb-3"><strong>{ p.What }</strong></p>
		@newBreaks(p.Breaks)
		if len(p.Fixes) > 0 {
			<div class="box">
				<p class="label is-small mb-2">Instead, without breaking anything</p>
				<div class="buttons">
					for _, f := range p.Fixes {
						<form method="post" action={ templ.SafeURL(p.Action) } class="is-inline">
							for _, v := range f.Fields {
								<input type="hidden" name={ v.Name } value={ v.Value }/>
							}
							<button class="button is-small is-link is-light" type="submit">{ f.Label }</button>
						</form>
					}
				</div>
			</div>
		}
		<div class="buttons">
			<form method="post" action={ templ.SafeURL(p.Action) } class="is-inline">
				for _, v := range p.Fields {
					<input type="hidden" name={ v.Name } value={ v.Value }/>
				}
				<input type="hidden" name="anyway" value="1"/>
				<button class="button is-small is-warning" type="submit">Make the change anyway</button>
			</form>
			<a class="button is-small" href={ templ.SafeURL(p.Back) }>Cancel</a>
		</div>
		<p class="help">Either way it goes into the draft: attendees see it only once you publish.</p>
	}
}
