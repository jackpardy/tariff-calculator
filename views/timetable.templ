package views

import (
	"strings"
	"fmt"
	"strconv"
)

// TimetablePage is the organiser's timetable (ADR 0005 step 4): the setup
// (days, areas, timings, blocked time, rules), the plan and what it falls
// short on, the day-by-area grid to adjust, sheets and publishing.
type TimetablePage struct {
	Base        string
	Competition CompetitionSummary
	Notice      string
	Setup       SetupForm
	Planned     bool
	Stale       bool // the setup changed since planning
	Published   bool
	Changes     bool // the draft differs from what's published
	Report      ReportView
	Days        []DayView
	Unplaced    []TimetableGymnast // entries in no flight
	Moves       []FlightOption     // flights a gymnast can move to
	Places      []FlightOption     // day and area a flight can move to
	Entries     int
	Rota        RotaView
}

// RotaView is the officials rota's report, and the people who can officiate.
type RotaView struct {
	People   int
	Options  []FlightOption // who can be given a seat
	Short    []string       // seats no one could take, a line a flight
	Empty    int            // seats no one could take, in all
	OwnClub  []string       // e.g. "UCD 4"
	Busiest  []string
	Broken   []string // the organiser's rules about people not kept
	Problems []string // what manual changes broke
	Coaches  []string // coaches needed in two places at once
}

// SeatView is one seat on a flight's panel.
type SeatView struct {
	Role, Person, Name, Club string
	Label                    string // e.g. "Execution judge 3", to choose it by
}

// SetupForm is the timetable's setup, as the forms show it.
type SetupForm struct {
	Days         []DayForm
	Areas        []AreaForm
	AreaNames    []string
	Timings      []TimingForm
	Rest         int
	RestMust     bool
	Separate     SplitForm
	AcrossBreaks bool // an event can run across a break
	CanSeparate  bool
	Blocks       []string // described
	Rules        []string // described
	Events       []string
	DayNames     []string
	People       []FlightOption // who can officiate, for rules about them
	Roles        []FlightOption
}

// DayForm is one day.
type DayForm struct {
	Name, Start, End string
	Areas            map[string]bool // none ticked: all
}

// AreaForm is one area.
type AreaForm struct {
	Name, Discipline string
}

// TimingForm is a discipline's timings.
type TimingForm struct {
	Key, Name                         string
	PerCompetitor, Between, MaxFlight string
}

// ReportView is what the plan falls short on, and what would fix it.
type ReportView struct {
	Days      []DayFinish
	Unplaced  []string
	Blocks    []string // blocked time that couldn't be placed
	ShortRest []string
	Broken    []string
	Fixes     []FixView
	Problems  []string // what manual changes have broken
	LookAlike []string // names that may be one person entered twice
}

// DayFinish is when a day finishes against its end.
type DayFinish struct {
	Name, Finish, End string
	Spare             int
	FlightsEnd        string // "" for no flights
	Free              int    // minutes after the last flight not blocked off for the whole venue
}

// FixView is a change and whether everything would then fit.
type FixView struct {
	Change string
	Fits   bool
}

// DayView is one day's areas, side by side.
type DayView struct {
	Name  string
	Areas []AreaView
}

// AreaView is one area's flights and blocks, in time order.
type AreaView struct {
	Name  string
	Items []ItemView
}

// ItemView is a flight or blocked time on an area.
type ItemView struct {
	Flight     bool
	Index      int // the flight's, for its controls
	Name       string
	Start, End string
	Gymnasts   []TimetableGymnast
	Pairs      bool       // synchro: each entry a pair
	Seats      []SeatView // its panel
	InRun      bool       // one of its event's flights: moving it moves them all
	Earlier    bool       // not its event's first flight, so it can go earlier
}

// TimetableGymnast is a gymnast in a running order.
type TimetableGymnast struct {
	ID, Name, Club, Category string
	Moved                    string // the event they're entered at now, if not the flight's
	Scratched                bool   // a no-show on the day: struck through on the printed sheets
}

// FlightOption is somewhere to move a gymnast or flight to.
type FlightOption struct {
	Value, Label string
}

// CompetitionTimetable is the organiser's timetable page.
templ CompetitionTimetable(p TimetablePage) {
	@competitionLayout("Timetable · " + p.Competition.Name) {
		<p class="mb-3"><a href={ templ.SafeURL(p.Base) }>← All entries</a></p>
		<h1 class="title is-4">Timetable</h1>
		<p class="subtitle is-6">{ p.Competition.Name } · { p.Competition.Date }</p>
		if p.Notice != "" {
			<div class="notification is-info is-light">{ p.Notice }</div>
		}
		@setupSections(p)
		<form method="post" action={ templ.SafeURL(p.Base + "/timetable/plan") } class="my-4">
			<button class="button is-primary" type="submit" onclick={ confirmReplan(p.Planned) }>
				if p.Planned {
					Plan again
				} else {
					Plan
				}
			</button>
			<p class="help">
				Places every event's flights across the days and areas, around blocked time, keeping your rules and never putting anyone in two places at once.
				if p.Planned {
					Planning again starts afresh and loses your changes.
				}
			</p>
		</form>
		<p class="mb-4"><a href={ templ.SafeURL(p.Base + "/timetable/simulate") }>Simulate</a>: try numbers of entries and judges against this setup, before entries arrive or alongside them, without changing the timetable.</p>
		if p.Planned {
			<p class="mb-4"><a href={ templ.SafeURL(p.Base + "/timetable/delay") }>What if there's a delay?</a> See what holding up an area for a while does to the rest of the day, without changing the timetable.</p>
			<p class="mb-4"><a href={ templ.SafeURL(p.Base + "/timetable/leave") }>What if an official has to leave?</a> See who'd fill each of their seats.</p>
		}
		if p.Stale {
			<div class="notification is-warning is-light">The setup has changed since this was planned. Plan again to use it.</div>
		}
		if p.Planned {
			@reportView(p.Report)
			@rotaReport(p)
			if p.Published && p.Changes {
				<div class="notification is-info is-light">
					<strong>Changes not published yet.</strong> Clubs, gymnasts and officials still see the timetable as you last published it. <strong>Publish changes</strong> shows them this one; <strong>Discard changes</strong> goes back to what's published.
				</div>
			}
			<div class="buttons">
				<form method="post" action={ templ.SafeURL(p.Base + "/timetable/publish") } class="buttons mb-0">
					if !p.Published {
						<button class="button is-small is-success" type="submit" name="action" value="publish">Publish</button>
					} else {
						if p.Changes {
							<button class="button is-small is-success" type="submit" name="action" value="publish">Publish changes</button>
							<button class="button is-small" type="submit" name="action" value="discard" onclick="return confirm('Go back to the published timetable, losing your changes since?')">Discard changes</button>
						}
						<button class="button is-small" type="submit" name="action" value="unpublish">Unpublish</button>
					}
				</form>
				<a class="button is-small" href={ templ.SafeURL(p.Base + "/timetable/print?sheet=marshal") }>Print marshal sheets</a>
				<a class="button is-small" href={ templ.SafeURL(p.Base + "/timetable/print?sheet=judges") }>Print chair of judges sheets</a>
				<a class="button is-small" href={ templ.SafeURL(p.Base + "/timetable/print?sheet=scores") }>Print score sheets</a>
				<a class="button is-small" href={ templ.SafeURL(p.Base + "/timetable/print?sheet=rota") }>Print the officials rota</a>
				<a class="button is-small" href={ templ.SafeURL(p.Base + "/timetable/print?sheet=timeline") }>Panel timeline</a>
				<a class="button is-small" href={ templ.SafeURL(p.Base + "/timetable/print?sheet=timeline-officials") }>Timeline with officials</a>
			</div>
			<p class="help mb-4">
				if p.Published {
					Published: clubs, members and gymnasts entering on their own see their flight, area and time, and officials their duties. What you change here (planning, moves, officials) is a draft until you publish it.
				} else {
					Not published: only you see it.
				}
			</p>
			if len(p.Unplaced) > 0 {
				<div class="box">
					<p class="mb-2"><strong>{ gymnastCount(len(p.Unplaced)) } not in a flight</strong> (entered since you planned, or moved out).</p>
					for _, g := range p.Unplaced {
						@moveGymnast(p, g, true)
					}
				</div>
			}
			for _, day := range p.Days {
				<h2 class="title is-5 mt-5">{ day.Name }</h2>
				<div class="columns is-multiline">
					for _, area := range day.Areas {
						<div class="column is-half-tablet is-one-third-desktop">
							<h3 class="title is-6">{ area.Name }</h3>
							if len(area.Items) == 0 {
								<p class="has-text-grey is-size-7">Nothing</p>
							}
							for _, it := range area.Items {
								if it.Flight {
									@flightBox(p, it)
								} else {
									@blockBox(p, it)
								}
							}
						</div>
					}
				</div>
			}
		}
	}
}

script confirmReplan(planned bool) {
	if (planned && !confirm("Plan again from scratch? Your changes to the flights are lost.")) { event.preventDefault(); }
}

// setupSections are the setup's forms, each collapsed.
templ setupSections(p TimetablePage) {
	<details class="box comp-manage" open?={ !p.Planned }>
		<summary><strong>Days and areas</strong> <span class="has-text-grey is-size-7">· { strconv.Itoa(len(p.Setup.Days)) } days, { strconv.Itoa(len(p.Setup.Areas)) } areas</span></summary>
		<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/days") } class="mt-3">
			<p class="label is-small">Days: each finishes by its end, a strict end</p>
			for i, d := range p.Setup.Days {
				<div class="comp-setup-row">
					<input class="input is-small" name={ fmt.Sprintf("day-%d-name", i) } value={ d.Name } aria-label="Day" required/>
					<input class="input is-small" type="time" name={ fmt.Sprintf("day-%d-start", i) } value={ d.Start } aria-label="Starts"/>
					<input class="input is-small" type="time" name={ fmt.Sprintf("day-%d-end", i) } value={ d.End } aria-label="Ends by"/>
					<span class="is-size-7 has-text-grey">areas:</span>
					for _, a := range p.Setup.AreaNames {
						<label class="checkbox is-size-7"><input type="checkbox" name={ fmt.Sprintf("day-%d-area", i) } value={ a } checked?={ d.Areas[a] }/> { a }</label>
					}
					<button class="button is-small is-text has-text-danger" type="submit" name="remove" value={ strconv.Itoa(i) }>Remove</button>
				</div>
			}
			<p class="help">Tick a day's areas if it doesn't use them all (a half day, say).</p>
			<div class="buttons mt-2">
				<button class="button is-small" type="submit">Save days</button>
				<button class="button is-small" type="submit" name="add" value="1">Add a day</button>
			</div>
		</form>
		<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/areas") } class="mt-4">
			<p class="label is-small">Areas: each named, as many of each as the venue has (trampoline panels also run synchro)</p>
			for i, a := range p.Setup.Areas {
				<div class="comp-setup-row">
					<input class="input is-small" name={ fmt.Sprintf("area-%d-name", i) } value={ a.Name } aria-label="Area" required/>
					<div class="select is-small">
						<select name={ fmt.Sprintf("area-%d-discipline", i) } aria-label="Discipline">
							<option value="trampoline" selected?={ a.Discipline == "" }>Trampoline and synchro</option>
							<option value="tumbling" selected?={ a.Discipline == "tumbling" }>Tumbling</option>
							<option value="dmt" selected?={ a.Discipline == "dmt" }>DMT</option>
						</select>
					</div>
					<button class="button is-small is-text has-text-danger" type="submit" name="remove" value={ strconv.Itoa(i) }>Remove</button>
				</div>
			}
			<div class="buttons mt-2">
				<button class="button is-small" type="submit">Save areas</button>
				<button class="button is-small" type="submit" name="add" value="1">Add an area</button>
			</div>
		</form>
	</details>
	<details class="box comp-manage">
		<summary><strong>Timings and rest</strong></summary>
		<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/timings") } class="mt-3">
			<div class="table-container">
				<table class="table is-narrow">
					<thead><tr><th></th><th>Minutes per competitor</th><th>Minutes between flights</th><th>Largest flight</th></tr></thead>
					<tbody>
						for _, t := range p.Setup.Timings {
							<tr>
								<td>{ t.Name }</td>
								<td><input class="input is-small comp-num" type="number" step="0.5" min="0.5" name={ "per-" + t.Key } value={ t.PerCompetitor } aria-label={ t.Name + " minutes per competitor" }/></td>
								<td><input class="input is-small comp-num" type="number" min="0" name={ "between-" + t.Key } value={ t.Between } aria-label={ t.Name + " minutes between flights" }/></td>
								<td><input class="input is-small comp-num" type="number" min="1" name={ "max-" + t.Key } value={ t.MaxFlight } aria-label={ t.Name + " largest flight" }/></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="help mb-3">Minutes per competitor cover all their turns (both rounds; a pair, for synchro). Between flights is each flight's warm-up and changeover.</p>
			<div class="comp-setup-row">
				<label class="label is-small mb-0" for="setup-rest">Rest between a person's turns</label>
				<input class="input is-small comp-num" id="setup-rest" type="number" min="0" name="rest" value={ strconv.Itoa(p.Setup.Rest) }/>
				<span class="is-size-7">minutes,</span>
				<label class="radio is-size-7"><input type="radio" name="restMust" value="0" checked?={ !p.Setup.RestMust }/> prefer</label>
				<label class="radio is-size-7"><input type="radio" name="restMust" value="1" checked?={ p.Setup.RestMust }/> must</label>
			</div>
			if p.Setup.CanSeparate {
				@splitFields("separate", "separateLevel", "Men's and women's flights", "Events ranking men and women separately can still fly together, e.g. a small one.", p.Setup.Separate)
			}
			<button class="button is-small" type="submit">Save</button>
		</form>
	</details>
	<details class="box comp-manage">
		<summary><strong>Blocked time</strong> <span class="has-text-grey is-size-7">· lunch, awards, events taking entries on the day ({ strconv.Itoa(len(p.Setup.Blocks)) })</span></summary>
		<div class="mt-3">
			<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/blocks") } class="comp-setup-row mb-3">
				<input type="hidden" name="breaks" value="1"/>
				<label class="checkbox is-size-7"><input type="checkbox" name="across" value="1" checked?={ p.Setup.AcrossBreaks }/> Events can run across breaks: an event pauses for one on its area and finishes afterwards, its panel breaking too. Otherwise each event is all before a break or all after it.</label>
				<button class="button is-small" type="submit">Save</button>
			</form>
			for i, b := range p.Setup.Blocks {
				<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/blocks") } class="comp-setup-row">
					<span>{ b }</span>
					<button class="button is-small is-text has-text-danger" type="submit" name="remove" value={ strconv.Itoa(i) }>Remove</button>
				</form>
			}
			<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/blocks") } class="mt-2">
				<div class="comp-setup-row">
					<input class="input is-small" name="name" placeholder="e.g. Lunch" aria-label="Name" required/>
					<input class="input is-small comp-num" type="number" min="5" name="minutes" placeholder="mins" aria-label="Minutes" required/>
					<div class="select is-small">
						<select name="day" aria-label="Day">
							for i, d := range p.Setup.DayNames {
								<option value={ strconv.Itoa(i) }>{ d }</option>
							}
						</select>
					</div>
				</div>
				<div class="comp-setup-row">
					<span class="is-size-7">at</span>
					<input class="input is-small" type="time" name="at" aria-label="Fixed time"/>
					<span class="is-size-7">or anywhere between</span>
					<input class="input is-small" type="time" name="from" aria-label="Window from"/>
					<span class="is-size-7">and</span>
					<input class="input is-small" type="time" name="to" aria-label="Window to"/>
				</div>
				<div class="comp-setup-row">
					<span class="is-size-7">on</span>
					for _, a := range p.Setup.AreaNames {
						<label class="checkbox is-size-7"><input type="checkbox" name="area" value={ a }/> { a }</label>
					}
					<span class="is-size-7 has-text-grey">(none ticked: every area)</span>
				</div>
				<div class="comp-setup-row">
					<span class="is-size-7">officials it needs (an ad hoc event, say):</span>
					<input class="input is-small comp-num" type="number" min="0" max="20" name="chair" placeholder="0" aria-label="Chairs"/>
					<span class="is-size-7">chair,</span>
					<input class="input is-small comp-num" type="number" min="0" max="20" name="judges" placeholder="0" aria-label="Judges"/>
					<span class="is-size-7">judges,</span>
					<input class="input is-small comp-num" type="number" min="0" max="20" name="recorder" placeholder="0" aria-label="Recorders"/>
					<span class="is-size-7">recorder,</span>
					<input class="input is-small comp-num" type="number" min="0" max="20" name="marshal" placeholder="0" aria-label="Marshals"/>
					<span class="is-size-7">marshal</span>
				</div>
				<button class="button is-small" type="submit" name="add" value="1">Add</button>
			</form>
		</div>
	</details>
	<details class="box comp-manage">
		<summary><strong>Your rules</strong> <span class="has-text-grey is-size-7">· what happens where ({ strconv.Itoa(len(p.Setup.Rules)) })</span></summary>
		<div class="mt-3">
			for i, r := range p.Setup.Rules {
				<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/rules") } class="comp-setup-row">
					<span>{ r }</span>
					<button class="button is-small is-text has-text-danger" type="submit" name="remove" value={ strconv.Itoa(i) }>Remove</button>
				</form>
			}
			<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/rules") } class="mt-2">
				<div class="comp-setup-row">
					<div class="select is-small">
						<select name="event" aria-label="Event">
							for _, e := range p.Setup.Events {
								<option value={ e }>{ e }</option>
							}
						</select>
					</div>
					<div class="select is-small">
						<select name="kind" aria-label="Rule">
							<option value="area">on area</option>
							<option value="day">on day</option>
							<option value="before">before</option>
							<option value="apart">not at the same time as</option>
						</select>
					</div>
					<div class="select is-small">
						<select name="area" aria-label="Area">
							for _, a := range p.Setup.AreaNames {
								<option value={ a }>{ a }</option>
							}
						</select>
					</div>
					<div class="select is-small">
						<select name="day" aria-label="Day">
							for i, d := range p.Setup.DayNames {
								<option value={ strconv.Itoa(i) }>{ d }</option>
							}
						</select>
					</div>
					<div class="select is-small">
						<select name="event2" aria-label="Other event">
							for _, e := range p.Setup.Events {
								<option value={ e }>{ e }</option>
							}
						</select>
					</div>
				</div>
				<div class="comp-setup-row">
					<label class="radio is-size-7"><input type="radio" name="must" value="0" checked/> prefer</label>
					<label class="radio is-size-7"><input type="radio" name="must" value="1"/> must</label>
					<button class="button is-small" type="submit" name="add" value="1">Add</button>
				</div>
				<p class="help">The area, day or other event used is the one the rule needs. A must is never broken; a prefer is kept where it can be.</p>
			</form>
			if len(p.Setup.People) > 0 {
				<form method="post" action={ templ.SafeURL(p.Base + "/timetable/setup/rules") } class="mt-4">
					<p class="label is-small">Officials: who does what</p>
					<div class="comp-setup-row">
						<div class="select is-small">
							<select name="person" aria-label="Person">
								for _, o := range p.Setup.People {
									<option value={ o.Value }>{ o.Label }</option>
								}
							</select>
						</div>
						<div class="select is-small">
							<select name="kind" aria-label="Rule about them">
								<option value="role">is</option>
								<option value="off">doesn't officiate at</option>
								<option value="hours">officiates only, on</option>
							</select>
						</div>
						<div class="select is-small">
							<select name="role" aria-label="Role">
								for _, ro := range p.Setup.Roles {
									<option value={ ro.Value }>{ ro.Label }</option>
								}
							</select>
						</div>
						<div class="select is-small">
							<select name="event" aria-label="At event">
								<option value="">any event</option>
								for _, e := range p.Setup.Events {
									<option value={ e }>{ e }</option>
								}
							</select>
						</div>
					</div>
					<div class="comp-setup-row">
						<div class="select is-small">
							<select name="day" aria-label="Day">
								for i, d := range p.Setup.DayNames {
									<option value={ strconv.Itoa(i) }>{ d }</option>
								}
							</select>
						</div>
						<span class="is-size-7">from</span>
						<input class="input is-small" type="time" name="from" aria-label="From"/>
						<span class="is-size-7">until</span>
						<input class="input is-small" type="time" name="to" aria-label="Until"/>
					</div>
					<div class="comp-setup-row">
						<label class="radio is-size-7"><input type="radio" name="must" value="0" checked/> prefer</label>
						<label class="radio is-size-7"><input type="radio" name="must" value="1"/> must</label>
						<button class="button is-small" type="submit" name="add" value="1">Add</button>
					</div>
					<p class="help">E.g. Mary is Chair of judges at Elite Women; Tom doesn't officiate at any event; Ann officiates only on Saturday from 12:00. "Is" needs an event; hours use the day and times.</p>
				</form>
			} else {
				<p class="help mt-3">Rules about officials appear here once people have offered to officiate (see Officials).</p>
			}
		</div>
	</details>
}

// rotaReport is how the officials rota went.
templ rotaReport(p TimetablePage) {
	<div class="box">
		<div class="is-flex is-justify-content-space-between is-align-items-center">
			<p><strong>Officials</strong> <span class="has-text-grey is-size-7">· { strconv.Itoa(p.Rota.People) } can officiate</span></p>
			<form method="post" action={ templ.SafeURL(p.Base + "/timetable/officials") }>
				<button class="button is-small" type="submit" name="action" value="rota" onclick={ confirmRota() }>Assign officials again</button>
			</form>
		</div>
		if p.Rota.People == 0 {
			<p class="help">No one has offered to judge or help yet. Clubs send their members' offers with their entries, and you can add people on the Officials page.</p>
		} else if len(p.Rota.Short) == 0 {
			<p class="has-text-success is-size-7 mt-1">Every seat on every panel is filled.</p>
		}
		if len(p.Rota.Short) > 0 {
			<details class="mt-2">
				<summary class="is-size-7"><strong>Seats no one could take:</strong> { emptySeats(p.Rota.Empty, len(p.Rota.Short)) }</summary>
				<ul class="is-size-7 mt-1">
					for _, it := range p.Rota.Short {
						<li>{ it }</li>
					}
				</ul>
			</details>
		}
		@problemsList("Manual changes have broken", p.Rota.Problems)
		@problemsList("Your rules about officials not kept", p.Rota.Broken)
		@problemsList("Coaches needed in two places", p.Rota.Coaches)
		@problemsList("Judging their own club's gymnasts, times by club", p.Rota.OwnClub)
		@problemsList("Busiest officials", p.Rota.Busiest)
	</div>
}

script confirmRota() {
	if (!confirm("Assign every panel again? Your changes to the officials are lost.")) { event.preventDefault(); }
}

templ reportView(r ReportView) {
	<div class="box">
		<div class="table-container">
			<table class="table is-narrow mb-2">
				<thead><tr><th>Day</th><th>Flights end</th><th>Finishes</th><th>Must end by</th><th>Free after flights</th></tr></thead>
				<tbody>
					for _, d := range r.Days {
						<tr>
							<td>{ d.Name }</td>
							<td>
								if d.FlightsEnd == "" {
									No flights
								} else {
									{ d.FlightsEnd }
								}
							</td>
							<td>{ d.Finish }</td>
							<td>{ d.End }</td>
							<td>{ durationWord(d.Free) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="help mb-2">Finishes counts blocked time such as awards. Free after flights is the time from the last flight to the end that isn't blocked off for the whole venue: room for more flights.</p>
		if len(r.Unplaced) > 0 || len(r.Blocks) > 0 {
			<div class="notification is-danger is-light">
				<p><strong>Doesn't fit:</strong> { joinNames(append(r.Unplaced, r.Blocks...)) }.</p>
				if len(r.Fixes) > 0 {
					<p class="mt-2">What each change would do:</p>
					<ul>
						for _, f := range r.Fixes {
							<li>
								if f.Fits {
									✓ { f.Change }: everything fits
								} else {
									✗ { f.Change }: still doesn't fit
								}
							</li>
						}
					</ul>
				}
			</div>
		} else {
			<p class="has-text-success mb-2"><strong>Everything fits.</strong></p>
		}
		@problemsList("Manual changes have broken", r.Problems)
		@problemsList("Less rest than wanted", r.ShortRest)
		@problemsList("Preferences not met", r.Broken)
		if len(r.LookAlike) > 0 {
			@problemsList("Names that look like the same person (if so, they're planned as two people: make the names match)", r.LookAlike)
		}
	</div>
}

templ problemsList(title string, items []string) {
	if len(items) > 0 {
		<details class="mt-2">
			<summary class="is-size-7"><strong>{ title }</strong> ({ strconv.Itoa(len(items)) })</summary>
			<ul class="is-size-7 mt-1">
				for _, it := range items {
					<li>{ it }</li>
				}
			</ul>
		</details>
	}
}

func joinNames(names []string) string {
	out := ""
	for i, n := range names {
		if i > 0 {
			out += ", "
		}
		out += n
	}
	return out
}

templ flightBox(p TimetablePage, f ItemView) {
	<div class="box comp-flight">
		<p class="mb-1"><strong>{ f.Name }</strong></p>
		<p class="is-size-7 has-text-grey mb-2">Warm-up { f.Start } · finishes about { f.End } · { flightCount(len(f.Gymnasts), f.Pairs) }</p>
		<ol class="comp-order">
			for _, g := range f.Gymnasts {
				<li>
					{ g.Name }
					<span class="has-text-grey is-size-7">{ g.Club }</span>
					if g.Moved != "" {
						<span class="tag is-warning is-light">now { g.Moved }</span>
					}
					<details class="comp-move is-inline-block">
						<summary class="is-size-7">move</summary>
						@moveGymnast(p, g, false)
					</details>
				</li>
			}
		</ol>
		if len(f.Seats) > 0 {
			@seatsEditor(p, f, "flight")
		}
		<form method="post" action={ templ.SafeURL(p.Base + "/timetable/flight") } class="comp-flight-actions">
			<input type="hidden" name="flight" value={ strconv.Itoa(f.Index) }/>
			<button class="button is-small is-text" type="submit" name="action" value="redraw">Redraw order</button>
			if f.Earlier {
				<button class="button is-small is-text" type="submit" name="action" value="earlier">Earlier</button>
			}
			<div class="select is-small">
				<select name="to" aria-label={ "Move " + f.Name }>
					for _, o := range p.Places {
						<option value={ o.Value }>{ o.Label }</option>
					}
				</select>
			</div>
			if f.InRun {
				<button class="button is-small" type="submit" name="action" value="move">Move event</button>
			} else {
				<button class="button is-small" type="submit" name="action" value="move">Move</button>
			}
		</form>
	</div>
}

// blockBox is blocked time on an area, with its panel if it needs one.
templ blockBox(p TimetablePage, b ItemView) {
	<div class="box comp-block">
		<strong>{ b.Name }</strong> <span class="has-text-grey is-size-7">{ b.Start }–{ b.End }</span>
		if len(b.Seats) > 0 {
			@seatsEditor(p, b, "block")
		}
	</div>
}

// seatsEditor lists a panel's seats, with a form to give one to someone.
templ seatsEditor(p TimetablePage, it ItemView, field string) {
	<details class="comp-panel mt-2">
		<summary class="is-size-7"><strong>Panel</strong> { seatsSummary(it.Seats) }</summary>
		<ul class="is-size-7 mt-1">
			for _, s := range it.Seats {
				<li>
					{ s.Role }:
					if s.Person == "" {
						<span class="has-text-danger">no one</span>
					} else {
						{ s.Name } <span class="has-text-grey">{ s.Club }</span>
					}
				</li>
			}
		</ul>
		<form method="post" action={ templ.SafeURL(p.Base + "/timetable/officials") } class="comp-flight-actions">
			<input type="hidden" name="action" value="seat"/>
			<input type="hidden" name={ field } value={ strconv.Itoa(it.Index) }/>
			<div class="select is-small">
				<select name="seat" aria-label={ "Seat on " + it.Name }>
					for i, s := range it.Seats {
						<option value={ strconv.Itoa(i) }>{ s.Label }</option>
					}
				</select>
			</div>
			<div class="select is-small">
				<select name="person" aria-label={ "Person for " + it.Name }>
					<option value="">No one</option>
					for _, o := range p.Rota.Options {
						<option value={ o.Value }>{ o.Label }</option>
					}
				</select>
			</div>
			<button class="button is-small" type="submit">Set</button>
		</form>
		if it.InRun {
			<p class="help">A seat is the event's: the change goes on its other flights that had the same person.</p>
		}
	</details>
}

// moveGymnast moves a gymnast to another flight, or out of the timetable.
templ moveGymnast(p TimetablePage, g TimetableGymnast, named bool) {
	<form method="post" action={ templ.SafeURL(p.Base + "/timetable/entry") } class="comp-move-form">
		<input type="hidden" name="entry" value={ g.ID }/>
		if named {
			<span class="is-size-7">{ g.Name } <span class="has-text-grey">{ g.Club } { g.Category }</span></span>
		}
		<div class="select is-small">
			<select name="to" aria-label={ "Flight for " + g.Name }>
				for _, o := range p.Moves {
					<option value={ o.Value }>{ o.Label }</option>
				}
				<option value="">Take out of the timetable</option>
			</select>
		</div>
		<button class="button is-small" type="submit">Move</button>
	</form>
}

// seatsSummary says how full a panel is, e.g. "· 9 of 11 seats filled".
func seatsSummary(seats []SeatView) string {
	n := 0
	for _, s := range seats {
		if s.Person != "" {
			n++
		}
	}
	return fmt.Sprintf("· %d of %d seats filled", n, len(seats))
}

// panelLine lists a panel for a sheet, e.g. "Chair of judges: Mary (UCD) ·
// Execution judge: …".
func panelLine(seats []SeatView) string {
	out := ""
	for i, s := range seats {
		if i > 0 {
			out += " · "
		}
		name := "—"
		if s.Person != "" {
			name = s.Name
			if s.Club != "" {
				name += " (" + s.Club + ")"
			}
		}
		out += s.Role + ": " + name
	}
	return out
}

func gymnastCount(n int) string {
	if n == 1 {
		return "1 gymnast"
	}
	return fmt.Sprintf("%d gymnasts", n)
}

// TimetableSheets is the printable marshal or chair of judges sheets: one
// page per area per day.
type TimetableSheets struct {
	Title       string
	Back        string
	Competition CompetitionSummary
	Judges      bool
	Sheets      []SheetView
	Exercises   map[string][2]string
	Notes       map[string]string
}

// SheetView is one area's day.
type SheetView struct {
	Day, Area string
	Flights   []ItemView
}

// TimetablePrint prints the marshal or chair of judges sheets.
templ TimetablePrint(s TimetableSheets) {
	@competitionLayout(s.Title) {
		<div class="comp-print-bar screen-only">
			<a href={ templ.SafeURL(s.Back) }>← Timetable</a>
			<button type="button" class="button is-small is-primary" onclick="window.print()">Print / Save as PDF</button>
		</div>
		for _, sheet := range s.Sheets {
			<section class="comp-sheet">
				<h1 class="title is-5 mb-1">{ s.Competition.Name } · { sheet.Area } · { sheet.Day }</h1>
				<p class="mb-3">
					if s.Judges {
						Chair of judges
					} else {
						Marshal
					}
				</p>
				for _, f := range sheet.Flights {
					<h2 class="title is-6 mt-4 mb-1">{ f.Name }</h2>
					<p class="is-size-7 mb-1">Warm-up { f.Start } · finishes about { f.End }</p>
					if len(f.Seats) > 0 {
						<p class="is-size-7 mb-1">{ panelLine(f.Seats) }</p>
					}
					<table class="table is-fullwidth is-narrow is-bordered comp-sheet-table">
						<thead>
							<tr>
								<th>#</th>
								<th>Gymnast</th>
								<th>Club</th>
								if s.Judges {
									<th>1st exercise</th>
									<th>2nd exercise</th>
									<th>Notes</th>
								} else {
									<th>Here</th>
								}
							</tr>
						</thead>
						<tbody>
							for i, g := range f.Gymnasts {
								<tr>
									<td>{ strconv.Itoa(i + 1) }</td>
									<td>
										if g.Scratched {
											<s class="comp-scratched">{ g.Name }</s> (scratched)
										} else {
											{ g.Name }
										}
										if g.Category != "" {
											<span class="is-size-7">({ g.Category })</span>
										}
									</td>
									<td>{ g.Club }</td>
									if s.Judges {
										<td>{ s.Exercises[g.ID][0] }</td>
										<td>{ s.Exercises[g.ID][1] }</td>
										<td class="is-size-7">{ s.Notes[g.ID] }</td>
									} else {
										<td></td>
									}
								</tr>
							}
						</tbody>
					</table>
				}
			</section>
		}
	}
}

// Placement is where an attendee competes, on a published timetable.
type Placement struct {
	Flight, Panel, Time string
}

// placementLine says where a gymnast competes, once the timetable is published.
templ placementLine(p *Placement) {
	if p != nil {
		<div class="notification is-info is-light">
			<p><strong>{ p.Flight }</strong> · { p.Panel } · warm-up { p.Time }</p>
		</div>
	}
}

// RotaSheet is the printable officials rota: each person's duties.
type RotaSheet struct {
	Title       string
	Back        string
	Competition CompetitionSummary
	People      []PersonDuties
}

// PersonDuties is one person's duties, in time order.
type PersonDuties struct {
	Name, Club string
	Duties     []string
}

// RotaPrint prints the officials rota.
templ RotaPrint(s RotaSheet) {
	@competitionLayout(s.Title) {
		<div class="comp-print-bar screen-only">
			<a href={ templ.SafeURL(s.Back) }>← Timetable</a>
			<button type="button" class="button is-small is-primary" onclick="window.print()">Print / Save as PDF</button>
		</div>
		<h1 class="title is-5 mb-3">{ s.Competition.Name } · Officials rota</h1>
		if len(s.People) == 0 {
			<p>No one has a duty yet.</p>
		}
		<table class="table is-fullwidth is-narrow is-bordered comp-sheet-table">
			<thead><tr><th>Name</th><th>Club</th><th>Duties</th></tr></thead>
			<tbody>
				for _, p := range s.People {
					<tr>
						<td>{ p.Name }</td>
						<td>{ p.Club }</td>
						<td class="is-size-7">
							for _, d := range p.Duties {
								<div>{ d }</div>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// dutiesBox lists a person's duties as an official, once the timetable is
// published.
templ dutiesBox(duties []string, scoreSheets string) {
	if len(duties) > 0 {
		<div class="notification is-info is-light">
			<p><strong>Officiating</strong></p>
			<ul class="is-size-7">
				for _, d := range duties {
					<li>{ d }</li>
				}
			</ul>
			if scoreSheets != "" {
				<p class="is-size-7 mt-1"><a href={ templ.SafeURL(scoreSheets) }>Score sheets for your panels</a></p>
			}
		</div>
	}
}

// Timeline is the panel timeline on a time scale: a row for every minute
// from Header+1, in sheets side by side: a day each, or with officials a
// day's area each.
type Timeline struct {
	Title, Back, CSV  string
	Other, OtherLabel string // the other kind of timeline
	Officials         bool   // a column for each seat
	Competition       CompetitionSummary
	Header            int // rows above the minutes
	Sheets            []TimelineSheet
	// Focus picks out someone's (or a club's) flights, explained by Heading
	// and Intro; BackLabel names where Back goes.
	Focus                   bool
	Heading, Intro, BackLabel string
}

// TimelineSheet is a day, or a day's area, with its own time column.
type TimelineSheet struct {
	Day, Title string
	Columns    string // grid-template-columns
	Minutes    int    // rows of a minute
	Areas      []TimelineArea
	Hours      []TimelineHour
	Off        []TimelineSpan // outside the day's hours
}

// TimelineArea is an area's columns from Column: what's on, then its seats.
type TimelineArea struct {
	Name            string
	Column, Columns int
	Seats           []TimelineSeat
	Cells           []TimelineCell
}

// TimelineSeat is a seat's column heading.
type TimelineSeat struct {
	Label, Title string // "E3", "Execution judge"
}

// TimelineHour labels an hour's rows.
type TimelineHour struct {
	Row, Rows int
	Label     string
}

// TimelineSpan is rows from Row.
type TimelineSpan struct {
	Row, Rows int
}

// TimelineCell is a flight or blocked time ("flight", "block"), or who has one
// of its seats ("seat"), placed on the grid.
type TimelineCell struct {
	Row, Rows, Column, Columns int
	Kind                       string
	Name, Time                 string // for a seat: who, and the role, flight and time
	Flight                     bool
	Gymnasts                   int  // entries: pairs, for synchro
	Pairs                      bool // synchro
	Empty                      bool // a seat no one could take
	Overlaps                   bool // moved manually onto another
	Mine, Faint                bool     // picked out, or not, on a focused timeline
	Notes                      []string // who, doing what, when picked out
}

func gridAt(row, rows, column, columns int) string {
	return fmt.Sprintf("grid-row: %d / span %d; grid-column: %d / span %d", row, rows, column, columns)
}

func (t Timeline) rows(sh TimelineSheet) string {
	return fmt.Sprintf("repeat(%d, auto) repeat(%d, var(--tl-min))", t.Header, sh.Minutes)
}

func (c TimelineCell) title() string {
	if c.Empty {
		return "No one · " + c.Time
	}
	if c.Kind == "seat" {
		return c.Name + " · " + c.Time
	}
	if c.Flight {
		return strings.Join(append([]string{c.Name + " · " + c.Time + " · " + flightCount(c.Gymnasts, c.Pairs)}, c.Notes...), "\n")
	}
	return c.Name + " · " + c.Time
}

// TimelinePrint prints the panel timeline.
templ TimelinePrint(t Timeline) {
	@competitionLayout(t.Title) {
		<div class="comp-print-bar screen-only">
			if t.BackLabel != "" {
				<a href={ templ.SafeURL(t.Back) }>{ t.BackLabel }</a>
			} else {
				<a href={ templ.SafeURL(t.Back) }>← Timetable</a>
			}
			<a class="button is-small" href={ templ.SafeURL(t.Other) }>{ t.OtherLabel }</a>
			if t.CSV != "" {
				<a class="button is-small" href={ templ.SafeURL(t.CSV) }>Download CSV</a>
			}
			<button type="button" class="button is-small is-primary" onclick="window.print()">Print / Save as PDF</button>
		</div>
		<section class={ "comp-timeline", templ.KV("comp-timeline-officials", t.Officials) }>
			<h1 class="title is-5 mb-3">
				{ t.Competition.Name } ·
				if t.Heading != "" {
					{ t.Heading }
				} else if t.Officials {
					Timeline with officials
				} else {
					Panel timeline
				}
			</h1>
			if t.Intro != "" {
				<p class="is-size-7 mb-3">{ t.Intro }</p>
			}
			<div class="comp-tl-sheets">
				for _, sh := range t.Sheets {
					<div class="comp-tl-sheet" style={ fmt.Sprintf("grid-template-columns: %s; grid-template-rows: %s; --tl-areas: %d", sh.Columns, t.rows(sh), len(sh.Areas)) }>
						<div class="comp-tl-head comp-tl-timehead" style={ gridAt(1, t.Header, 1, 1) }>Time</div>
						<div class="comp-tl-head comp-tl-day" style={ fmt.Sprintf("grid-row: 1; grid-column: 2 / -1") }>{ sh.Title }</div>
						for _, a := range sh.Areas {
							if !t.Officials {
								<div class="comp-tl-head comp-tl-areahead" style={ gridAt(2, 1, a.Column, a.Columns) }>{ a.Name }</div>
							} else {
								<div class="comp-tl-head comp-tl-areahead" style={ gridAt(2, 1, a.Column, 1) }>Flight</div>
								for i, seat := range a.Seats {
									<div class="comp-tl-head comp-tl-areahead" style={ gridAt(2, 1, a.Column+1+i, 1) } title={ seat.Title }>{ seat.Label }</div>
								}
							}
							<div class="comp-tl-area" style={ gridAt(t.Header+1, sh.Minutes, a.Column, a.Columns) }></div>
						}
						for _, o := range sh.Off {
							<div class="comp-tl-off" style={ fmt.Sprintf("grid-row: %d / span %d; grid-column: 2 / -1", o.Row, o.Rows) }></div>
						}
						for _, h := range sh.Hours {
							<div class="comp-tl-hour" style={ gridAt(h.Row, h.Rows, 1, 1) }>{ h.Label }</div>
							<div class="comp-tl-line" style={ fmt.Sprintf("grid-row: %d / span 1; grid-column: 2 / -1", h.Row) }></div>
						}
						for _, a := range sh.Areas {
							for _, c := range a.Cells {
								<div class={ "comp-tl-cell", "comp-tl-" + c.Kind, templ.KV("comp-tl-empty", c.Empty), templ.KV("comp-tl-overlap", c.Overlaps), templ.KV("comp-tl-mine", c.Mine), templ.KV("comp-tl-faint", c.Faint) } style={ gridAt(c.Row, c.Rows, c.Column, c.Columns) } title={ c.title() }>
									if c.Kind == "seat" {
										{ c.Name }
									} else {
										<strong>{ c.Name }</strong>
										<div>
											{ c.Time }
											if c.Flight {
												· { strconv.Itoa(c.Gymnasts) }
											}
										</div>
										for _, n := range c.Notes {
											<div class="comp-tl-note">{ n }</div>
										}
									}
								</div>
							}
						}
					</div>
				}
			</div>
		</section>
	}
}

// emptySeats counts seats no one could take and the flights they're on, e.g.
// "11, on 3 flights".
func emptySeats(seats, panels int) string {
	out := fmt.Sprintf("%d, on %d panels", seats, panels)
	if panels == 1 {
		out = fmt.Sprintf("%d, on 1 panel", seats)
	}
	return out
}

// durationWord is minutes as "45 min" or "5h 35m".
func durationWord(minutes int) string {
	if minutes < 60 {
		return fmt.Sprintf("%d min", minutes)
	}
	return fmt.Sprintf("%dh %02dm", minutes/60, minutes%60)
}

// flightCount counts a flight's entries: gymnasts, or for synchro pairs.
func flightCount(n int, pairs bool) string {
	switch {
	case !pairs:
		return gymnastCount(n)
	case n == 1:
		return "1 pair"
	}
	return fmt.Sprintf("%d pairs", n)
}

// ScoreSheets are the recorders' score sheets: a page per flight, a row per
// gymnast in running order, a column for each mark of each routine, to
// write in as the paper copy of the scores.
type ScoreSheets struct {
	Title, Back string
	BackLabel   string // e.g. "← Timetable"
	Intro       string // for an official: whose flights these are
	Competition CompetitionSummary
	Flights     []ScoreFlight
}

// ScoreFlight is one flight's score sheet.
type ScoreFlight struct {
	Name, Day, Area, Start string
	Seats                  []SeatView // who's on its panel
	Marks                  []string // each routine's columns: "E1"…, "D", "HD", "S1"…, "Pen", "Total"
	Rows                   []ScoreRow
}

// ScoreRow is a gymnast (or synchro pair) on a score sheet.
type ScoreRow struct {
	Name, Club string
	Scratched  bool // a no-show on the day: struck through
}

// ScorePrint is the recorders' score sheets, to print landscape.
templ ScorePrint(s ScoreSheets) {
	@competitionLayout(s.Title) {
		<style>@page { size: A4 landscape; margin: 10mm; }</style>
		<div class="comp-print-bar screen-only">
			<a href={ templ.SafeURL(s.Back) }>{ s.BackLabel }</a>
			<button type="button" class="button is-small is-primary" onclick="window.print()">Print / Save as PDF</button>
			<span class="is-size-7">Landscape, a page a flight.</span>
		</div>
		if s.Intro != "" {
			<p class="mb-4 screen-only">{ s.Intro }</p>
		}
		if len(s.Flights) == 0 && s.Intro != "" {
			<p class="has-text-grey">You're not on the panel for any flight.</p>
		} else if len(s.Flights) == 0 {
			<p class="has-text-grey">No flights.</p>
		}
		for _, f := range s.Flights {
			<section class="comp-sheet">
				<h1 class="title is-5 mb-1">{ f.Name }</h1>
				<p class="mb-1">{ s.Competition.Name } · { f.Area } · { f.Day } · warm-up { f.Start } · Recorder's score sheet</p>
				if len(f.Seats) > 0 {
					<p class="is-size-7 mb-2">{ panelLine(f.Seats) }</p>
				}
				<div class="table-container">
				<table class="table is-fullwidth is-bordered comp-score-table">
					<thead>
						<tr>
							<th rowspan="2">#</th>
							<th rowspan="2">Gymnast</th>
							<th rowspan="2">Club</th>
							<th colspan={ strconv.Itoa(len(f.Marks)) } class="has-text-centered">1st routine</th>
							<th colspan={ strconv.Itoa(len(f.Marks)) } class="has-text-centered">2nd routine</th>
							<th rowspan="2">Total</th>
							<th rowspan="2">Place</th>
						</tr>
						<tr>
							for range 2 {
								for _, m := range f.Marks {
									<th class={ "comp-score-mark", templ.KV("comp-score-total", m == "Total") }>{ m }</th>
								}
							}
						</tr>
					</thead>
					<tbody>
						for i, g := range f.Rows {
							<tr>
								<td>{ strconv.Itoa(i + 1) }</td>
								<td>
									if g.Scratched {
										<s class="comp-scratched">{ g.Name }</s> (scratched)
									} else {
										{ g.Name }
									}
								</td>
								<td class="is-size-7">{ g.Club }</td>
								for range 2 {
									for _, m := range f.Marks {
										<td class={ "comp-score-mark", templ.KV("comp-score-total", m == "Total") }></td>
									}
								}
								<td class="comp-score-total"></td>
								<td></td>
							</tr>
						}
					</tbody>
				</table>
				</div>
			</section>
		}
	}
}
