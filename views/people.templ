package views

// PeoplePage is everyone at a competition, for the organiser (roadmap: all
// people): gymnasts and their partners, officials and coaches, once each.
type PeoplePage struct {
	Competition CompetitionSummary
	Menu        []MenuSection
	People      []PersonRow
	Tools       ListTools // the list's search and filters
}

// PersonRow is one person in the list.
type PersonRow struct {
	Name, Club string
	Href       string // their page
	Does       string // what they do, e.g. "Trampoline BUCS L7 · judge, can chair · coaches 6"
	List       ListRow // what the list's search and filters see
}

// People is the list of everyone.
templ People(p PeoplePage) {
	@competitionLayout("People · " + p.Competition.Name) {
		<h1 class="title is-4">People</h1>
		<p class="subtitle is-6">{ p.Competition.Name }</p>
		@pageMenu(p.Menu)
		<p class="mb-3">Everyone at this competition, once: gymnasts, officials and coaches. Open a name to see everything they're doing.</p>
		@listSection("Everyone", len(p.People)) {
			if len(p.People) == 0 {
				<p class="has-text-grey">Nobody yet. Gymnasts, officials and coaches show here once entries are sent.</p>
			} else {
				@listTools(p.Tools)
				<div class="table-container">
					<table class="table is-fullwidth is-narrow comp-stack" id={ p.Tools.ID }>
						<thead><tr><th>Name</th><th>Club</th><th>What they do</th></tr></thead>
						<tbody>
							for _, r := range p.People {
								<tr { r.List.Attrs()... }>
									<td><a href={ templ.SafeURL(r.Href) }>{ r.Name }</a></td>
									<td data-label="Club">{ r.Club }</td>
									<td data-label="What they do">{ r.Does }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}
