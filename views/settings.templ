package views

// SettingsPage is the organiser's page of links and settings (roadmap
// 2026-10-14): everything that was under "Links and settings" on the entries
// page.
type SettingsPage struct {
	Base          string // the admin link's path, which the page's own links extend
	Notice        string // what just happened
	New           string // "replaced" just after the admin link was replaced, to say to save it
	Menu          []MenuSection
	Access        Access // what the link it was opened by can do (ADR 0009)
	Competition   CompetitionSummary
	Links         CompetitionLinks
	LinkList      []LinkView
	Ties          []TieView // people whose own link opens these pages (ADR 0010)
	DeadlineDate  string // the closing time, for changing it
	DeadlineTime  string
	ChangesDate   string // when changes and sign-offs close, if later, for changing them
	ChangesTime   string
	SignoffsDate  string
	SignoffsTime  string
	LiveDate      string // when it's due to go live, for changing it
	LiveTime      string
	NotifyOn      bool // people can ask to hear about changes (ADR 0008)
	NoWait        bool // no wait on the competition's days
	Limits        []LimitField
	Video         VideoForm
	CoachApproval CoachApprovalForm
	Split         SplitForm
	Events        EventsForm
	LevelOrder    []LevelOrder
}

// settingsGroup is a heading on the settings page, with the id its jump link
// goes to.
templ settingsGroup(id, title string) {
	<h2 class="title is-5 mt-6 mb-3" id={ id }>{ title }</h2>
}

// CompetitionSettings is the page of links and settings.
templ CompetitionSettings(p SettingsPage) {
	@competitionLayout("Settings · " + p.Competition.Name) {
		<h1 class="title is-4">Settings</h1>
		<p class="subtitle is-6">{ p.Competition.Name }</p>
		@pageMenu(p.Menu)
		if p.New != "" && p.Links.Admin != "" {
			@newAdminLink(p.Competition, p.Links.Admin, p.New)
		}
		if p.Notice != "" {
			<div class="notification is-success is-light">{ p.Notice }</div>
		}
		<p class="is-size-7 mb-4">
			Jump to:
			<a href="#links">Links</a> ·
			<a href="#deadlines">Entries and deadlines</a> ·
			<a href="#limits">Limits and waiting lists</a> ·
			<a href="#events">Events and levels</a> ·
			<a href="#signoff">Sign-off and coaches</a> ·
			<a href="#video">Video</a> ·
			<a href="#live">Going live</a> ·
			if p.NotifyOn {
				<a href="#notify">Telling people about changes</a> ·
			}
			<a href="#individuals">Entering on their own</a>
			if p.Access.Organiser {
				· <a href="#admin-link">Admin link and deleting</a>
			}
		</p>
		@settingsGroup("links", "Links")
		if p.Access.Organiser {
			@linksBox(p.Base, p.LinkList)
			@tiesBox(p.Base+"/ties/remove", p.Ties, "Someone who adds the admin link or a helper's link to their own page (a club member's, say) opens these pages from there, with a tab for each.")
		}
		if p.Links.Club != "" {
			@linkBox("Club link", p.Links.Club, "Give it to clubs' competition secretaries: they enter their club and send its members' entries.")
		}
		if p.Competition.Individuals {
			@linkBox("Link for entering on their own", p.Links.Individual, "Anyone with it can enter on their own, without a club.")
		}
		@settingsGroup("deadlines", "Entries and deadlines")
		<form method="post" action={ templ.SafeURL(p.Base + "/deadline") } class="mb-3">
			<label class="label is-small">Entries close</label>
			<div class="comp-deadline mb-2">
				<input class="input is-small" name="deadlineDate" type="date" required value={ p.DeadlineDate } aria-label="Closing date"/>
				<input class="input is-small" name="deadlineTime" type="time" required value={ p.DeadlineTime } aria-label="Closing time"/>
				<button class="button is-small" type="submit">Change</button>
			</div>
		</form>
		<form method="post" action={ templ.SafeURL(p.Base + "/later-deadlines") } class="mb-3">
			<label class="label is-small">Changes to entries close (empty: with entries)</label>
			<div class="comp-deadline mb-2">
				<input class="input is-small" name="changesDate" type="date" value={ p.ChangesDate } aria-label="Changes closing date"/>
				<input class="input is-small" name="changesTime" type="time" value={ p.ChangesTime } aria-label="Changes closing time"/>
			</div>
			if p.Competition.Signoff {
				<label class="label is-small">Coaches' sign-off closes (empty: with entries)</label>
				<div class="comp-deadline mb-2">
					<input class="input is-small" name="signoffsDate" type="date" value={ p.SignoffsDate } aria-label="Sign-off closing date"/>
					<input class="input is-small" name="signoffsTime" type="time" value={ p.SignoffsTime } aria-label="Sign-off closing time"/>
				</div>
			}
			<button class="button is-small" type="submit">Change</button>
			<p class="help">After entries close, no new entries; clubs and gymnasts can still change, withdraw or send again the entries they've made until changes close, and coaches can sign off until sign-off closes. Either can be later than entries closing, by the end of the competition date. After changes close, late changes are by request.</p>
		</form>
		if p.Competition.Open {
			<form method="post" action={ templ.SafeURL(p.Base + "/deadline") } class="mb-3">
				<input type="hidden" name="close" value="1"/>
				<button class="button is-small" type="submit">Close entries now</button>
				<p class="help">Nobody can send or change entries after that, unless you change the closing time again.</p>
			</form>
		}
		@settingsGroup("limits", "Limits and waiting lists")
		@limitsForm(p.Base, p.Limits)
		@settingsGroup("events", "Events and levels")
		<form method="post" action={ templ.SafeURL(p.Base + "/events") } class="mb-3">
			@otherEvents(p.Events)
			<button class="button is-small" type="submit">Change events</button>
		</form>
		@levelOrderForm(p.Base, p.LevelOrder)
		<form method="post" action={ templ.SafeURL(p.Base + "/split") } class="mb-3">
			@splitFields("split", "splitLevel", "Men and women", "Which levels rank men and women separately. Their gymnasts say which when entering.", p.Split)
			<button class="button is-small" type="submit">Change</button>
		</form>
		@settingsGroup("signoff", "Sign-off and coaches")
		<form method="post" action={ templ.SafeURL(p.Base + "/signoff") } class="mb-3">
			if p.Competition.Signoff {
				<input type="hidden" name="on" value="0"/>
				<button class="button is-small" type="submit">Stop requiring coach sign-off</button>
			} else {
				<input type="hidden" name="on" value="1"/>
				<button class="button is-small" type="submit">Require coach sign-off</button>
			}
		</form>
		if p.Competition.Signoff {
			@coachApprovalFields(p.Base, p.CoachApproval)
		}
		@settingsGroup("video", "Video")
		<form method="post" action={ templ.SafeURL(p.Base + "/video") } class="mb-3">
			@videoFields(p.Video)
			<button class="button is-small" type="submit">Change video proof</button>
		</form>
		@settingsGroup("live", "Going live")
		if p.Competition.Live {
			<p class="mb-2">The competition is live: clubs and gymnasts can enter, while entries are open.</p>
			<form method="post" action={ templ.SafeURL(p.Base + "/live") } class="mb-3">
				<input type="hidden" name="opens" value="private"/>
				<input type="hidden" name="back" value="settings"/>
				<button class="button is-small" type="submit">Make private (pause entries)</button>
				<p class="help">Nobody can send or change entries until you go live again. Entries already made are kept.</p>
			</form>
		} else {
			@liveBox(p.Base, p.Competition, p.LiveDate, p.LiveTime, "settings")
		}
		if p.NotifyOn {
			@settingsGroup("notify", "Telling people about changes")
			<form method="post" action={ templ.SafeURL(p.Base + "/no-wait") } class="mb-3">
				if p.NoWait {
					<input type="hidden" name="on" value="0"/>
					<button class="button is-small" type="submit">Wait 10 minutes before telling changes, on the competition's days too</button>
				} else {
					<input type="hidden" name="on" value="1"/>
					<button class="button is-small" type="submit">No wait on the competition's days</button>
				}
				<p class="help">Changes you publish, and cards you check, go to those who asked after 10 minutes, so a mistake put right tells no one. On the competition's days, news may not wait.</p>
			</form>
		}
		@settingsGroup("individuals", "Entering on their own")
		<form method="post" action={ templ.SafeURL(p.Base + "/individuals") } class="mb-3">
			if p.Competition.Individuals {
				<input type="hidden" name="on" value="0"/>
				<button class="button is-small" type="submit">Stop entries on their own</button>
			} else {
				<input type="hidden" name="on" value="1"/>
				<button class="button is-small" type="submit">Let gymnasts enter on their own</button>
			}
		</form>
		if p.Access.Organiser {
			@settingsGroup("admin-link", "Admin link and deleting")
			<form method="post" action={ templ.SafeURL(p.Base + "/replace-link") } class="mb-3">
				<button class="button is-small" type="submit">Replace the admin link</button>
				<p class="help">If the admin link has been shared too widely. The old one stops working.</p>
			</form>
			<form method="post" action={ templ.SafeURL(p.Base + "/delete") }>
				<label class="checkbox is-size-7">
					<input type="checkbox" name="confirm" value="1" required/>
					Delete the competition and every entry, now
				</label>
				<button class="button is-small is-danger is-outlined ml-2" type="submit">Delete</button>
			</form>
		}
	}
}
