package views

import (
	"fmt"
	"strconv"
	"strings"
)

// OfferForm says what a person can do as an official (ADR 0005 Decision 5).
type OfferForm struct {
	Action      string
	Disciplines []OfferDiscipline
	Recorder    bool
	Marshal     bool
	Summary     string // what they offer now, "" for nothing
	Note        string // e.g. that an individual's offer is the same on each of their entries
	Problems    []string
	Judging     *JudgingBox // their judging qualifications, with adding them; nil where there's nowhere to keep them
}

// JudgingBox is a judge's qualifications (ADR 0014), each with its
// certificate, and how to add and remove them.
type JudgingBox struct {
	Whose   string // "Your", or the member's name and "'s"
	List    []JudgingRow
	Add     string // where adding posts (an upload); "" for a club role that can't (ADR 0015)
	Back    string // the page to come back to
	Options []FlightOption
	Full    bool   // as many as a judge can have
	Status  string // the organiser's approval, where the competition approves judges
	Done    bool   // approved
	Kept    string // where they're kept and who sees them, a sentence
	ID      string // its id on the page, where several entries each show one; "" for "judging"
}

// JudgingRow is one judging qualification: Certificate and Remove are ""
// for a club role that can't open or remove it (ADR 0015).
type JudgingRow struct {
	Name, Certificate, Remove string
}

// OfferDiscipline is judging one discipline: whether, up to which level, and
// whether they can chair.
type OfferDiscipline struct {
	Key    string // the form's name for it
	Name   string
	Levels []string
	Judge  bool
	UpTo   string
	Chair  bool
}

// offerForm asks what someone can judge and help with.
templ offerForm(f OfferForm) {
	@problemList(f.Problems)
	<form method="post" action={ templ.SafeURL(f.Action) } class="comp-offer">
		for _, d := range f.Disciplines {
			<div class="field comp-offer-row">
				<label class="checkbox">
					<input type="checkbox" name={ "judge-" + d.Key } value="1" checked?={ d.Judge }/>
					Judge { d.Name }
				</label>
				<div class="select is-small">
					<select name={ "upto-" + d.Key } aria-label={ "Highest " + d.Name + " level to judge" }>
						<option value="" selected?={ d.UpTo == "" }>any level</option>
						for _, l := range d.Levels {
							<option value={ l } selected?={ d.UpTo == l }>up to { l }</option>
						}
					</select>
				</div>
				<label class="checkbox is-size-7">
					<input type="checkbox" name={ "chair-" + d.Key } value="1" checked?={ d.Chair }/>
					can chair
				</label>
			</div>
		}
		<div class="field">
			<label class="checkbox mr-4"><input type="checkbox" name="recorder" value="1" checked?={ f.Recorder }/> Recorder</label>
			<label class="checkbox"><input type="checkbox" name="marshal" value="1" checked?={ f.Marshal }/> Marshal</label>
		</div>
		<button class="button is-small is-primary" type="submit">Save</button>
		<p class="help">
			if f.Note != "" {
				{ f.Note }
			}
			The organiser puts officials on panels around their own turns. Untick everything to offer nothing.
		</p>
	</form>
	if f.Judging != nil {
		@judgingBox(*f.Judging)
	}
}

// judgingID is a judging box's id: "judging", or its own where there are several.
func judgingID(b JudgingBox) string {
	if b.ID != "" {
		return b.ID
	}
	return "judging"
}

// judgingBox lists a judge's qualifications with their certificates, and
// adds one (an upload, its own form, outside the offer's).
templ judgingBox(b JudgingBox) {
	<div class="mt-4" id={ judgingID(b) }>
		<p class="label is-small mb-1">{ b.Whose } judging qualifications</p>
		if b.Status != "" {
			<p class="mb-2">
				if b.Done {
					@StateChip(Done, b.Status)
				} else {
					@StateChip(InProgress, b.Status)
				}
			</p>
		}
		if len(b.List) == 0 {
			<p class="is-size-7 has-text-grey mb-2">None added. An organiser may ask for them before you judge.</p>
		}
		for _, q := range b.List {
			<div class="comp-qualification">
				<span>
					{ q.Name }
					if q.Certificate != "" {
						· <a href={ templ.SafeURL(q.Certificate) } target="_blank" rel="noopener">certificate</a>
					}
				</span>
				if q.Remove != "" {
					<form method="post" action={ templ.SafeURL(q.Remove) } class="is-inline">
						<input type="hidden" name="back" value={ b.Back }/>
						<input type="hidden" name="at" value={ judgingID(b) }/>
						<button class="button is-small is-text has-text-danger" type="submit">Remove</button>
					</form>
				}
			</div>
		}
		if !b.Full && b.Add != "" {
			<details class="comp-judging-add mt-2">
				<summary class="button is-small comp-opens-button">Add a judging qualification</summary>
				<form method="post" action={ templ.SafeURL(b.Add) } enctype="multipart/form-data" class="comp-flight-actions">
					<input type="hidden" name="back" value={ b.Back }/>
					<input type="hidden" name="at" value={ judgingID(b) }/>
					<div class="select is-small">
						<select name="qualification" required aria-label="Judging qualification">
							<option value="">Choose the qualification</option>
							for _, o := range b.Options {
								<option value={ o.Value }>{ o.Label }</option>
							}
						</select>
					</div>
					<input class="input is-small comp-file" type="file" name="certificate" required accept="image/jpeg,image/png,image/webp,application/pdf" aria-label="Its certificate"/>
					<button class="button is-small is-primary" type="submit">Add</button>
				</form>
				<p class="help">A photo or PDF of its certificate, up to 3 MB. { b.Kept }</p>
			</details>
		}
	</div>
}

// offerBox is what someone offers, with the form to change it, collapsed.
templ offerBox(f OfferForm) {
	<div class="mt-4">
		@changeLine("Judging and helping", offerNow(f), len(f.Problems) > 0) {
			@offerForm(f)
		}
	</div>
}

// offerNow is what someone offers, in a line.
func offerNow(f OfferForm) string {
	if f.Summary == "" {
		return "nothing offered"
	}
	return f.Summary
}

// OfficialsPage is the organiser's officials: the panels and judging rule,
// who's available for each discipline, and everyone who has offered.
type OfficialsPage struct {
	Base            string
	Competition     CompetitionSummary
	Menu            []MenuSection
	Notice          string
	Judge           string // the judging rule
	RecordersChange bool   // recorders can change between an event's flights
	MarshalsChange  bool   // marshals can too
	Panels          []PanelSetting
	Cover           []Cover
	Officials       []OfficialRow
	Tools           ListTools // the People list's search and filters
	Add             OfferForm // for adding a person
}

// PanelSetting is a discipline's panel, as the form shows it.
type PanelSetting struct {
	Key, Name                                                 string
	Chair, Execution, Difficulty, HD, Sync, Recorder, Marshal int
	HasHD                                                     bool // trampoline and synchro: HD judges where no machine measures it
	HasSync                                                   bool // synchro: synchronisation judges where no machine measures it
}

// Cover is how many people can do each job in a discipline, against what one
// panel needs.
type Cover struct {
	Name                     string
	Judges, Chairs           int
	PanelJudges, PanelChairs int
}

// OfficialRow is one of the competition's officials.
type OfficialRow struct {
	ID, Name, Club, Source, Offer string
	Person                        string // their page
	Qualified, Added              bool
	Judging                       []JudgingRow // their judging qualifications, each with its certificate (ADR 0014)
	Unqualified                   []string     // disciplines they offer to judge with no qualification in, by name
	Who                           Role    // who they are on a seat: a gymnast, a club's judge or the organiser's own
	List                          ListRow // what the People list's search and filters see
}

// CompetitionOfficials is the organiser's officials page.
templ CompetitionOfficials(p OfficialsPage) {
	@competitionLayout("Officials · " + p.Competition.Name) {
		<h1 class="title is-4">Officials</h1>
		<p class="subtitle is-6">{ p.Competition.Name }</p>
		@pageMenu(p.Menu)
		if p.Notice != "" {
			// Stays in sight as the page goes to the person changed.
			@stickyNotice(p.Notice)
		}
		<div class="table-container">
			<table class="table is-narrow">
				<thead><tr><th>Discipline</th><th>Can judge</th><th>Can chair</th><th>One panel needs</th></tr></thead>
				<tbody>
					for _, c := range p.Cover {
						<tr>
							<td>{ c.Name }</td>
							<td>{ strconv.Itoa(c.Judges) }</td>
							<td>{ strconv.Itoa(c.Chairs) }</td>
							<td>{ strconv.Itoa(c.PanelJudges) } judges, { strconv.Itoa(c.PanelChairs) } chair</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="help mb-4">People who compete judge around their own turns; the timetable puts them on panels.</p>
		@changeLine("Panels and who may judge", panelsNow(p), false) {
			<form method="post" action={ templ.SafeURL(p.Base + "/officials/settings") }>
				<p class="help mb-2">Each discipline's panel starts as the FIG Code of Points' (a Chair of Judges Panel, 6 execution and 2 difficulty judges), plus a recorder and a marshal. Change any of it. Trampoline and synchro need HD (horizontal displacement) judges where no machine measures it; synchro starts with 2 synchronisation judges, for where no machine measures synchronisation.</p>
				<div class="table-container">
					<table class="table is-narrow comp-panels comp-stack">
						<thead><tr><th></th><th>Chair</th><th>Execution</th><th>Difficulty</th><th>HD</th><th>Sync</th><th>Recorder</th><th>Marshal</th></tr></thead>
						<tbody>
							for _, s := range p.Panels {
								<tr>
									<td>{ s.Name }</td>
									@panelInput(s.Key, "chair", s.Chair)
									@panelInput(s.Key, "execution", s.Execution)
									@panelInput(s.Key, "difficulty", s.Difficulty)
									if s.HasHD {
										@panelInput(s.Key, "hd", s.HD)
									} else {
										<td class="has-text-grey"></td>
									}
									if s.HasSync {
										@panelInput(s.Key, "sync", s.Sync)
									} else {
										<td class="has-text-grey"></td>
									}
									@panelInput(s.Key, "recorder", s.Recorder)
									@panelInput(s.Key, "marshal", s.Marshal)
								</tr>
							}
						</tbody>
					</table>
				</div>
				<p class="help mb-1">A panel judges all of an event's flights, so every gymnast in it is scored by the same people.</p>
				<label class="checkbox comp-option"><input type="checkbox" name="recordersChange" value="1" checked?={ p.RecordersChange }/> Recorders can change between an event's flights</label>
				<label class="checkbox comp-option mb-3"><input type="checkbox" name="marshalsChange" value="1" checked?={ p.MarshalsChange }/> Marshals can change between an event's flights</label>
				<fieldset class="field">
					<legend class="label is-small">Who may judge what</legend>
					<label class="radio comp-option"><input type="radio" name="judge" value="" checked?={ p.Judge == "" }/> Anyone, up to the level they say</label>
					<label class="radio comp-option"><input type="radio" name="judge" value="below" checked?={ p.Judge == "below" }/> Only levels below the one they compete at</label>
					<label class="radio comp-option"><input type="radio" name="judge" value="qualified" checked?={ p.Judge == "qualified" }/> Only people I mark qualified</label>
				</fieldset>
				<button class="button is-small" type="submit">Save</button>
			</form>
		}
		@listSection("People", len(p.Officials)) {
			@addOfficial(p)
			if len(p.Officials) == 0 {
				@emptyLine("Nobody yet. Gymnasts offer when they enter (clubs send members' offers with their entries), or add someone above.")
			} else {
				@listTools(p.Tools)
				<div class="table-container">
					<table class="table is-fullwidth is-narrow comp-table comp-stack" id={ p.Tools.ID }>
						<thead><tr><th>Name</th><th>Club</th><th>Can do</th><th>Qualified</th><th></th></tr></thead>
						<tbody>
							for _, o := range p.Officials {
								<tr id={ "official-" + o.ID } class="comp-target" { o.List.Attrs()... }>
									<td>
										<a href={ templ.SafeURL(o.Person) }>{ o.Name }</a>
										// Sent by their club, as most are, needs no chip: their club is beside it.
										// Only how they came differently shows: added by you, or on their own.
										if o.Who != RoleClub && o.Source != "sent by their club" {
											@WhoChip(o.Who, o.Source)
										}
									</td>
									<td data-label="Club">{ o.Club }</td>
									<td class="comp-wrap" data-label="Can do">
										{ o.Offer }
										// What they've shown they're qualified to judge, to look at before ticking Qualified.
										for _, q := range o.Judging {
											<span class="is-block is-size-7">{ q.Name } · <a href={ templ.SafeURL(q.Certificate) } target="_blank" rel="noopener">certificate</a></span>
										}
										if len(o.Unqualified) > 0 {
											<span class="is-block">
												@StateChip(Attention, "No judging qualification for "+strings.Join(o.Unqualified, " or "))
											</span>
										}
									</td>
									<td data-label="Qualified">
										<form method="post" action={ templ.SafeURL(p.Base + "/officials/" + o.ID + "/qualified") }>
											<input type="hidden" name="on" value={ boolValue(!o.Qualified) }/>
											<label class="checkbox">
												<input type="checkbox" checked?={ o.Qualified } onchange="this.form.submit()" aria-label={ o.Name + " qualified" }/>
											</label>
											<noscript><button class="button is-small" type="submit">Change</button></noscript>
										</form>
									</td>
									<td>
										if o.Added {
											<form method="post" action={ templ.SafeURL(p.Base + "/officials/" + o.ID + "/remove") } class="is-inline">
												<button class="button is-small is-text has-text-danger" type="submit">Remove</button>
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

// addOfficial is the form for adding a judge or helper who isn't entering,
// at the head of the People list it adds to.
templ addOfficial(p OfficialsPage) {
	@opens("", "A judge or helper who isn't entering, perhaps with no club", "Add someone", false) {
		<form method="post" action={ templ.SafeURL(p.Base + "/officials/add") }>
			<div class="field">
				<input class="input is-small" name="name" required maxlength="80" placeholder="Name" aria-label="Name"/>
				<input class="input is-small mt-1" name="club" maxlength="80" placeholder="Club (leave blank if none)" aria-label="Club"/>
			</div>
			for _, d := range p.Add.Disciplines {
				<div class="field comp-offer-row">
					<label class="checkbox"><input type="checkbox" name={ "judge-" + d.Key } value="1"/> Judge { d.Name }</label>
					<div class="select is-small">
						<select name={ "upto-" + d.Key } aria-label={ "Highest " + d.Name + " level to judge" }>
							<option value="">any level</option>
							for _, l := range d.Levels {
								<option value={ l }>up to { l }</option>
							}
						</select>
					</div>
					<label class="checkbox is-size-7"><input type="checkbox" name={ "chair-" + d.Key } value="1"/> can chair</label>
				</div>
			}
			<div class="field">
				<label class="checkbox mr-4"><input type="checkbox" name="recorder" value="1"/> Recorder</label>
				<label class="checkbox"><input type="checkbox" name="marshal" value="1"/> Marshal</label>
			</div>
			<button class="button is-small is-primary" type="submit">Add</button>
		</form>
	}
}

templ panelInput(key, field string, value int) {
	<td data-label={ panelFieldName(field) }><input class="input is-small comp-num" type="number" min="0" max="20" name={ "panel-" + key + "-" + field } value={ strconv.Itoa(value) } aria-label={ key + " " + field }/></td>
}

// panelFieldName is a panel's seat as the table's heading says it, for a
// phone's card.
func panelFieldName(field string) string {
	return map[string]string{"chair": "Chair", "execution": "Execution", "difficulty": "Difficulty", "hd": "HD", "sync": "Sync", "recorder": "Recorder", "marshal": "Marshal"}[field]
}

// panelsNow says, in a line, how many sit on each discipline's panel and
// who may judge.
func panelsNow(p OfficialsPage) string {
	var seats []string
	for _, s := range p.Panels {
		n := s.Chair + s.Execution + s.Difficulty + s.Recorder + s.Marshal
		if s.HasHD {
			n += s.HD
		}
		if s.HasSync {
			n += s.Sync
		}
		seats = append(seats, fmt.Sprintf("%s %d", s.Name, n))
	}
	who := "anyone, up to the level they say"
	switch p.Judge {
	case "below":
		who = "only levels below the one they compete at"
	case "qualified":
		who = "only people you mark qualified"
	}
	return "seats on a panel: " + strings.Join(seats, ", ") + "; who may judge: " + who
}
