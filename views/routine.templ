package views

import (
	"fmt"
	"strconv"
	"strings"

	"tariffCalculator/requirements"
	"tariffCalculator/skills"
)

// RoutineSide says which builder column a routine is shown in: "a", the routine
// being edited, or "b", the one shown beside it when comparing. Other is the
// routine in the other column, if there is one, to mark where they differ.
type RoutineSide struct {
	Side   string
	Other  *CompareSide
	Checks Checks
	Level  *LevelCheck // the level the routine is one exercise of, if any
}

// LevelCheck is a routine doing one exercise of a level, and how the routine
// doing the other exercise (if there is one) meets its requirements.
type LevelCheck struct {
	Name       string
	Err        string // why the level couldn't be used, if it couldn't
	Exercise   int    // 1 or 2
	HasOther   bool   // a routine does the other exercise
	OtherName  string
	OtherErr   string // why the other routine couldn't be checked
	OtherMet   int
	OtherRules int
}

// exerciseName is "first" or "second".
func exerciseName(n int) string {
	if n == 2 {
		return "second"
	}
	return "first"
}

// Checks are which of the Code of Points' checks apply to a routine. Set
// (compulsory) routines usually score no difficulty and may repeat elements;
// the routine's requirement set says, and the coach can change it.
type Checks struct {
	ScoreDifficulty bool
	FlagRepeats     bool
	ScoredElements  int // only this many elements score difficulty (0: all)
}

// list is the id of the column's card list, which the page makes sortable.
func (s RoutineSide) list() string {
	if s.Side == "b" {
		return "routine-skills-b"
	}
	return "routine-skills"
}

// call is an Alpine call to a card method for skill i in this column, e.g.
// "editSkill(2, 'b')". Side is only ever "a" or "b".
func (s RoutineSide) call(method string, i int) string {
	return fmt.Sprintf("%s(%d, '%s')", method, i, s.Side)
}

// expanded is the Alpine expression for whether card i is expanded.
func (s RoutineSide) expanded(i int) string {
	if s.Side == "b" {
		return fmt.Sprintf("expandedB[%d]", i)
	}
	return fmt.Sprintf("expanded[%d]", i)
}

// Routine renders a routine builder column's skill cards and totals for a
// validated routine. The page's Alpine component owns the routines (in
// localStorage) and re-requests this view whenever one changes; card controls
// call its methods with the column's side, and it makes the card list
// drag-sortable (SortableJS).
templ Routine(rv skills.RoutineValidation, check *RequirementCheck, side RoutineSide) {
	<div id={ side.list() } class="routine-skills" data-scoring={ templ.JSONString(scoringElements(rv)) }>
		if len(rv.Skills) == 0 {
			<p class="has-text-grey">Add skills using the form above.</p>
		} else {
			for i, sv := range rv.Skills {
				@skillCard(i, sv, rv.Messages[i], i == len(rv.Skills)-1, side, side.Other != nil && differs(CompareSide{Validation: rv}, *side.Other, i), rv.ScoredElements > 0 && (sv.Counted || sv.Unscored), ticked(rv, sv))
			}
		}
	</div>
	@results(rv, side)
	if side.Level != nil {
		@levelPanel(*side.Level)
	}
	if check != nil {
		@requirementsPanel(*check, side.Side)
	}
}

// levelPanel says which exercise of a level the routine is, and how the
// routine doing the other exercise is getting on.
templ levelPanel(l LevelCheck) {
	<div class="level-check mt-4">
		<p>
			<strong>{ l.Name }</strong> · { exerciseName(l.Exercise) } exercise
		</p>
		if l.Err != "" {
			<p class="has-text-danger is-size-7">Couldn't use this level: { l.Err }</p>
		} else if !l.HasOther {
			<p class="has-text-grey is-size-7">No routine for the { exerciseName(3 - l.Exercise) } exercise yet.</p>
		} else {
			<p class="is-size-7">
				{ titleCase(exerciseName(3 - l.Exercise)) } exercise: { l.OtherName }
				if l.OtherErr != "" {
					<span class="has-text-danger">· couldn't check it: { l.OtherErr }</span>
				} else if l.OtherRules > 0 {
					<span class={ "tag", "is-small", templ.KV("is-success", l.OtherMet == l.OtherRules), templ.KV("is-danger", l.OtherMet < l.OtherRules) }>
						{ fmt.Sprintf("%d of %d met", l.OtherMet, l.OtherRules) }
					</span>
				}
			</p>
		}
	</div>
}

func titleCase(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

templ skillCard(i int, sv skills.SkillValidation, message string, last bool, side RoutineSide, different bool, canScore, scoresTicked bool) {
	<div class="routine-skill-container" x-bind:class={ fmt.Sprintf("{ 'editing': editingIndex === %d && editingSide === '%s' }", i, side.Side) }>
		<div
			class={ "routine-skill", "box", "mb-2",
				templ.KV("invalid-transition", sv.InvalidTransition || sv.IntermediateJump),
				templ.KV("invalid-landing", sv.InvalidLanding),
				templ.KV("duplicate-skill", sv.IsDuplicate),
				templ.KV("not-counted", sv.AfterInterruption || sv.ScoredEarlier),
				templ.KV("differs", different) }
		>
			// Clickable header toggles the details.
			<div class="card-head" x-on:click={ side.call("toggleExpanded", i) }>
				<div class="skill-name-block is-flex is-align-items-center mb-0 mr-2" style="flex: 1; min-width: 0;">
					<span
						class="icon mr-1 has-text-grey"
						style="font-size: 1.1rem; transition: transform 0.2s ease-in-out; display: flex; align-items: center;"
						x-bind:style={ side.expanded(i) + " ? 'transform: rotate(90deg);' : 'transform: rotate(0deg);'" }
					>▶</span>
					// Stacks on mobile, inline on tablet and up.
					<div class="is-flex-tablet is-align-items-baseline" style="flex: 1; min-width: 0;">
						<p class="skill-name mb-0 mr-2" style="line-height: 1.2; word-wrap: break-word;">
							<strong>{ cardTitle(i, sv.Skill) }</strong>
							if sv.Skill.CustomName != "" {
								<span class="has-text-grey">· { sv.Skill.Name }</span>
							}
						</p>
						<p class="is-size-7 has-text-grey mb-0" style="white-space: nowrap; line-height: 1.2;">
							{ sv.FIGNotation }
							// When only some elements score, the coach can choose which.
							if canScore {
								<label class={ "scores-toggle", templ.KV("is-scoring", sv.Counted) } x-on:click.stop>
									<input type="checkbox" checked?={ scoresTicked } x-on:change={ fmt.Sprintf("toggleScores(%d, '%s', $event.target.checked)", i, side.Side) }/>
									Scores
								</label>
							}
							// Flags a problem while the card is collapsed; the message is in the details.
							if message != "" {
								<span class="has-text-danger ml-1" title={ message } aria-label={ "Issue: " + message }>⚠️</span>
							}
						</p>
					</div>
				</div>
				// Compact button grid; clicks here must not toggle the card.
				<div class="card-buttons" x-on:click.stop>
					<button class="button is-info is-small is-fullwidth px-0 card-text-button" title="Edit" x-on:click={ side.call("editSkill", i) }>Edit</button>
					<button class="button is-small is-fullwidth px-0" title="Move Up" x-on:click={ side.call("moveSkillUp", i) } disabled?={ i == 0 }>↑</button>
					<button class="button is-danger is-small is-fullwidth px-0 card-text-button" title="Remove" x-on:click={ side.call("removeSkill", i) }>Del</button>
					<button class="button is-small is-fullwidth px-0" title="Move Down" x-on:click={ side.call("moveSkillDown", i) } disabled?={ last }>↓</button>
				</div>
			</div>
			// Collapsible details.
			<div x-show={ side.expanded(i) } x-cloak>
				<hr class="mt-2 mb-2"/>
				<div class="skill-details-columns columns is-mobile is-multiline is-variable is-2 mb-0">
					@detail("Rotation", rotationText(sv.Skill))
					@detail("Twists", twistText(sv.Skill))
					@detail("Landing", sv.Skill.TakeoffPosition.String()+" → "+sv.Landing.String())
					@detail("Shape", sv.Skill.Shape.String())
					<div class="column is-half-mobile is-narrow-tablet">
						<p class="is-size-7-mobile">
							<span class="has-text-grey mr-1">Tariff:</span>
							<strong class="has-text-primary">{ fmt.Sprintf("%.2f", sv.Skill.Tariff) }</strong>
						</p>
					</div>
				</div>
				if message != "" {
					<div class="skill-validation-row mt-1">
						<p class="transition-status is-size-7 has-text-danger">{ message }</p>
					</div>
				}
			</div>
		</div>
	</div>
}

templ detail(label, value string) {
	<div class="column is-half-mobile is-narrow-tablet">
		<p class="is-size-7-mobile">
			<span class="has-text-grey mr-1">{ label }:</span>
			<strong>{ value }</strong>
		</p>
	</div>
}

templ results(rv skills.RoutineValidation, side RoutineSide) {
	<div class="routine-results mt-4">
		<div class="card">
			<div class="card-content">
				if side.Checks.ScoreDifficulty {
					<p class="title">Total Tariff: { fmt.Sprintf("%.2f", rv.TotalTariff) }</p>
					if rv.ScoredElements > 0 {
						<p class="compare-difference">
							if rv.ScoringChosen {
								From the elements you ticked "Scores" ·
								<a x-on:click.prevent={ fmt.Sprintf("clearScores('%s')", side.Side) } href="#">Choose automatically</a>
							} else {
								From the { strconv.Itoa(rv.ScoredElements) } highest-scoring elements, ticked "Scores". Tick others to choose.
							}
						</p>
						if rv.ScoringOverChosen > 0 {
							<p class="has-text-danger is-size-7">Only { strconv.Itoa(rv.ScoredElements) } elements score: untick { strconv.Itoa(rv.ScoringOverChosen) }.</p>
						}
					}
					if side.Other != nil {
						<p class="compare-difference">{ differenceFrom(rv, *side.Other) }</p>
					}
				} else {
					<p class="title is-4">Difficulty not scored</p>
					<p class="compare-difference">The elements add up to { fmt.Sprintf("%.2f", rv.TotalTariff) }</p>
				}
				<p class="subtitle">{ strconv.Itoa(len(rv.Skills)) } of { strconv.Itoa(skills.RoutineLength) } skills</p>
				if side.Checks.ScoreDifficulty && rv.ScoredElements == 0 && rv.RawTariff > rv.TotalTariff+1e-9 {
					<p class="subtitle tariff-difference">(Raw Total: { fmt.Sprintf("%.2f", rv.RawTariff) })</p>
				}
				<div class="validation-messages mt-3">
					if rv.RoutineTooLong {
						<p class="has-text-warning mb-2">⚠️ Routine has more than 10 skills (skills after the 10th don't count toward Tariff).</p>
					}
					if rv.HasDuplicates {
						<p class="has-text-warning mb-2">⚠️ Duplicate skills only count once toward total!</p>
					}
					if rv.HasInvalidTransitions {
						<p class="has-text-danger">❌ Invalid transitions detected.</p>
					}
					if rv.InterruptedAt >= 0 {
						<p class="has-text-danger">❌ { interruptionText(rv.InterruptedAt) }</p>
					}
					if rv.HasInvalidLandings {
						<p class="has-text-landing-warning">🚫 Invalid landing positions detected.</p>
					}
					if rv.TenthSkillWarning {
						<p class="has-text-tenth-warning">🎯 10th skill must land on feet!</p>
					}
				</div>
				// Which checks apply; the routine's requirement set chooses them, and the coach can change them.
				<div class="routine-checks">
					<span class="routine-checks-label">Checks</span>
					<label class="checkbox">
						<input type="checkbox" checked?={ side.Checks.ScoreDifficulty } x-on:change={ fmt.Sprintf("setCheck('%s', 'difficulty', $event.target.checked)", side.Side) }/>
						Score difficulty
					</label>
					<label class="checkbox">
						<input type="checkbox" checked?={ side.Checks.FlagRepeats } x-on:change={ fmt.Sprintf("setCheck('%s', 'repeats', $event.target.checked)", side.Side) }/>
						Flag repeated elements
					</label>
					if side.Checks.ScoreDifficulty {
						<label class="scored-elements">
							Score
							<span class="select is-small">
								<select x-on:change={ fmt.Sprintf("setCheck('%s', 'scored', Number($event.target.value))", side.Side) }>
									<option value="0" selected?={ side.Checks.ScoredElements == 0 }>all</option>
									for n := 1; n < skills.RoutineLength; n++ {
										<option value={ strconv.Itoa(n) } selected?={ side.Checks.ScoredElements == n }>{ strconv.Itoa(n) }</option>
									}
								</select>
							</span>
							elements
						</label>
					}
				</div>
			</div>
		</div>
	</div>
}

// RequirementCheck is a routine checked against a requirement set (ADR 0003).
type RequirementCheck struct {
	SetName    string
	Results    []requirements.Result
	Err        string // why the set couldn't be used, if it couldn't
	SetRoutine bool   // the set is a set (compulsory) routine, which can be loaded
}

// Met counts the requirements the routine meets.
func (c RequirementCheck) Met() int {
	n := 0
	for _, r := range c.Results {
		if r.Passed {
			n++
		}
	}
	return n
}

// requirementsPanel lists each requirement with whether the routine meets it.
templ requirementsPanel(c RequirementCheck, side string) {
	<div id="requirements-results" class="card mt-4">
		<div class="card-content">
			<p class="requirements-title">
				{ c.SetName }
				if c.Err == "" && len(c.Results) > 0 {
					<span class={ "tag", templ.KV("is-success", c.Met() == len(c.Results)), templ.KV("is-danger", c.Met() < len(c.Results)) }>
						{ fmt.Sprintf("%d of %d met", c.Met(), len(c.Results)) }
					</span>
				}
			</p>
			if c.Err != "" {
				<p class="has-text-danger is-size-7">Couldn't use these requirements: { c.Err }</p>
			} else if len(c.Results) == 0 {
				<p class="has-text-grey is-size-7">There are no rules here yet.</p>
			} else {
				<ul class="requirements-list">
					for _, r := range c.Results {
						<li class={ templ.KV("is-met", r.Passed), templ.KV("is-unmet", !r.Passed) }>
							<span class="requirement-mark" aria-label={ metText(r.Passed) }>{ markFor(r.Passed) }</span>
							<span>
								{ r.Description }
								if text := resultDetail(r); text != "" {
									<span class="requirement-detail">{ text }</span>
								}
							</span>
						</li>
					}
				</ul>
				if c.SetRoutine && c.Met() < len(c.Results) {
					<button class="button is-small is-link is-light mt-3" type="button" x-on:click={ fmt.Sprintf("loadSetRoutine('%s', true)", side) }>Load this set routine</button>
				}
			}
		</div>
	</div>
}

func markFor(passed bool) string {
	if passed {
		return "✓"
	}
	return "✗"
}

func metText(passed bool) string {
	if passed {
		return "Met"
	}
	return "Not met"
}

// resultDetail is what the check found, and which elements it involves.
func resultDetail(r requirements.Result) string {
	parts := []string{}
	if r.Detail != "" {
		parts = append(parts, r.Detail)
	}
	if len(r.Elements) > 0 && !strings.Contains(r.Detail, "element") && !strings.HasPrefix(r.Detail, "differs") {
		nums := make([]string, len(r.Elements))
		for i, e := range r.Elements {
			nums[i] = strconv.Itoa(e)
		}
		word := "element "
		if len(nums) > 1 {
			word = "elements "
		}
		parts = append(parts, word+strings.Join(nums, ", "))
	}
	return strings.Join(parts, " · ")
}

// ticked is whether an element's Scores box is ticked: the coach's choice if
// they've made one, otherwise whether it's one of the highest that score.
// (The box's highlight says whether it actually scores.)
func ticked(rv skills.RoutineValidation, sv skills.SkillValidation) bool {
	if rv.ScoringChosen {
		return sv.Skill.Scores
	}
	return sv.Counted
}

// scoringElements are the elements (0-based) that score when only some do,
// so the page can start the coach's choice from them.
func scoringElements(rv skills.RoutineValidation) []int {
	out := []int{}
	if rv.ScoredElements == 0 {
		return out
	}
	for i, sv := range rv.Skills {
		if sv.Counted {
			out = append(out, i)
		}
	}
	return out
}

// differenceFrom compares this routine's difficulty with the other column's.
func differenceFrom(rv skills.RoutineValidation, other CompareSide) string {
	diff := rv.TotalTariff - other.Validation.TotalTariff
	switch {
	case diff > 0.005:
		return fmt.Sprintf("%.1f more than %s", diff, other.Name)
	case diff < -0.005:
		return fmt.Sprintf("%.1f less than %s", -diff, other.Name)
	}
	return "Same as " + other.Name
}

// alpine formats an Alpine expression; arguments are only ever ints.
func alpine(format string, args ...int) string {
	vals := make([]any, len(args))
	for i, a := range args {
		vals[i] = a
	}
	return fmt.Sprintf(format, vals...)
}

// interruptionText explains what an interruption at skill index i costs (CoP §15.2-15.3).
func interruptionText(i int) string {
	return fmt.Sprintf("Routine interrupted at skill %d: it and the skills after it don't count toward Tariff.", i+1)
}

// cardTitle is "N. name", preferring the user's custom name.
func cardTitle(i int, s skills.TrampolineSkill) string {
	name := s.Name
	if s.CustomName != "" {
		name = s.CustomName
	}
	return fmt.Sprintf("%d. %s", i+1, name)
}

func rotationText(s skills.TrampolineSkill) string {
	direction := "F"
	if s.Backward {
		direction = "B"
	}
	return fmt.Sprintf("%d %s", s.Rotation, direction)
}

func twistText(s skills.TrampolineSkill) string {
	if len(s.TwistDistribution) == 0 {
		return "0"
	}
	parts := make([]string, len(s.TwistDistribution))
	for i, t := range s.TwistDistribution {
		parts[i] = strconv.Itoa(t)
	}
	return strings.Join(parts, " | ")
}
