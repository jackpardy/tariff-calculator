package views

import (
	"fmt"
	"slices"
	"strconv"
	"strings"

	"tariffCalculator/requirements"
	"tariffCalculator/skills"
)

// RoutineSide says which builder column a routine is shown in: "a", the routine
// being edited, or "b", the one shown beside it when comparing. Other is the
// routine in the other column, if there is one, to mark where they differ.
type RoutineSide struct {
	Side   string
	Other  *CompareSide
	Checks Checks
	Level  *LevelCheck // the level the routine is one exercise of, if any
	// ReadOnly shows a set routine as prescribed: no editing, reordering or checks.
	ReadOnly bool
}

// LevelCheck is a routine doing one exercise of a level, and how the routine
// doing the other exercise (if there is one) meets its requirements.
type LevelCheck struct {
	Name       string
	Err        string // why the level couldn't be used, if it couldn't
	Exercise   int    // 1 or 2
	HasOther   bool   // a routine does the other exercise
	OtherName  string
	OtherErr   string // why the other routine couldn't be checked
	OtherMet   int
	OtherRules int
	// When the first exercise scores only some elements, their difficulty
	// carries over and they can't be repeated in the second exercise.
	Carried  []int // the first exercise's elements that carry over (1-based)
	Repeated []int // the second exercise's elements repeating one of them
}

// exerciseName is "first" or "second".
func exerciseName(n int) string {
	if n == 2 {
		return "second"
	}
	return "first"
}

// Checks are which of the Code of Points' checks apply to a routine.
type Checks = requirements.Checks

// list is the id of the column's card list, which the page makes sortable.
func (s RoutineSide) list() string {
	if s.Side == "b" {
		return "routine-skills-b"
	}
	return "routine-skills"
}

// call is an Alpine call to a card method for skill i in this column, e.g.
// "editSkill(2, 'b')". Side is only ever "a" or "b".
func (s RoutineSide) call(method string, i int) string {
	return fmt.Sprintf("%s(%d, '%s')", method, i, s.Side)
}

// expanded is the Alpine expression for whether card i is expanded.
func (s RoutineSide) expanded(i int) string {
	if s.Side == "b" {
		return fmt.Sprintf("expandedB[%d]", i)
	}
	return fmt.Sprintf("expanded[%d]", i)
}

// Routine renders a routine builder column's skill cards and totals for a
// validated routine. The page's Alpine component owns the routines (in
// localStorage) and re-requests this view whenever one changes; card controls
// call its methods with the column's side, and it makes the card list
// drag-sortable (SortableJS).
templ Routine(rv skills.RoutineValidation, check *RequirementCheck, side RoutineSide) {
	// How it's doing against its requirements, by Check against, where it's
	// seen: the list of each requirement is under the total.
	if check != nil && check.Err == "" && len(check.Results) > 0 {
		<p class="check-summary">
			@metChip(check.Met(), len(check.Results))
			<a href={ templ.SafeURL("#" + side.list() + "-requirements") }>See which</a>
		</p>
	}
	<div id={ side.list() } class={ "routine-skills", templ.KV("is-read-only", side.ReadOnly) } data-scoring={ templ.JSONString(scoringElements(rv)) } data-read-only?={ side.ReadOnly }>
		if len(rv.Skills) == 0 {
			<p class="routine-empty">No skills yet: add them under Add a skill.</p>
		} else {
			for i, sv := range rv.Skills {
				@skillCard(i, sv, rv.Messages[i], i == len(rv.Skills)-1, side, side.Other != nil && differs(CompareSide{Validation: rv}, *side.Other, i), !side.ReadOnly && rv.ScoredElements > 0 && (sv.Counted || sv.Unscored), ticked(rv, sv), scoringFull(rv))
			}
		}
	</div>
	@results(rv, side)
	if side.Level != nil {
		@levelPanel(*side.Level)
	}
	if check != nil {
		@requirementsPanel(*check, side)
	}
}

// levelPanel says which exercise of a level the routine is, and how the
// routine doing the other exercise is getting on.
templ levelPanel(l LevelCheck) {
	<div class="level-check">
		<p>
			<strong>{ l.Name }</strong> · { exerciseName(l.Exercise) } exercise
		</p>
		if l.Err != "" {
			<p class="routine-total-note is-problem">Couldn't use this level: { l.Err }</p>
		} else if !l.HasOther {
			<p class="routine-total-note">No routine for the { exerciseName(3 - l.Exercise) } exercise yet.</p>
		} else {
			<p class="routine-total-note">
				{ titleCase(exerciseName(3 - l.Exercise)) } exercise: { l.OtherName }
				if l.OtherErr != "" {
					<span class="is-problem">· couldn't check it: { l.OtherErr }</span>
				} else if l.OtherRules > 0 {
					@metChip(l.OtherMet, l.OtherRules)
				}
			</p>
			if len(l.Carried) > 0 {
				<ul class="requirements-list">
					<li class={ templ.KV("is-met", len(l.Repeated) == 0), templ.KV("is-unmet", len(l.Repeated) > 0) }>
						<span class="requirement-mark" aria-label={ metText(len(l.Repeated) == 0) }>{ markFor(len(l.Repeated) == 0) }</span>
						<span>
							The second exercise doesn't repeat an element whose difficulty carries over from the first
							<span class="requirement-detail">{ carryDetail(l) }</span>
						</span>
					</li>
				</ul>
			}
		}
	</div>
}

// carryDetail names the elements that carry over and any repeats, from this
// routine's side of the pair.
func carryDetail(l LevelCheck) string {
	elements := func(ns []int) string {
		parts := make([]string, len(ns))
		for i, n := range ns {
			parts[i] = strconv.Itoa(n)
		}
		word := "element "
		if len(ns) > 1 {
			word = "elements "
		}
		return word + strings.Join(parts, ", ")
	}
	text := "carried over: " + elements(l.Carried) + " of the first exercise"
	if l.Exercise == 1 {
		text = "carried over: " + elements(l.Carried)
	}
	if len(l.Repeated) > 0 {
		if l.Exercise == 2 {
			text += " · repeated at " + elements(l.Repeated)
		} else {
			text += " · the second exercise repeats them at " + elements(l.Repeated)
		}
	}
	return text
}

func titleCase(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

// skillCard is one element of the routine. Its head is a button that opens
// the details, so it works from the keyboard: the name, FIG notation and
// tariff, with a mark while a problem is folded away. ↑, ↓ and Edit sit at
// the right; Remove is in the details, away from them, and can be undone.
templ skillCard(i int, sv skills.SkillValidation, message string, last bool, side RoutineSide, different bool, canScore, scoresTicked, scoresFull bool) {
	{{ text, problem := cardMessage(i, message) }}
	<div class="routine-skill-container" x-bind:class={ fmt.Sprintf("{ 'editing': editingIndex === %d && editingSide === '%s' }", i, side.Side) }>
		<div
			class={ "routine-skill",
				templ.KV("invalid-transition", sv.InvalidTransition || sv.IntermediateJump),
				templ.KV("invalid-landing", sv.InvalidLanding),
				templ.KV("duplicate-skill", (sv.IsDuplicate && !firstOfRepeat(message)) || sv.ScoredEarlier),
				templ.KV("not-counted", sv.AfterInterruption),
				templ.KV("differs", different) }
		>
			<div class="card-head">
				<button type="button" class="card-toggle" x-on:click={ side.call("toggleExpanded", i) } x-bind:aria-expanded={ side.expanded(i) + " ? 'true' : 'false'" }>
					<span class="card-arrow" aria-hidden="true"></span>
					<span class="card-title">
						<span class="skill-name">
							{ cardTitle(i, sv.Skill) }
							if sv.Skill.CustomName != "" {
								<span class="card-official">· { sv.Skill.Name }</span>
							}
						</span>
						<span class="card-fig">{ sv.FIGNotation }</span>
					</span>
					// Flags a problem while the card is folded; the details say what it is.
					if problem {
						// A word, not "!" (the owner: no "!" on warnings).
						<span class="card-problem" title={ text } aria-label={ "Problem: " + text }>
							@StateChip(Attention, "Problem")
						</span>
					}
					<span class="card-tariff">{ tariffText(sv.Skill.Tariff) }</span>
				</button>
				// When only some elements score, the coach can choose which.
				if canScore {
					<label class={ "scores-toggle", templ.KV("is-scoring", sv.Counted) }>
						// Once as many score as may, another waits for one to be unticked.
						<input type="checkbox" checked?={ scoresTicked } disabled?={ scoresFull && !scoresTicked } title={ scoresTitle(scoresFull && !scoresTicked) } x-on:change={ fmt.Sprintf("toggleScores(%d, '%s', $event.target.checked)", i, side.Side) }/>
						Scores
					</label>
				}
				if !side.ReadOnly {
					<div class="card-buttons">
						<button class="button" type="button" title="Move up" aria-label={ fmt.Sprintf("Move element %d up", i+1) } x-on:click={ side.call("moveSkillUp", i) } disabled?={ i == 0 }>↑</button>
						<button class="button" type="button" title="Move down" aria-label={ fmt.Sprintf("Move element %d down", i+1) } x-on:click={ side.call("moveSkillDown", i) } disabled?={ last }>↓</button>
						<button class="button" type="button" x-on:click={ side.call("editSkill", i) }>Edit</button>
					</div>
				}
			</div>
			<div class="card-details" x-show={ side.expanded(i) } x-cloak>
				<dl class="card-facts">
					@detail("Rotation", rotationText(sv.Skill))
					@detail("Twist", twistText(sv.Skill))
					@detail("Landing", sv.Skill.TakeoffPosition.String()+" → "+sv.Landing.String())
					@detail("Shape", sv.Skill.Shape.String())
				</dl>
				if text != "" {
					<p class={ "card-message", templ.KV("is-problem", problem) }>{ text }</p>
				}
				<div class="card-actions">
					if judged(sv.Skill) {
						@judgingButton(sv.Skill, endsExercise(i, last))
					}
					if !side.ReadOnly {
						<button class="button is-small is-danger is-outlined card-remove" type="button" x-on:click={ side.call("removeSkill", i) }>Remove</button>
					}
				</div>
			</div>
		</div>
	</div>
}

templ detail(label, value string) {
	<div>
		<dt>{ label }</dt>
		<dd>{ value }</dd>
	</div>
}

// results is the column's total, the routine's problems in the words the
// tariff sheet uses (skills.RoutineNotes), and the checks that apply.
templ results(rv skills.RoutineValidation, side RoutineSide) {
	<div class="routine-results">
		<p class="routine-total">
			if side.Checks.ScoreDifficulty {
				<span>Total tariff</span>
				<strong class="routine-total-value">{ tariffText(rv.TotalTariff) }</strong>
			} else {
				<span>Difficulty not scored</span>
			}
			<span class="routine-count">{ strconv.Itoa(len(rv.Skills)) } of { strconv.Itoa(skills.RoutineLength) } skills</span>
		</p>
		if !side.Checks.ScoreDifficulty {
			<p class="routine-total-note">The elements add up to { tariffText(rv.TotalTariff) }.</p>
		} else if rv.ScoredElements > 0 {
			<p class="routine-total-note">
				if rv.ScoringChosen {
					From the elements you ticked "Scores" ·
					<a x-on:click.prevent={ fmt.Sprintf("clearScores('%s')", side.Side) } href="#">Choose automatically</a>
				} else {
					From the { strconv.Itoa(rv.ScoredElements) } highest-scoring elements, ticked "Scores". Tick others to choose.
				}
			</p>
			if rv.ScoringOverChosen > 0 {
				<p class="routine-total-note is-problem">Only { strconv.Itoa(rv.ScoredElements) } elements score: untick { strconv.Itoa(rv.ScoringOverChosen) }.</p>
			}
		} else if rv.RawTariff > rv.TotalTariff+1e-9 {
			<p class="routine-total-note">Counting every element: { tariffText(rv.RawTariff) }.</p>
		}
		if side.Checks.ScoreDifficulty && side.Other != nil {
			<p class="routine-total-note">{ differenceFrom(rv, *side.Other) }</p>
		}
		if notes := skills.RoutineNotes(rv.Messages); len(notes) > 0 {
			<ul class="routine-notes">
				for _, note := range notes {
					<li>{ note }</li>
				}
			</ul>
		}
		// Which checks apply; the routine's requirement set chooses them, and the coach can change them.
		if !side.ReadOnly {
			<div class="routine-checks">
				<span class="routine-checks-label">Checks</span>
				<label class="checkbox">
					<input type="checkbox" checked?={ side.Checks.ScoreDifficulty } x-on:change={ fmt.Sprintf("setCheck('%s', 'difficulty', $event.target.checked)", side.Side) }/>
					Score difficulty
				</label>
				<label class="checkbox">
					<input type="checkbox" checked?={ side.Checks.FlagRepeats } x-on:change={ fmt.Sprintf("setCheck('%s', 'repeats', $event.target.checked)", side.Side) }/>
					Flag repeated elements
				</label>
				if side.Checks.ScoreDifficulty {
					<label class="scored-elements">
						Score
						<span class="select is-small">
							<select x-on:change={ fmt.Sprintf("setCheck('%s', 'scored', Number($event.target.value))", side.Side) }>
								<option value="0" selected?={ side.Checks.ScoredElements == 0 }>all</option>
								for n := 1; n < skills.RoutineLength; n++ {
									<option value={ strconv.Itoa(n) } selected?={ side.Checks.ScoredElements == n }>{ strconv.Itoa(n) }</option>
								}
							</select>
						</span>
						elements
					</label>
				}
			</div>
		}
	</div>
}

// RequirementCheck is a routine checked against a requirement set (ADR 0003).
type RequirementCheck struct {
	SetName    string
	Results    []requirements.Result
	Err        string // why the set couldn't be used, if it couldn't
}

// Met counts the requirements the routine meets.
func (c RequirementCheck) Met() int {
	n := 0
	for _, r := range c.Results {
		if r.Passed {
			n++
		}
	}
	return n
}

// requirementsPanel lists each requirement with whether the routine meets it.
// Check against's summary (at the top of the column) links here.
templ requirementsPanel(c RequirementCheck, side RoutineSide) {
	<section id={ side.list() + "-requirements" } class="requirements-results">
		<h3 class="requirements-title">
			{ c.SetName }
			if c.Err == "" && len(c.Results) > 0 {
				@metChip(c.Met(), len(c.Results))
			}
		</h3>
		if c.Err != "" {
			<p class="routine-total-note is-problem">Couldn't use these requirements: { c.Err }</p>
		} else if len(c.Results) == 0 {
			<p class="routine-total-note">There are no rules here yet.</p>
		} else {
			<ul class="requirements-list">
				for _, r := range c.Results {
					<li class={ templ.KV("is-met", r.Passed), templ.KV("is-unmet", !r.Passed) }>
						<span class="requirement-mark" aria-label={ metText(r.Passed) }>{ markFor(r.Passed) }</span>
						<span>
							{ r.Description }
							if text := resultDetail(r); text != "" {
								<span class="requirement-detail">{ text }</span>
							}
						</span>
					</li>
				}
			</ul>
		}
	</section>
}

// metChip says how many of a routine's requirements it meets, as a state:
// done when it meets them all, otherwise one to look at.
templ metChip(met, of int) {
	if met == of {
		@StateChip(Done, fmt.Sprintf("%d of %d met", met, of))
	} else {
		@StateChip(Attention, fmt.Sprintf("%d of %d met", met, of))
	}
}

func markFor(passed bool) string {
	if passed {
		return "✓"
	}
	return "✗"
}

func metText(passed bool) string {
	if passed {
		return "Met"
	}
	return "Not met"
}

// resultDetail is what the check found, and which elements it involves.
func resultDetail(r requirements.Result) string {
	parts := []string{}
	if r.Detail != "" {
		parts = append(parts, r.Detail)
	}
	if len(r.Elements) > 0 && !strings.Contains(r.Detail, "element") && !strings.HasPrefix(r.Detail, "differs") {
		nums := make([]string, len(r.Elements))
		for i, e := range r.Elements {
			nums[i] = strconv.Itoa(e)
		}
		word := "element "
		if len(nums) > 1 {
			word = "elements "
		}
		parts = append(parts, word+strings.Join(nums, ", "))
	}
	return strings.Join(parts, " · ")
}

// ticked is whether an element's Scores box is ticked: the coach's choice if
// they've made one, otherwise whether it's one of the highest that score.
// (The box's highlight says whether it actually scores.)
func ticked(rv skills.RoutineValidation, sv skills.SkillValidation) bool {
	if rv.ScoringChosen {
		return sv.Skill.Scores
	}
	return sv.Counted
}

// scoringFull says whether as many elements are ticked to score as may.
func scoringFull(rv skills.RoutineValidation) bool {
	n := 0
	for _, sv := range rv.Skills {
		if ticked(rv, sv) {
			n++
		}
	}
	return rv.ScoredElements > 0 && n >= rv.ScoredElements
}

// scoresTitle explains a Scores box that can't be ticked.
func scoresTitle(waiting bool) string {
	if waiting {
		return "As many score as may: untick one first"
	}
	return ""
}

// scoringElements are the elements (0-based) that score when only some do,
// so the page can start the coach's choice from them.
func scoringElements(rv skills.RoutineValidation) []int {
	out := []int{}
	if rv.ScoredElements == 0 {
		return out
	}
	for i, sv := range rv.Skills {
		if sv.Counted {
			out = append(out, i)
		}
	}
	return out
}

// differenceFrom compares this routine's difficulty with the other column's.
func differenceFrom(rv skills.RoutineValidation, other CompareSide) string {
	diff := rv.TotalTariff - other.Validation.TotalTariff
	switch {
	case diff > 0.005:
		return fmt.Sprintf("%.1f more than %s", diff, other.Name)
	case diff < -0.005:
		return fmt.Sprintf("%.1f less than %s", -diff, other.Name)
	}
	return "Same as " + other.Name
}

// alpine formats an Alpine expression; arguments are only ever ints.
func alpine(format string, args ...int) string {
	vals := make([]any, len(args))
	for i, a := range args {
		vals[i] = a
	}
	return fmt.Sprintf(format, vals...)
}

// cardTitle is "N. name", preferring the user's custom name.
func cardTitle(i int, s skills.TrampolineSkill) string {
	name := s.Name
	if s.CustomName != "" {
		name = s.CustomName
	}
	return fmt.Sprintf("%d. %s", i+1, name)
}

// firstOfRepeat says a card's skill is the first of a repeat: the one that
// counts (validation says "Duplicate (Counts Once)" of it).
func firstOfRepeat(message string) bool {
	return slices.Contains(strings.Split(message, " / "), "Duplicate (Counts Once)")
}

// cardMessage is element i's message in the same words as the tariff sheet
// and the competition pages (skills.ElementNote), and whether it's a
// problem: the first of a repeated skill counts, so it's only a note.
func cardMessage(i int, message string) (string, bool) {
	if message == "" {
		return "", false
	}
	problem := slices.ContainsFunc(strings.Split(message, " / "), func(m string) bool { return m != "Duplicate (Counts Once)" })
	return skills.ElementNote(i, message), problem
}

// tariffText is a tariff as every routine tool shows it: one decimal place,
// as the Code of Points' values are ("0.6", "5.8").
func tariffText(t float64) string {
	return fmt.Sprintf("%.1f", t)
}

// rotationText is a skill's somersault in words: "1¼ somersaults, backward".
func rotationText(s skills.TrampolineSkill) string {
	if s.Rotation == 0 {
		return somersaultText(0)
	}
	direction := "forward"
	if s.Backward {
		direction = "backward"
	}
	return somersaultText(s.Rotation) + ", " + direction
}

// twistText is a skill's twist in words, by somersault where it has more than
// one: "1 twist", "½ twist, then 1½ twists".
func twistText(s skills.TrampolineSkill) string {
	if s.TotalTwist() == 0 || len(s.TwistDistribution) <= 1 {
		return twistAmountText(s.TotalTwist())
	}
	parts := make([]string, len(s.TwistDistribution))
	for i, t := range s.TwistDistribution {
		parts[i] = strings.ToLower(twistAmountText(t))
	}
	return strings.ToUpper(parts[0][:1]) + parts[0][1:] + ", then " + strings.Join(parts[1:], ", then ")
}
