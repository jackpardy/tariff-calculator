package views

import (
	"fmt"
	"slices"
	"strconv"
	"strings"

	"tariffCalculator/requirements"
	"tariffCalculator/static"
)

// RequirementsPage lists the built-in requirement sets and the ones saved in
// this browser, and holds the set editor. Its script (static/js/requirements.js)
// manages the saved sets and opens them in the editor.
templ RequirementsPage(groups []requirements.BuiltinGroup) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Requirements</title>
			<meta name="app-version" content={ static.Version }/>
			<script defer src={ static.URL("js/version.js") }></script>
			<link rel="stylesheet" href={ static.URL("css/bulma.min.css") }/>
			<link rel="stylesheet" href={ static.URL("css/styles.css") }/>
			<script src={ static.URL("js/htmx.min.js") }></script>
			<script defer src={ static.URL("js/selectsearch.js") }></script>
			<script defer src={ static.URL("js/routines.js") }></script>
			<script defer src={ static.URL("js/sets.js") }></script>
			<script defer src={ static.URL("js/share.js") }></script>
			<script defer src={ static.URL("js/requirements.js") }></script>
			<script defer src={ static.URL("js/alpine.min.js") }></script>
			@templ.JSONScript("builtin-sets", builtinSets(groups))
			@templ.JSONScript("level-data", levelData(groups))
		</head>
		<body>
			<section class="section">
				<div class="container" x-data="requirementsPage()">
					<a class="is-size-7" href="/">← Routine Builder</a>
					<h1 class="title is-4 mt-1">Requirements</h1>
					<p class="mb-4">
						Requirements are the rules a routine is checked against: required or banned elements,
						how many elements and difficulty limits. Choose them for a routine under "Check against"
						in the Routine Builder. A level pairs requirements and set routines for a competition's
						two exercises, e.g. a choice of set routines and then a voluntary: open it in the
						Routine Builder's Levels mode.
					</p>
					// The editor, when a set is open.
					<div class="box" x-show="editing !== null" x-cloak>
						<div class="box-head editor-head">
							<h2 class="title is-5 mb-0" x-text="editing?.title"></h2>
							<div class="buttons mb-0">
								<button class="button is-primary is-small" type="button" x-on:click="saveEditing()">Save</button>
								<button class="button is-light is-small" type="button" x-on:click="closeEditor()">Close</button>
							</div>
						</div>
						<div id="editor-area" hx-sync="this:replace"></div>
						// Requirements written for one of the level's exercises,
						// under it (writeForLevel in static/js/requirements.js).
						<div class="level-writer" x-show="levelWriting" x-cloak>
							<h3 class="title is-6 mb-1" x-text="levelWriting?.title"></h3>
							<p class="matcher-hint mb-3">Saved into this level. Tick below to keep them in Your requirements too, to use in other levels or check routines against.</p>
							<div id="level-write-area"></div>
							<label class="checkbox mt-3">
								<input type="checkbox" x-model="levelKeepToo"/>
								Also keep them in Your requirements
							</label>
							<div class="buttons mt-3 mb-0">
								<button class="button is-primary is-small" type="button" x-on:click="saveForLevel()">Use in this level</button>
								<button class="button is-text is-small" type="button" x-on:click="cancelForLevel()">Cancel</button>
							</div>
						</div>
					</div>
					<div class="box">
						<div class="box-head">
							<h2 class="title is-5 mb-0">Your levels</h2>
							<div class="buttons mb-0">
								<button class="button is-primary is-small" type="button" x-on:click="newLevel()">+ New</button>
							</div>
						</div>
						<p class="has-text-grey" x-show="levels.length === 0">None yet. Start a new one, or duplicate a built-in one.</p>
						<ul class="set-list">
							<template x-for="l in levels" x-bind:key="l.id">
								<li class="set-item">
									<div>
										<p class="set-name"><span x-text="l.level.name"></span><span class="ml-1" x-show="l.kept" title="Kept on your page: on any phone, and safe if this browser forgets it">@StateChip(Done, "On your page")</span></p>
										<p class="set-description" x-show="l.level.description" x-text="l.level.description"></p>
										<ul class="level-exercises">
											<template x-for="(line, i) in exerciseLines(l.level)" x-bind:key="i">
												<li x-text="line"></li>
											</template>
										</ul>
										<p class="set-meta" x-show="l.level.source" x-text="l.level.source"></p>
									</div>
									<div class="buttons are-small mb-0">
										<button class="button is-small" type="button" x-on:click="editLevel(l.id)">Edit</button>
										<button class="button is-small" type="button" x-on:click="duplicateLevel(l.level)">Duplicate</button>
										<button class="button is-small" type="button" x-on:click="Share.open('sets', [l.id])">Share</button>
										// A personal page saved in this browser keeps it (ADR 0013).
										<template x-for="p in personLinks" x-bind:key="p.url">
											<button class="button is-small" type="button" x-show="!l.kept" x-on:click="keepOnPage(p, 'level', l)" x-text="personLinks.length > 1 ? `Save to my page: ${p.name}` : 'Save to my page'"></button>
										</template>
										<button class="button is-small is-danger is-outlined" type="button" x-on:click="removeLevel(l.id)">Delete</button>
									</div>
								</li>
							</template>
						</ul>
					</div>
					<div class="box">
						<div class="box-head">
							<h2 class="title is-5 mb-0">Your set routines</h2>
							<div class="buttons mb-0">
								<button class="button is-primary is-small" type="button" x-on:click="makingSetRoutine = !makingSetRoutine">+ New set routine</button>
							</div>
						</div>
						// A set routine is built, not written: in the Routine Builder, or from a routine already built.
						<div class="import-panel" x-show="makingSetRoutine" x-cloak>
							<p class="mb-2">
								Build it like any routine in the <a href="/">Routine Builder</a>, then choose
								<strong>More → Save as a set routine</strong>.
							</p>
							<template x-if="routines.length > 0">
								<div class="set-routine-from">
									<span class="is-size-7">Or use a routine you've built:</span>
									<div class="select is-small">
										<select aria-label="Routine to make a set routine of" x-model="fromRoutine">
											<option value="">Choose a routine...</option>
											<template x-for="r in routines.filter((r) => r.skills.length > 0)" x-bind:key="r.id">
												<option x-bind:value="r.id" x-text="`${r.name} (${r.skills.length})`"></option>
											</template>
										</select>
									</div>
									<input class="input is-small" type="text" maxlength="60" placeholder="Name, e.g. Club L1" x-model="setRoutineName"/>
									<button class="button is-small is-primary" type="button" x-bind:disabled="!fromRoutine" x-on:click="saveFromRoutine()">Save as a set routine</button>
								</div>
							</template>
						</div>
						<p class="has-text-grey" x-show="setRoutines().length === 0">None yet. Build one, or copy a built-in one below.</p>
						<ul class="set-list">
							<template x-for="s in setRoutines()" x-bind:key="s.id">
								<li class="set-item">
									<div>
										<p class="set-name"><span x-text="s.set.name"></span><span class="ml-1" x-show="s.kept" title="Kept on your page: on any phone, and safe if this browser forgets it">@StateChip(Done, "On your page")</span></p>
										<p class="set-meta" x-show="s.set.source" x-text="s.set.source"></p>
										<details class="set-rules">
											<summary x-text="`${elementsOf(s.set).length} elements`"></summary>
											<ol>
												<template x-for="(text, i) in elementsOf(s.set)" x-bind:key="i">
													<li x-text="text"></li>
												</template>
											</ol>
										</details>
									</div>
									<div class="buttons are-small mb-0">
										<a class="button is-small" x-bind:href="`/?setRoutine=${s.id}`">Edit in the Routine Builder</a>
										<button class="button is-small" type="button" x-on:click="Share.open('sets', [s.id])">Share</button>
										// A personal page saved in this browser keeps it (ADR 0013).
										<template x-for="p in personLinks" x-bind:key="p.url">
											<button class="button is-small" type="button" x-show="!s.kept" x-on:click="keepOnPage(p, 'set', s)" x-text="personLinks.length > 1 ? `Save to my page: ${p.name}` : 'Save to my page'"></button>
										</template>
										<button class="button is-small is-danger is-outlined" type="button" x-on:click="remove(s.id)">Delete</button>
									</div>
								</li>
							</template>
						</ul>
					</div>
					<div class="box">
						<div class="box-head">
							<h2 class="title is-5 mb-0">Your requirements</h2>
							<div class="buttons mb-0">
								<button class="button is-primary is-small" type="button" x-on:click="newSet()">+ New</button>
								<button class="button is-small" type="button" x-on:click="importing = !importing">Import</button>
							</div>
						</div>
						<div class="import-panel" x-show="importing" x-cloak>
							<p class="is-size-7 mb-2">Paste requirements someone shared, or choose a .json file.</p>
							<textarea class="textarea is-small" rows="4" x-model="importText" placeholder="Paste requirements here"></textarea>
							<div class="buttons mt-2">
								<button class="button is-small is-primary" type="button" x-on:click="importPasted()">Open pasted requirements</button>
								<label class="button is-small">
									Choose file
									<input type="file" accept=".json,application/json" class="is-hidden" x-on:change="importFile($event)"/>
								</label>
							</div>
						</div>
						<p class="has-text-grey" x-show="requirementSets().length === 0">None yet. Start new ones, duplicate built-in ones, or import some.</p>
						<ul class="set-list">
							<template x-for="s in requirementSets()" x-bind:key="s.id">
								<li class="set-item">
									<div>
										<p class="set-name"><span x-text="s.set.name"></span><span class="ml-1" x-show="s.kept" title="Kept on your page: on any phone, and safe if this browser forgets it">@StateChip(Done, "On your page")</span></p>
										<p class="set-meta" x-show="s.set.source" x-text="s.set.source"></p>
										<details class="set-rules" x-show="s.described?.length">
											<summary x-text="rulesCount(s.set)"></summary>
											<ul>
												<template x-for="(text, i) in s.described" x-bind:key="i">
													<li x-text="text"></li>
												</template>
											</ul>
										</details>
										<p class="set-meta" x-show="!s.described?.length" x-text="rulesCount(s.set)"></p>
									</div>
									<div class="buttons are-small mb-0">
										<button class="button is-small" type="button" x-on:click="edit(s.id)">Edit</button>
										<button class="button is-small" type="button" x-on:click="duplicate(s.set)">Duplicate</button>
										<button class="button is-small" type="button" x-on:click="Share.open('sets', [s.id])">Share</button>
										<button class="button is-small" type="button" x-on:click="exportSet(s.set)">Export</button>
										// A coach's page saved in this browser takes them as a club level (ADR 0011).
										<template x-for="c in coachLinks" x-bind:key="c.url">
											<button class="button is-small" type="button" x-on:click="saveToClub(c, s)" x-text="coachLinks.length > 1 ? `Save to club levels: ${c.name}` : 'Save to club levels'"></button>
										</template>
										// A personal page saved in this browser keeps it (ADR 0013).
										<template x-for="p in personLinks" x-bind:key="p.url">
											<button class="button is-small" type="button" x-show="!s.kept" x-on:click="keepOnPage(p, 'set', s)" x-text="personLinks.length > 1 ? `Save to my page: ${p.name}` : 'Save to my page'"></button>
										</template>
										<button class="button is-small is-danger is-outlined" type="button" x-on:click="remove(s.id)">Delete</button>
									</div>
								</li>
							</template>
						</ul>
					</div>
					<div class="box">
						<h2 class="title is-5">Built-in levels</h2>
						<p class="is-size-7 has-text-grey mb-3">Each pairs a level's built-in requirements for its two exercises. Duplicate one to adjust it.</p>
						for _, g := range groups {
							if len(g.Levels) > 0 {
								@builtinLevelGroup(g)
							}
						}
					</div>
					<div class="box">
						<h2 class="title is-5">Built-in requirements</h2>
						<p class="is-size-7 has-text-grey mb-3">Drafted from each organisation's published rules, which name their source. Rules change, so check them against the current rules; duplicate one to adjust it.</p>
						for _, g := range groups {
							if sets := g.Requirements(); len(sets) > 0 {
								@builtinGroup(g.Name, sets)
							}
						}
					</div>
					// Set (prescribed) routines, by source.
					<div class="box">
						<h2 class="title is-5">Set routines</h2>
						<p class="is-size-7 has-text-grey mb-3">Prescribed routines. Start a routine from one with "Start from a set..." in the Routine Builder, or see them in a level.</p>
						for _, g := range groups {
							if routines := g.SetRoutines(); len(routines) > 0 {
								@builtinGroup(g.Name, routines)
							}
						}
					</div>
					<div x-show="toast" x-transition class="notification is-info is-fixed-bottom-right" x-cloak>
						<span x-text="toast"></span>
					</div>
				</div>
			</section>
		</body>
	</html>
}


// builtinSets maps built-in set IDs to their sets, for duplicating one in the browser.
func builtinSets(groups []requirements.BuiltinGroup) map[string]requirements.Set {
	out := map[string]requirements.Set{}
	for _, g := range groups {
		for _, b := range g.Sets {
			out[b.ID] = b.Set
		}
	}
	return out
}

// CheckOption is a voluntary's requirements, as "Check against" offers them.
type CheckOption struct {
	Ref   string // "builtin:<id>"
	Label string
}

// CheckOptions are the requirements a group's voluntaries are checked
// against, level by level: named after the level when its voluntaries share
// requirements ("BUCS L7"), and by exercise when the two differ ("BUCS L1 ·
// first exercise"). Set routines aren't requirements to check against.
// Requirements shared by several levels are listed once, by their own name,
// which covers them all ("BG Regional L4 13+ · first exercise").
func CheckOptions(g requirements.BuiltinGroup) []CheckOption {
	var out []CheckOption
	seen := map[string]bool{}
	levelsUsing := map[string]int{}
	for _, l := range g.Levels {
		used := map[string]bool{}
		for n := 1; n <= 2; n++ {
			for _, ref := range l.Level.Exercise(n).Options {
				used[ref] = true
			}
		}
		for ref := range used {
			levelsUsing[ref]++
		}
	}
	for _, l := range g.Levels {
		type voluntary struct {
			ref      string
			exercise int
		}
		var vols []voluntary
		for n := 1; n <= 2; n++ {
			for _, ref := range l.Level.Exercise(n).Options {
				set, ok := requirements.LookupBuiltin(ref)
				if _, isSetRoutine := requirements.SetRoutine(set); !ok || isSetRoutine || slices.ContainsFunc(vols, func(v voluntary) bool { return v.ref == ref }) {
					continue
				}
				vols = append(vols, voluntary{ref, n})
			}
		}
		for _, v := range vols {
			if seen[v.ref] {
				continue
			}
			seen[v.ref] = true
			label := l.Level.Name
			if len(vols) > 1 {
				label += " · " + exerciseName(v.exercise) + " exercise"
			}
			if levelsUsing[v.ref] > 1 {
				set, _ := requirements.LookupBuiltin(v.ref)
				label = set.Name
			}
			out = append(out, CheckOption{Ref: v.ref, Label: label})
		}
	}
	// Requirements no level uses, by their own names.
	for _, b := range g.Requirements() {
		if !seen[requirements.BuiltinPrefix+b.ID] {
			out = append(out, CheckOption{Ref: requirements.BuiltinPrefix + b.ID, Label: b.Set.Name})
		}
	}
	return out
}

// LevelData is what a page needs to offer levels: each built-in level by
// reference ("builtin-level:<id>"), and the names of built-in requirements by
// reference ("builtin:<id>") and which are set routines, for a level's tabs.
type LevelData struct {
	Levels      map[string]requirements.Level `json:"levels"`
	Names       map[string]string             `json:"names"`
	SetRoutines []string                      `json:"set_routines"`
}

func levelData(groups []requirements.BuiltinGroup) LevelData {
	data := LevelData{Levels: map[string]requirements.Level{}, Names: map[string]string{}, SetRoutines: []string{}}
	for _, g := range groups {
		for _, l := range g.Levels {
			data.Levels[requirements.BuiltinLevelPrefix+l.ID] = l.Level
		}
		for _, b := range g.Sets {
			data.Names[requirements.BuiltinPrefix+b.ID] = b.Set.Name
			if b.IsSetRoutine() {
				data.SetRoutines = append(data.SetRoutines, requirements.BuiltinPrefix+b.ID)
			}
		}
	}
	return data
}

// SetEditorData is the requirement set being edited.
type SetEditorData struct {
	Set      requirements.Set
	JSON     string   // the set as it would be saved
	Problems []string // what's wrong with it, if anything
	// Conflicts are rules that can't be met, alone or together
	// (requirements.Conflicts). They're warnings: the set can still be saved.
	Conflicts []string
	// Club is set when the editor writes one of a club's levels, on the
	// coach's page; nil on the Requirements page.
	Club *ClubEditor
	// Routine is the routine on screen, when the editor is beside it in the
	// Routine Builder (its skills' JSON, posted back each time); Results are
	// how it does against each rule, by index, while the set can be read.
	Routine string
	Results map[int]requirements.Result
	// OpenRule is the rule open in a club level's editor, where lines are
	// folded: the one just added as another kind of rule; -1 for none.
	OpenRule int
}

// ClubEditor is what the editor needs to write a club's level (ADR 0011
// Decision 5): where it posts as it changes and where Save posts, the kinds
// of rule a level can track, and the club's own named skills to pick.
type ClubEditor struct {
	Endpoint string // the coach's level editor, posted on every change
	Save     string // where Save level posts the level
	Back     string // the Levels page
	Picks    []requirements.Pick
	// Own are the club's own skills to track (not trampoline skills), for a
	// rule of one of them (requirements.Track).
	Own []ClubThing
}

// ClubThing is one of a club's own skills to track, as the editor offers it.
type ClubThing struct{ ID, Name string }

// ownName is one of the club's own skills' name, by id; "" if it isn't one.
func (e *SetEditorData) ownName(id string) string {
	if e.Club != nil {
		for _, c := range e.Club.Own {
			if c.ID == id {
				return c.Name
			}
		}
	}
	return ""
}

// ruleTitle is a rule in words, heading its card: one of the club's own
// skills by its name.
func (e *SetEditorData) ruleTitle(rule requirements.Rule) string {
	if name := e.ownName(rule.Item); rule.Type == requirements.Track && strings.TrimSpace(rule.Label) == "" && name != "" {
		return name
	}
	// On a club's level, a skill on its list is just its name.
	if e.Club != nil && strings.TrimSpace(rule.Label) == "" && rule.Match != nil && requirements.KindOfRule(rule) == "include" {
		return requirements.Capitalise(requirements.DescribeMatcher(*rule.Match))
	}
	return describeSafely(rule)
}

// endpoint is where the editor posts as it changes.
func (e *SetEditorData) endpoint() string {
	if e.Club != nil {
		return e.Club.Endpoint
	}
	return "/requirements/editor"
}

// picks are what the editor offers to describe skills: the club's own
// named skills first, on a club's level.
func (e *SetEditorData) picks() []requirements.Pick {
	if e.Club != nil {
		return slices.Concat(e.Club.Picks, requirements.Picks())
	}
	return requirements.Picks()
}

// SetEditor is the editor form for one requirement set. Every change posts the
// form to /requirements/editor, which re-renders it; data-set-json carries the
// set as it would be saved.
templ SetEditor(e SetEditorData) {
	<form
		id="set-editor"
		class="set-editor"
		hx-post={ e.endpoint() }
		hx-trigger="change"
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="this:replace"
		data-set-json={ e.JSON }
		data-problems={ strconv.Itoa(len(e.Problems)) }
		data-described={ templ.JSONString(describedRules(e.Set)) }
		x-on:submit.prevent
		if e.Club != nil {
			action={ templ.SafeURL(e.Club.Save) }
			method="post"
		}
	>
		<div class="field">
			<label class="label is-small" for="set-name">Name</label>
			<input class="input" id="set-name" name="name" value={ e.Set.Name } placeholder="e.g. Student novice 2026–27"/>
		</div>
		// A club's level is a list of skills: no description, source or scoring.
		if e.Club == nil {
		<div class="field">
			<label class="label is-small" for="set-description">Description (optional)</label>
			<input class="input is-small" id="set-description" name="description" value={ e.Set.Description }/>
		</div>
		<div class="field">
			<label class="label is-small" for="set-source">Source (optional)</label>
			<input class="input is-small" id="set-source" name="source" value={ e.Set.Source } placeholder="e.g. Competition handbook, September 2026"/>
		</div>
		// How routines checked against the set are scored; routines can still change it.
		<div class="field set-scoring">
			<label class="checkbox">
				<input type="checkbox" name="no_difficulty" value="1" checked?={ e.Set.NoDifficulty }/>
				Difficulty isn't scored
			</label>
			<label class="checkbox">
				<input type="checkbox" name="repeats_allowed" value="1" checked?={ e.Set.RepeatsAllowed }/>
				Elements may be repeated
			</label>
			<label class="scored-elements">
				Only
				<input class="input is-small scored-input" type="number" inputmode="numeric" min="0" max="10" name="scored_elements" value={ scoredText(e.Set.ScoredElements) } placeholder="all"/>
				elements score difficulty
			</label>
			<p class="matcher-hint">Unless elements may be repeated, a repeated element is flagged and scores no difficulty (§14). The first two are usual for set (compulsory) routines; AG3 first exercises score 2 elements.</p>
		</div>
		}
		<input type="hidden" name="rules" value={ strconv.Itoa(len(e.Set.Rules)) }/>
		if e.Routine != "" {
			<input type="hidden" name="routineData" value={ e.Routine }/>
		}
		for i, rule := range e.Set.Rules {
			@ruleCard(&e, i, rule, len(e.Set.Rules))
		}
		// A club's level is mostly a list of skills: each picked here is a line
		// of its own, ticked off on its own.
		if e.Club != nil {
			<div class="field">
				<label class="label is-small" for="add-pick">Add a skill</label>
				<div class="select is-small">
					<select id="add-pick" name="addpick" data-search-select="Search to add, e.g. seat drop or a drill">
						<option value="">Choose a skill to add...</option>
						if len(e.Club.Own) > 0 {
							<optgroup label="Your club's own skills (not trampoline skills)">
								for _, c := range e.Club.Own {
									<option value={ "own:" + c.ID }>{ c.Name }</option>
								}
							</optgroup>
						}
						for _, g := range pickGroups(e.picks()) {
							<optgroup label={ g.name }>
								for _, p := range g.picks {
									<option value={ p.ID }>{ p.Label }</option>
								}
							</optgroup>
						}
					</select>
				</div>
				<p class="help">Each one you pick is a line of its own. Add as many as the level needs, in any mix with the rules below.</p>
			</div>
		}
		<div class="field">
			<label class="label is-small" for="add-rule">
				if e.Club != nil {
					Or add another kind of rule
				} else {
					Add a rule
				}
			</label>
			<div class="select is-small">
				<select id="add-rule" name="add">
					<option value="">Choose a kind of rule...</option>
					for _, k := range editorKinds(&e, "") {
						<option value={ k.ID }>{ k.Label }</option>
					}
				</select>
			</div>
		</div>
		if len(e.Conflicts) > 0 {
			<div class="notification is-danger is-light set-conflicts">
				<p class="has-text-weight-semibold">These can't all be met:</p>
				<ul>
					for _, c := range e.Conflicts {
						<li>{ c }</li>
					}
				</ul>
				<p class="is-size-7 mt-2">No routine could meet these requirements as they stand. You can still save them.</p>
			</div>
		}
		if len(e.Problems) > 0 {
			<div class="notification is-warning is-light set-problems">
				<p class="has-text-weight-semibold">Fix before saving:</p>
				<ul>
					for _, p := range e.Problems {
						<li>{ p }</li>
					}
				</ul>
			</div>
		}
		if e.Club != nil {
			<div class="buttons mt-4">
				<button class="button is-primary" type="submit">Save level</button>
				<a class="button is-text" href={ templ.SafeURL(e.Club.Back) }>Cancel</a>
			</div>
		}
	</form>
}

templ ruleCard(e *SetEditorData, i int, rule requirements.Rule, total int) {
	{{ p := fmt.Sprintf("r%d.", i) }}
	{{ kind := requirements.KindOfRule(rule) }}
	<div class="rule-card">
		<div class="rule-card-head">
			<p class="rule-card-title">
				{ fmt.Sprintf("%d. ", i+1) }{ e.ruleTitle(rule) }
				// Beside the routine: whether it meets this rule as it stands.
				if res, ok := e.Results[i]; ok {
					if res.Passed {
						@StateChip(Done, "Met")
					} else {
						@StateChip(Attention, "Not met")
					}
					if res.Detail != "" {
						<span class="is-size-7 has-text-grey has-text-weight-normal">{ res.Detail }</span>
					}
				}
			</p>
			<div class="buttons are-small mb-0">
				@editorAction(e, "↑", fmt.Sprintf("up:%d", i), i == 0)
				@editorAction(e, "↓", fmt.Sprintf("down:%d", i), i == total-1)
				@editorAction(e, "Remove", fmt.Sprintf("delete:%d", i), false)
			</div>
		</div>
		// On a club's level, a line is folded to its name, with Change to open
		// it: a level is mostly a list of skills. Open ones stay open as the
		// editor redraws (ClubLevelEditor's script); one just added opens.
		if e.Club != nil {
			<details class="rule-card-body" data-rule={ strconv.Itoa(i) } open?={ e.OpenRule == i }>
				<summary class="is-size-7">Change</summary>
				@ruleBody(e, i, rule, p, kind)
			</details>
		} else {
			@ruleBody(e, i, rule, p, kind)
		}
	</div>
}

// ruleBody is a rule card's fields: its kind, wording, and what the kind needs.
templ ruleBody(e *SetEditorData, i int, rule requirements.Rule, p, kind string) {
	<input type="hidden" name={ p + "was" } value={ kind }/>
	<div class="rule-grid rule-kind">
		<div class="field">
			<label class="label is-small" for={ p + "type" }>Kind of rule</label>
			<div class="select is-small is-fullwidth">
				<select id={ p + "type" } name={ p + "type" }>
					for _, k := range editorKinds(e, kind) {
						<option value={ k.ID } selected?={ k.ID == kind }>{ k.Label }</option>
					}
				</select>
			</div>
		</div>
		<div class="field">
			<label class="label is-small" for={ p + "label" }>Wording (optional)</label>
			<input class="input is-small" id={ p + "label" } name={ p + "label" } value={ rule.Label } placeholder="e.g. A back somersault"/>
		</div>
	</div>
	switch rule.Type {
		case requirements.Count:
			switch kind {
				case "include":
					if e.Club != nil {
						@matcherFields(e, p+"m.", rule.Match, "The gymnast can do")
					} else {
						@matcherFields(e, p+"m.", rule.Match, "The routine must include")
					}
				case "exclude":
					@matcherFields(e, p+"m.", rule.Match, "The routine must not include")
				default:
					<div class="rule-grid">
						@numberField(p+"min", "At least", floatText(rule.Min), "1")
						@numberField(p+"max", "At most (0 = not allowed)", floatText(rule.Max), "1")
					</div>
					@matcherFields(e, p+"m.", rule.Match, "Skills that count")
			}
		case requirements.Linked:
			<p class="matcher-hint mb-2">Counts pairs of these elements performed one straight after another, e.g. linked somersaults. Three in a row are two pairs.</p>
			<div class="rule-grid">
				@numberField(p+"min", "At least (pairs)", floatText(rule.Min), "1")
				@numberField(p+"max", "At most (0 = none linked)", floatText(rule.Max), "1")
			</div>
			@matcherFields(e, p+"m.", rule.Match, "Skills that count")
		case requirements.Every:
			@matcherFields(e, p+"m.", rule.Match, "Every skill must be")
		case requirements.Elements:
			<div class="rule-grid">
				@numberField(p+"min", "At least", floatText(rule.Min), "1")
				@numberField(p+"max", "At most", floatText(rule.Max), "1")
			</div>
		case requirements.Difficulty:
			<div class="rule-grid">
				@numberField(p+"min", "At least", floatText(rule.Min), "0.1")
				@numberField(p+"max", "At most", floatText(rule.Max), "0.1")
				@numberField(p+"cap", "Each element counts at most", floatText(rule.Cap), "0.1")
			</div>
		case requirements.Position:
			<div class="rule-grid">
				@numberField(p+"position", "Element number", strconv.Itoa(rule.Position), "1")
			</div>
			@matcherFields(e, p+"m.", rule.Match, "That skill must be")
		case requirements.Sequence:
			// A set routine is built in the Routine Builder, not written here.
			<p class="matcher-hint mb-2">This is a set routine. Its elements are built in the Routine Builder: save these requirements, then use "Edit in the Routine Builder" under Your set routines.</p>
			<ol class="set-routine-elements">
				for _, m := range rule.Sequence {
					<li>{ requirements.DescribeMatcher(m) }</li>
				}
			</ol>
			<input type="hidden" name={ p + "seqjson" } value={ templ.JSONString(rule.Sequence) }/>
		case requirements.Separate:
			<p class="matcher-hint mb-2">Each requirement must be met by a different element, as with the starred (*) elements on a competition card.</p>
			<input type="hidden" name={ p + "seq" } value={ strconv.Itoa(len(rule.Each)) }/>
			for j, m := range rule.Each {
				@itemFields(e, fmt.Sprintf("%ss%d.", p, j), &m, fmt.Sprintf("Requirement %d", j+1), "e.g. Landing on the front")
				<div class="buttons are-small">
					@editorAction(e, fmt.Sprintf("Remove requirement %d", j+1), fmt.Sprintf("delete-element:%d:%d", i, j), len(rule.Each) == 1)
				</div>
			}
			<div class="buttons are-small">
				@editorAction(e, "+ Add requirement", fmt.Sprintf("add-element:%d", i), false)
			</div>
		case requirements.Track:
			// One of the club's own skills, which no routine shows: chosen
			// from the club's list, or kept as it is where there's none.
			if e.Club != nil && len(e.Club.Own) > 0 {
				<div class="field">
					<label class="label is-small" for={ p + "item" }>Which of your club's skills</label>
					<div class="select is-small">
						<select id={ p + "item" } name={ p + "item" }>
							for _, c := range e.Club.Own {
								<option value={ c.ID } selected?={ c.ID == rule.Item }>{ c.Name }</option>
							}
						</select>
					</div>
				</div>
			} else {
				<p class="matcher-hint mb-2">One of a club's own skills to track. Only the club's page tracks it; a routine isn't checked against it.</p>
				<input type="hidden" name={ p + "item" } value={ rule.Item }/>
			}
		case requirements.Includes:
			<p class="matcher-hint mb-2">These skills one straight after another: each a skill you pick, or a kind of skill (a back somersault, then a barani). Add another option for "or instead".</p>
			<input type="hidden" name={ p + "opts" } value={ strconv.Itoa(len(rule.Options)) }/>
			for k, option := range rule.Options {
				{{ op := fmt.Sprintf("%so%d.", p, k) }}
				<fieldset class="option-group">
					<legend>Option { strconv.Itoa(k + 1) }</legend>
					<input type="hidden" name={ op + "seq" } value={ strconv.Itoa(len(option)) }/>
					for j, m := range option {
						@itemFields(e, fmt.Sprintf("%ss%d.", op, j), &m, stepTitle(j), "e.g. ¾ somersault to front or back")
						<div class="buttons are-small">
							@editorAction(e, fmt.Sprintf("Remove %s", strings.ToLower(stepTitle(j))), fmt.Sprintf("delete-step:%d:%d:%d", i, k, j), len(option) == 1)
						</div>
					}
					<div class="buttons are-small">
						@editorAction(e, "+ Then another skill", fmt.Sprintf("add-step:%d:%d", i, k), false)
						@editorAction(e, fmt.Sprintf("Remove option %d", k+1), fmt.Sprintf("delete-option:%d:%d", i, k), len(rule.Options) == 1)
					</div>
				</fieldset>
			}
			<div class="buttons are-small">
				@editorAction(e, "+ Or instead", fmt.Sprintf("add-option:%d", i), false)
			</div>
		case requirements.Different:
			<p class="matcher-hint">No element may be repeated. Shapes count as different elements only where the Code of Points says they do (§14). Leaving "Elements may be repeated" unticked already flags repeats, so this rule only adds a line to the results.</p>
	}
}

// editorAction is a button that posts the editor with an action ("delete:2").
templ editorAction(e *SetEditorData, label, action string, disabled bool) {
	<button
		type="button"
		class="button is-small"
		disabled?={ disabled }
		hx-post={ e.endpoint() }
		hx-include="#set-editor"
		hx-target="#set-editor"
		hx-swap="outerHTML"
		hx-vals={ editorActionVals(action) }
	>{ label }</button>
}

templ numberField(name, label, value, step string) {
	<div class="field">
		<label class="label is-small" for={ name }>{ label }</label>
		<input class="input is-small" type="number" inputmode="decimal" min="0" step={ step } id={ name } name={ name } value={ value }/>
	</div>
}

// itemFields is one element of a set routine or one special requirement: its
// wording and which elements meet it.
templ itemFields(e *SetEditorData, prefix string, m *requirements.Matcher, title, placeholder string) {
	<div class="field mb-1">
		<label class="label is-small" for={ prefix + "label" }>{ title }: wording (optional)</label>
		<input class="input is-small" id={ prefix + "label" } name={ prefix + "label" } value={ m.Label } placeholder={ placeholder }/>
	</div>
	@matcherFields(e, prefix, m, title)
}

// matcherFields describes which skills a rule is about: picked, a skill or a
// kind of skill (requirements.Picks), or described field by field under
// "Or describe it", open for a description of the coach's own. Empty fields
// don't restrict. picked is the pick shown, so the form knows when a new one
// is chosen.
templ matcherFields(e *SetEditorData, prefix string, m *requirements.Matcher, title string) {
	{{
		if m == nil {
			m = &requirements.Matcher{}
		}
		base := *m
		base.Or = nil // its alternatives are picked below it
		picked := requirements.PickIn(e.picks(), base)
		alternative := strings.Contains(prefix, ".or")
		own := picked == "" && requirements.DescribeMatcher(requirements.Matcher{Rotation: m.Rotation, Direction: m.Direction, Twist: m.Twist, Shapes: m.Shapes, Takeoff: m.Takeoff, Landing: m.Landing, Tariff: m.Tariff, FIG: m.FIG}) != "any element"
	}}
	<fieldset class="matcher">
		<legend>{ title }: <span class="matcher-summary">{ requirements.DescribeMatcher(*m) }</span></legend>
		<div class="field matcher-pick">
			<label class="label is-small" for={ prefix + "pick" }>A skill, or a kind of skill</label>
			<div class="select is-small is-fullwidth">
				<select id={ prefix + "pick" } name={ prefix + "pick" } data-search-select="Search, e.g. barani or tuck jump">
					<option value="" selected?={ picked == "" }>
						if own {
							Your own description, below
						} else {
							Any skill
						}
					</option>
					for _, g := range pickGroups(e.picks()) {
						<optgroup label={ g.name }>
							for _, p := range g.picks {
								<option value={ p.ID } selected?={ p.ID == picked }>{ p.Label }</option>
							}
						</optgroup>
					}
				</select>
			</div>
			<input type="hidden" name={ prefix + "picked" } value={ picked }/>
		</div>
		<details class="matcher-describe" open?={ own }>
			<summary>Or describe it: somersault, twist, direction, shape</summary>
			<div class="rule-grid">
				@numberField(prefix+"rotmin", "Somersault at least (quarters)", rangeMin(m.Rotation), "1")
				@numberField(prefix+"rotmax", "Somersault at most (quarters)", rangeMax(m.Rotation), "1")
				@numberField(prefix+"twmin", "Twist at least (half twists)", rangeMin(m.Twist), "1")
				@numberField(prefix+"twmax", "Twist at most (half twists)", rangeMax(m.Twist), "1")
				<div class="field">
					<label class="label is-small" for={ prefix + "dir" }>Direction</label>
					<div class="select is-small is-fullwidth">
						<select id={ prefix + "dir" } name={ prefix + "dir" }>
							<option value="" selected?={ m.Direction == "" }>Either</option>
							<option value="forward" selected?={ m.Direction == "forward" }>Forward</option>
							<option value="backward" selected?={ m.Direction == "backward" }>Backward</option>
						</select>
					</div>
				</div>
			</div>
			@checkboxes(prefix+"shape", "Shape", []string{"tuck", "pike", "straight", "straddle"}, m.Shapes)
			// Less common conditions, shown when one is set.
			<details class="matcher-more" open?={ m.Tariff != nil || m.FIG != "" || len(m.Takeoff) > 0 || len(m.Landing) > 0 }>
				<summary>More conditions: tariff, FIG, take-off and landing</summary>
				<div class="rule-grid">
					@numberField(prefix+"tarmin", "Tariff at least", tariffMin(m.Tariff), "0.1")
					@numberField(prefix+"tarmax", "Tariff at most", tariffMax(m.Tariff), "0.1")
					<div class="field">
						<label class="label is-small" for={ prefix + "fig" }>FIG notation (exact)</label>
						<input class="input is-small" id={ prefix + "fig" } name={ prefix + "fig" } value={ m.FIG } placeholder="e.g. 4 1 o"/>
					</div>
				</div>
				@checkboxes(prefix+"takeoff", "Takes off from", []string{"feet", "front", "back", "seat"}, m.Takeoff)
				@checkboxes(prefix+"landing", "Lands on", []string{"feet", "front", "back", "seat"}, m.Landing)
			</details>
			<p class="matcher-hint">4 quarters = 1 somersault; 2 half twists = 1 twist. Leave a field empty to allow anything.</p>
		</details>
		// Other skills that count too, which needn't fit the same description.
		if !alternative {
			<input type="hidden" name={ prefix + "ors" } value={ strconv.Itoa(len(m.Or)) }/>
			for k, alt := range m.Or {
				<div class="matcher-or">
					@matcherFields(e, fmt.Sprintf("%sor%d.", prefix, k), &alt, "Or")
					<div class="buttons are-small mb-2">
						@editorAction(e, "Remove this one", fmt.Sprintf("or-del:%s:%d", prefix, k), false)
					</div>
				</div>
			}
			<div class="buttons are-small mb-0">
				@editorAction(e, "+ Or another skill", "or-add:"+prefix, false)
			</div>
		}
	</fieldset>
}

// pickGroup is a heading of picks in the editor, and its picks.
type pickGroup struct {
	name  string
	picks []requirements.Pick
}

// pickGroups are the editor's picks under their headings, in order.
func pickGroups(picks []requirements.Pick) []pickGroup {
	var out []pickGroup
	for _, p := range picks {
		if len(out) == 0 || out[len(out)-1].name != p.Group {
			out = append(out, pickGroup{name: p.Group})
		}
		out[len(out)-1].picks = append(out[len(out)-1].picks, p)
	}
	return out
}

templ checkboxes(name, label string, options, chosen []string) {
	<div class="field matcher-choices">
		<span class="label is-small">{ label }</span>
		for _, o := range options {
			<label class="checkbox">
				<input type="checkbox" name={ name } value={ o } checked?={ slices.Contains(chosen, o) }/>
				{ o }
			</label>
		}
	</div>
}

// stepTitle names skill j of a "this, then this" option: the first, then the next.
func stepTitle(j int) string {
	if j == 0 {
		return "Skill"
	}
	return fmt.Sprintf("Then skill %d", j+1)
}

// describedRules is each rule in plain English, saved with the set for its listing.
func describedRules(set requirements.Set) []string {
	out := make([]string, len(set.Rules))
	for i, r := range set.Rules {
		out[i] = describeSafely(r)
	}
	return out
}

// describeSafely describes a rule that may still be incomplete in the editor.
func describeSafely(r requirements.Rule) string {
	if (r.Type == requirements.Count || r.Type == requirements.Linked || r.Type == requirements.Every || r.Type == requirements.Position) && r.Match == nil {
		r.Match = &requirements.Matcher{}
	}
	if r.Type == requirements.Count && r.Min == nil && r.Max == nil {
		return "Elements that must (or mustn't) appear: give a minimum or maximum"
	}
	if r.Type == requirements.Linked && r.Min == nil && r.Max == nil {
		return "Linked elements: give a minimum or maximum"
	}
	return requirements.Describe(r)
}

// editorKinds are the kinds of rule the editor offers, by what they mean
// (requirements.RuleKinds), and a set routine where the rule already is one:
// set routines are built in the Routine Builder.
func editorKinds(e *SetEditorData, current string) []requirements.RuleKind {
	out := slices.Clone(requirements.RuleKinds)
	if e.Club != nil {
		out = slices.Clone(requirements.LevelKinds)
		// One of the club's own skills, where it has some to choose.
		if len(e.Club.Own) == 0 && current != requirements.Track {
			out = slices.DeleteFunc(out, func(k requirements.RuleKind) bool { return k.ID == requirements.Track })
		}
	} else if current == requirements.Track {
		out = append(out, requirements.RuleKind{ID: requirements.Track, Label: "One of a club's own skills"})
	}
	if current == requirements.Sequence {
		out = append(out, requirements.SetRoutineKind)
	}
	if current == requirements.Different {
		out = append(out, requirements.NoRepeatsKind)
	}
	return out
}

func editorActionVals(action string) string {
	return fmt.Sprintf(`{"action": %q}`, action)
}

func floatText(v *float64) string {
	if v == nil {
		return ""
	}
	return strconv.FormatFloat(*v, 'f', -1, 64)
}

func rangeMin(r *requirements.Range) string {
	if r == nil || r.Min == nil {
		return ""
	}
	return strconv.Itoa(*r.Min)
}

func rangeMax(r *requirements.Range) string {
	if r == nil || r.Max == nil {
		return ""
	}
	return strconv.Itoa(*r.Max)
}

func tariffMin(r *requirements.TariffRange) string {
	if r == nil {
		return ""
	}
	return floatText(r.Min)
}

func tariffMax(r *requirements.TariffRange) string {
	if r == nil {
		return ""
	}
	return floatText(r.Max)
}

// scoredText is a set's number of scoring elements for the editor; blank for all.
func scoredText(n int) string {
	if n == 0 {
		return ""
	}
	return strconv.Itoa(n)
}

// builtinGroup lists one source's built-in sets, folded away. A set routine
// lists its elements in order; other requirements, their rules.
templ builtinGroup(name string, sets []requirements.Builtin) {
	<details class="builtin-group">
		<summary>{ name } <span class="set-meta">· { strconv.Itoa(len(sets)) }</span></summary>
		<ul class="set-list">
			for _, b := range sets {
				<li class="set-item">
					<div>
						<p class="set-name">{ b.Set.Name }</p>
						if b.Set.Description != "" {
							<p class="set-description">{ b.Set.Description }</p>
						}
						if b.Set.Source != "" {
							<p class="set-meta">{ b.Set.Source }</p>
						}
						if routine, ok := requirements.SetRoutine(b.Set); ok {
							<details class="set-rules">
								<summary>{ strconv.Itoa(len(routine)) } elements</summary>
								<ol>
									for _, m := range setRoutineSteps(b.Set) {
										<li>{ m }</li>
									}
								</ol>
							</details>
						} else {
							<details class="set-rules">
								<summary>{ Count(len(b.Set.Rules), "rule", "rules") }</summary>
								<ul>
									for _, rule := range b.Set.Rules {
										<li>{ requirements.Describe(rule) }</li>
									}
								</ul>
							</details>
						}
					</div>
					<div class="buttons are-small mb-0">
						if b.IsSetRoutine() {
							<a class="button is-small" href={ templ.SafeURL("/?fromSet=" + requirements.BuiltinPrefix + b.ID) }>Copy to the Routine Builder</a>
						} else {
							<button class="button is-small" type="button" x-on:click={ fmt.Sprintf("duplicateBuiltin('%s')", b.ID) }>Duplicate</button>
						}
					</div>
				</li>
			}
		</ul>
	</details>
}

// setRoutineSteps are a set routine's elements in words, in order.
func setRoutineSteps(set requirements.Set) []string {
	for _, rule := range set.Rules {
		if rule.Type == requirements.Sequence {
			steps := make([]string, len(rule.Sequence))
			for i, m := range rule.Sequence {
				steps[i] = requirements.DescribeMatcher(m)
			}
			return steps
		}
	}
	return nil
}
