package views

// A gymnast entering on their own (ADR 0010): one personal page, like a club
// member's without the club. Competitions lists the competitions they've
// entered, each with a page that has a row per discipline; Your details has
// their link and their other links.

// GymnastPage is one of an individual's own pages.
type GymnastPage struct {
	Name         string
	Menu         []MenuSection
	Home         string // the competitions list, their default page
	Link         string // their personal link, as a full URL; "" when opened through another of their links
	Notice       string
	Competitions []GymnastCompetition // the list
	Competition  *GymnastCompetition  // the one competition's page shows
	Other        *OtherLinks          // on their details
	Kept         KeptPart             // their own requirements and levels, on Requirements (ADR 0013)
	Enter        *GymnastEnter        // entering another discipline
}

// GymnastEnter enters another discipline of a competition an individual has
// entered, under their name.
type GymnastEnter struct {
	Back        string // their page for the competition
	Competition CompetitionSummary
	Form        *EntryForm      // nil for a discipline they've entered already
	Disciplines []DisciplineTab // those not entered yet, as tabs when there are several
	Entered     []DisciplineTab // those entered, each opening its entry on Back
	Already     *DisciplineTab  // the discipline asked for, entered already
}

// GymnastCompetition is one competition an individual entered, with their
// entry for each discipline.
type GymnastCompetition struct {
	Page        string // their page for it
	Competition CompetitionSummary
	Status      string // e.g. "2 entries"
	Problems    int    // on their entries' cards, for the list's chip
	Events      []GymnastEvent
	Day         string // their My competition page
	Enter       string // where to enter another discipline, while entries are open
	MyLinks            // hearing about changes, desk messages and their duties
	Pairs       []PairView // synchro entries they're the partner in
	Saved       bool       // an entry was just saved
}

// GymnastEvent is an individual's entry for one discipline, as a row that
// opens to everything about it: its card, changing and withdrawing it, their
// coach, fees and what they offer.
type GymnastEvent struct {
	Row   MemberEvent // the row: discipline, level and status
	Open  bool        // shown open: the one asked for, or a save had problems
	Entry EntryPage
}

// gymnastFrame is the top of each of an individual's pages.
templ gymnastFrame(p GymnastPage) {
	@competitionLayout(p.Name + " · entered on their own") {
		<p class="has-text-grey mb-1">Entered on your own</p>
		<h1 class="title is-4">{ p.Name }</h1>
		@pageMenu(p.Menu)
		if p.Link != "" {
			// Saves their link in this browser (static/js/competitions.js).
			<span hidden data-gymnast-link={ p.Link } data-gymnast-name={ p.Name }></span>
		}
		if p.Notice != "" {
			@notice(p.Notice)
		}
		{ children... }
	}
}

// GymnastHome is an individual's default page: the competitions they entered.
templ GymnastHome(p GymnastPage) {
	@gymnastFrame(p) {
		if len(p.Competitions) == 0 {
			@emptyLine("No entries now. To enter a competition, open the entry link its organiser shared and give this page's link there.")
		}
		for _, c := range p.Competitions {
			<a class="box comp-member-row" href={ templ.SafeURL(c.Page) }>
				<strong>{ c.Competition.Name }</strong>
				<span class="is-block has-text-grey is-size-7">{ c.Competition.Date }</span>
				<span class="is-block is-size-7">
					{ c.Status }
					if c.Problems > 0 {
						@StateChip(Attention, Count(c.Problems, "problem", "problems"))
					}
					if c.Timeline != "" {
						@StateChip(Done, "Timetable published")
					}
					if len(c.Desk) > 0 {
						@StateChip(Attention, "Message from the organisers")
					}
				</span>
			</a>
		}
		<p class="help">Entering another competition? Open its entry link and give this page's link there, so the entry joins this page.</p>
	}
}

// GymnastCompetitionPage is an individual's page for one competition: a row
// for each discipline they entered, opening to all of that entry, as a
// member's page has (an entry's own link opens this page at its row).
templ GymnastCompetitionPage(p GymnastPage) {
	@gymnastFrame(p) {
		@backLink(p.Home, "Competitions")
		if c := p.Competition; c != nil {
			if c.Saved && p.Link != "" {
				<div class="notification is-success is-light">
					<p class="mb-2"><strong>Entry saved.</strong> Your personal link opens this entry and every other you make with it: keep it to change or withdraw them. It's saved in this browser too.</p>
					@linkBox("Your personal link (keep it to yourself)", p.Link, "")
				</div>
			} else if c.Saved {
				<div class="notification is-success is-light"><p><strong>Entry saved.</strong> It's on your page with your other entries.</p></div>
			}
			<h2 class="title is-5">{ c.Competition.Name }</h2>
			@competitionFacts(c.Competition)
			@dayLink(c.Day)
			@deskMessages(c.Desk)
			// The timetables and calendars are on My competition; hearing about changes is here too.
			@timelineLinks("", "", c.Notify, "", "")
			@dutiesBox(c.Duties, c.ScoreSheets)
			for _, ev := range c.Events {
				<details class="box comp-event-row" open?={ ev.Open }>
					<summary>
						@memberEventRow(ev.Row)
					</summary>
					<div class="mt-3">
						@entryBody(entryUnder(ev.Entry, 4))
					</div>
				</details>
			}
			@pairEntries(c.Pairs)
			if c.Enter != "" {
				<a class="button" href={ templ.SafeURL(c.Enter) }>Enter another discipline</a>
			}
			if c.Competition.ChangesOpen {
				@privacyNote(c.Competition)
			}
		}
	}
}

// GymnastEnterPage is entering another discipline, from an individual's page
// for the competition and back to it.
templ GymnastEnterPage(p GymnastPage) {
	@gymnastFrame(p) {
		if e := p.Enter; e != nil {
			@backLink(e.Back, e.Competition.Name)
			<h2 class="title is-5">Enter another discipline</h2>
			if e.Already != nil {
				<div class="notification is-warning is-light">
					{ "You've already entered " + e.Already.Name + " here." }
					<a href={ templ.SafeURL(e.Already.URL) }>Change that entry →</a>
				</div>
			}
			if len(e.Entered) > 0 {
				<p class="mb-3 is-size-7">
					Entered already, to change on the competition's page:
					for i, d := range e.Entered {
						if i > 0 {
							{ ", " }
						}
						<a href={ templ.SafeURL(d.URL) }>{ d.Name + " →" }</a>
					}
				</p>
			}
			if !e.Competition.Open {
				<p class="has-text-grey">Entries are closed.</p>
			} else if len(e.Disciplines) == 0 {
				<p class="has-text-grey">You've entered every discipline this competition has.</p>
			} else {
				if len(e.Disciplines) > 1 {
					<div class="tabs is-small">
						<ul>
							for _, d := range e.Disciplines {
								<li class={ templ.KV("is-active", d.Current) }><a href={ templ.SafeURL(d.URL) }>{ d.Name }</a></li>
							}
						</ul>
					</div>
				}
				if e.Form != nil {
					@entryForm(*e.Form)
					@privacyNote(e.Competition)
				}
			}
		}
	}
}

// GymnastDetails is an individual's details: their link and their other links.
templ GymnastDetails(p GymnastPage) {
	@gymnastFrame(p) {
		if p.Link != "" {
			@linkBox("Your personal link (keep it to yourself)", p.Link, "Open it on any phone or computer to see your entries. Anyone who has it can change them.")
		}
		if p.Other != nil {
			@otherLinksBox(*p.Other)
		}
	}
}
