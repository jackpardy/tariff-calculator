package views

import (
	"slices"
	"strconv"
)

// DelayPage is the organiser's "what if there's a delay": which areas are
// held up, from when, for how long, and what it does to the day.
type DelayPage struct {
	Base        string
	Competition CompetitionSummary
	Days        []FlightOption // value: the day's index
	AllAreas    []string
	// The delay asked about, as given.
	Day, From, Minutes string
	Areas              []string // none for every area
	// How the organiser would ease it, as given.
	Breaks, Shorten, Between, Quicker, MaxFlight, Overrun string
	Asked              bool
	Problems           []string
	Result             *DelayResult
}

// DelayResult is what a delay does.
type DelayResult struct {
	Easing    []string     // what the organiser does to ease it, described
	Without   string       // what the delay alone would do, when eased
	Merged    []string
	Breaks    []string
	Days      []DelayDay
	Changes   []DelayChangeView
	Unplaced  []string
	Clashes   []string
	ShortRest [2]int // people with less rest than wanted, before and after
}

// DelayDay is how a day's end changes.
type DelayDay struct {
	Name, WasEnd, NowEnd, End string
	WasFree, NowFree          int
}

// DelayChangeView is a flight that starts later or moves.
type DelayChangeView struct {
	Flight, Was, Now, Why string
	Later                 int // minutes
	Moved                 bool
}

// Delay is the delay page.
templ Delay(p DelayPage) {
	@competitionLayout("What if there's a delay · " + p.Competition.Name) {
		<p class="mb-3"><a href={ templ.SafeURL(p.Base + "/timetable") }>← Timetable</a></p>
		<h1 class="title is-4">What if there's a delay?</h1>
		<p class="subtitle is-6">{ p.Competition.Name } · { p.Competition.Date }</p>
		<p class="mb-4">Say which areas are held up, from when and for how long. Their later flights shift back as little as they can (any slack takes some of it), around blocked time; a flight that would then run past the end of the day, or need someone in two places, moves to another area if one is free. Nothing is saved: the timetable stays as it is.</p>
		@problemList(p.Problems)
		<form method="get" action={ templ.SafeURL(p.Base + "/timetable/delay") } class="box">
			<div class="comp-setup-row">
				<label class="label is-small mb-0" for="delay-day">Day</label>
				<div class="select is-small">
					<select id="delay-day" name="day">
						for _, d := range p.Days {
							<option value={ d.Value } selected?={ p.Day == d.Value }>{ d.Label }</option>
						}
					</select>
				</div>
				<label class="label is-small mb-0" for="delay-from">from</label>
				<input class="input is-small comp-num" id="delay-from" name="from" type="time" required value={ p.From }/>
				<label class="label is-small mb-0" for="delay-minutes">for</label>
				<input class="input is-small comp-num" id="delay-minutes" name="minutes" type="number" min="1" max="600" required value={ p.Minutes }/>
				<span class="is-size-7">minutes</span>
			</div>
			<fieldset class="field mt-2">
				<legend class="label is-small">Areas held up (none ticked: all of them)</legend>
				for _, a := range p.AllAreas {
					<label class="checkbox comp-option mr-3">
						<input type="checkbox" name="area" value={ a } checked?={ slices.Contains(p.Areas, a) }/>
						{ a }
					</label>
				}
			</fieldset>
			<details class="mt-2 mb-3" open?={ p.Breaks != "" || p.Between != "" || p.Quicker != "" || p.MaxFlight != "" || p.Overrun != "" }>
				<summary class="label is-small">Ease it (on the held-up areas, from the delay)</summary>
				<div class="field mt-2">
					<p class="label is-small mb-1">Breaks, such as lunch</p>
					for _, o := range [][2]string{{"", "Wait for them"}, {"move", "Move them later"}, {"shorten", "Shorten them by up to"}, {"through", "Keep going through them"}} {
						<label class="radio comp-option mr-3">
							<input type="radio" name="breaks" value={ o[0] } checked?={ p.Breaks == o[0] }/>
							{ o[1] }
						</label>
					}
					<input class="input is-small comp-num" name="shorten" type="number" min="0" max="120" value={ p.Shorten } aria-label="Minutes breaks can be shortened by"/>
					<span class="is-size-7">min</span>
				</div>
				<div class="comp-sim-grid">
					<label class="comp-sim-row">
						<span>Minutes between flights (empty: as set up)</span>
						<input class="input is-small comp-num" name="between" type="number" min="0" max="60" value={ p.Between }/>
					</label>
					<label class="comp-sim-row">
						<span>Quicker turns: % less time per competitor</span>
						<input class="input is-small comp-num" name="quicker" type="number" min="0" max="50" value={ p.Quicker }/>
					</label>
					<label class="comp-sim-row">
						<span>Bigger flights: merge an event's flights next to each other up to this many</span>
						<input class="input is-small comp-num" name="maxFlight" type="number" min="0" max="40" value={ p.MaxFlight }/>
					</label>
					<label class="comp-sim-row">
						<span>Let the day run past its end by up to (min)</span>
						<input class="input is-small comp-num" name="overrun" type="number" min="0" max="240" value={ p.Overrun }/>
					</label>
				</div>
			</details>
			<button class="button is-primary is-small" type="submit">Show what happens</button>
		</form>
		if r := p.Result; r != nil {
			<div class="box">
				if len(r.Easing) > 0 {
					<p class="mb-2"><strong>Easing it:</strong> { joinNames(r.Easing) }.</p>
					if r.Without != "" {
						<p class="is-size-7 mb-3">Without that: { r.Without }.</p>
					}
				}
				if len(r.Changes) == 0 {
					<p class="has-text-success"><strong>Nothing changes:</strong> there's enough slack to take the delay.</p>
				} else {
					if len(r.Days) > 0 {
						<div class="table-container">
							<table class="table is-narrow mb-2">
								<thead><tr><th>Day</th><th>Flights end</th><th>Must end by</th><th>Free after flights</th></tr></thead>
								<tbody>
									for _, d := range r.Days {
										<tr>
											<td>{ d.Name }</td>
											<td>{ d.WasEnd } → <strong>{ d.NowEnd }</strong></td>
											<td>{ d.End }</td>
											<td class={ templ.KV("has-text-danger", d.NowFree < 0) }>{ durationWord(d.WasFree) } → <strong>{ signedDuration(d.NowFree) }</strong></td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
					if len(r.Unplaced) > 0 {
						<div class="notification is-danger is-light">
							<p><strong>No longer fits the day:</strong> { joinNames(r.Unplaced) }. Nowhere free before the end could take it.</p>
						</div>
					} else {
						<p class="has-text-success mb-2"><strong>Everything still fits.</strong></p>
					}
					@problemsList("Needed in two places", r.Clashes)
					@problemsList("Breaks", r.Breaks)
					@problemsList("Flights merged", r.Merged)
					if r.ShortRest[1] > r.ShortRest[0] {
						<p class="is-size-7 mb-2">Less rest than wanted: { strconv.Itoa(r.ShortRest[0]) } people before, { strconv.Itoa(r.ShortRest[1]) } after.</p>
					}
					<h2 class="title is-6 mt-3">Flights that change ({ strconv.Itoa(len(r.Changes)) })</h2>
					<div class="table-container">
						<table class="table is-narrow is-fullwidth comp-table">
							<thead><tr><th>Flight</th><th>Was</th><th>Now</th><th></th></tr></thead>
							<tbody>
								for _, c := range r.Changes {
									<tr>
										<td>{ c.Flight }</td>
										<td>{ c.Was }</td>
										<td><strong>{ c.Now }</strong></td>
										<td class="is-size-7 comp-wrap">
											if c.Why != "" {
												{ c.Why }
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		} else if !p.Asked {
			<p class="help">e.g. Panel 2's trampoline needs a spring replaced: Saturday, from 10:30, for 25 minutes, Panel 2.</p>
		}
	}
}

func signedDuration(minutes int) string {
	if minutes < 0 {
		return durationWord(-minutes) + " over"
	}
	return durationWord(minutes)
}
