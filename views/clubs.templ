package views

import (
	"fmt"
	"strconv"
	"strings"

	"tariffCalculator/competitions"
	"tariffCalculator/static"
)

// ClubPage is a club's competition secretary's page.
type ClubPage struct {
	Base                 string // the admin link's path, which the page's own links extend
	Name                 string
	New                  string // "created" or "replaced" just after the admin link was made
	AdminLink            string // set only when New is
	JoinLink             string
	NewLink              *MemberLink // a member's or coach's link just made, to send them
	Ask                  *LinkAsk    // asking before a link is replaced
	Notice               string      // what just happened, e.g. "Sent 4 entries to Student Open"
	NoticeAt             string      // the member the notice is about, whose row says it too, where the page opens
	Members              []ClubMember
	Competitions         []ClubCompetition
	Coaches              []ClubCoach
	CoachOptions         []CoachOption
	CoachesSeeAll        bool
	QualificationOptions []CoachOption // every qualification, to give a coach
	Pairs                []PairView    // synchro entries other clubs' gymnasts made with members
	Menu                 []MenuSection // the sections of the comp sec's pages
	KeptUntil            string        // when the club is deleted if no one uses it, on Settings (ADR 0011)
	SkillsOpen           bool          // every member sees everyone's skills (ADR 0011)
	// MemberOptions are the members who aren't coaches too, to make one;
	// Ties the people whose own link opens these pages (ADR 0010).
	MemberOptions []CoachOption
	Ties          []TieView
	// MembersTools and CoachesTools are the search and filters of the
	// Members and Coaches lists.
	MembersTools, CoachesTools ListTools
}

// ClubCoach is one of the club's coaches.
type ClubCoach struct {
	ID, Name       string
	Members        int  // members who chose them
	SignsOff       bool // they sign off routines
	Qualifications []QualificationView
	Member         string // the member who is the same person, whose link opens their page; "" for none
	List           ListRow // what the list's search and filters see
}

// QualificationView is one of a coach's qualifications.
type QualificationView struct {
	ID, Name    string
	Certificate string // where to open it
}

// LinkAsk asks before a link is replaced, as the old one stops working:
// the same form posts again with anyway=1 to replace it.
type LinkAsk struct {
	Title, Text string
	Action      string // where replacing it posts
	Button      string
	Back        string // where Cancel goes
}

// MemberLink is a member's personal link.
type MemberLink struct {
	Name, Link string
	Coach      bool // a coach's link, not a member's
}

// ClubMember is one of the club's members.
type ClubMember struct {
	ID, Name  string
	Entries   int
	CoachID   string
	AlsoCoach bool    // a coach of the club too
	Routines  int     // routines kept on their page (ADR 0011)
	Can       int     // skills marked Can do (ADR 0011)
	Marks     bool    // has any skills marked
	List      ListRow // what the list's search and filters see
}

// ClubCompetition is a competition the club is entered in, with its members' entries.
type ClubCompetition struct {
	ID          string
	Competition CompetitionSummary
	Rows        []ClubEntryRow
	Tools       ListTools // the search and filters of its entries
	ToSend      int       // entries never sent, or changed since
	Offers      []ClubOfferRow
	// ApproveCoaches says the competition approves coaches; Coaches are the
	// club's who sign off, to send for approval (ADR 0007 Decision 5).
	ApproveCoaches bool
	Coaches        []ClubSendCoach
	MyLinks
	Fees           *FeesSummary // what the club owes, if the competition charges
	// Enter a member: where it goes, and who and what to choose from (none
	// while entries are closed).
	EnterMember string
	Members     []FlightOption
	Disciplines []FlightOption
	Pairs       []PairView // synchro entries others made, with one of the members as partner
	NoOffer     []FlightOption // members who haven't offered to help, while offers can change
	// NoSigner says the competition needs a coach's sign-off, but no coach
	// of the club signs off routines, so every entry waits.
	NoSigner bool
}

// ClubSendCoach is one of the club's coaches, to send to a competition.
type ClubSendCoach struct {
	ID, Name         string
	Ticked           bool   // sent, or to send
	Status           string // e.g. "Waiting for the organiser", "" if not sent
	State            State  // Status's state
	Approved         bool
	Note             string // the organiser's
	Changed          bool   // their qualifications changed since they were sent
	NoQualifications bool
}

// ClubOfferRow is what a member offers to judge and help with.
type ClubOfferRow struct {
	Member, Offer, Edit string
}

// ClubEntryRow is one member's entry for a competition.
type ClubEntryRow struct {
	Member, Level string
	// Partner is a synchro entry's partner, and Unconfirmed says they haven't
	// confirmed the pair yet.
	Partner     string
	Unconfirmed bool
	Status        string // "Not sent", "Sent", "Changed since sent", "Withdrawn"
	State         State  // Status's state
	Problems      int
	Edit          string // where the comp sec changes it, "" if they can't
	Note          string // the organiser's note
	Video         string // "missing" or "need more" when the club needs to act
	Signoff       SignoffView
	Flight        string // where they compete, once the timetable is published
	Late          LateStatus // a late change, where it stands
	LateAsk       string     // where to ask for a late change, once entries close
	List          ListRow
}

// ClubEntryEdit is the comp sec changing a member's entry on their behalf.
type ClubEntryEdit struct {
	Back        string // the competition's entries, where Back goes
	Club        string
	Member      string
	Competition CompetitionSummary
	Card        *EntryCard // nil if they haven't entered
	Partner     *PartnerView // a synchro entry's partner, and whether they've confirmed
	Form        EntryForm
	Menu        []MenuSection
	Withdraw    string // where withdrawing their entry posts, while changes are open
	Notice      string
}

// JoinPage is where a club's members join it.
type JoinPage struct {
	Club     string
	Name     string
	Problems []string
}

// MemberPage is a member's own pages: the list of the competitions their club
// is entered in, one competition with their entries, and their details.
type MemberPage struct {
	Club         string
	Member       string
	Menu         []MenuSection
	Home         string // the competitions list, their default page
	Coaches      []CoachOption
	CoachID      string
	CoachAction  string // where choosing a coach posts
	Link         string // their personal link, as a full URL
	New          bool   // just joined
	Notice       string
	Competitions []MemberCompetition // the list
	Competition  *MemberCompetition  // the one competition's page shows
	Pairs        []PairView          // synchro entries they're the partner in
	Other        *OtherLinks         // their other links, on their details (ADR 0010)
	Routines     RoutinesPart        // their kept routines, on Routines (ADR 0011)
	Skills       SkillsPart          // what they're learning and can do, on Skills (ADR 0011)
	Kept         KeptPart            // their own requirements and levels, on Requirements (ADR 0013)
}

// MemberCompetition is a member's entry for one competition, and the form to
// make or change it.
type MemberCompetition struct {
	ID           string
	Page         string // their page for it
	Competition  CompetitionSummary
	Status       string        // e.g. "2 entries"
	Problems     int           // on their entries' cards
	Events       []MemberEvent // one per discipline the competition offers
	Offer        *OfferForm    // what they offer to judge and help with
	MyLinks
	Day          string        // their My competition page
}

// MemberEvent is a member's entry for one of a competition's disciplines.
type MemberEvent struct {
	Discipline  string
	Name        string // the discipline's, e.g. "Synchro"
	Level       string // the entry's, e.g. "BUCS L3"; "" before they enter
	Status      string
	Brief       string // the status in a word or two, for the list: "Checked", "2 problems"
	BriefState  State  // Brief's state
	Open        bool   // shown open: it has problems to fix, or the notice is about it
	Waiting     string // on a waiting list, and where
	Late        LateStatus // a late change, where it stands
	LateAsk     string // where to ask for a late change, once entries close
	Note        string // the organiser's note
	VideoReview string // the organiser's review of its videos
	VideoNote   string
	Placement   *Placement // where they compete, once the timetable is published
	Partner     *PartnerView
	Card        *EntryCard
	Form        EntryForm
	Withdraw    string
}

// ClubLinkPage is a competition's club link: a comp sec enters their club.
type ClubLinkPage struct {
	Competition CompetitionSummary
	Action      string
	Problems    []string
}

// Hub lists the competitions, clubs and entries this browser has links to.
templ Hub() {
	@competitionLayout("Competitions and clubs") {
		<h1 class="title is-4">Competitions and clubs</h1>
		<p class="mb-4">Links to the competitions, clubs and entries you have, saved in this browser.</p>
		for _, list := range hubLists {
			<div class="box" data-hub-list={ list.Key } hidden>
				<h2 class="title is-6">{ list.Title }</h2>
				<ul></ul>
			</div>
		}
		<p class="has-text-grey mb-4" data-hub-empty hidden>Nothing saved in this browser yet.</p>
		<div class="buttons">
			<a class="button is-primary" href="/competitions/new">New competition</a>
			<a class="button" href="/clubs/new">New club</a>
		</div>
	}
}

// hubLists are the links the hub lists, by their key in the browser.
var hubLists = []struct{ Key, Title string }{
	{"trampolineCompetitions", "Competitions you run"},
	{"trampolineClubs", "Clubs you run"},
	{"trampolineMemberLinks", "Your clubs"},
	{"trampolineCoachLinks", "Clubs you coach"},
	{"trampolineGymnastLinks", "Entered on your own"},
	{"trampolineEntryLinks", "Your own entries, from before"},
}

// NewClub is the form that creates a club.
templ NewClub(name string, problems []string) {
	@competitionLayout("New club") {
		<h1 class="title is-4">New club</h1>
		<p class="mb-4">For a club's competition secretary. Members join through a link you share in the club's chat and keep their own entries; you send them to each competition. There are no accounts: you get an admin link to keep.</p>
		@problemList(problems)
		<form method="post" action="/clubs">
			<div class="field">
				<label class="label" for="club-name">Club</label>
				<input class="input" id="club-name" name="name" required maxlength="80" value={ name } placeholder="e.g. UCD Trampoline Club"/>
			</div>
			<button class="button is-primary is-fullwidth" type="submit">Create club</button>
		</form>
		<p class="help mt-4">We keep the club's name and its members' names, entries and routines, nothing else. A club is deleted 13 months after anyone last used it.</p>
	}
}

// clubFrame is the top of each of a comp sec's pages: the club's name, the menu
// and what just happened. The page's own part is its children.
templ clubFrame(c ClubPage) {
	@competitionLayout(c.Name) {
		<h1 class="title is-4">{ c.Name }</h1>
		@pageMenu(c.Menu)
		// Saves the admin link in this browser whenever it's opened (static/js/competitions.js).
		<span hidden data-club-page={ c.Base } data-club-name={ c.Name }></span>
		if c.New != "" && c.AdminLink != "" {
			<div class="notification is-warning is-light">
				<p class="mb-2">
					<strong>
						if c.New == "replaced" {
							Your new admin link.
						} else {
							Club created.
						}
					</strong>
					Save this page's link, the admin link: it's the only way back to the club, and anyone who has it can send its entries.
				</p>
				<div data-club-admin={ c.AdminLink } data-club-name={ c.Name } data-replaces?={ c.New == "replaced" }>
					@linkBox("Admin link (keep it secret)", c.AdminLink, "Saved in this browser too.")
				</div>
				if c.New == "created" {
					<p class="mt-2">Next, share the join link from <a href={ templ.SafeURL(c.Base + "/members") }>Members</a> so your club can join.</p>
				}
			</div>
		}
		if c.Notice != "" {
			@notice(c.Notice)
		}
		if a := c.Ask; a != nil {
			<div class="notification is-warning is-light" id="ask">
				<p class="mb-2"><strong>{ a.Title }</strong></p>
				<p class="mb-3">{ a.Text }</p>
				<form method="post" action={ templ.SafeURL(a.Action) } class="buttons">
					<input type="hidden" name="anyway" value="1"/>
					<button class="button is-small is-warning" type="submit">{ a.Button }</button>
					<a class="button is-small" href={ templ.SafeURL(a.Back) }>Cancel</a>
				</form>
			</div>
		}
		if c.NewLink != nil {
			<div class="notification is-info is-light">
				if c.NewLink.Coach {
					@linkBox(c.NewLink.Name+"'s coach link", c.NewLink.Link, "Send it to them: it's their page for signing off members' routines. It's shown only now; New link makes another.")
				} else {
					@linkBox(c.NewLink.Name+"'s new link", c.NewLink.Link, "Send it to them. Their old link no longer works.")
				}
			</div>
		}
		{ children... }
	}
}

// ClubAdmin is the comp sec's page, the Competitions section: a row for
// each competition the club is in, opening its own pages.
templ ClubAdmin(c ClubPage) {
	@clubFrame(c) {
		if len(c.Competitions) == 0 {
			<p class="has-text-grey">Not entered in any yet. Open the club link a competition's organiser gave you to enter the club.</p>
		}
		for _, comp := range c.Competitions {
			<a class="box comp-member-row" href={ templ.SafeURL(c.Base + "/competitions/" + comp.ID) }>
				<strong>{ comp.Competition.Name }</strong>
				<span class="is-block has-text-grey is-size-7">{ comp.Competition.Date }</span>
				<span class="is-block is-size-7">
					{ Count(len(comp.Rows), "entry", "entries") }
					if comp.ToSend > 0 {
						@StateChip(Attention, Count(comp.ToSend, "to send", "to send"))
					}
					if n := clubProblems(comp); n > 0 {
						@StateChip(Attention, strconv.Itoa(n)+" with problems")
					}
					if comp.Timeline != "" {
						@StateChip(Done, "Timetable published")
					}
					if len(comp.Desk) > 0 {
						@StateChip(Attention, "Message from the organisers")
					}
				</span>
			</a>
		}
	}
}

// clubProblems counts a competition's entries with problems.
func clubProblems(comp ClubCompetition) int {
	n := 0
	for _, r := range comp.Rows {
		if r.Problems > 0 {
			n++
		}
	}
	return n
}

// clubCompetitionHead is the top of each of a competition's pages for the
// comp sec, under the menu: the competition, its facts and its messages.
templ clubCompetitionHead(comp ClubCompetition) {
	<h2 class="title is-5 mb-2">{ comp.Competition.Name }</h2>
	@competitionFacts(comp.Competition)
	@deskMessages(comp.Desk)
}

// ClubCompetitionEntries is a competition's Entries: where they stand,
// sending them, and the members' entries.
templ ClubCompetitionEntries(c ClubPage, comp ClubCompetition) {
	@clubFrame(c) {
		@clubCompetitionHead(comp)
		@timelineLinks("", comp.Timeline, comp.Notify, "", comp.Calendar)
		if comp.Competition.ChangesOpen && (len(comp.Rows) > 0 || len(comp.Offers) > 0) {
			// Sending is what the page is for, so it's above the entries, with
			// sending everything again (rarely needed) as a quiet button.
			<form method="post" action={ templ.SafeURL(c.Base + "/competitions/" + comp.ID + "/send") } class="comp-send">
				<div class="comp-send-state">
					if comp.ToSend > 0 {
						@StateChip(Attention, Count(comp.ToSend, "entry to send", "entries to send"))
					} else {
						@StateChip(Done, "All sent")
					}
					<span class="comp-send-note">The organiser sees only what you send, with what members offer to judge and help with. Sending all again also takes back withdrawn entries.</span>
				</div>
				<div class="comp-send-actions">
					<button class="button is-primary is-small" type="submit" name="which" value="changed" disabled?={ comp.ToSend == 0 }>
						{ fmt.Sprintf("Send new and changed (%d)", comp.ToSend) }
					</button>
					<button class="button is-small is-text" type="submit" name="which" value="all" title="Sends every entry again, and takes back withdrawn ones">Send all again</button>
				</div>
			</form>
		}
		if comp.NoSigner {
			<div class="notification is-warning is-light">
				This competition needs a coach to sign off each entry, but no coach of the club signs off routines yet, so entries wait for sign-off. They can still be sent: the organiser sees they aren't signed off.
				<a href={ templ.SafeURL(c.Base + "/coaches") }>Add a coach or let one sign off, on Coaches →</a>
			</div>
		}
		// A member entered by the comp sec, as they'd enter themselves.
		if len(comp.Members) > 0 {
			<script defer src={ static.URL("js/selectsearch.js") }></script>
			@opens("", "", "Enter a member", false) {
				<form method="get" action={ templ.SafeURL(comp.EnterMember) } class="comp-flight-actions">
					<div class="select is-small">
						<select name="member" required aria-label="Member" data-search-select="Search the members">
							<option value="" disabled selected>Choose a member</option>
							for _, m := range comp.Members {
								<option value={ m.Value }>{ m.Label }</option>
							}
						</select>
					</div>
					if len(comp.Disciplines) > 1 {
						<div class="select is-small">
							<select name="discipline" aria-label="Discipline">
								for _, d := range comp.Disciplines {
									<option value={ d.Value }>{ d.Label }</option>
								}
							</select>
						</div>
					}
					<button class="button is-small is-primary" type="submit">Enter them</button>
				</form>
			}
		}
		if len(comp.Rows) == 0 {
			<p class="has-text-grey is-size-7">No member has entered yet.</p>
		} else {
			@listSection("Entries", len(comp.Rows)) {
				@listTools(comp.Tools)
				<div class="table-container">
					<table class="table is-fullwidth is-narrow comp-table comp-club-entries comp-stack" id={ comp.Tools.ID }>
						<thead>
							<tr><th>Member</th><th>Level</th><th>Problems</th><th>Status</th></tr>
						</thead>
						<tbody>
							for _, row := range comp.Rows {
								<tr { row.List.Attrs()... }>
									<td>
										{ row.Member }
										if row.Partner != "" {
											<span class="is-size-7 has-text-grey">and { row.Partner }</span>
											if row.Unconfirmed {
												@StateChip(InProgress, "Partner to confirm")
											}
										}
										if row.Edit != "" {
											<br/>
											<a class="is-size-7" href={ templ.SafeURL(row.Edit) }>Change</a>
										}
									</td>
									<td data-label="Level">{ row.Level }</td>
									<td data-label="Problems">
										// Empty when there are none, so a phone's card leaves the line out.
										if row.Problems > 0 {
											// Opens the entry, where its problems are listed.
											if row.Edit != "" {
												<a href={ templ.SafeURL(row.Edit) } title="See the problems">
													@StateChip(Attention, Count(row.Problems, "problem", "problems"))
												</a>
											} else {
												@StateChip(Attention, Count(row.Problems, "problem", "problems"))
											}
										}
									</td>
									<td data-label="Status">
										@StateChip(row.State, row.Status)
										if row.Video != "" {
											<br/>
											@StateChip(Attention, "Video "+row.Video)
										}
										if row.Flight != "" {
											<br/>
											<span class="is-size-7 has-text-grey-dark comp-flight-line">{ row.Flight }</span>
										}
										if row.Late.Text != "" {
											<br/>
											<span class="is-size-7">
												@StateChip(row.Late.State, "Late change")
												<span class="ml-1">{ row.Late.Text }</span>
											</span>
										}
										if row.LateAsk != "" {
											<br/>
											<a class="is-size-7" href={ templ.SafeURL(row.LateAsk) }>Ask for a late change</a>
										}
										if row.Signoff.Status() != "" {
											<br/>
											<span>
												@signoffCell(row.Signoff, "")
												@signoffWaiting(row.Signoff)
												if row.Signoff.Unapproved {
													@unapprovedKey()
												}
											</span>
											if row.Signoff.Note != "" {
												<br/>
												<span class="is-size-7">Coach's note: { row.Signoff.Note }</span>
											}
										}
										if row.Note != "" {
											<br/>
											<span class="is-size-7 has-text-info-dark">Organiser: { row.Note }</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
		// Synchro entries other clubs' gymnasts made with one of ours as
		// partner: not the club's to send, but their members compete in them.
		@pairEntries(comp.Pairs)
	}
}

// ClubCompetitionCoaches is a competition's coaches to send for approval,
// where it approves coaches.
templ ClubCompetitionCoaches(c ClubPage, comp ClubCompetition) {
	@clubFrame(c) {
		@clubCompetitionHead(comp)
		if comp.ApproveCoaches {
			// A list with its count, each coach a row with their state in a
			// column of its own, so the chips line up whatever the names.
			@listSection("Coaches for this competition", len(comp.Coaches)) {
				<p class="help mb-2">It approves coaches from their qualifications: only those it approves can sign off. Tick who to send.</p>
				if len(comp.Coaches) == 0 {
					<p class="is-size-7 has-text-grey">None of your coaches signs off routines yet (see <a href={ templ.SafeURL(c.Base + "/coaches") }>Coaches</a>).</p>
				} else {
					<form method="post" action={ templ.SafeURL(c.Base + "/competitions/" + comp.ID + "/coaches") }>
						<table class="table is-fullwidth is-narrow comp-stack">
							<tbody>
								for _, k := range comp.Coaches {
									<tr>
										<td>
											<label class="checkbox">
												<input type="checkbox" name="coach" value={ k.ID } checked?={ k.Ticked }/>
												{ k.Name }
											</label>
										</td>
										<td>
											if k.Status != "" {
												@StateChip(k.State, k.Status)
											}
											if k.Changed {
												@StateChip(Attention, "Qualifications changed since sent: send again")
											}
											if k.NoQualifications {
												@StateChip(Attention, "No qualifications added")
											}
											if k.Note != "" {
												<span class="is-size-7 has-text-grey">· { k.Note }</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
						<button class="button is-small" type="submit">Send coaches</button>
					</form>
				}
			}
		}
	}
}

// offerAddPath is where adding a member's offer goes: beside the
// competition's Enter a member.
func offerAddPath(comp ClubCompetition) string {
	return strings.TrimSuffix(comp.EnterMember, "/enter-member") + "/add-offer"
}

// ClubCompetitionOffers is what members offer to judge and help with at a
// competition, sent with the entries.
templ ClubCompetitionOffers(c ClubPage, comp ClubCompetition) {
	@clubFrame(c) {
		@clubCompetitionHead(comp)
		if len(comp.Offers) == 0 {
			<p class="has-text-grey mt-4">No member has offered to judge or help yet. Members say what they can do on their page for the competition.</p>
		}
		// An offer for a member who told the comp sec rather than adding it.
		if len(comp.NoOffer) > 0 {
			<script defer src={ static.URL("js/selectsearch.js") }></script>
			<div class="mt-3">
				@opens("", "", "Add an offer", false) {
					<form method="get" action={ templ.SafeURL(offerAddPath(comp)) } class="comp-flight-actions">
						<div class="select is-small">
							<select name="member" required aria-label="Member" data-search-select="Search the members">
								<option value="">Choose a member</option>
								for _, m := range comp.NoOffer {
									<option value={ m.Value }>{ m.Label }</option>
								}
							</select>
						</div>
						<button class="button is-small is-primary" type="submit">Add their offer</button>
					</form>
				}
			</div>
		}
		if len(comp.Offers) > 0 {
			@listSection("Judging and helping", len(comp.Offers)) {
				<p class="help mb-2">What members offer, sent with the entries.</p>
				<div class="table-container">
					<table class="table is-fullwidth is-narrow comp-offers">
						<tbody>
							for _, o := range comp.Offers {
								<tr>
									<td>{ o.Member }</td>
									<td>{ o.Offer }</td>
									<td class="has-text-right">
										if o.Edit != "" {
											<a class="button is-small is-text" href={ templ.SafeURL(o.Edit) }>Change</a>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

// ClubCompetitionFees is what the club owes a competition: the invoice's
// lines and payments, with the invoice to print.
templ ClubCompetitionFees(c ClubPage, comp ClubCompetition, invoice *InvoicePage) {
	@clubFrame(c) {
		@clubCompetitionHead(comp)
		if invoice == nil {
			<p class="has-text-grey mt-4">There's nothing to pay for this competition yet.</p>
		} else {
			// What's to pay and how, first: the lines can run long.
			<div class="comp-send">
				<div class="comp-send-state">
					if invoice.Settled {
						@StateChip(Done, "Paid in full")
					} else {
						<p class="title is-5 mb-1">{ invoice.Balance } to pay</p>
					}
					<span class="comp-send-note">Removed, held and withdrawn entries aren't charged. If something here is wrong, ask the organiser.</span>
				</div>
				<div class="comp-send-actions">
					<a class="button is-small" href={ templ.SafeURL(c.Base + "/competitions/" + comp.ID + "/invoice") }>Print the invoice</a>
				</div>
			</div>
			@howToPay(*invoice)
			@invoiceTable(*invoice)
		}
	}
}

// ClubMembers is the comp sec's Members section: the join link and the members.
templ ClubMembers(c ClubPage) {
	@clubFrame(c) {
		@linkBox("Join link", c.JoinLink, "Share it in the club's chat: members join with it and keep their own entries.")
		@listSection("Members", len(c.Members)) {
			if len(c.Members) == 0 {
				<p class="has-text-grey">No members yet. Share the join link.</p>
			} else {
				@listTools(c.MembersTools)
				<div class="table-container">
					<table class="table is-fullwidth is-narrow comp-stack" id={ c.MembersTools.ID }>
						<tbody>
							for _, m := range c.Members {
								<tr id={ MemberAnchor(m.ID) } class="comp-target" { m.List.Attrs()... }>
									<td>
										{ m.Name }
										if m.AlsoCoach {
											@WhoLink(RoleCoach, "", c.Base+"/coaches")
										}
										if c.NoticeAt == m.ID && c.Notice != "" {
											<span class="is-block is-size-7">{ c.Notice }</span>
										}
									</td>
									<td class="has-text-grey is-size-7">
										{ Count(m.Entries, "entry", "entries") }
										if m.Routines > 0 {
											· <a href={ templ.SafeURL(c.Base + "/members/" + m.ID + "/routines") }>{ Count(m.Routines, "routine", "routines") }</a>
										}
										if m.Marks {
											· <a href={ templ.SafeURL(c.Base + "/members/" + m.ID + "/skills") }>can do { strconv.Itoa(m.Can) }</a>
										}
									</td>
									if len(c.CoachOptions) > 0 {
										<td data-label="Coach">
											@coachSelect(c.Base+"/members/"+m.ID+"/coach", c.CoachOptions, m.CoachID, m.Name+"'s coach")
										</td>
									}
									<td class="comp-row-more">
										// The rare things to do to a member, out of the way until asked for.
										@opens("", "", "More", false) {
											if !m.AlsoCoach {
												<form method="post" action={ templ.SafeURL(c.Base + "/coaches/from-member") }>
													<input type="hidden" name="member" value={ m.ID }/>
													<button class="button is-small is-text" type="submit" title="Their member link opens the coach's page too">Make a coach too</button>
												</form>
											}
											<form method="post" action={ templ.SafeURL(c.Base + "/members/" + m.ID + "/new-link") }>
												<button class="button is-small is-text" type="submit" title="For a member who lost their link: you're asked first, as their old one stops working">New link</button>
											</form>
											<form method="post" action={ templ.SafeURL(c.Base + "/members/" + m.ID + "/remove") } onsubmit={ confirmRemove(m.Name) }>
												<button class="button is-small is-text has-text-danger" type="submit">Remove</button>
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
		@pairEntries(c.Pairs)
	}
}

// ClubCoaches is the comp sec's Coaches section.
templ ClubCoaches(c ClubPage) {
	@clubFrame(c) {
		@listSection("Coaches", len(c.Coaches)) {
			if len(c.Coaches) == 0 {
				<p class="has-text-grey">No coaches yet. Add one below.</p>
			} else {
				@listTools(c.CoachesTools)
				<div class="table-container">
					<table class="table is-fullwidth is-narrow comp-coaches" id={ c.CoachesTools.ID }>
						for _, coach := range c.Coaches {
							<tbody id={ "coach-" + coach.ID } class="comp-target" { coach.List.Attrs()... }>
								<tr>
									<td>
										{ coach.Name }
										if coach.Member != "" {
											<span class="is-block has-text-grey is-size-7">A member too: opens from their member link</span>
										}
									</td>
									<td class="is-size-7">
										if coach.Members > 0 {
											<a href={ templ.SafeURL(c.Base + "/members?coach=" + coach.ID) }>{ Count(coach.Members, "member chose them", "members chose them") }</a>
										} else {
											<span class="has-text-grey">No member chose them</span>
										}
									</td>
									<td class="comp-row-more">
										@opens("", "", "More", false) {
											<form method="post" action={ templ.SafeURL(c.Base + "/coaches/" + coach.ID + "/new-link") }>
												<button class="button is-small is-text" type="submit" title="You're asked first, as their old link stops working">New link</button>
											</form>
											<form method="post" action={ templ.SafeURL(c.Base + "/coaches/" + coach.ID + "/remove") } onsubmit={ confirmRemoveCoach(coach.Name) }>
												<button class="button is-small is-text has-text-danger" type="submit">Remove</button>
											</form>
										}
									</td>
								</tr>
								<tr>
									<td colspan="3" class="is-size-7">
										<form method="post" action={ templ.SafeURL(c.Base + "/coaches/" + coach.ID + "/signs-off") } class="mb-1">
											<input type="hidden" name="on" value={ boolValue(!coach.SignsOff) }/>
											<label class="checkbox">
												<input type="checkbox" checked?={ coach.SignsOff } onchange="this.form.submit()"/>
												Signs off routines
											</label>
											<noscript><button class="button is-small" type="submit">Change</button></noscript>
										</form>
										for _, q := range coach.Qualifications {
											<div class="comp-qualification">
												<span>{ q.Name } · <a href={ templ.SafeURL(q.Certificate) } target="_blank" rel="noopener">certificate</a></span>
												<form method="post" action={ templ.SafeURL(c.Base + "/coaches/" + coach.ID + "/qualifications/" + q.ID + "/remove") } class="is-inline">
													<button class="button is-small is-text has-text-danger" type="submit">Remove</button>
												</form>
											</div>
										}
										<details>
											<summary>Add a qualification</summary>
											<form method="post" action={ templ.SafeURL(c.Base + "/coaches/" + coach.ID + "/qualifications") } enctype="multipart/form-data" class="comp-flight-actions mt-1">
												<div class="select is-small">
													<select name="qualification" required aria-label={ coach.Name + "'s qualification" }>
														<option value="">Qualification…</option>
														for _, o := range c.QualificationOptions {
															<option value={ o.ID }>{ o.Name }</option>
														}
													</select>
												</div>
												<input class="input is-small comp-file" type="file" name="certificate" required accept="image/jpeg,image/png,image/webp,application/pdf" aria-label={ coach.Name + "'s certificate" }/>
												<button class="button is-small" type="submit">Add</button>
											</form>
											<p class="help">The certificate: a photo or PDF, up to 3 MB. It's kept until you remove it or the coach.</p>
										</details>
									</td>
								</tr>
							</tbody>
						}
					</table>
				</div>
			}
		}
		<div class="mt-4">
			// Open at first while the club has no coaches: adding one is all there is to do.
			@opens("", "", "Add a coach", len(c.Coaches) == 0) {
				<form method="post" action={ templ.SafeURL(c.Base + "/coaches") } class="field has-addons">
					<div class="control is-expanded">
						<input class="input is-small" name="name" required maxlength="80" placeholder="Coach's name" aria-label="Coach's name"/>
					</div>
					<div class="control"><button class="button is-small" type="submit">Add coach</button></div>
				</form>
				if len(c.MemberOptions) > 0 {
					<form method="post" action={ templ.SafeURL(c.Base + "/coaches/from-member") } class="field has-addons mb-1">
						<div class="control is-expanded">
							<div class="select is-small is-fullwidth">
								<select name="member" required aria-label="Member to make a coach">
									<option value="">Or a member who coaches…</option>
									for _, m := range c.MemberOptions {
										<option value={ m.ID }>{ m.Name }</option>
									}
								</select>
							</div>
						</div>
						<div class="control"><button class="button is-small" type="submit">Make a coach too</button></div>
					</form>
					<p class="help">A member who coaches needs no coach link: their member link opens the coach's page too, with a tab for each.</p>
				}
			}
		</div>
		if len(c.Coaches) > 0 {
			@changeLine("Who coaches see", coachesSeeNow(c.CoachesSeeAll), false) {
				<form method="post" action={ templ.SafeURL(c.Base + "/coaches-see-all") }>
					<input type="hidden" name="on" value={ boolValue(!c.CoachesSeeAll) }/>
					<label class="checkbox is-size-7">
						<input type="checkbox" checked?={ c.CoachesSeeAll } onchange="this.form.submit()"/>
						Every coach sees every member
					</label>
					<noscript><button class="button is-small" type="submit">Change</button></noscript>
				</form>
			}
		}
		<p class="help">Coaches sign off members' routines on their own page. A member chooses their coach, or you do on Members. A competition can ask for coaches' qualifications: add each one's with a photo or PDF of the certificate, which only you, and organisers you send the coach to, can open.</p>
	}
}

// ClubSettings is the comp sec's Settings section: replacing the admin link and
// deleting the club.
templ ClubSettings(c ClubPage) {
	@clubFrame(c) {
		// The settings are rows, each opening its form (rendering.md, "Settings
		// and forms on a page"); the tab says it's Settings already.
		@changeLine("Members' skills", skillsNow(c.SkillsOpen), false) {
			<form method="post" action={ templ.SafeURL(c.Base + "/skills-open") }>
				<input type="hidden" name="on" value={ onIfNot(c.SkillsOpen) }/>
				<button class="button is-small" type="submit">
					if c.SkillsOpen {
						Show each member only their own
					} else {
						Let every member see everyone's skills
					}
				</button>
			</form>
		}
		@opens("Admin link", "If it's been shared too widely, replace it: the old one stops working.", "Replace", false) {
			<form method="post" action={ templ.SafeURL(c.Base + "/replace-link") }>
				<button class="button is-small" type="submit">Replace the admin link</button>
			</form>
		}
		@opens("Delete the club", "Its members and their entries, now. Entries already sent stay with each competition.", "Delete", false) {
			<form method="post" action={ templ.SafeURL(c.Base + "/delete") }>
				<label class="checkbox comp-check is-size-7">
					<input type="checkbox" name="confirm" value="1" required/>
					Delete the club, its members and their entries, now
				</label>
				<button class="button is-small is-danger is-outlined ml-2" type="submit">Delete</button>
			</form>
		}
		if c.KeptUntil != "" {
			<p class="help mb-5">{ "The club is kept until " + c.KeptUntil + ": 13 months after anyone last opened its pages, or a member's or coach's. Each time someone does, that moves on." }</p>
		}
		@tiesBox(c.Base+"/ties/remove", c.Ties, "Someone who adds this admin link to their own page (a member's or coach's, say) opens these pages from there, with a tab for each.")
	}
}

script confirmRemoveCoach(name string) {
	if (!confirm("Remove " + name + " as a coach? Their members will have no coach until one is chosen.")) { event.preventDefault(); }
}

script confirmRemove(name string) {
	if (!confirm("Remove " + name + " and their entries from the club?")) { event.preventDefault(); }
}

// ClubEntryEditPage is the comp sec changing a member's entry.
templ ClubEntryEditPage(e ClubEntryEdit) {
	@competitionLayout(e.Member + " · " + e.Competition.Name) {
		@pageMenu(e.Menu)
		<p class="mb-3"><a href={ templ.SafeURL(e.Back) }>← { e.Competition.Name }</a></p>
		<h1 class="title is-4">
			{ e.Member }
			if e.Partner != nil {
				and { e.Partner.Name }
			}
		</h1>
		if e.Notice != "" {
			@notice(e.Notice)
		}
		if e.Card != nil {
			<p class="subtitle is-6">{ e.Competition.Name } · { e.Card.Level }</p>
			@partnerBox(e.Partner)
			// Above the card, by its problems, so fixing them is where they're
			// read; collapsed so the entry is what shows, open when a save had
			// problems.
			<div class="mb-4">
				@opens("", "", "Change the entry", len(e.Form.Problems) > 0) {
					@entryForm(e.Form)
				}
			</div>
			@entryCardChecks(*e.Card)
			if e.Withdraw != "" {
				<div class="mt-4">
					@withdrawForm(e.Withdraw, e.Form.Discipline)
				</div>
			}
		} else {
			<p class="subtitle is-6">{ e.Competition.Name } · { competitions.DisciplineName(e.Form.Discipline) }</p>
			<h2 class="title is-5 mt-5">Enter them in { strings.ToLower(competitions.DisciplineName(e.Form.Discipline)) }</h2>
			@entryForm(e.Form)
		}
	}
}

// ClubJoin is where a member joins a club.
templ ClubJoin(p JoinPage) {
	@competitionLayout("Join " + p.Club) {
		<h1 class="title is-4">Join { p.Club }</h1>
		<p class="mb-4">Join to keep your competition entries with the club. Your club's competition secretary sends them to each competition.</p>
		@problemList(p.Problems)
		<form method="post">
			<div class="field">
				<label class="label" for="member-name">Your name</label>
				<input class="input" id="member-name" name="name" required maxlength="80" value={ p.Name } placeholder="As on the results"/>
			</div>
			<button class="button is-primary is-fullwidth" type="submit">Join</button>
		</form>
		<p class="help mt-4">We keep your name, your entries, and any routines and skills you keep on your page, which your club sees, and your entries the competitions they're sent to. Nothing else, and no account.</p>
	}
}

// memberFrame is the top of each of a member's pages: who they are, the menu
// and what just happened. The page's own part is its children.
templ memberFrame(p MemberPage) {
	@competitionLayout(p.Member + " · " + p.Club) {
		<p class="has-text-grey mb-1">{ p.Club }</p>
		<h1 class="title is-4">{ p.Member }</h1>
		@pageMenu(p.Menu)
		if p.Link != "" {
			// Saves their link in this browser (static/js/competitions.js), whichever page they open first.
			// data-member-coach marks a member who coaches too, so tools for coaches
			// offer this link (ADR 0010: their coach's pages open through it).
			<span hidden data-member-link={ p.Link } data-member-name={ p.Member + " · " + p.Club } data-member-coach?={ coachesToo(ctx) }></span>
		}
		if p.New {
			<div class="notification is-success is-light">
				<p><strong>You've joined.</strong> This page is yours: its link is saved in this browser, so on this phone your entries are simply here. Keep the link to open them anywhere else.</p>
			</div>
		}
		if p.Notice != "" {
			@notice(p.Notice)
		}
		{ children... }
	}
}

// MemberHome is a member's default page: the competitions their club is in.
templ MemberHome(p MemberPage) {
	@memberFrame(p) {
		if len(p.Competitions) == 0 {
			<p class="has-text-grey">Your club isn't entered in any competitions yet. When it is, you'll enter here.</p>
		}
		for _, c := range p.Competitions {
			<a class="box comp-member-row" href={ templ.SafeURL(c.Page) }>
				<strong>{ c.Competition.Name }</strong>
				<span class="is-block has-text-grey is-size-7">{ c.Competition.Date }</span>
				<span class="is-block is-size-7">
					{ c.Status }
					if c.Problems > 0 {
						@StateChip(Attention, Count(c.Problems, "problem", "problems"))
					}
					if c.Timeline != "" {
						@StateChip(Done, "Timetable published")
					}
					if len(c.Desk) > 0 {
						@StateChip(Attention, "Message from the organisers")
					}
				</span>
			</a>
		}
		// Below their own entries: the other gymnast's, which they're in.
		@pairEntries(p.Pairs)
	}
}

// MemberCompetitionPage is a member's page for one competition: its facts and
// links, each discipline's entry as a list row that opens to its card and
// forms, what they officiate and what they offer to judge and help with.
templ MemberCompetitionPage(p MemberPage) {
	@memberFrame(p) {
		<p class="mb-3"><a href={ templ.SafeURL(p.Home) }>← Competitions</a></p>
		if p.Competition != nil {
			@memberCompetitionBody(*p.Competition)
		}
	}
}

templ memberCompetitionBody(c MemberCompetition) {
	<h2 class="title is-5">{ c.Competition.Name }</h2>
	@competitionFacts(c.Competition)
	@dayLink(c.Day)
	@deskMessages(c.Desk)
	// The timetables and calendars are on My competition; hearing about changes is here too.
	@timelineLinks("", "", c.Notify, "", "")
	for _, ev := range c.Events {
		@memberEvent(c.Competition, ev)
	}
	@dutiesBox(c.Duties, c.ScoreSheets)
	if c.Offer != nil && c.Competition.ChangesOpen {
		@offerBox(*c.Offer)
	}
}

// MemberDetails is a member's details: their personal link and their coach.
templ MemberDetails(p MemberPage) {
	@memberFrame(p) {
		if p.Link != "" {
			@linkBox("Your personal link (keep it to yourself)", p.Link, "Open it on any phone or computer to see your entries. Anyone who has it can change them.")
		}
		if len(p.Coaches) > 0 {
			<div class="mt-4">
				@changeLine("Your coach", coachNow(p.Coaches, p.CoachID), false) {
					@coachSelect(p.CoachAction, p.Coaches, p.CoachID, "Your coach")
					<p class="help">They sign off your routines. Without one chosen, any of the club's coaches can.</p>
				}
			</div>
		}
		if p.Other != nil {
			@otherLinksBox(*p.Other)
		}
	}
}

// ClubLink is a competition's club link: a comp sec enters their club.
templ ClubLink(p ClubLinkPage) {
	@competitionLayout("Enter a club in " + p.Competition.Name) {
		<h1 class="title is-4">Enter your club in { p.Competition.Name }</h1>
		@competitionFacts(p.Competition)
		@problemList(p.Problems)
		<form method="post" action={ templ.SafeURL(p.Action) } class="comp-club-link">
			// Clubs saved in this browser (static/js/competitions.js).
			<div class="field" data-saved-clubs hidden>
				<label class="label" for="saved-club">Your club</label>
				<div class="select is-fullwidth"><select id="saved-club"></select></div>
			</div>
			<div class="field">
				<label class="label" for="club-admin">Your club's admin link</label>
				<input class="input" id="club-admin" name="clubAdmin" required placeholder="https://.../clubs/admin/..."/>
				<p class="help">The link you got when you created the club. No club yet? <a href="/clubs/new">Create one</a>, then open this link again.</p>
			</div>
			<button class="button is-primary is-fullwidth" type="submit">Enter the club</button>
		</form>
	}
}

// memberEvent is a member's entry for one discipline: a list row (discipline,
// level, status) that opens to its card and the forms to make or change it.
templ memberEvent(comp CompetitionSummary, ev MemberEvent) {
	if ev.Card != nil || comp.ChangesOpen {
		<details class="box comp-event-row" open?={ ev.Open }>
			<summary>
				@memberEventRow(ev)
			</summary>
			<div class="mt-3">
				if ev.Card != nil {
					<p class="mb-2"><strong>{ ev.Status }</strong></p>
				}
				@waitingLine(ev.Waiting)
				@lateLine(ev.Late, ev.LateAsk)
				@placementLine(ev.Placement)
				@organiserNote(ev.Note)
				@videoReviewNote(ev.VideoReview, ev.VideoNote)
				@partnerBox(ev.Partner)
				if ev.Card != nil {
					// Change above the card, by its problems (open when a save
					// had problems); Withdraw, rare, below it.
					if comp.ChangesOpen {
						<div class="mb-4">
							@opens("", "", "Change your entry", len(ev.Form.Problems) > 0) {
								@entryForm(ev.Form)
							}
						</div>
					}
					@entryCardChecks(*ev.Card)
					if comp.ChangesOpen {
						<div class="mt-4">
							@withdrawForm(ev.Withdraw, ev.Discipline)
						</div>
					}
				} else if comp.ChangesOpen {
					@entryForm(ev.Form)
				}
			</div>
		</details>
	} else {
		// Nothing to open: entries are closed and there is no entry.
		<div class="box comp-event-row">
			@memberEventRow(ev)
		</div>
	}
}

// memberEventRow is the one line a discipline's entry takes in the list. A
// synchro event's name says Synchro already: not twice.
templ memberEventRow(ev MemberEvent) {
	<strong>{ ev.Name }</strong>
	if ev.Level != "" {
		<span class="has-text-grey is-size-7">· { strings.TrimPrefix(ev.Level, ev.Name+" ") }</span>
	}
	@StateChip(ev.BriefState, ev.Brief)
}

// ClubOfferEdit is the comp sec changing what a member offers.
type ClubOfferEdit struct {
	Back, Club, Member string // Back: the competition's Judging and helping
	Competition        CompetitionSummary
	Form               OfferForm
	Menu               []MenuSection
}

// ClubOfferEditPage is the comp sec changing a member's offer.
templ ClubOfferEditPage(e ClubOfferEdit) {
	@competitionLayout(e.Member + " · judging and helping") {
		@pageMenu(e.Menu)
		<p class="mb-3"><a href={ templ.SafeURL(e.Back) }>← { e.Competition.Name }</a></p>
		<h1 class="title is-4">{ e.Member }</h1>
		<p class="subtitle is-6">Judging and helping at { e.Competition.Name }</p>
		@offerForm(e.Form)
	}
}

// coachNow names a member's chosen coach, for Your details.
func coachNow(coaches []CoachOption, chosen string) string {
	for _, c := range coaches {
		if c.ID == chosen {
			return c.Name
		}
	}
	return "None chosen: any of the club's coaches can sign off your routines"
}

// skillsNow says who sees members' skills, for Settings.
func skillsNow(open bool) string {
	if open {
		return "Every member sees everyone's skills"
	}
	return "Each member's skills are seen by them, their coaches and you"
}

// coachesSeeNow says which members coaches see, for Coaches.
func coachesSeeNow(all bool) string {
	if all {
		return "Every coach sees every member"
	}
	return "Each coach sees the members who chose them, and those who haven't chosen a coach"
}

// onIfNot is the "on" value that turns a setting the other way.
func onIfNot(on bool) string {
	if on {
		return ""
	}
	return "1"
}

// MemberAnchor is a member's row on the comp sec's Members.
func MemberAnchor(id string) string { return "member-" + id }
