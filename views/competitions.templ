package views

import (
	"fmt"
	"strconv"
	"strings"

	"tariffCalculator/requirements"
	"tariffCalculator/static"
)

// CompetitionSummary is what every competition page says about it, with dates
// already written for Ireland and the UK.
type CompetitionSummary struct {
	Name          string
	Date          string // e.g. "Saturday 13 March 2027"
	Deadline      string // e.g. "Saturday 6 March 2027, 23:59"
	DeleteAfter   string // when it and its entries are deleted
	Open          bool   // new entries can be made
	ChangesOpen   bool   // entries already made can be changed, withdrawn or sent again
	SignoffsOpen  bool   // coaches can sign off
	ChangesUntil  string // when changes close, if later than the deadline
	SignoffsUntil string // when sign-offs close, if later than the deadline
	Live          bool   // gone live: not private, being set up or paused
	Opens         string // when it goes live, if it's due to, e.g. "Monday 1 February 2027, 09:00"
	Individuals   bool   // individuals can enter directly
	Video         string // what video proof it asks for, "" for none
	Signoff       bool   // entries need a coach's sign-off
}

// CompetitionForm is the form that creates a competition. Levels are the
// built-in levels ticked, by reference; a coach's own levels come from the
// browser (static/js/competitions.js) and are posted as JSON.
type CompetitionForm struct {
	Name, Date, DeadlineDate, DeadlineTime string
	Opens                                  string // "later" (private), "now" or "at"
	LiveDate, LiveTime                     string // when, for "at"
	Individuals                            bool
	Levels                                 map[string]bool
	Groups                                 []requirements.BuiltinGroup
	Video                                  VideoForm
	Signoff                                bool
	SplitAll                               bool // rank men and women separately at every level
	Events                                 EventsForm
	Problems                               []string
}

// VideoForm is the choice of video proof a competition asks for: none, for
// some skills (triples, doubles, or a tariff or more), or every whole routine.
type VideoForm struct {
	Need             string // "", "skills" or "routine"
	Triples, Doubles bool
	Tariff           string // e.g. "1.5", "" for none
}

// CompetitionLinks are a competition's links, as full URLs. Admin is set only
// when it's just been made or replaced: it's shown once.
type CompetitionLinks struct {
	Admin, Club, Individual string
}

templ competitionLayout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<title>{ title }</title>
			<meta name="app-version" content={ static.Version }/>
			<meta name="page-time" content={ pageTime() }/>
			<script defer src={ static.URL("js/version.js") }></script>
			<link rel="stylesheet" href={ static.URL("css/bulma.min.css") }/>
			<link rel="stylesheet" href={ static.URL("css/styles.css") }/>
			<script defer src={ static.URL("js/routines.js") }></script>
			<script defer src={ static.URL("js/sets.js") }></script>
			<script defer src={ static.URL("js/competitions.js") }></script>
			<script defer src={ static.URL("js/menus.js") }></script>
			<script defer src={ static.URL("js/tables.js") }></script>
		</head>
		<body>
			@sandboxBanner()
			<section class="section comp-page">
				<div class="container">
					<div class="notification is-warning is-light comp-offline" hidden>You're offline: this is the page as it was when last opened (<span data-offline-when></span>).</div>
					@roleTabs(rolesOf(ctx))
					{ children... }
					@feedbackButton(FeedbackFormOf(ctx))
				</div>
			</section>
		</body>
	</html>
}

// Message is a page that only says something, e.g. a link that leads nowhere.
templ Message(title, text string) {
	@competitionLayout(title) {
		<h1 class="title is-4">{ title }</h1>
		<p>{ text }</p>
		@messageOnward()
	}
}

// DeadLink is Message for a link that leads nowhere (or no longer will: a
// competition just deleted). The browser forgets it if it saved it
// (data-dead-link, static/js/competitions.js).
templ DeadLink(title, text string) {
	@competitionLayout(title) {
		<h1 class="title is-4">{ title }</h1>
		<p data-dead-link>{ text }</p>
		@messageOnward()
	}
}

// messageOnward is the way on from a page that only says something: back,
// or to the links saved in this browser.
templ messageOnward() {
	<p class="buttons mt-4">
		<button type="button" class="button is-small" onclick="history.back()">← The page before</button>
		<a class="button is-small" href="/competitions">Your competitions and pages</a>
	</p>
}

templ problemList(problems []string) {
	if len(problems) > 0 {
		<div class="notification is-danger is-light" role="alert">
			<ul>
				for _, p := range problems {
					<li>{ p }</li>
				}
			</ul>
		</div>
	}
}

// linkBox shows a link to copy. A secret one says so. It's blurred in a
// picture sent with feedback (data-private, Light).
templ linkBox(label, url, hint string) {
	<div class="field comp-link">
		<label class="label is-small">{ label }</label>
		<div class="field has-addons">
			<div class="control is-expanded">
				<input class="input is-small" type="text" readonly value={ url } aria-label={ label } data-private/>
			</div>
			<div class="control">
				<button type="button" class="button is-small" data-copy={ url }>Copy</button>
			</div>
		</div>
		if hint != "" {
			<p class="help">{ hint }</p>
		}
	</div>
}

// NewCompetition is the form that creates a competition.
templ NewCompetition(f CompetitionForm) {
	@competitionLayout("New competition") {
		<h1 class="title is-4">New competition</h1>
		<p class="mb-4">Collect gymnasts' competition cards before the day, each checked against its level. There are no accounts: you get an admin link to keep, and links to give clubs and gymnasts.</p>
		@problemList(f.Problems)
		<form method="post" action="/competitions" id="new-competition">
			<div class="field">
				<label class="label" for="comp-name">Name</label>
				<input class="input" id="comp-name" name="name" required maxlength="80" value={ f.Name } placeholder="e.g. Student Open 2027"/>
			</div>
			<div class="field">
				<label class="label" for="comp-date">Date</label>
				<input class="input" id="comp-date" name="date" type="date" required value={ f.Date }/>
				<p class="help">The (first) day of the competition.</p>
			</div>
			<div class="field">
				<label class="label">Entries close</label>
				<div class="comp-deadline">
					<input class="input" name="deadlineDate" type="date" required value={ f.DeadlineDate } aria-label="Closing date"/>
					<input class="input" name="deadlineTime" type="time" required value={ f.DeadlineTime } aria-label="Closing time"/>
				</div>
				<p class="help">Irish and UK time. Clubs and gymnasts can change entries until then.</p>
			</div>
			<fieldset class="field">
				<legend class="label">Entries open</legend>
				<label class="radio is-block mb-1">
					<input type="radio" name="opens" value="later" checked?={ f.Opens != "now" && f.Opens != "at" }/>
					When I go live: set it up in private first
				</label>
				<label class="radio is-block mb-1 ml-0">
					<input type="radio" name="opens" value="at" checked?={ f.Opens == "at" }/>
					At a set time
				</label>
				<div class="comp-deadline mb-1 ml-4">
					<input class="input is-small" name="liveDate" type="date" value={ f.LiveDate } aria-label="Opening date"/>
					<input class="input is-small" name="liveTime" type="time" value={ f.LiveTime } aria-label="Opening time"/>
				</div>
				<label class="radio is-block ml-0">
					<input type="radio" name="opens" value="now" checked?={ f.Opens == "now" }/>
					Now
				</label>
				<p class="help">Until then, the club link and the link for entering on their own show the competition's name and date, and when entries open, so you can share them early.</p>
			</fieldset>
			<div class="field">
				<label class="checkbox comp-check">
					<input type="checkbox" name="individuals" value="1" checked?={ f.Individuals }/>
					Gymnasts can also enter on their own, not only through a club
				</label>
			</div>
			<fieldset class="field">
				<legend class="label">Levels</legend>
				<p class="help mb-2">Tick every level gymnasts can enter.</p>
				@levelGroups(f.Groups, "level", f.Levels)
				// The levels saved in this browser, filled by static/js/competitions.js.
				<details id="own-levels" class="comp-level-group" hidden>
					<summary>Your own levels</summary>
				</details>
			</fieldset>
			@otherEvents(f.Events)
			@videoFields(f.Video)
			@signoffField(f.Signoff)
			<div class="field">
				<label class="checkbox comp-check">
					<input type="checkbox" name="split" value="all" checked?={ f.SplitAll }/>
					Rank men and women separately
				</label>
				<p class="help">Gymnasts say which when entering. Afterwards, under Settings, you can split only some levels; the timetable can still run them in mixed flights.</p>
			</div>
			<button class="button is-primary" type="submit">Create competition</button>
		</form>
		// The competitions already saved here, after the form this page is
		// for (Competitions and clubs lists them too).
		<div id="saved-competitions" class="mt-5" hidden>
			<h2 class="title is-6 mb-2">Your competitions in this browser</h2>
			<ul></ul>
		</div>
	}
}

func groupChosen(g requirements.BuiltinGroup, chosen map[string]bool) bool {
	for _, l := range g.Levels {
		if chosen[requirements.BuiltinLevelPrefix+l.ID] {
			return true
		}
	}
	return false
}

// newAdminLink tells the organiser to save the admin link they've just been given.
templ newAdminLink(c CompetitionSummary, link, which string) {
	<div class="notification is-warning is-light">
		<p class="mb-2">
			<strong>
				if which == "replaced" {
					Your new admin link.
				} else {
					Competition created.
				}
			</strong>
			Save this page's link, the admin link: it's the only way back to the entries, and anyone who has it can manage the competition.
		</p>
		<div data-competition-admin={ link } data-competition-name={ c.Name } data-replaces?={ which == "replaced" }>
			@linkBox("Admin link (keep it secret)", link, "Saved in this browser too: it's under Your competitions in this browser, on the Competitions page.")
		</div>
	</div>
}

templ competitionFacts(c CompetitionSummary) {
	<p class="mb-1">{ c.Date }</p>
	<p class={ templ.KV("mb-4", c.Video == "" && !c.Signoff), templ.KV("mb-1", c.Video != "" || c.Signoff) }>
		if c.Open {
			Entries close { c.Deadline }.
			if c.ChangesUntil != "" {
				Changes to entries until { c.ChangesUntil }.
			}
			if c.SignoffsUntil != "" && c.Signoff {
				Coaches' sign-off until { c.SignoffsUntil }.
			}
		} else if c.Live && (c.ChangesOpen || c.SignoffsOpen && c.Signoff) {
			<strong>New entries closed { c.Deadline }.</strong>
			if c.ChangesOpen {
				Changes to entries until { c.ChangesUntil }.
			}
			if c.SignoffsOpen && c.Signoff {
				Coaches' sign-off until { c.SignoffsUntil }.
			}
		} else if !c.Live && c.Opens != "" {
			<strong>Entries open { c.Opens }</strong>, and close { c.Deadline }.
		} else if !c.Live {
			<strong>Entries aren't open at the moment.</strong> They close { c.Deadline }.
		} else {
			<strong>Entries closed { c.Deadline }.</strong>
		}
	</p>
	if c.Video != "" {
		<p class={ templ.KV("mb-4", !c.Signoff), templ.KV("mb-1", c.Signoff) }>{ c.Video }, as a link.</p>
	}
	if c.Signoff {
		<p class="mb-4">Entries need a coach's sign-off.</p>
	}
}

// liveBox is the organiser's way to go live, while the competition is
// private or due to go live.
templ liveBox(base string, c CompetitionSummary, liveDate, liveTime, from string) {
	if !c.Live {
		<div class="box comp-live">
			<p class="mb-2">
				<strong>Private.</strong>
				if c.Opens != "" {
					It goes live { c.Opens }.
				}
				The club link and the link for entering on their own show the competition's name and date, and when entries open, but nobody can enter until it's live.
			</p>
			<form method="post" action={ templ.SafeURL(base + "/live") } class="mb-2">
				<input type="hidden" name="opens" value="now"/>
				@backField(from)
				<button class="button is-small is-primary" type="submit">Go live now</button>
			</form>
			<p class="is-size-7 mb-1">
				if c.Opens != "" {
					Or change when:
				} else {
					Or go live at a set time:
				}
			</p>
			<form method="post" action={ templ.SafeURL(base + "/live") } class="comp-deadline">
				<input type="hidden" name="opens" value="at"/>
				@backField(from)
				<input class="input is-small" name="liveDate" type="date" required value={ liveDate } aria-label="Opening date"/>
				<input class="input is-small" name="liveTime" type="time" required value={ liveTime } aria-label="Opening time"/>
				<button class="button is-small" type="submit">
					if c.Opens != "" {
						Change
					} else {
						Go live then
					}
				</button>
			</form>
			if c.Opens != "" {
				<form method="post" action={ templ.SafeURL(base + "/live") } class="mt-2">
					<input type="hidden" name="opens" value="private"/>
					@backField(from)
					<button class="button is-small is-text" type="submit">Don't go live then: stay private</button>
				</form>
			}
		</div>
	}
}

// CompetitionEntry is the organiser's view of one entry.
// backField says which page a form came from, so the answer goes back to it.
templ backField(from string) {
	if from != "" {
		<input type="hidden" name="back" value={ from }/>
	}
}

// organiserNote is the organiser's note on an entry, for the club or gymnast.
templ organiserNote(note string) {
	if note != "" {
		<div class="notification is-info is-light">
			<p><strong>Note from the organiser:</strong> { note }</p>
		</div>
	}
}

// videoFields choose what video proof a competition asks for (ADR 0004
// Decision 10).
templ videoFields(v VideoForm) {
	<fieldset class="field comp-video">
		<legend class="label">Video proof</legend>
		<p class="help mb-2">Ask for video showing gymnasts can perform their routines safely. Gymnasts send a link (YouTube, Google Drive, Vimeo, Dropbox or OneDrive): nothing is uploaded here, and you open each video in a new tab.</p>
		<label class="radio comp-option"><input type="radio" name="video" value="" checked?={ v.Need == "" }/> No video</label>
		<label class="radio comp-option"><input type="radio" name="video" value="skills" checked?={ v.Need == "skills" }/> Video of some skills:</label>
		<div class="comp-video-skills">
			<label class="checkbox comp-level"><input type="checkbox" name="videoTriples" value="1" checked?={ v.Triples }/> any triple somersault</label>
			<label class="checkbox comp-level"><input type="checkbox" name="videoDoubles" value="1" checked?={ v.Doubles }/> any double somersault or more</label>
			// Its box isn't posted: unticked, the script empties the tariff, which is what's sent.
			<label class="checkbox comp-level">
				<input type="checkbox" data-video-tariff checked?={ v.Tariff != "" }/>
				any skill of tariff
				<input class="input is-small comp-tariff" type="number" name="videoTariff" min="0.1" max="5" step="0.1" value={ v.Tariff } aria-label="Tariff"/>
				or more
			</label>
		</div>
		<label class="radio comp-option"><input type="radio" name="video" value="routine" checked?={ v.Need == "routine" }/> Video of each whole routine</label>
	</fieldset>
}

// videoReviewNote is the organiser's review of an entry's videos, for the
// club or gymnast.
templ videoReviewNote(review, note string) {
	if review == "ok" {
		<p class="mb-2"><strong>✓ Video accepted by the organiser.</strong></p>
	} else if review == "more" {
		<div class="notification is-warning is-light">
			<p><strong>The organiser needs more video:</strong> { note }</p>
		</div>
	}
}

// signoffField asks whether entries need a coach's sign-off (ADR 0004
// Decision 11).
templ signoffField(on bool) {
	<div class="field">
		<label class="checkbox comp-check">
			<input type="checkbox" name="signoff" value="1" checked?={ on }/>
			Entries need a coach's sign-off
		</label>
		<p class="help">Clubs' coaches sign off their members' routines; gymnasts entering on their own send their coach a sign-off link. Entries without one can still be sent, flagged as a problem.</p>
	</div>
}

// SplitForm chooses which levels split men and women: none, all, or some.
type SplitForm struct {
	Mode   string          // "", "all" or "some"
	Levels []string        // the levels to choose from
	Chosen map[string]bool // with "some": the levels split
}

// splitFields chooses levels to split, posting name (the mode) and levelName
// (each level, with "some").
templ splitFields(name, levelName, legend, help string, f SplitForm) {
	<fieldset class="field">
		<legend class="label is-small">{ legend }</legend>
		<p class="help mb-2">{ help }</p>
		<label class="radio comp-option"><input type="radio" name={ name } value="" checked?={ f.Mode == "" }/> Not separately</label>
		<label class="radio comp-option"><input type="radio" name={ name } value="all" checked?={ f.Mode == "all" }/> Separately at every level</label>
		<label class="radio comp-option"><input type="radio" name={ name } value="some" checked?={ f.Mode == "some" }/> Separately at these levels:</label>
		<div class="comp-video-skills">
			for _, l := range f.Levels {
				<label class="checkbox comp-level"><input type="checkbox" name={ levelName } value={ l } checked?={ f.Chosen[l] }/> { l }</label>
			}
		</div>
	</fieldset>
}

// levelGroups ticks built-in levels, group by group, posting each as name.
templ levelGroups(groups []requirements.BuiltinGroup, name string, chosen map[string]bool) {
	for _, g := range groups {
		if len(g.Levels) > 0 {
			<details class="comp-level-group" open?={ groupChosen(g, chosen) }>
				<summary>{ g.Name }</summary>
				for _, l := range g.Levels {
					<label class="checkbox comp-level">
						<input type="checkbox" name={ name } value={ requirements.BuiltinLevelPrefix + l.ID } checked?={ chosen[requirements.BuiltinLevelPrefix+l.ID] }/>
						{ l.Level.Name }
					</label>
				}
			</details>
		}
	}
}

// EventsForm is the competition's events beyond individual trampoline (ADR
// 0005 Decision 1).
type EventsForm struct {
	Groups   []requirements.BuiltinGroup
	Synchro  map[string]bool // built-in levels ticked for synchro
	Pairs    string          // synchro levels paired into one event, one event a line: "BUCS L1 + BUCS L2"
	Tumbling string          // one level a line
	DMT      string
}

// otherEvents chooses synchro levels and names tumbling and DMT levels.
templ otherEvents(f EventsForm) {
	<fieldset class="field">
		<legend class="label">Synchro, tumbling and DMT</legend>
		<p class="help mb-2">Optional. Synchro routines are checked like trampoline's; tumbling and DMT entries are a level only, for now.</p>
		<details class="comp-level-group" open?={ len(f.Synchro) > 0 }>
			<summary>Synchro levels</summary>
			<div class="pl-4">
				@levelGroups(f.Groups, "synchroLevel", f.Synchro)
				<div class="field mt-2">
					<label class="label is-small" for="events-synchro-pairs">Pair synchro levels into one event (optional)</label>
					<textarea class="textarea is-small" id="events-synchro-pairs" name="synchroPairs" rows={ linesRows(f.Pairs) } placeholder="e.g. BUCS L1 + BUCS L2">{ f.Pairs }</textarea>
					<p class="help">One event a line, levels joined by +: they're flighted and ranked as one (e.g. "BUCS L1/L2"), and each pair says which level they're doing: the one they both compete at, or the easier of two a level apart.</p>
				</div>
			</div>
		</details>
		<div class="field mt-2">
			<label class="label is-small" for="events-tumbling">Tumbling levels, one a line, easiest first</label>
			<textarea class="textarea is-small" id="events-tumbling" name="tumbling" rows={ linesRows(f.Tumbling) } placeholder="e.g. Novice">{ f.Tumbling }</textarea>
		</div>
		<div class="field">
			<label class="label is-small" for="events-dmt">DMT levels, one a line, easiest first</label>
			<textarea class="textarea is-small" id="events-dmt" name="dmt" rows={ linesRows(f.DMT) } placeholder="e.g. Novice">{ f.DMT }</textarea>
		</div>
	</fieldset>
}

// levelOrderForm moves levels up and down each discipline's order. Judging
// "up to" a level, and "only levels below their own", go by it.
templ levelOrderForm(base string, order []LevelOrder) {
	<form method="post" action={ templ.SafeURL(base + "/levels/move") } class="mb-3" id="level-order">
		<p class="label is-small">Order of levels</p>
		<p class="help mb-2">Easiest first. A judge offering "up to" a level judges it and the levels before it.</p>
		for _, o := range order {
			if len(order) > 1 {
				<p class="is-size-7 has-text-weight-semibold mt-2">{ o.Name }</p>
			}
			<ol class="comp-level-order">
				for i, name := range o.Levels {
					<li>
						<span class="comp-level-name">{ name }</span>
						if i > 0 {
							<button class="button is-small" type="submit" name="move" value={ fmt.Sprintf("%s:%d:-1", o.Discipline, i) } aria-label={ "Move " + name + " earlier (easier)" }>↑</button>
						} else {
							<span class="comp-level-gap"></span>
						}
						if i < len(o.Levels)-1 {
							<button class="button is-small" type="submit" name="move" value={ fmt.Sprintf("%s:%d:1", o.Discipline, i) } aria-label={ "Move " + name + " later (harder)" }>↓</button>
						} else {
							<span class="comp-level-gap"></span>
						}
					</li>
				}
			</ol>
		}
	</form>
}

// linesRows is a box's height for its text: every line, and one more to add.
func linesRows(text string) string {
	return strconv.Itoa(max(2, strings.Count(strings.TrimRight(text, "\n"), "\n")+2))
}
