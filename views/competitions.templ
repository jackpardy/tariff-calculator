package views

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"tariffCalculator/requirements"
	"tariffCalculator/skills"
	"tariffCalculator/static"
)

// CompetitionSummary is what every competition page says about it, with dates
// already written for Ireland and the UK.
type CompetitionSummary struct {
	Name        string
	Date        string // e.g. "Saturday 13 March 2027"
	Deadline    string // e.g. "Saturday 6 March 2027, 23:59"
	DeleteAfter string // when it and its entries are deleted
	Open        bool   // entries can still be sent or changed
	Live        bool   // gone live: not private, being set up or paused
	Opens       string // when it goes live, if it's due to, e.g. "Monday 1 February 2027, 09:00"
	Individuals bool   // individuals can enter directly
	Video       string // what video proof it asks for, "" for none
	Signoff     bool   // entries need a coach's sign-off
}

// CompetitionForm is the form that creates a competition. Levels are the
// built-in levels ticked, by reference; a coach's own levels come from the
// browser (static/js/competitions.js) and are posted as JSON.
type CompetitionForm struct {
	Name, Date, DeadlineDate, DeadlineTime string
	Opens                                  string // "later" (private), "now" or "at"
	LiveDate, LiveTime                     string // when, for "at"
	Individuals                            bool
	Levels                                 map[string]bool
	Groups                                 []requirements.BuiltinGroup
	Video                                  VideoForm
	Signoff                                bool
	SplitAll                               bool // rank men and women separately at every level
	Events                                 EventsForm
	Problems                               []string
}

// VideoForm is the choice of video proof a competition asks for: none, for
// some skills (triples, doubles, or a tariff or more), or every whole routine.
type VideoForm struct {
	Need             string // "", "skills" or "routine"
	Triples, Doubles bool
	Tariff           string // e.g. "1.5", "" for none
}

// CompetitionLinks are a competition's links, as full URLs. Admin is set only
// when it's just been made or replaced: it's shown once.
type CompetitionLinks struct {
	Admin, Club, Individual string
}

// Dashboard is the organiser's overview of every entry.
type Dashboard struct {
	Base          string // the admin link's path, which the dashboard's own links extend
	New           string // "created" or "replaced" just after the admin link was made, to say to save it
	Notice        string // what just happened
	DeadlineDate  string // the closing time, for changing it
	DeadlineTime  string
	LiveDate      string // when it's due to go live, for changing it
	NotifyOn      bool   // people can ask to hear about changes (ADR 0008)
	NotifyAt      string // when the changes waiting are told, e.g. "14:32"; "" for none
	NoWait        bool   // no wait on the competition's days
	LiveTime      string
	Unchecked     int // entries not checked yet
	Withdrawn     int // entries withdrawn since their club sent them
	Video         VideoForm
	CoachApproval CoachApprovalForm
	Split         SplitForm
	Events        EventsForm
	LevelOrder    []LevelOrder
	Competition   CompetitionSummary
	Links         CompetitionLinks
	Clubs         []string // the clubs entered, by name
	Club          string   // the club the table is filtered to ("" for all, "individual" for individuals)
	ProblemsOnly  bool
	Entries       int // every entry, before filtering
	WithProblems  int
	Levels        []DashboardLevel
	Removed       []RemovedRow // entries removed or held
	// The filters (roadmap 2026-10-08): as given, and each.
	Filter                                    url.Values
	Search, Coach                             string
	CheckedFilter, SignedFilter, VideoFilter string // "", yes or no; a video status
	Category, Sort                            string
	CanSplit                                  bool     // some levels rank men and women apart
	Coaches                                   []string // the coaches entries have, to filter by
	Shown                                     int      // entries the filters show
}

// RemovedRow is an entry the organiser removed or holds.
type RemovedRow struct {
	ID, Gymnast, Club, Level string
	Held                     bool   // on hold for changes, not removed
	Resent                   bool   // held, changed and sent again: waiting to be accepted
	Note                     string // the reason
	To                       string // who sees it, e.g. "the club"
}

// LevelOrder is one discipline's levels, easiest first, for the organiser to
// move.
type LevelOrder struct {
	Discipline, Name string
	Levels           []string
}

// DashboardLevel is one level's table.
type DashboardLevel struct {
	Name   string
	Anchor string // its id on the page, to jump to
	Total  int    // its entries, before the filters
	Rows   []DashboardRow
}

// DashboardRow is one entry in a level's table.
type DashboardRow struct {
	ID, Gymnast, Club string
	Exercises         [2]string // a set routine's name, or a voluntary's difficulty
	Met, Rules        int
	Problems          []string
	Sent              string
	Checked           bool
	Note              string
	Video             string // "" when not needed, else missing, provided, OK or need more
	Withdrawn         bool   // withdrawn since the club sent it
	Category          string // Men or Women, where the level splits them
	Signoff           SignoffView
	Coach             string // who coaches them: who signed off, or else their coach
}

// EntryCard is an entry checked exactly as the builder checks a level.
type EntryCard struct {
	Gymnast, Club, Level string
	Exercises            [2]ExerciseCard
	Problems             []string
	Signoff              SignoffView
	Unchecked            bool // tumbling or DMT: a level only
}

// ExerciseCard is one exercise of an entry, checked.
type ExerciseCard struct {
	Title        string // "First exercise"
	Requirements string // what it's checked against
	SetRoutine   bool   // performed as written
	Validation   skills.RoutineValidation
	Checks       Checks
	Results      []requirements.Result
	Required     map[int]bool
	SetErr       string
	Video        VideoView
	Carried      []int // elements whose difficulty carries over (first exercise)
	Repeated     []int // elements repeating one that carried over (second exercise)
	Skip         bool  // not done: synchro does only the level's voluntary
}

// EntryDetail is the organiser's view of one entry.
type EntryDetail struct {
	Base        string
	ID          string
	Competition CompetitionSummary
	Card        EntryCard
	Sent        string
	Checked     string // when it was marked checked, "" if it isn't
	Note        string
	VideoReview string // "", "ok" or "more"
	VideoNote   string
	Withdrawn   bool // withdrawn since the club sent it
}

// EntryForm enters or replaces an individual's entry. Each level's exercises
// are listed, and the page (static/js/competitions.js) shows the chosen
// level's and fills each voluntary from the routines saved in this browser.
type EntryForm struct {
	Action   string // where the form posts
	Key      string // tells forms on the same page apart
	Submit   string // its button
	Gymnast  string
	Member   bool   // the gymnast is a club's member, under their own name
	Video    string // what video the competition asks for, "" for none
	Level    string
	Category string // Men or Women, where the level splits them
	Levels   []EntryLevel
	Problems []string
	// The discipline: "" for individual trampoline, or synchro (with a
	// partner), tumbling or DMT (a level only: not checked).
	Discipline  string
	Synchro     bool
	Unchecked   bool
	PartnerName string
	PartnerClub string
}

// EntryLevel is a level an entry can choose, with its two exercises.
type EntryLevel struct {
	Name      string // posted as the level
	Label     string // how it's shown, if not its name: "BUCS L1/L2 (doing BUCS L1)"
	Split     bool   // gymnasts say Men or Women
	Exercises [2]EntryExercise
}

// EntryExercise is one exercise's choice: which option, and for a voluntary,
// which routine.
type EntryExercise struct {
	Options []EntryOption
	Chosen  string // the option chosen
	Skills  string // the routine as JSON, if one was chosen or entered already
	Count   int    // how many skills it has
	Video   string // its video link and note, if the competition asks for video
	Note    string
	Skip    bool   // not done: synchro does only the level's voluntary
	Title   string // its heading, if not "First exercise" or "Second exercise"
}

// EntryOption is one of an exercise's options.
type EntryOption struct {
	Ref, Label string
	SetRoutine bool
}

// EntryPage is an individual's own entry, through their personal link.
type EntryPage struct {
	Competition CompetitionSummary
	Link        string // their personal link, as a full URL
	JustSaved   bool
	Sent        string
	Checked     bool   // the organiser checked it
	Note        string // the organiser's note
	VideoReview string // the organiser's review of its videos
	VideoNote   string
	Card        EntryCard
	Form        EntryForm
	Withdraw    string // where withdrawing posts
	SignoffLink string // the link for their coach to sign it off, where the competition needs it
	Partner     *PartnerView
	Placement   *Placement // where they compete, once the timetable is published
	Duties      []string   // their seats on panels, once the timetable is published
	Day         string     // their My competition page
	Offer       *OfferForm // what they offer to judge and help with
	Coach       *EntryCoachView // their coach, where the competition approves coaches
	Notice      string
	Pairs       []PairView // synchro entries they're the partner in
	Removal     string     // what the organiser did with it, and why, if anything
	Timeline    string     // their timetable as the panel timeline, once published
	Notify      string     // where they ask to hear about changes
}

// EntryCoachView is the coach an individual names, for the organiser to
// approve (ADR 0007 Decision 8).
type EntryCoachView struct {
	Name, Qualification string // as named; "" before
	Status              string // e.g. "Waiting for the organiser"
	Approved            bool
	Note                string // the organiser's
	Action              string // where naming them posts
	Options             []CoachOption
	Asked               string // the levels the competition asks for
}

// EnterPage is a competition's individual entry page.
type EnterPage struct {
	Competition CompetitionSummary
	Form        EntryForm
	Disciplines []DisciplineTab // to choose from, when there are several
}

// DisciplineTab is one of a competition's disciplines to enter.
type DisciplineTab struct {
	Name, URL string
	Current   bool
}

templ competitionLayout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<title>{ title }</title>
			<meta name="app-version" content={ static.Version }/>
			<script defer src={ static.URL("js/version.js") }></script>
			<link rel="stylesheet" href={ static.URL("css/bulma.min.css") }/>
			<link rel="stylesheet" href={ static.URL("css/styles.css") }/>
			<script defer src={ static.URL("js/routines.js") }></script>
			<script defer src={ static.URL("js/sets.js") }></script>
			<script defer src={ static.URL("js/competitions.js") }></script>
		</head>
		<body>
			<section class="section comp-page">
				<div class="container">
					{ children... }
				</div>
			</section>
		</body>
	</html>
}

// Message is a page that only says something, e.g. a link that leads nowhere.
templ Message(title, text string) {
	@competitionLayout(title) {
		<h1 class="title is-4">{ title }</h1>
		<p>{ text }</p>
	}
}

templ problemList(problems []string) {
	if len(problems) > 0 {
		<div class="notification is-danger is-light" role="alert">
			<ul>
				for _, p := range problems {
					<li>{ p }</li>
				}
			</ul>
		</div>
	}
}

// linkBox shows a link to copy. A secret one says so.
templ linkBox(label, url, hint string) {
	<div class="field comp-link">
		<label class="label is-small">{ label }</label>
		<div class="field has-addons">
			<div class="control is-expanded">
				<input class="input is-small" type="text" readonly value={ url } aria-label={ label }/>
			</div>
			<div class="control">
				<button type="button" class="button is-small" data-copy={ url }>Copy</button>
			</div>
		</div>
		if hint != "" {
			<p class="help">{ hint }</p>
		}
	</div>
}

// NewCompetition is the form that creates a competition.
templ NewCompetition(f CompetitionForm) {
	@competitionLayout("New competition") {
		<h1 class="title is-4">New competition</h1>
		<p class="mb-4">Collect gymnasts' competition cards before the day, each checked against its level. There are no accounts: you get an admin link to keep, and links to give clubs and gymnasts.</p>
		<div id="saved-competitions" class="box" hidden>
			<h2 class="title is-6">Your competitions in this browser</h2>
			<ul></ul>
		</div>
		@problemList(f.Problems)
		<form method="post" action="/competitions" id="new-competition">
			<div class="field">
				<label class="label" for="comp-name">Name</label>
				<input class="input" id="comp-name" name="name" required maxlength="80" value={ f.Name } placeholder="e.g. Student Open 2027"/>
			</div>
			<div class="field">
				<label class="label" for="comp-date">Date</label>
				<input class="input" id="comp-date" name="date" type="date" required value={ f.Date }/>
				<p class="help">The (first) day of the competition.</p>
			</div>
			<div class="field">
				<label class="label">Entries close</label>
				<div class="comp-deadline">
					<input class="input" name="deadlineDate" type="date" required value={ f.DeadlineDate } aria-label="Closing date"/>
					<input class="input" name="deadlineTime" type="time" required value={ f.DeadlineTime } aria-label="Closing time"/>
				</div>
				<p class="help">Irish and UK time. Clubs and gymnasts can change entries until then.</p>
			</div>
			<fieldset class="field">
				<legend class="label">Entries open</legend>
				<label class="radio is-block mb-1">
					<input type="radio" name="opens" value="later" checked?={ f.Opens != "now" && f.Opens != "at" }/>
					When I go live: set it up in private first
				</label>
				<label class="radio is-block mb-1 ml-0">
					<input type="radio" name="opens" value="at" checked?={ f.Opens == "at" }/>
					At a set time
				</label>
				<div class="comp-deadline mb-1 ml-4">
					<input class="input is-small" name="liveDate" type="date" value={ f.LiveDate } aria-label="Opening date"/>
					<input class="input is-small" name="liveTime" type="time" value={ f.LiveTime } aria-label="Opening time"/>
				</div>
				<label class="radio is-block ml-0">
					<input type="radio" name="opens" value="now" checked?={ f.Opens == "now" }/>
					Now
				</label>
				<p class="help">Until then, the club and individual links show the competition's name and date, and when entries open, so you can share them early.</p>
			</fieldset>
			<div class="field">
				<label class="checkbox">
					<input type="checkbox" name="individuals" value="1" checked?={ f.Individuals }/>
					Gymnasts can also enter on their own, not only through a club
				</label>
			</div>
			<fieldset class="field">
				<legend class="label">Levels</legend>
				<p class="help mb-2">Tick every level gymnasts can enter.</p>
				@levelGroups(f.Groups, "level", f.Levels)
				// The levels saved in this browser, filled by static/js/competitions.js.
				<details id="own-levels" class="comp-level-group" hidden>
					<summary>Your own levels</summary>
				</details>
			</fieldset>
			@otherEvents(f.Events)
			@videoFields(f.Video)
			@signoffField(f.Signoff)
			<div class="field">
				<label class="checkbox">
					<input type="checkbox" name="split" value="all" checked?={ f.SplitAll }/>
					Rank men and women separately
				</label>
				<p class="help">Gymnasts say which when entering. Afterwards, under Links and settings, you can split only some levels; the timetable can still run them in mixed flights.</p>
			</div>
			<button class="button is-primary is-fullwidth" type="submit">Create competition</button>
		</form>
	}
}

func groupChosen(g requirements.BuiltinGroup, chosen map[string]bool) bool {
	for _, l := range g.Levels {
		if chosen[requirements.BuiltinLevelPrefix+l.ID] {
			return true
		}
	}
	return false
}

// newAdminLink tells the organiser to save the admin link they've just been given.
templ newAdminLink(c CompetitionSummary, link, which string) {
	<div class="notification is-warning is-light">
		<p class="mb-2">
			<strong>
				if which == "replaced" {
					Your new admin link.
				} else {
					Competition created.
				}
			</strong>
			Save this page's link, the admin link: it's the only way back to the entries, and anyone who has it can manage the competition.
		</p>
		<div data-competition-admin={ link } data-competition-name={ c.Name }>
			@linkBox("Admin link (keep it secret)", link, "Saved in this browser too, under New competition.")
		</div>
	</div>
}

// Dashboard is the organiser's overview: every entry, by level, with its problems.
templ CompetitionDashboard(d Dashboard) {
	@competitionLayout(d.Competition.Name) {
		<h1 class="title is-4">{ d.Competition.Name }</h1>
		if d.New != "" {
			@newAdminLink(d.Competition, d.Links.Admin, d.New)
		}
		if d.Notice != "" {
			<div class="notification is-success is-light">{ d.Notice }</div>
		}
		@competitionFacts(d.Competition)
		if d.NotifyAt != "" {
			<form method="post" action={ templ.SafeURL(d.Base + "/notify-now") } class="notification is-info is-light">
				Your changes go to everyone who asked to hear about them at { d.NotifyAt }, after a wait in case anything is put back.
				<button class="button is-small ml-2" type="submit">Notify now</button>
			</form>
		}
		@liveBox(d)
		<nav class="level is-mobile comp-counts">
			@count(d.Entries, "entries")
			@count(d.WithProblems, "with problems")
			@count(d.Unchecked, "not checked")
			if d.Withdrawn > 0 {
				@count(d.Withdrawn, "withdrawn")
			}
			@count(len(d.Clubs), "clubs")
		</nav>
		<details class="box comp-manage">
			<summary><strong>Links and settings</strong></summary>
			if d.Links.Club != "" {
				@linkBox("Club link", d.Links.Club, "Give it to clubs' competition secretaries: they enter their club and send its members' entries.")
			}
			if d.Competition.Individuals {
				@linkBox("Individual entry link", d.Links.Individual, "Anyone with it can enter on their own.")
			}
			<form method="post" action={ templ.SafeURL(d.Base + "/deadline") } class="mb-3">
				<label class="label is-small">Entries close</label>
				<div class="comp-deadline mb-2">
					<input class="input is-small" name="deadlineDate" type="date" required value={ d.DeadlineDate } aria-label="Closing date"/>
					<input class="input is-small" name="deadlineTime" type="time" required value={ d.DeadlineTime } aria-label="Closing time"/>
					<button class="button is-small" type="submit">Change</button>
				</div>
			</form>
			<form method="post" action={ templ.SafeURL(d.Base + "/events") } class="mb-3">
				@otherEvents(d.Events)
				<button class="button is-small" type="submit">Change events</button>
			</form>
			@levelOrderForm(d.Base, d.LevelOrder)
			<form method="post" action={ templ.SafeURL(d.Base + "/split") } class="mb-3">
				@splitFields("split", "splitLevel", "Men and women", "Which levels rank men and women separately. Their gymnasts say which when entering.", d.Split)
				<button class="button is-small" type="submit">Change</button>
			</form>
			<form method="post" action={ templ.SafeURL(d.Base + "/signoff") } class="mb-3">
				if d.Competition.Signoff {
					<input type="hidden" name="on" value="0"/>
					<button class="button is-small" type="submit">Stop requiring coach sign-off</button>
				} else {
					<input type="hidden" name="on" value="1"/>
					<button class="button is-small" type="submit">Require coach sign-off</button>
				}
			</form>
			if d.Competition.Signoff {
				@coachApprovalFields(d.Base, d.CoachApproval)
			}
			<form method="post" action={ templ.SafeURL(d.Base + "/video") } class="mb-3">
				@videoFields(d.Video)
				<button class="button is-small" type="submit">Change video proof</button>
			</form>
			if d.Competition.Live {
				<form method="post" action={ templ.SafeURL(d.Base + "/live") } class="mb-3">
					<input type="hidden" name="opens" value="private"/>
					<button class="button is-small" type="submit">Make private (pause entries)</button>
					<p class="help">Nobody can send or change entries until you go live again. Entries already made are kept.</p>
				</form>
			}
			if d.Competition.Open {
				<form method="post" action={ templ.SafeURL(d.Base + "/deadline") } class="mb-3">
					<input type="hidden" name="close" value="1"/>
					<button class="button is-small" type="submit">Close entries now</button>
					<p class="help">Nobody can send or change entries after that, unless you change the closing time again.</p>
				</form>
			}
			if d.NotifyOn {
				<form method="post" action={ templ.SafeURL(d.Base + "/no-wait") } class="mb-3">
					if d.NoWait {
						<input type="hidden" name="on" value="0"/>
						<button class="button is-small" type="submit">Wait 10 minutes before telling changes, on the competition's days too</button>
					} else {
						<input type="hidden" name="on" value="1"/>
						<button class="button is-small" type="submit">No wait on the competition's days</button>
					}
					<p class="help">Changes you publish, and cards you check, go to those who asked after 10 minutes, so a mistake put right tells no one. On the competition's days, news may not wait.</p>
				</form>
			}
			<form method="post" action={ templ.SafeURL(d.Base + "/individuals") } class="mb-3">
				if d.Competition.Individuals {
					<input type="hidden" name="on" value="0"/>
					<button class="button is-small" type="submit">Stop individual entries</button>
				} else {
					<input type="hidden" name="on" value="1"/>
					<button class="button is-small" type="submit">Let gymnasts enter on their own</button>
				}
			</form>
			<form method="post" action={ templ.SafeURL(d.Base + "/replace-link") } class="mb-3">
				<button class="button is-small" type="submit">Replace the admin link</button>
				<p class="help">If the admin link has been shared too widely. The old one stops working.</p>
			</form>
			<form method="post" action={ templ.SafeURL(d.Base + "/delete") }>
				<label class="checkbox is-size-7">
					<input type="checkbox" name="confirm" value="1" required/>
					Delete the competition and every entry, now
				</label>
				<button class="button is-small is-danger is-outlined ml-2" type="submit">Delete</button>
			</form>
		</details>
		@dashboardFilters(d)
		<div class="buttons">
			<a class="button is-small is-link is-light" href={ templ.SafeURL(d.Base + "/timetable") }>Timetable</a>
			<a class="button is-small is-link is-light" href={ templ.SafeURL(d.Base + "/officials") }>Officials</a>
			if d.CoachApproval.On {
				<a class="button is-small is-link is-light" href={ templ.SafeURL(d.Base + "/coaches") }>
					Coaches
					if d.CoachApproval.Waiting > 0 {
						<span class="tag is-warning ml-1">{ strconv.Itoa(d.CoachApproval.Waiting) } waiting</span>
					}
				</a>
			}
		</div>
		if d.Entries > 0 {
			<div class="buttons">
				<a class="button is-small" href={ templ.SafeURL(d.Base + "/cards" + filterQuery(d, "")) }>Print cards</a>
				<a class="button is-small" href={ templ.SafeURL(d.Base + "/cards?unchecked=1") }>Print cards not checked</a>
				<a class="button is-small" href={ templ.SafeURL(d.Base + "/entries.csv") } download>Download CSV</a>
			</div>
		}
		if d.Entries == 0 {
			<p class="has-text-grey">No entries yet. Clubs send theirs through the club link; individuals enter through theirs.</p>
		} else {
			@removeForm(d.Base)
		}
		if len(d.Levels) > 0 {
			<div class="buttons mt-4 mb-0">
				<button class="button is-small" type="button" onclick="document.querySelectorAll('details.comp-dash-level').forEach(e => e.open = true)">Expand all</button>
				<button class="button is-small" type="button" onclick="document.querySelectorAll('details.comp-dash-level').forEach(e => e.open = false)">Collapse all</button>
			</div>
		}
		for _, l := range d.Levels {
			<details class="comp-dash-level" id={ l.Anchor } data-level={ l.Name } data-remember?={ !filtered(d) } open?={ filtered(d) && len(l.Rows) > 0 }>
			<summary class="title is-5 mt-5">
				{ l.Name } <span class="has-text-grey is-size-6">({ shownCount(d, l) })</span>
				if len(l.Rows) > 0 {
					<a class="is-size-7 has-text-weight-normal ml-2" href={ templ.SafeURL(d.Base + "/cards" + filterQuery(d, l.Name)) }>Print this level</a>
				}
			</summary>
			if len(l.Rows) == 0 {
				<p class="has-text-grey is-size-7">None</p>
			} else {
				<div class="table-container">
					<table class="table is-fullwidth is-narrow comp-table comp-entries">
						<thead>
							<tr>
								<th><input type="checkbox" aria-label={ "Tick all of " + l.Name } onchange="this.closest('table').querySelectorAll('input[name=entry]').forEach(c => c.checked = this.checked)"/></th>
								<th>Gymnast</th>
								<th>Club</th>
								<th>1st exercise</th>
								<th>2nd exercise</th>
								<th>Requirements</th>
								<th>Problems</th>
								<th>Sent</th>
								if d.Competition.Video != "" {
									<th>Video</th>
								}
								if d.Competition.Signoff {
									<th>Coach</th>
								}
								<th>Checked</th>
							</tr>
						</thead>
						<tbody>
							for _, r := range l.Rows {
								<tr class={ templ.KV("has-problems", len(r.Problems) > 0 && !r.Withdrawn), templ.KV("is-withdrawn", r.Withdrawn) }>
									<td><input type="checkbox" name="entry" value={ r.ID } form="remove-form" aria-label={ "Tick " + r.Gymnast }/></td>
									<td>
										<a href={ templ.SafeURL(d.Base + "/entries/" + r.ID) }>{ r.Gymnast }</a>
										if r.Withdrawn {
											<span class="tag is-warning is-light ml-1" title="Withdrawn since the club sent it; it goes when the club sends again">Withdrawn</span>
										}
									</td>
									<td>
										{ r.Club }
										if r.Category != "" {
											<span class="tag is-light ml-1">{ r.Category }</span>
										}
									</td>
									<td>{ r.Exercises[0] }</td>
									<td>{ r.Exercises[1] }</td>
									<td>
										if r.Rules > 0 {
											{ fmt.Sprintf("%d/%d %s", r.Met, r.Rules, markFor(r.Met == r.Rules)) }
										}
									</td>
									<td class="comp-problem-cell">
										if len(r.Problems) == 0 {
											–
										} else {
											{ r.Problems[0] }
											if len(r.Problems) > 1 {
												<span class="has-text-grey">{ fmt.Sprintf(" +%d more", len(r.Problems)-1) }</span>
											}
										}
									</td>
									<td>{ r.Sent }</td>
									if d.Competition.Video != "" {
										<td class={ templ.KV("has-text-danger", r.Video == "missing" || r.Video == "need more") }>
											if r.Video == "" {
												–
											} else {
												{ r.Video }
											}
										</td>
									}
									if d.Competition.Signoff {
										<td class={ templ.KV("has-text-success", r.Signoff.Signed), templ.KV("has-text-danger", !r.Signoff.Signed && !r.Withdrawn) } title={ r.Signoff.Note }>
											if r.Signoff.Signed {
												✓ { r.Signoff.By }
											} else {
												not signed off
											}
										</td>
									}
									<td title={ r.Note }>
										if r.Checked {
											✓
										} else {
											–
										}
										if r.Note != "" {
											<span class="has-text-grey" aria-label="Has a note">✎</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			</details>
		}
		@removedList(d.Base, d.Removed)
	}
}

func hasIndividuals(d Dashboard) bool {
	for _, l := range d.Levels {
		for _, r := range l.Rows {
			if r.Club == "individual" {
				return true
			}
		}
	}
	return false
}

templ count(n int, label string) {
	<div class="level-item has-text-centered">
		<div>
			<p class="title is-4">{ strconv.Itoa(n) }</p>
			<p class="heading">{ label }</p>
		</div>
	</div>
}

templ competitionFacts(c CompetitionSummary) {
	<p class="mb-1">{ c.Date }</p>
	<p class={ templ.KV("mb-4", c.Video == "" && !c.Signoff), templ.KV("mb-1", c.Video != "" || c.Signoff) }>
		if c.Open {
			Entries close { c.Deadline }.
		} else if !c.Live && c.Opens != "" {
			<strong>Entries open { c.Opens }</strong>, and close { c.Deadline }.
		} else if !c.Live {
			<strong>Entries aren't open at the moment.</strong> They close { c.Deadline }.
		} else {
			<strong>Entries closed { c.Deadline }.</strong>
		}
	</p>
	if c.Video != "" {
		<p class={ templ.KV("mb-4", !c.Signoff), templ.KV("mb-1", c.Signoff) }>{ c.Video }, as a link.</p>
	}
	if c.Signoff {
		<p class="mb-4">Entries need a coach's sign-off.</p>
	}
}

// liveBox is the organiser's way to go live, while the competition is
// private or due to go live.
templ liveBox(d Dashboard) {
	if !d.Competition.Live {
		<div class="box comp-live">
			<p class="mb-2">
				<strong>Private.</strong>
				if d.Competition.Opens != "" {
					It goes live { d.Competition.Opens }.
				}
				The club and individual links show the competition's name and date, and when entries open, but nobody can enter until it's live.
			</p>
			<form method="post" action={ templ.SafeURL(d.Base + "/live") } class="mb-2">
				<input type="hidden" name="opens" value="now"/>
				<button class="button is-small is-success" type="submit">Go live now</button>
			</form>
			<p class="is-size-7 mb-1">
				if d.Competition.Opens != "" {
					Or change when:
				} else {
					Or go live at a set time:
				}
			</p>
			<form method="post" action={ templ.SafeURL(d.Base + "/live") } class="comp-deadline">
				<input type="hidden" name="opens" value="at"/>
				<input class="input is-small" name="liveDate" type="date" required value={ d.LiveDate } aria-label="Opening date"/>
				<input class="input is-small" name="liveTime" type="time" required value={ d.LiveTime } aria-label="Opening time"/>
				<button class="button is-small" type="submit">
					if d.Competition.Opens != "" {
						Change
					} else {
						Go live then
					}
				</button>
			</form>
			if d.Competition.Opens != "" {
				<form method="post" action={ templ.SafeURL(d.Base + "/live") } class="mt-2">
					<input type="hidden" name="opens" value="private"/>
					<button class="button is-small is-text" type="submit">Don't go live then: stay private</button>
				</form>
			}
		</div>
	}
}

// CompetitionEntry is the organiser's view of one entry.
templ CompetitionEntry(d EntryDetail) {
	@competitionLayout(d.Card.Gymnast + " · " + d.Competition.Name) {
		<p class="mb-3"><a href={ templ.SafeURL(d.Base) }>← All entries</a></p>
		if d.Withdrawn {
			<div class="notification is-warning is-light">
				<p><strong>Withdrawn.</strong> { d.Card.Gymnast } has withdrawn this entry, or left the club, since { d.Card.Club } sent it. It goes when the club sends its entries again; until then it isn't counted or printed.</p>
			</div>
		}
		@entryCard(d.Card)
		<p class="has-text-grey is-size-7 mt-4">Sent { d.Sent }.</p>
		<div class="box mt-4">
			<form method="post" action={ templ.SafeURL(d.Base + "/entries/" + d.ID + "/check") }>
				if d.Checked != "" {
					<p class="mb-2"><strong>✓ Checked</strong> <span class="has-text-grey is-size-7">{ d.Checked }</span></p>
				}
				<div class="field">
					<label class="label is-small" for="check-note">Note for the club or gymnast</label>
					<textarea class="textarea is-small" id="check-note" name="note" rows="2" maxlength="500" placeholder="e.g. Element 7 repeats element 3: please change it">{ d.Note }</textarea>
				</div>
				<div class="buttons">
					if d.Checked == "" {
						<button class="button is-primary is-small" type="submit" name="checked" value="1">Mark checked</button>
						<button class="button is-small" type="submit" name="checked" value="0">Save the note</button>
					} else {
						<button class="button is-small" type="submit" name="checked" value="1">Save the note</button>
						<button class="button is-small" type="submit" name="checked" value="0">Unmark</button>
					}
					<a class="button is-small" href={ templ.SafeURL(d.Base + "/cards?entry=" + d.ID) }>Print card</a>
				</div>
				<p class="help">If the entry changes after you check it, it needs checking again. The note stays.</p>
			</form>
		</div>
		if d.Competition.Video != "" {
			<div class="box mt-4">
				<form method="post" action={ templ.SafeURL(d.Base + "/entries/" + d.ID + "/video") }>
					<p class="mb-2">
						<strong>Video</strong>
						switch d.VideoReview {
							case "ok":
								<span class="has-text-success">✓ OK</span>
							case "more":
								<span class="has-text-danger">needs more</span>
						}
					</p>
					<div class="field">
						<label class="label is-small" for="video-note">What more is needed (for the club or gymnast)</label>
						<input class="input is-small" id="video-note" name="note" maxlength="300" value={ d.VideoNote } placeholder="e.g. The full-in isn't in the video"/>
					</div>
					<div class="buttons">
						<button class="button is-small is-success is-light" type="submit" name="review" value="ok">Video OK</button>
						<button class="button is-small is-warning is-light" type="submit" name="review" value="more">Need more</button>
						if d.VideoReview != "" {
							<button class="button is-small" type="submit" name="review" value="">Clear</button>
						}
					</div>
					<p class="help">Whether a video shows the gymnast performing safely is your judgement. A new link clears the review.</p>
				</form>
			</div>
		}
	}
}

// entryCard is an entry checked: both exercises, side by side on wider screens.
templ entryCard(c EntryCard) {
	<h1 class="title is-4">{ c.Gymnast }</h1>
	<p class="subtitle is-6">{ c.Club } · { c.Level }</p>
	@signoffBox(c.Signoff)
	if c.Unchecked && len(c.Problems) == 0 {
	} else if len(c.Problems) == 0 {
		<div class="notification is-success is-light">No problems found.</div>
	} else {
		<div class="notification is-danger is-light">
			<p><strong>{ problemCount(len(c.Problems)) }</strong></p>
			<ul>
				for _, p := range c.Problems {
					<li>{ p }</li>
				}
			</ul>
		</div>
	}
	if c.Unchecked {
		<p class="has-text-grey">Entered at { c.Level }. Tumbling and DMT passes aren't checked yet.</p>
	} else {
		<div class="columns">
			for _, ex := range c.Exercises {
				if !ex.Skip {
					<div class="column">
						@exerciseCard(ex)
					</div>
				}
			}
		</div>
	}
}

func problemCount(n int) string {
	if n == 1 {
		return "1 problem"
	}
	return fmt.Sprintf("%d problems", n)
}

templ exerciseCard(ex ExerciseCard) {
	<div class="box comp-exercise">
		<h2 class="title is-6 mb-1">{ ex.Title }</h2>
		<p class="is-size-7 has-text-grey mb-2">
			{ ex.Requirements }
			if ex.SetRoutine {
				· set routine as written
			}
		</p>
		if ex.SetErr != "" {
			<p class="has-text-danger">{ ex.SetErr }</p>
		}
		if len(ex.Validation.Skills) == 0 {
			<p class="has-text-grey">No routine.</p>
		} else {
			<table class="table is-fullwidth is-narrow comp-skills">
				<tbody>
					for i, sv := range ex.Validation.Skills {
						<tr class={ templ.KV("not-counted", !sv.Counted && !sv.Unscored) }>
							<td class="has-text-grey">{ strconv.Itoa(i + 1) }</td>
							<td>
								{ displayName(sv.Skill) }
								if ex.Required[i+1] {
									<span title="Meets a requirement">*</span>
								}
								if ex.Validation.Messages[i] != "" {
									<br/>
									<span class="is-size-7 has-text-danger">{ ex.Validation.Messages[i] }</span>
								}
							</td>
							<td class="has-text-grey">{ sv.FIGNotation }</td>
							<td class="has-text-right">
								if ex.Checks.ScoreDifficulty {
									{ fmt.Sprintf("%.1f", sv.Skill.Tariff) }
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			<p class="has-text-right">
				if ex.Checks.ScoreDifficulty {
					<strong>Difficulty { fmt.Sprintf("%.1f", ex.Validation.TotalTariff) }</strong>
				} else {
					<span class="has-text-grey">No difficulty</span>
				}
			</p>
		}
		if len(ex.Carried) > 0 {
			<p class="is-size-7 mt-2">{ fmt.Sprintf("Difficulty carries over from elements %s.", elementNumbers(ex.Carried)) }</p>
		}
		if len(ex.Repeated) > 0 {
			<p class="is-size-7 mt-2 has-text-danger">{ fmt.Sprintf("Element %s repeats one whose difficulty carried over.", elementNumbers(ex.Repeated)) }</p>
		}
		@videoBox(ex.Video)
		if len(ex.Results) > 0 {
			<ul class="comp-results mt-3">
				for _, r := range ex.Results {
					<li class={ templ.KV("is-unmet", !r.Passed) }>
						{ markFor(r.Passed) } { r.Description }
						if r.Detail != "" && !r.Passed {
							<span class="has-text-grey is-size-7">({ r.Detail })</span>
						}
					</li>
				}
			</ul>
		}
	</div>
}

func elementNumbers(ns []int) string {
	out := ""
	for i, n := range ns {
		if i > 0 {
			out += ", "
		}
		out += strconv.Itoa(n)
	}
	return out
}

// CompetitionEnter is the individual entry page.
templ CompetitionEnter(p EnterPage) {
	@competitionLayout("Enter " + p.Competition.Name) {
		<h1 class="title is-4">Enter { p.Competition.Name }</h1>
		@competitionFacts(p.Competition)
		if p.Competition.Open {
			if len(p.Disciplines) > 1 {
				<div class="tabs is-small">
					<ul>
						for _, d := range p.Disciplines {
							<li class={ templ.KV("is-active", d.Current) }><a href={ templ.SafeURL(d.URL) }>{ d.Name }</a></li>
						}
					</ul>
				</div>
				<p class="help mb-3">Enter each discipline separately; each entry gets its own link.</p>
			}
			@entryForm(p.Form)
			@privacyNote(p.Competition)
		}
	}
}

templ privacyNote(c CompetitionSummary) {
	<p class="help mt-4">
		We keep the gymnast's name, level and routines, which the organiser and the difficulty judges see. Nothing else, and no account. They're deleted { c.DeleteAfter }, or sooner if the organiser deletes the competition.
	</p>
}

// entryForm chooses a level, each exercise's option and each voluntary's routine.
templ entryForm(f EntryForm) {
	@problemList(f.Problems)
	<form method="post" action={ templ.SafeURL(f.Action) } class="comp-entry-form">
		<input type="hidden" name="discipline" value={ f.Discipline }/>
		if !f.Member {
			<div class="field">
				<label class="label" for={ "entry-gymnast" + f.Key }>Gymnast</label>
				<input class="input" id={ "entry-gymnast" + f.Key } name="gymnast" required maxlength="80" value={ f.Gymnast } placeholder="Name, as on the results"/>
			</div>
		}
		if f.Synchro {
			<div class="field">
				<label class="label" for={ "entry-partner" + f.Key }>Synchro partner</label>
				<input class="input" id={ "entry-partner" + f.Key } name="partnerName" required maxlength="80" value={ f.PartnerName } placeholder="Their name"/>
				<input class="input mt-1" name="partnerClub" maxlength="80" value={ f.PartnerClub } placeholder="Their club (leave blank if none)" aria-label="Synchro partner's club"/>
				<p class="help">Any gymnast, from any club or none. You'll get a link to send them to confirm the pair.</p>
			</div>
		}
		if f.Unchecked {
			<p class="help mb-3">Tumbling and DMT entries are a level only: their passes aren't checked yet.</p>
		}
		<div class="field">
			<label class="label" for={ "entry-level" + f.Key }>Level</label>
			<div class="select is-fullwidth">
				<select id={ "entry-level" + f.Key } name="level" required>
					<option value="" disabled selected?={ f.Level == "" }>Choose a level</option>
					for _, l := range f.Levels {
						<option value={ l.Name } selected?={ f.Level == l.Name }>{ entryLevelLabel(l) }</option>
					}
				</select>
			</div>
		</div>
		for _, l := range f.Levels {
			<fieldset class="comp-entry-level" data-level={ l.Name } hidden?={ l.Name != f.Level } disabled?={ l.Name != f.Level }>
				if l.Split {
					<div class="field">
						<p class="label is-small">{ l.Name } ranks men and women separately</p>
						for _, c := range []string{"Men", "Women"} {
							<label class="radio comp-option">
								<input type="radio" name="category" value={ c } checked?={ f.Category == c } required/>
								{ c }
							</label>
						}
					</div>
				}
				if !f.Unchecked {
					for n, ex := range l.Exercises {
						if !ex.Skip {
							@entryExercise(n+1, ex, f.Video)
						}
					}
				}
			</fieldset>
		}
		<button class="button is-primary is-fullwidth mt-4" type="submit">{ f.Submit }</button>
	</form>
}

templ entryExercise(n int, ex EntryExercise, video string) {
	{{ prefix := fmt.Sprintf("ex%d", n) }}
	<div class="box comp-entry-exercise" data-exercise={ prefix }>
		<h2 class="title is-6">
			if ex.Title != "" {
				{ ex.Title }
			} else {
				{ titleCase(exerciseName(n)) } exercise
			}
		</h2>
		if len(ex.Options) > 1 {
			for _, o := range ex.Options {
				<label class="radio comp-option">
					<input type="radio" name={ prefix + "Option" } value={ o.Ref } data-set-routine={ strconv.FormatBool(o.SetRoutine) } checked?={ ex.Chosen == o.Ref } required/>
					{ o.Label }
				</label>
			}
		} else if len(ex.Options) == 1 {
			<input type="hidden" name={ prefix + "Option" } value={ ex.Options[0].Ref } data-set-routine={ strconv.FormatBool(ex.Options[0].SetRoutine) }/>
			<p class="is-size-7 has-text-grey">{ ex.Options[0].Label }</p>
		}
		<p class="comp-set-note is-size-7" hidden>The set routine, as written: nothing to choose.</p>
		<div class="field comp-routine mt-2">
			<label class="label is-small">Routine</label>
			<div class="select is-fullwidth">
				// Filled from the routines saved in this browser (static/js/competitions.js).
				<select data-routine-for={ prefix } aria-label={ "Routine for the " + exerciseName(n) + " exercise" }>
					if ex.Skills != "" {
						<option value="current" selected>{ fmt.Sprintf("Keep the routine entered (%d skills)", ex.Count) }</option>
					}
				</select>
			</div>
			<p class="help">One of the routines saved in this browser. Build it in the Routine Builder first.</p>
		</div>
		<input type="hidden" name={ prefix + "Skills" } value={ ex.Skills }/>
		if video != "" {
			<div class="field mt-3">
				<label class="label is-small">Video link</label>
				<input class="input is-small" type="url" name={ prefix + "Video" } value={ ex.Video } maxlength="500" placeholder="https://youtu.be/..." aria-label={ "Video link for the " + exerciseName(n) + " exercise" }/>
				<input class="input is-small mt-1" type="text" name={ prefix + "VideoNote" } value={ ex.Note } maxlength="200" placeholder="What it shows, e.g. Full-in at 0:42" aria-label={ "What the " + exerciseName(n) + " exercise's video shows" }/>
				<p class="help">{ video }. A YouTube video must be <strong>unlisted, not private</strong> (a private one only plays for people it's shared with); a Google Drive file must be shared with <strong>anyone with the link</strong>.</p>
			</div>
		}
	</div>
}

// CompetitionEntryPage is an individual's own entry, through their personal link.
templ CompetitionEntryPage(p EntryPage) {
	@competitionLayout(p.Card.Gymnast + " · " + p.Competition.Name) {
		<p class="has-text-grey mb-1">{ p.Competition.Name }</p>
		@competitionFacts(p.Competition)
		if p.JustSaved {
			<div class="notification is-success is-light">
				<p><strong>Entry saved.</strong> This is your personal link: keep it to change or withdraw the entry. It's saved in this browser too.</p>
			</div>
		}
		<div data-entry-link={ p.Link } data-entry-name={ p.Card.Gymnast + " · " + p.Competition.Name }>
			@linkBox("Your personal link (keep it to yourself)", p.Link, "")
		</div>
		@partnerBox(p.Partner)
		if p.Notice != "" {
			<div class="notification is-success is-light">{ p.Notice }</div>
		}
		if p.Removal != "" {
			<div class="notification is-warning is-light">{ p.Removal }</div>
		}
		if p.Coach != nil {
			@entryCoachBox(*p.Coach, p.Competition.Open)
		}
		if p.SignoffLink != "" {
			@linkBox("Sign-off link for your coach", p.SignoffLink, "This competition needs a coach's sign-off. Send this link to your coach: they see your entry and sign it off.")
		}
		@dayLink(p.Day)
		@timelineLinks(p.Timeline, "", p.Notify)
		@placementLine(p.Placement)
		@dutiesBox(p.Duties)
		if p.Checked {
			<p class="mb-2"><strong>✓ Checked by the organiser.</strong></p>
		}
		@organiserNote(p.Note)
		@videoReviewNote(p.VideoReview, p.VideoNote)
		@entryCard(p.Card)
		<p class="has-text-grey is-size-7">Entered { p.Sent }.</p>
		@pairEntries(p.Pairs)
		if p.Competition.Open {
			<details class="box mt-4" open?={ len(p.Form.Problems) > 0 }>
				<summary><strong>Change the entry</strong></summary>
				@entryForm(p.Form)
			</details>
			if p.Offer != nil {
				@offerBox(*p.Offer)
			}
			<form method="post" action={ templ.SafeURL(p.Withdraw) } class="mt-4">
				<label class="checkbox is-size-7">
					<input type="checkbox" name="confirm" value="1" required/>
					Withdraw this entry
				</label>
				<button class="button is-small is-danger is-outlined ml-2" type="submit">Withdraw</button>
			</form>
			@privacyNote(p.Competition)
		}
	}
}

// filterQuery is the dashboard's filter as a query for the cards page, for one
// level or ("") all.
func filterQuery(d Dashboard, level string) string {
	q := url.Values{}
	for k, v := range d.Filter {
		q[k] = v
	}
	if level != "" {
		q.Set("level", level)
	}
	if len(q) == 0 {
		return ""
	}
	return "?" + q.Encode()
}

// filtered says whether any filter is on.
func filtered(d Dashboard) bool { return len(d.Filter) > 0 }

// shownCount says how many of a level's entries are shown, e.g. "12 of 96".
func shownCount(d Dashboard, l DashboardLevel) string {
	if filtered(d) && len(l.Rows) != l.Total {
		return fmt.Sprintf("%d of %d", len(l.Rows), l.Total)
	}
	return strconv.Itoa(l.Total)
}

// CardsPage is a set of competition cards to print, one exercise per page.
type CardsPage struct {
	Title string
	Back  string
	Cards []PrintedCard
}

// PrintedCard is one exercise's card, its details filled in.
type PrintedCard struct {
	Validation skills.RoutineValidation
	Required   map[int]bool
	Checks     Checks
	Details    SheetDetails
}

// CompetitionCards prints competition cards, one per page.
templ CompetitionCards(p CardsPage) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<title>{ p.Title }</title>
			<meta name="app-version" content={ static.Version }/>
			<script defer src={ static.URL("js/version.js") }></script>
			<link rel="stylesheet" href={ static.URL("css/sheet.css") }/>
		</head>
		<body>
			<div class="toolbar screen-only">
				<a href={ templ.SafeURL(p.Back) }>← Entries</a>
				<button type="button" class="print" onclick="window.print()">Print / Save as PDF</button>
				<span>{ cardCount(len(p.Cards)) }</span>
			</div>
			if len(p.Cards) == 0 {
				<p class="hint">No entries to print.</p>
			}
			for _, c := range p.Cards {
				<section class="card-page">
					@TariffSheet(c.Validation, c.Required, c.Checks, c.Details)
				</section>
			}
		</body>
	</html>
}

func cardCount(n int) string {
	if n == 1 {
		return "1 card"
	}
	return fmt.Sprintf("%d cards", n)
}

// organiserNote is the organiser's note on an entry, for the club or gymnast.
templ organiserNote(note string) {
	if note != "" {
		<div class="notification is-info is-light">
			<p><strong>Note from the organiser:</strong> { note }</p>
		</div>
	}
}

// videoFields choose what video proof a competition asks for (ADR 0004
// Decision 10).
templ videoFields(v VideoForm) {
	<fieldset class="field comp-video">
		<legend class="label">Video proof</legend>
		<p class="help mb-2">Ask for video showing gymnasts can perform their routines safely. Gymnasts send a link (YouTube, Google Drive, Vimeo, Dropbox or OneDrive): nothing is uploaded here, and you open each video in a new tab.</p>
		<label class="radio comp-option"><input type="radio" name="video" value="" checked?={ v.Need == "" }/> No video</label>
		<label class="radio comp-option"><input type="radio" name="video" value="skills" checked?={ v.Need == "skills" }/> Video of some skills:</label>
		<div class="comp-video-skills">
			<label class="checkbox comp-level"><input type="checkbox" name="videoTriples" value="1" checked?={ v.Triples }/> any triple somersault</label>
			<label class="checkbox comp-level"><input type="checkbox" name="videoDoubles" value="1" checked?={ v.Doubles }/> any double somersault or more</label>
			<label class="checkbox comp-level">
				any skill of tariff
				<input class="input is-small comp-tariff" type="number" name="videoTariff" min="0.1" max="5" step="0.1" value={ v.Tariff } aria-label="Tariff"/>
				or more
			</label>
		</div>
		<label class="radio comp-option"><input type="radio" name="video" value="routine" checked?={ v.Need == "routine" }/> Video of each whole routine</label>
	</fieldset>
}

// VideoView is an exercise's video: whether it's needed, for which skills,
// and the gymnast's link.
type VideoView struct {
	Needed bool
	Skills []string // the skills that need it; none for the whole routine
	Link   string
	Note   string
}

// videoBox shows an exercise's video: what needs it, and the link, which
// opens in a new tab and is never embedded.
templ videoBox(v VideoView) {
	if v.Needed || v.Link != "" {
		<div class="comp-video-box mt-3">
			if v.Needed && len(v.Skills) > 0 {
				<p class="is-size-7"><strong>Video needed for:</strong> { strings.Join(v.Skills, ", ") }</p>
			} else if v.Needed {
				<p class="is-size-7"><strong>Video needed</strong> of the whole routine</p>
			}
			if v.Link != "" {
				<p class="is-size-7">
					<a href={ templ.SafeURL(v.Link) } target="_blank" rel="noopener noreferrer nofollow">Open the video ↗</a>
					if v.Note != "" {
						<span class="has-text-grey">· { v.Note }</span>
					}
				</p>
			} else if v.Needed {
				<p class="is-size-7 has-text-danger">No video yet.</p>
			}
		</div>
	}
}

// videoReviewNote is the organiser's review of an entry's videos, for the
// club or gymnast.
templ videoReviewNote(review, note string) {
	if review == "ok" {
		<p class="mb-2"><strong>✓ Video accepted by the organiser.</strong></p>
	} else if review == "more" {
		<div class="notification is-warning is-light">
			<p><strong>The organiser needs more video:</strong> { note }</p>
		</div>
	}
}

// signoffField asks whether entries need a coach's sign-off (ADR 0004
// Decision 11).
templ signoffField(on bool) {
	<div class="field">
		<label class="checkbox">
			<input type="checkbox" name="signoff" value="1" checked?={ on }/>
			Entries need a coach's sign-off
		</label>
		<p class="help">Clubs' coaches sign off their members' routines; gymnasts entering on their own send their coach a sign-off link. Entries without one can still be sent, flagged as a problem.</p>
	</div>
}

// SplitForm chooses which levels split men and women: none, all, or some.
type SplitForm struct {
	Mode   string          // "", "all" or "some"
	Levels []string        // the levels to choose from
	Chosen map[string]bool // with "some": the levels split
}

// splitFields chooses levels to split, posting name (the mode) and levelName
// (each level, with "some").
templ splitFields(name, levelName, legend, help string, f SplitForm) {
	<fieldset class="field">
		<legend class="label is-small">{ legend }</legend>
		<p class="help mb-2">{ help }</p>
		<label class="radio comp-option"><input type="radio" name={ name } value="" checked?={ f.Mode == "" }/> Not separately</label>
		<label class="radio comp-option"><input type="radio" name={ name } value="all" checked?={ f.Mode == "all" }/> Separately at every level</label>
		<label class="radio comp-option"><input type="radio" name={ name } value="some" checked?={ f.Mode == "some" }/> Separately at these levels:</label>
		<div class="comp-video-skills">
			for _, l := range f.Levels {
				<label class="checkbox comp-level"><input type="checkbox" name={ levelName } value={ l } checked?={ f.Chosen[l] }/> { l }</label>
			}
		</div>
	</fieldset>
}

// PartnerView is a synchro entry's partner and their link to confirm.
type PartnerView struct {
	Name      string
	Link      string // as a full URL
	Confirmed bool
}

// partnerBox shows a synchro pair's partner, and until they confirm, the link
// to send them.
templ partnerBox(p *PartnerView) {
	if p != nil {
		if p.Confirmed {
			<p class="mb-3"><strong>✓ { p.Name } has confirmed the pair.</strong></p>
		} else {
			<div class="notification is-warning is-light">
				<p class="mb-2"><strong>{ p.Name } hasn't confirmed the pair yet.</strong> Send them this link.</p>
				@linkBox("Partner link", p.Link, "")
			</div>
		}
	}
}

// PartnerPage is a synchro partner confirming the pair.
type PartnerPage struct {
	Competition CompetitionSummary
	Gymnast     string // who entered the pair
	Club        string
	Partner     string // the partner's name, as entered
	Event       string
	Confirmed   bool
	Action      string
	Problems    []string
}

// PartnerConfirm is the partner link's page.
templ PartnerConfirm(p PartnerPage) {
	@competitionLayout("Synchro · " + p.Competition.Name) {
		<h1 class="title is-4">{ p.Event } with { p.Gymnast }</h1>
		<p class="subtitle is-6">{ p.Competition.Name }</p>
		@competitionFacts(p.Competition)
		if p.Confirmed {
			<div class="notification is-success is-light">The pair is confirmed. Thank you.</div>
		} else {
			<p class="mb-3">
				{ p.Gymnast }
				if p.Club != "" {
					({ p.Club })
				}
				has entered { p.Event } with you, { p.Partner }. Confirm so the timetable knows it's you, and never puts you in two places at once.
			</p>
			@problemList(p.Problems)
			<form method="post" action={ templ.SafeURL(p.Action) } class="comp-partner">
				// Links saved in this browser (static/js/competitions.js).
				<div class="field" data-saved-people hidden>
					<label class="label is-small" for="partner-saved">You are</label>
					<div class="select is-fullwidth"><select id="partner-saved"></select></div>
				</div>
				<div class="field">
					<label class="label is-small" for="partner-link">Your own link: your club member page, or your own entry</label>
					<input class="input" id="partner-link" name="link" placeholder="https://.../clubs/member/... or .../competitions/entry/..."/>
					<p class="help">Leave it blank if you have no other entry in this competition.</p>
				</div>
				<button class="button is-primary is-fullwidth" type="submit">Confirm the pair</button>
			</form>
		}
	}
}

// levelGroups ticks built-in levels, group by group, posting each as name.
templ levelGroups(groups []requirements.BuiltinGroup, name string, chosen map[string]bool) {
	for _, g := range groups {
		if len(g.Levels) > 0 {
			<details class="comp-level-group" open?={ groupChosen(g, chosen) }>
				<summary>{ g.Name }</summary>
				for _, l := range g.Levels {
					<label class="checkbox comp-level">
						<input type="checkbox" name={ name } value={ requirements.BuiltinLevelPrefix + l.ID } checked?={ chosen[requirements.BuiltinLevelPrefix+l.ID] }/>
						{ l.Level.Name }
					</label>
				}
			</details>
		}
	}
}

// EventsForm is the competition's events beyond individual trampoline (ADR
// 0005 Decision 1).
type EventsForm struct {
	Groups   []requirements.BuiltinGroup
	Synchro  map[string]bool // built-in levels ticked for synchro
	Pairs    string          // synchro levels paired into one event, one event a line: "BUCS L1 + BUCS L2"
	Tumbling string          // one level a line
	DMT      string
}

// otherEvents chooses synchro levels and names tumbling and DMT levels.
templ otherEvents(f EventsForm) {
	<fieldset class="field">
		<legend class="label">Synchro, tumbling and DMT</legend>
		<p class="help mb-2">Optional. Synchro routines are checked like trampoline's; tumbling and DMT entries are a level only, for now.</p>
		<details class="comp-level-group" open?={ len(f.Synchro) > 0 }>
			<summary>Synchro levels</summary>
			<div class="pl-4">
				@levelGroups(f.Groups, "synchroLevel", f.Synchro)
				<div class="field mt-2">
					<label class="label is-small" for="events-synchro-pairs">Pair synchro levels into one event (optional)</label>
					<textarea class="textarea is-small" id="events-synchro-pairs" name="synchroPairs" rows="2" placeholder="e.g. BUCS L1 + BUCS L2">{ f.Pairs }</textarea>
					<p class="help">One event a line, levels joined by +: they're flighted and ranked as one (e.g. "BUCS L1/L2"), and each pair says which level they're doing: the one they both compete at, or the easier of two a level apart.</p>
				</div>
			</div>
		</details>
		<div class="field mt-2">
			<label class="label is-small" for="events-tumbling">Tumbling levels, one a line, easiest first</label>
			<textarea class="textarea is-small" id="events-tumbling" name="tumbling" rows="2" placeholder="e.g. Novice">{ f.Tumbling }</textarea>
		</div>
		<div class="field">
			<label class="label is-small" for="events-dmt">DMT levels, one a line, easiest first</label>
			<textarea class="textarea is-small" id="events-dmt" name="dmt" rows="2" placeholder="e.g. Novice">{ f.DMT }</textarea>
		</div>
	</fieldset>
}

// levelOrderForm moves levels up and down each discipline's order. Judging
// "up to" a level, and "only levels below their own", go by it.
templ levelOrderForm(base string, order []LevelOrder) {
	<form method="post" action={ templ.SafeURL(base + "/levels/move") } class="mb-3" id="level-order">
		<p class="label is-small">Order of levels</p>
		<p class="help mb-2">Easiest first. A judge offering "up to" a level judges it and the levels before it.</p>
		for _, o := range order {
			if len(order) > 1 {
				<p class="is-size-7 has-text-weight-semibold mt-2">{ o.Name }</p>
			}
			<ol class="comp-level-order">
				for i, name := range o.Levels {
					<li>
						<span class="comp-level-name">{ name }</span>
						if i > 0 {
							<button class="button is-small" type="submit" name="move" value={ fmt.Sprintf("%s:%d:-1", o.Discipline, i) } aria-label={ "Move " + name + " earlier (easier)" }>↑</button>
						} else {
							<span class="comp-level-gap"></span>
						}
						if i < len(o.Levels)-1 {
							<button class="button is-small" type="submit" name="move" value={ fmt.Sprintf("%s:%d:1", o.Discipline, i) } aria-label={ "Move " + name + " later (harder)" }>↓</button>
						} else {
							<span class="comp-level-gap"></span>
						}
					</li>
				}
			</ol>
		}
	</form>
}

func entryLevelLabel(l EntryLevel) string {
	if l.Label != "" {
		return l.Label
	}
	return l.Name
}

// removeForm removes or holds the entries ticked in the tables.
templ removeForm(base string) {
	<details class="box comp-manage">
		<summary><strong>Remove or hold entries</strong> <span class="has-text-grey is-size-7">· tick them in the tables below</span></summary>
		<form id="remove-form" method="post" action={ templ.SafeURL(base + "/remove") } class="mt-3">
			<div class="field">
				<label class="radio comp-option"><input type="radio" name="action" value="remove" checked/> <strong>Remove</strong>: they can't be sent or changed again unless you restore them</label>
				<label class="radio comp-option"><input type="radio" name="action" value="hold"/> <strong>Hold, asking for changes</strong>: the club or gymnast changes the entry and sends it again, and you accept it back in</label>
			</div>
			<div class="field">
				<input class="input is-small" name="note" maxlength="300" placeholder="Reason (optional), e.g. Entry fee not paid" aria-label="Reason"/>
			</div>
			<div class="field is-size-7">
				Show the reason to
				<label class="radio ml-2"><input type="radio" name="to" value="club"/> the club</label>
				<label class="radio"><input type="radio" name="to" value="member"/> the gymnast</label>
				<label class="radio"><input type="radio" name="to" value="both" checked/> both</label>
			</div>
			<button class="button is-small is-danger is-light" type="submit">Apply to the ticked entries</button>
			<p class="help">To take a whole club, filter by the club above, then tick each table's header. Removed and held entries aren't counted, printed or timetabled.</p>
		</form>
	</details>
}

// removedList is the entries removed or held, to restore or accept.
templ removedList(base string, rows []RemovedRow) {
	if len(rows) > 0 {
		<h2 class="title is-5 mt-5">Removed and on hold <span class="has-text-grey is-size-6">({ strconv.Itoa(len(rows)) })</span></h2>
		<div class="table-container">
			<table class="table is-fullwidth is-narrow">
				<tbody>
					for _, r := range rows {
						<tr>
							<td><a href={ templ.SafeURL(base + "/entries/" + r.ID) }>{ r.Gymnast }</a></td>
							<td>{ r.Club }</td>
							<td>{ r.Level }</td>
							<td>
								if r.Resent {
									<span class="tag is-info is-light">Changed and sent again: waiting for you</span>
								} else if r.Held {
									<span class="tag is-warning is-light">On hold for changes</span>
								} else {
									<span class="tag is-danger is-light">Removed</span>
								}
								if r.Note != "" {
									<span class="is-size-7 has-text-grey">{ r.Note } ({ r.To })</span>
								}
							</td>
							<td class="has-text-right">
								<form method="post" action={ templ.SafeURL(base + "/entries/" + r.ID + "/restore") }>
									<button class="button is-small" type="submit">
										if r.Resent {
											Accept back in
										} else {
											Restore
										}
									</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// dashboardFilters are the ways to find entries: search, filters, sorting,
// a list of the levels to jump to, and printing or downloading what's shown.
templ dashboardFilters(d Dashboard) {
	<form method="get" class="box comp-filters">
		<div class="comp-setup-row">
			<input class="input is-small" type="search" name="q" value={ d.Search } placeholder="Search for a gymnast" aria-label="Search for a gymnast"/>
			<div class="select is-small">
				<select name="club" aria-label="Club" onchange="this.form.submit()">
					<option value="" selected?={ d.Club == "" }>All clubs</option>
					for _, c := range d.Clubs {
						<option value={ c } selected?={ d.Club == c }>{ c }</option>
					}
					if d.Competition.Individuals || hasIndividuals(d) {
						<option value="individual" selected?={ d.Club == "individual" }>Individuals</option>
					}
				</select>
			</div>
			if len(d.Coaches) > 0 {
				<div class="select is-small">
					<select name="coach" aria-label="Coach" onchange="this.form.submit()">
						<option value="" selected?={ d.Coach == "" }>Any coach</option>
						for _, c := range d.Coaches {
							<option value={ c } selected?={ d.Coach == c }>{ c }</option>
						}
						<option value="none" selected?={ d.Coach == "none" }>No coach</option>
					</select>
				</div>
			}
			@yesNoFilter("checked", "Checked", d.CheckedFilter, "Checked or not", "Checked", "Not checked")
			if d.Competition.Signoff {
				@yesNoFilter("signedoff", "Signed off", d.SignedFilter, "Signed off or not", "Signed off", "Not signed off")
			}
			if d.Competition.Video != "" {
				<div class="select is-small">
					<select name="video" aria-label="Video" onchange="this.form.submit()">
						<option value="" selected?={ d.VideoFilter == "" }>Any video</option>
						<option value="missing" selected?={ d.VideoFilter == "missing" }>Video missing</option>
						<option value="provided" selected?={ d.VideoFilter == "provided" }>Video to review</option>
						<option value="need more" selected?={ d.VideoFilter == "need more" }>Video: need more</option>
						<option value="OK" selected?={ d.VideoFilter == "OK" }>Video OK</option>
					</select>
				</div>
			}
			if d.CanSplit {
				<div class="select is-small">
					<select name="category" aria-label="Men or women" onchange="this.form.submit()">
						<option value="" selected?={ d.Category == "" }>Men and women</option>
						<option value="Men" selected?={ d.Category == "Men" }>Men</option>
						<option value="Women" selected?={ d.Category == "Women" }>Women</option>
					</select>
				</div>
			}
			<label class="checkbox is-size-7">
				<input type="checkbox" name="problems" value="1" checked?={ d.ProblemsOnly } onchange="this.form.submit()"/>
				Problems only
			</label>
			<div class="select is-small">
				<select name="sort" aria-label="Sort by" onchange="this.form.submit()">
					<option value="" selected?={ d.Sort == "" }>By club</option>
					<option value="gymnast" selected?={ d.Sort == "gymnast" }>By gymnast</option>
					<option value="sent" selected?={ d.Sort == "sent" }>Latest sent first</option>
					if d.Competition.Signoff {
						<option value="coach" selected?={ d.Sort == "coach" }>By coach</option>
					}
				</select>
			</div>
			<button class="button is-small" type="submit">Show</button>
			if filtered(d) || d.Sort != "" {
				<a class="button is-small is-text" href={ templ.SafeURL(d.Base) }>Clear</a>
			}
		</div>
		<p class="is-size-7 mt-2">
			if filtered(d) {
				<strong>{ strconv.Itoa(d.Shown) } of { strconv.Itoa(d.Entries) } shown.</strong>
				<a href={ templ.SafeURL(d.Base + "/cards" + filterQuery(d, "")) }>Print what's shown</a> ·
				<a href={ templ.SafeURL(d.Base + "/entries.csv" + filterQuery(d, "")) } download>CSV of what's shown</a> ·
			}
			Jump to:
			for i, l := range d.Levels {
				if i > 0 {
					·
				}
				<a href={ templ.SafeURL("#" + l.Anchor) } onclick={ openLevel(l.Anchor) }>{ l.Name } ({ shownCount(d, l) })</a>
			}
		</p>
	</form>
}

// yesNoFilter is a filter that's on, off or either.
templ yesNoFilter(name, label, value, either, yes, no string) {
	<div class="select is-small">
		<select name={ name } aria-label={ label } onchange="this.form.submit()">
			<option value="" selected?={ value == "" }>{ either }</option>
			<option value="yes" selected?={ value == "yes" }>{ yes }</option>
			<option value="no" selected?={ value == "no" }>{ no }</option>
		</select>
	</div>
}

// openLevel opens a level's table when jumping to it.
script openLevel(id string) {
	const d = document.getElementById(id);
	if (d) { d.open = true; }
}
