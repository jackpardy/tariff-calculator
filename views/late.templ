package views

// LateRequestPage is where a club or individual asks to change an entry
// after the deadline (roadmap 2026-10-08).
type LateRequestPage struct {
	Competition CompetitionSummary
	Back        string
	Gymnast     string
	Current     string   // the entry's event now
	Allowed     []string // the kinds of change allowed, with fees
	Status      LateStatus // the latest request, if any
	CoachFirst  bool     // a coach signs it off before the organiser sees it
	Problems    []string
	Form        EntryForm
}

// LateRequest is the page for asking for a late change.
templ LateRequest(p LateRequestPage) {
	@competitionLayout("Late change · " + p.Competition.Name) {
		<p class="mb-3"><a href={ templ.SafeURL(p.Back) }>← Back</a></p>
		<h1 class="title is-4">Ask for a late change</h1>
		<p class="subtitle is-6">{ p.Gymnast } · { p.Current } · { p.Competition.Name }</p>
		<p class="mb-2">Entries have closed. You can ask the organiser for:</p>
		<ul class="mb-3">
			for _, a := range p.Allowed {
				<li>{ a }</li>
			}
		</ul>
		<p class="mb-4 is-size-7">
			Change the entry below and send it.
			if p.CoachFirst {
				It goes to your coach to sign off first (a member's coach on their coach page; if you entered on your own, your coach through your sign-off link), then to the organiser.
			}
			The organiser checks whether it can be fitted in, then accepts it (it replaces the entry, and needs checking again) or says why not. Until then, the entry stays as it is.
		</p>
		@lateStatusLine(p.Status, "mb-4")
		@problemList(p.Problems)
		@entryForm(p.Form)
	}
}

// LateAdminPage is the organiser's page of late changes.
type LateAdminPage struct {
	Base, Notice string
	Competition  CompetitionSummary
	Menu []MenuSection
	Signoff      bool // entries need a coach's sign-off
	SignoffFirst bool
	Kinds        []LateKindField
	Now          string // what can be asked for, in a line
	Requests     []LateRequestView
	Timetable    string // the timetable, when its draft has changes to publish; "" if not
}

// LateKindField is a kind of late change, for the form.
type LateKindField struct {
	Kind, Name, Fee string
	On              bool
}

// LateRequestView is a request, for the organiser.
type LateRequestView struct {
	ID, Who, Kind, Gymnast, From, To, Note, At, Fee, Status, Link string
	Waiting                                                       bool // for the organiser to decide
	ForCoach                                                      bool // waiting for a coach to sign it off
	Checks                                                        []string
	NewCard                                                       *EntryCard // the card as it would be, while waiting
}

// LateAdmin is the organiser's page of late changes.
templ LateAdmin(p LateAdminPage) {
	@competitionLayout("Late changes · " + p.Competition.Name) {
		<h1 class="title is-4">Late changes</h1>
		<p class="subtitle is-6">{ p.Competition.Name }</p>
		@pageMenu(p.Menu)
		if p.Notice != "" {
			@notice(p.Notice)
		}
		if p.Timetable != "" {
			<p class="mb-3 is-size-7">The draft timetable has changes not published yet. <a href={ templ.SafeURL(p.Timetable) }>Open the timetable to publish them →</a></p>
		}
		@changeLine("Late changes", p.Now, false) {
			<form method="post" action={ templ.SafeURL(p.Base + "/late/settings") }>
				for _, k := range p.Kinds {
					<div class="comp-flight-actions mb-2">
						<label class="checkbox">
							<input type="checkbox" name={ "late-" + k.Kind } value="1" checked?={ k.On }/>
							{ k.Name }
						</label>
						<span class="is-size-7">fee if accepted</span>
						<input class="input is-small comp-num" name={ "fee-" + k.Kind } inputmode="decimal" value={ k.Fee } placeholder="0" aria-label={ k.Name + " fee" }/>
					</div>
				}
				if p.Signoff {
					<label class="checkbox mb-2">
						<input type="checkbox" name="signoffFirst" value="1" checked?={ p.SignoffFirst }/>
						A coach must sign off a late change before it comes to you
					</label>
				}
				<p class="help mb-2">Level change: a different level, with its routines. Routine change: new routines at the same level. Clubs and gymnasts ask from their pages once entries close; the fee goes on their invoice if you accept.</p>
				<button class="button is-small is-primary" type="submit">Save</button>
			</form>
		}
		if len(p.Requests) == 0 {
			<p class="has-text-grey">No late changes asked for.</p>
		}
		for _, r := range p.Requests {
			<div class={ "box", templ.KV("has-text-grey", !r.Waiting) }>
				<p>
					<strong><a href={ templ.SafeURL(r.Link) }>{ r.Gymnast }</a></strong> · { r.Kind }:
					if r.From != r.To {
						{ r.From } → <strong>{ r.To }</strong>
					} else {
						{ r.To }
					}
				</p>
				<p class="is-size-7 has-text-grey">
					if r.Who == r.Gymnast {
						Asked by them · { r.At }
					} else {
						Asked by { r.Who } · { r.At }
					}
					if r.Fee != "" {
						· fee on accepting: { r.Fee }
					}
				</p>
				if r.Note != "" {
					<p class="is-size-7">Their note: { r.Note }</p>
				}
				if r.Waiting {
					<ul class="is-size-7 mt-2 mb-2">
						for _, c := range r.Checks {
							<li>{ c }</li>
						}
					</ul>
					if r.NewCard != nil {
						<details class="mb-2">
							<summary class="is-size-7">See the new card</summary>
							@entryCard(*r.NewCard)
						</details>
					}
					<div class="comp-flight-actions">
						<form method="post" action={ templ.SafeURL(p.Base + "/late/" + r.ID + "/accept") } class="comp-flight-actions">
							<input class="input is-small" name="note" maxlength="300" placeholder="Note (optional)" aria-label="Note with accepting"/>
							<button class="button is-small is-success" type="submit">Accept</button>
						</form>
						<form method="post" action={ templ.SafeURL(p.Base + "/late/" + r.ID + "/reject") } class="comp-flight-actions">
							<input class="input is-small" name="reason" required maxlength="300" placeholder="Why not (they see it)" aria-label="Reason for not accepting"/>
							<button class="button is-small is-warning is-light" type="submit">Not accepted</button>
						</form>
					</div>
				} else if r.ForCoach {
					<p class="is-size-7 has-text-grey">{ r.Status }</p>
					<form method="post" action={ templ.SafeURL(p.Base + "/late/" + r.ID + "/reject") } class="comp-flight-actions mt-1">
						<input class="input is-small" name="reason" required maxlength="300" placeholder="Why not (they see it)" aria-label="Reason for not accepting"/>
						<button class="button is-small is-warning is-light" type="submit">Not accepted</button>
					</form>
				} else {
					<p class="is-size-7">{ r.Status }</p>
				}
			</div>
		}
	}
}

// LateStatus is where the latest late change asked for an entry stands:
// in words, and as a state (asked and waiting, accepted, or not accepted).
type LateStatus struct {
	Text  string // "" for none
	State State
}

// lateStatusLine is a late change's state as a chip, then what it is.
templ lateStatusLine(s LateStatus, class string) {
	if s.Text != "" {
		<p class={ "is-size-7", class }>
			@StateChip(s.State, "Late change")
			<span class="ml-1">{ s.Text }</span>
		</p>
	}
}

// lateLine shows where a late change stands, and links to ask for one.
templ lateLine(status LateStatus, ask string) {
	@lateStatusLine(status, "mb-2")
	if ask != "" {
		<p class="is-size-7 mb-2"><a href={ templ.SafeURL(ask) }>Ask for a late change</a></p>
	}
}

// LateSignoffPage is a coach signing off a late change.
type LateSignoffPage struct {
	Competition    CompetitionSummary
	Back, Action   string
	What, Note     string // e.g. "Level change to BUCS L5"; the gymnast's note
	Card           EntryCard
	AskName        bool // an individual's coach gives their name
	Problems       []string
}

// LateSignoff shows a late change's new card, for a coach to sign off.
templ LateSignoff(p LateSignoffPage) {
	@competitionLayout("Sign off a late change · " + p.Competition.Name) {
		<p class="mb-3"><a href={ templ.SafeURL(p.Back) }>← Back</a></p>
		<h1 class="title is-4">Sign off a late change</h1>
		<p class="subtitle is-6">{ p.Card.Gymnast } · { p.What } · { p.Competition.Name }</p>
		if p.Note != "" {
			<p class="mb-3 is-size-7">Their note: { p.Note }</p>
		}
		@entryCard(p.Card)
		<div class="box mt-4">
			@problemList(p.Problems)
			<form method="post" action={ templ.SafeURL(p.Action) }>
				<p class="mb-2">Have you seen { p.Card.Gymnast } perform this safely, and is it ready to compete?</p>
				if p.AskName {
					<div class="field">
						<label class="label is-small" for="late-coach">Your name (coach)</label>
						<input class="input is-small" id="late-coach" name="coach" required maxlength="80"/>
					</div>
				}
				<div class="field">
					<label class="label is-small" for="late-note">Note (optional)</label>
					<input class="input is-small" id="late-note" name="note" maxlength="300"/>
				</div>
				<button class="button is-success is-small" type="submit">Sign off</button>
				<p class="help">Then it goes to the organiser, who accepts it or says why not. If accepted, the entry is signed off as you signed this.</p>
			</form>
		</div>
	}
}

// CoachLate is a late change for a coach to sign off.
type CoachLate struct {
	Member, What, Link string
}

// coachLates lists the late changes a coach can sign off.
templ coachLates(list []CoachLate) {
	if len(list) > 0 {
		<div class="notification is-warning is-light">
			<p><strong>Late changes to sign off</strong></p>
			<ul class="is-size-7">
				for _, l := range list {
					<li><a href={ templ.SafeURL(l.Link) }>{ l.Member } · { l.What }</a></li>
				}
			</ul>
		</div>
	}
}
