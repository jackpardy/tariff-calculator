package views

import "strconv"

// MyCompetitionPage is one person's competition (roadmap: competitions 5):
// their events, cards and flights, what they officiate, and the flights and
// panels they're in, or the published timetable with them picked out.
type MyCompetitionPage struct {
	Competition CompetitionSummary
	Name        string
	Over        string // on their own page, their club, or that they entered on their own
	Back        string // their own page
	BackLabel   string // says where Back goes, e.g. "← Your page"
	MyLinks
	Lateness    []string // how late the areas their flights are on are running today
	Notice      string     // what just happened, e.g. after "I'm here for the rest"
	Here        *MyHere    // the box for someone scratched who may still be here; nil for none
	Published   bool
	Events      []MyEvent
	Days        []DayView       // their flights and seats, or with Whole the whole timetable
	Whole       bool            // the whole timetable asked for (?timetable=all)
	Mine        map[string]bool // their entries, by id
	Me          string          // their person key, for the seats they're in
	Menu        []MenuSection   // the organiser's menu, on the organiser's page of a person; their own tabs on theirs
	Admin       *PersonAdmin    // what the organiser's page of a person adds; nil on their own page
}

// MyLinks are the links on a person's or club's page for a
// competition, and what reaches them there; each empty where there's none.
type MyLinks struct {
	Timeline     string     // their timetable as the panel timeline, once published
	ClubTimeline string     // a member's club's, once published
	Calendar     string     // their timetable as a calendar file, once published
	ClubCalendar string     // a member's club's
	Notify       string     // where they ask to hear about changes
	ScoreSheets  string     // the score sheets of the flights they officiate, if any
	Duties       []string   // their seats on panels, once published
	Desk         []DeskNote // messages from the organisers that reach them
}

// MyHere is the box that lets someone scratched from an event tell the
// organisers they're still here for the rest.
type MyHere struct {
	Scratched string // the events they're scratched from, e.g. "Tumbling Novice and Trampoline L3"
	For       string // what they might still be here for: "your other events", "your officiating" or "both"
	Action    string // where the button posts to
}

// MyEvent is one of their events.
type MyEvent struct {
	ID                        string // the entry's id
	Link                      string // the organiser's page for the entry: organiser's page of a person only
	Checkin                   string // whether they're here, once published: organiser's page only
	Coach, CoachLink          string // who coaches them, and their page: organiser's page only
	Event, Gymnasts, Category string
	Status                    string
	StatusState               State // Status's state
	Scratched                 bool  // scratched on the day
	Problems                  []string
	Flight, Area, Day, WarmUp string
	Position, Of              int
	Turn, Turn2               string // about when each of their routines is
}

// PersonAdmin is what the organiser's page of a person adds to their
// competition (roadmap: all people): who they are, what they offered and
// coach, and anything to watch on the day.
type PersonAdmin struct {
	Club        string
	Roles       []string // e.g. "Gymnast", "Judge", "Coach"
	Officiating *PersonOfficiating
	Coaching    *PersonCoaching
	Scratch     []string // scratch warnings that still stand for them
}

// PersonOfficiating is what someone offered to do, and where the timetable
// has them.
type PersonOfficiating struct {
	Offers    []string // what they offered, and who sent it
	Judges    string   // the events they may judge under the judging rule, "" for none
	Rule      string   // the judging rule, in words
	Qualified string   // whether the organiser marked them qualified, where the rule asks
	Seats     []string // their seats on the timetable
	SeatsNote string   // which timetable the seats are from
	Panel     string   // whether they're here for their panels, once published
}

// PersonCoaching is the gymnasts someone coaches.
type PersonCoaching struct {
	Approval string // where the competition approves coaches: how they stand
	Entries  []PersonCoached
}

// PersonCoached is one entry someone coaches.
type PersonCoached struct {
	People  []PersonLink // the gymnast, or the pair
	Event   string
	Entry   string      // the entry's page
	Signoff SignoffView // where its sign-off stands, where one is needed
}

// PersonLink is a person and their page.
type PersonLink struct {
	Name, Href string
}

// MyCompetition is the person's page for a competition.
templ MyCompetition(p MyCompetitionPage) {
	@competitionLayout(myTitle(p)) {
		if p.Admin != nil {
			<p class="mb-3"><a href={ templ.SafeURL(p.Back) }>{ p.BackLabel }</a></p>
			<h1 class="title is-4">{ p.Name }</h1>
			<p class="subtitle is-6">
				if p.Admin.Club != "" {
					{ p.Admin.Club } ·
				}
				{ p.Competition.Name } · { p.Competition.Date }
			</p>
			@pageMenu(p.Menu)
			// What they are here, as role chips: labels in the roles' colours,
			// not buttons.
			<p class="mb-4 comp-roles">
				for _, r := range p.Admin.Roles {
					<span class={ "chip", "chip-who", "chip-who-" + roleClass(r), "mr-1" }>{ r }</span>
				}
			</p>
		} else {
			// Their own page: who they are and their tabs, as on their other
			// pages, then the way back to the competition.
			if p.Over != "" {
				<p class="has-text-grey mb-1">{ p.Over }</p>
			}
			<h1 class="title is-4">{ p.Name }</h1>
			@pageMenu(p.Menu)
			<p class="mb-3"><a href={ templ.SafeURL(p.Back) }>{ p.BackLabel }</a></p>
			<h2 class="title is-5">My competition</h2>
			<p class="subtitle is-6">{ p.Competition.Name } · { p.Competition.Date }</p>
		}
		@timelineLinks(p.Timeline, p.ClubTimeline, p.Notify, p.Calendar, p.ClubCalendar)
		if p.Notice != "" {
			<div class="notification is-info is-light">{ p.Notice }</div>
		}
		@latenessNotes(p.Lateness)
		@deskMessages(p.Desk)
		if p.Here != nil {
			<div class="notification is-warning is-light">
				<p>You're scratched from { p.Here.Scratched }. If you're still here for { p.Here.For }, tell the organisers:</p>
				<form method="post" action={ templ.SafeURL(p.Here.Action) } class="mt-2">
					<button class="button is-warning" type="submit">I'm here for the rest</button>
				</form>
			</div>
		}
		if p.Admin != nil && len(p.Events) > 0 {
			<h2 class="title is-5 mt-5">Entries</h2>
		}
		if len(p.Events) == 0 && p.Admin == nil {
			<div class="notification is-light">No entries for you have reached the competition yet. Once your club sends them (or you enter), they show here.</div>
		}
		for _, ev := range p.Events {
			<div class="box comp-my-event">
				<p class="mb-1">
					if ev.Link != "" {
						<strong><a href={ templ.SafeURL(ev.Link) }>{ ev.Event }</a></strong>
					} else {
						<strong>{ ev.Event }</strong>
					}
					if ev.Category != "" {
						<span class="has-text-grey"> · { ev.Category }</span>
					}
				</p>
				<p class="is-size-7 mb-2">{ ev.Gymnasts }</p>
				<p class="mb-1">
					if ev.Scratched {
						@StateChip(Stopped, "Scratched")
					}
					if len(ev.Problems) > 0 && ev.Link != "" {
						<a href={ templ.SafeURL(ev.Link + "#problems") } title="See the problems">
							@StateChip(ev.StatusState, ev.Status)
						</a>
					} else {
						@StateChip(ev.StatusState, ev.Status)
					}
				</p>
				if ev.Coach != "" {
					<p class="is-size-7">
						Coach:
						if ev.CoachLink != "" {
							<a href={ templ.SafeURL(ev.CoachLink) }>{ ev.Coach }</a>
						} else {
							{ ev.Coach }
						}
					</p>
				}
				if len(ev.Problems) > 0 {
					<ul class="is-size-7 mb-2">
						for _, pr := range ev.Problems {
							<li>{ pr }</li>
						}
					</ul>
				}
				if ev.Flight != "" {
					<div class="comp-my-flight mt-2">
						<p><strong>{ ev.Flight }</strong> · { ev.Area } · { ev.Day }</p>
						if p.Admin != nil {
							<p>Warm-up <strong>{ ev.WarmUp }</strong> · <strong>{ ordinal(ev.Position) }</strong> of { strconv.Itoa(ev.Of) }</p>
						} else {
							<p>Warm-up <strong>{ ev.WarmUp }</strong> · you're <strong>{ ordinal(ev.Position) }</strong> of { strconv.Itoa(ev.Of) }</p>
						}
						<p class="is-size-7 has-text-grey">Routines at about { ev.Turn } and { ev.Turn2 }, if the flight runs to time: a guide only.</p>
						if ev.Checkin != "" {
							<p class="is-size-7">Check-in: <strong>{ ev.Checkin }</strong></p>
						}
					</div>
				} else if p.Published && p.Admin != nil {
					<p class="is-size-7 has-text-grey mt-2">Not in a flight yet.</p>
				} else if p.Published {
					<p class="is-size-7 has-text-grey mt-2">Not in a flight yet: ask the organiser.</p>
				}
			</div>
		}
		if p.Admin != nil {
			@personOfficiating(p.Admin.Officiating)
			@personCoaching(p.Admin.Coaching)
			for _, s := range p.Admin.Scratch {
				<div class="notification is-warning is-light py-2">{ s }</div>
			}
		} else {
			@dutiesBox(p.Duties, p.ScoreSheets)
		}
		if !p.Published && p.Admin == nil {
			<div class="notification is-light">The timetable isn't published yet. Your flights, times and any judging show here once it is.</div>
		} else if !p.Published && showsTimetable(p) {
			<div class="notification is-light">The timetable isn't published yet. Their flights, times and check-in show here once it is.</div>
		} else if p.Published && showsTimetable(p) {
			<h2 class="title is-5 mt-5" id="timetable">
				if p.Whole {
					The timetable
				} else if p.Admin != nil {
					Their flights and panels
				} else {
					Your flights and panels
				}
			</h2>
			// Only theirs unless asked: the whole of it is many screens on a
			// phone.
			<p class="help mb-3">
				if p.Whole && p.Admin != nil {
					{ p.Name } is picked out in bold, and the panels they're on are marked. <a href="?#timetable">Only theirs</a>
				} else if p.Whole {
					You're picked out in bold, and the panels you're on are marked. <a href="?#timetable">Only yours</a>
				} else if len(p.Days) == 0 && p.Admin != nil {
					Not in a flight or on a panel. <a href="?timetable=all#timetable">Show the whole timetable</a>
				} else if len(p.Days) == 0 {
					You're not in a flight or on a panel. <a href="?timetable=all#timetable">Show the whole timetable</a>
				} else {
					Each with its running order and panel. <a href="?timetable=all#timetable">Show the whole timetable</a>
				}
			</p>
			for _, day := range p.Days {
				<h3 class="title is-6 mt-4">{ day.Name }</h3>
				<div class="columns is-multiline">
					for _, area := range day.Areas {
						<div class="column is-half-tablet is-one-third-desktop">
							<p class="has-text-weight-semibold mb-2">{ area.Name }</p>
							for _, it := range area.Items {
								if it.Flight {
									@myFlight(p, it)
								} else {
									<div class={ "box comp-block", templ.KV("comp-mine", seatOf(p, it) != "") }>
										<strong>{ it.Name }</strong> <span class="has-text-grey is-size-7">{ it.Start }–{ it.End }</span>
										if seatOf(p, it) != "" {
											<span class="tag is-info is-light ml-1">{ seatOf(p, it) }</span>
										}
										if len(it.Seats) > 0 {
											<p class="is-size-7 mt-1">{ panelLine(it.Seats) }</p>
										}
									</div>
								}
							}
						</div>
					}
				</div>
			}
		}
	}
}

// myTitle is the page's title: whose competition, on the organiser's page
// of a person; My competition, on their own.
func myTitle(p MyCompetitionPage) string {
	if p.Admin != nil {
		return p.Competition.Name + " · " + p.Name
	}
	return "My competition · " + p.Competition.Name
}

// showsTimetable says whether a page shows the timetable: always on a person's
// own page, and on the organiser's only for someone in it, competing or on a
// panel (not a coach).
func showsTimetable(p MyCompetitionPage) bool {
	return p.Admin == nil || len(p.Events) > 0 || len(p.Duties) > 0
}

// personOfficiating is what someone offered to do, who may judge what, and
// their seats: on the organiser's page of them.
templ personOfficiating(o *PersonOfficiating) {
	if o != nil {
		<div class="box">
			<h2 class="title is-5">Officiating</h2>
			<ul class="is-size-7 mb-2">
				for _, offer := range o.Offers {
					<li>{ offer }</li>
				}
			</ul>
			if o.Judges != "" {
				<p class="is-size-7 mb-1"><strong>Can judge:</strong> { o.Judges }</p>
			} else {
				<p class="is-size-7 mb-1"><strong>Can judge:</strong> <span class="has-text-grey">no events, under the judging rule</span></p>
			}
			<p class="is-size-7 has-text-grey mb-1">Judging rule: { o.Rule }.</p>
			if o.Qualified != "" {
				<p class="is-size-7 mb-1">{ o.Qualified }</p>
			}
			if len(o.Seats) > 0 {
				<p class="is-size-7 mt-2"><strong>Seats</strong> <span class="has-text-grey">({ o.SeatsNote })</span></p>
				<ul class="is-size-7">
					for _, s := range o.Seats {
						<li>{ s }</li>
					}
				</ul>
			} else {
				<p class="is-size-7 has-text-grey mt-2">{ o.SeatsNote }</p>
			}
			if o.Panel != "" {
				<p class="is-size-7 mt-1">Panel check-in: <strong>{ o.Panel }</strong></p>
			}
		</div>
	}
}

// personCoaching is the gymnasts someone coaches: on the organiser's page of
// them.
templ personCoaching(k *PersonCoaching) {
	if k != nil {
		<div class="box">
			<h2 class="title is-5">Coaching</h2>
			if k.Approval != "" {
				<p class="is-size-7 mb-2">{ k.Approval }</p>
			}
			if len(k.Entries) == 0 {
				<p class="is-size-7 has-text-grey">No entries yet.</p>
			}
			// A row each, with where its sign-off stands.
			<ul class="comp-coached">
				for _, e := range k.Entries {
					<li>
						for i, g := range e.People {
							if i > 0 {
								{ "&" }
							}
							<a href={ templ.SafeURL(g.Href) }>{ g.Name }</a>
						}
						· <a href={ templ.SafeURL(e.Entry) }>{ e.Event }</a>
						if e.Signoff.Required {
							@StateChip(signoffState(e.Signoff))
						}
					</li>
				}
			</ul>
		</div>
	}
}

templ myFlight(p MyCompetitionPage, f ItemView) {
	<details class={ "box comp-flight", templ.KV("comp-mine", flightHas(p, f)) } open?={ flightHas(p, f) }>
		<summary>
			<strong>{ f.Name }</strong>
			<span class="is-size-7 has-text-grey">{ f.Start }–{ f.End } · { flightCount(len(f.Gymnasts), f.Pairs) }</span>
			if seatOf(p, f) != "" {
				<span class="tag is-info is-light ml-1">{ seatOf(p, f) }</span>
			}
		</summary>
		<ol class="comp-order mt-2">
			for _, g := range f.Gymnasts {
				<li value={ strconv.Itoa(g.No) }>
					if p.Mine[g.ID] {
						<strong>{ g.Name }</strong>
					} else {
						{ g.Name }
					}
					<span class="has-text-grey is-size-7">{ g.Club }</span>
				</li>
			}
		</ol>
		if len(f.Seats) > 0 {
			<p class="is-size-7 mt-2">{ panelLine(f.Seats) }</p>
		}
	</details>
}

// flightHas says whether the person competes in or officiates a flight.
func flightHas(p MyCompetitionPage, f ItemView) bool {
	for _, g := range f.Gymnasts {
		if p.Mine[g.ID] {
			return true
		}
	}
	return seatOf(p, f) != ""
}

// seatOf is the person's role on a flight's panel, if they have one.
func seatOf(p MyCompetitionPage, f ItemView) string {
	for _, s := range f.Seats {
		if s.Person != "" && s.Person == p.Me {
			return s.Role
		}
	}
	return ""
}

// ordinal writes 1 as "1st", 2 as "2nd", and so on.
func ordinal(n int) string {
	suffix := "th"
	if n%100 < 11 || n%100 > 13 {
		switch n % 10 {
		case 1:
			suffix = "st"
		case 2:
			suffix = "nd"
		case 3:
			suffix = "rd"
		}
	}
	return strconv.Itoa(n) + suffix
}

// dayLink links to a person's My competition page.
templ dayLink(href string) {
	if href != "" {
		<p class="mb-3">
			<a class="button is-small is-info is-light" href={ templ.SafeURL(href) }>My competition →</a>
			<span class="is-block help">Your flights and times, the timetable, your calendar and news of changes.</span>
		</p>
	}
}

// latenessNotes say how late the areas someone's flights are on are running.
templ latenessNotes(lines []string) {
	for _, l := range lines {
		@latenessLine(l)
	}
}

// latenessLine is one area running late or early, e.g. "Panel 2 is running
// about 15 min late (as of 10:40)".
templ latenessLine(text string) {
	<div class="notification is-warning is-light py-2">{ text }</div>
}

// timelineLinks are a person's and their club's timetables, laid out as
// the panel timeline, and as calendar files to add to a calendar (subscribe
// to keep it up to date), once the timetable is published.
templ timelineLinks(mine, club, notify, calendar, clubCalendar string) {
	if mine != "" || club != "" || notify != "" || calendar != "" || clubCalendar != "" {
		<div class="mb-3 buttons">
			if len(timetableLinks(mine, club, calendar, clubCalendar)) > 2 {
				// Yours and the club's, timetable and calendar: one menu rather
				// than a row of four alike.
				<details class="comp-popup comp-popup-left" data-menu>
					<summary class="button is-small is-light comp-opens-button">Timetables and calendars</summary>
					<div class="comp-popup-panel">
						for _, l := range timetableLinks(mine, club, calendar, clubCalendar) {
							<a href={ templ.SafeURL(l.Href) } { l.attrs()... }>{ l.Label }</a>
						}
					</div>
				</details>
			} else {
				for _, l := range timetableLinks(mine, club, calendar, clubCalendar) {
					<a class="button is-small is-light" href={ templ.SafeURL(l.Href) } { l.attrs()... }>{ l.Label }</a>
				}
			}
			if notify != "" {
				<a class="button is-small is-light" href={ templ.SafeURL(notify) }>Tell me about changes</a>
			}
		</div>
	}
}

// timetableLink is one of the timetables or calendars timelineLinks offers.
type timetableLink struct {
	Label, Href, Title string
}

// attrs is the link's title, if it has one.
func (l timetableLink) attrs() templ.Attributes {
	if l.Title == "" {
		return nil
	}
	return templ.Attributes{"title": l.Title}
}

// timetableLinks are the timetables and calendars there are, in order: the
// person's, then the club's.
func timetableLinks(mine, club, calendar, clubCalendar string) []timetableLink {
	const subscribe = "Subscribe to it to keep it up to date"
	var links []timetableLink
	for _, l := range []timetableLink{
		{"Your timetable", mine, ""},
		{"Club timetable", club, ""},
		{"Add to calendar", calendar, subscribe},
		{"Club calendar", clubCalendar, subscribe},
	} {
		if l.Href != "" {
			links = append(links, l)
		}
	}
	return links
}

// roleClass is a role's colour on a person's page: a gymnast's or a coach's,
// and the officials' (judge, recorder, marshal) the organiser's.
func roleClass(r string) string {
	switch r {
	case "Gymnast", "Synchro partner":
		return string(RoleGymnast)
	case "Coach":
		return string(RoleCoach)
	}
	return string(RoleOrganiser)
}
