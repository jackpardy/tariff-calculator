package views

import (
	"fmt"
	"strconv"

	"tariffCalculator/skills"
	"tariffCalculator/static"
)

// TariffSheetPage is the printable tariff sheet page. It is a plain link from the
// calculator (so reloading works and nothing is blocked as a popup): on load it
// posts the routine saved in this browser and swaps in TariffSheet.
templ TariffSheetPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Tariff Sheet</title>
			<meta name="app-version" content={ static.Version }/>
			<script defer src={ static.URL("js/version.js") }></script>
			<link rel="stylesheet" href={ static.URL("css/sheet.css") }/>
			<script src={ static.URL("js/htmx.min.js") }></script>
			<script defer src={ static.URL("js/routines.js") }></script>
			<script defer src={ static.URL("js/sets.js") }></script>
			<script defer src={ static.URL("js/sheet.js") }></script>
			<script defer src={ static.URL("js/menus.js") }></script>
		</head>
		<body>
			<div class="toolbar screen-only">
				<button type="button" class="print" onclick="window.print()">Print / Save as PDF</button>
				// Display options (static/js/sheet.js): each box hides part of the sheet, on
				// screen and in print, by toggling its data-hides class on #tariff-sheet.
				<details class="options" data-menu>
					<summary>Show on sheet</summary>
					<div class="options-panel">
						<fieldset>
							<legend>Table</legend>
							<label class="option"><input type="checkbox" id="show-names" data-hides="hide-names" checked/> Skill names</label>
							<label class="option"><input type="checkbox" id="show-req" data-hides="hide-req" checked/> Req. * column</label>
							<label class="option"><input type="checkbox" id="show-judge" data-hides="hide-judge" checked/> Judge column</label>
						</fieldset>
						<fieldset>
							<legend>Details</legend>
							for _, f := range sheetFields {
								<label class="option">
									<input type="checkbox" id={ "show-field-" + f.Key } data-hides={ "hide-field-" + f.Key } checked/>
									{ f.Label }
								</label>
							}
						</fieldset>
					</div>
				</details>
				<span>Fill in the details, then print. What you type isn't saved.</span>
			</div>
			<div
				id="tariff-sheet"
				hx-post="/tariff-sheet"
				hx-trigger="load"
				hx-vals="js:{routineData: JSON.stringify(RoutineStore.current(RoutineStore.load()).skills), requirementSet: SetStore.payload(RoutineStore.current(RoutineStore.load()).requirements), checks: JSON.stringify(RoutineStore.current(RoutineStore.load()).checks || {})}"
				hx-on:htmx:response-error="this.querySelector('.loading').textContent = 'Could not build the sheet: ' + event.detail.xhr.responseText"
			>
				<p class="loading screen-only">Loading the current routine saved in this browser...</p>
			</div>
		</body>
	</html>
}

// TariffSheet is a printable tariff sheet (competition card) for a routine: the
// elements in performance order with their FIG notation and difficulty (CoP
// §6.1-6.2). The details fields are filled in on the page before printing and
// are not stored. Warnings show on screen only.
templ TariffSheet(rv skills.RoutineValidation, required map[int]bool, checks Checks) {
	if issues := sheetIssues(rv); len(issues) > 0 {
		<div class="warnings screen-only">
			<strong>Check before printing:</strong>
			<ul>
				for _, issue := range issues {
					<li>{ issue }</li>
				}
			</ul>
		</div>
	}
	<main class="sheet">
		<h1>Tariff Sheet</h1>
		<div class="fields">
			for _, f := range sheetFields {
				<label class={ "field-" + f.Key }>
					{ f.Label }
					<input type="text" aria-label={ f.Label }/>
				</label>
			}
		</div>
		// Scrolls sideways on narrow screens; on paper it fits the page.
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th class="num" rowspan="2">No.</th>
						// "Element" spans its name and FIG sub-columns, or FIG alone when names are
						// hidden: two cells, one shown per mode, as a span can't change in CSS.
						<th class="element element-with-names" colspan="2">Element</th>
						<th class="element element-without-names">Element</th>
						<th class="diff" rowspan="2">Difficulty</th>
						<th class="req" rowspan="2" title="Required element (CoP §6.1.1)">Req. *</th>
						<th class="judge" rowspan="2">Judge</th>
					</tr>
					<tr class="subhead">
						<th class="col-name">Name</th>
						<th class="fig">FIG</th>
					</tr>
				</thead>
				<tbody>
					for i := range sheetRows(len(rv.Skills)) {
						if i < len(rv.Skills) {
							@sheetRow(i, rv.Skills[i], required[i+1])
						} else {
							<tr class="blank">
								<td class="num">{ strconv.Itoa(i + 1) }</td>
								<td class="col-name"></td>
								<td></td>
								<td></td>
								<td class="req"></td>
								<td class="judge"></td>
							</tr>
						}
					}
				</tbody>
				<tfoot>
					<tr>
						// Two label cells, one shown per mode, so the total stays under Difficulty
						// whether or not the name column is shown.
						<td colspan="3" class="total-with-names">Total difficulty</td>
						<td colspan="2" class="total-without-names">Total difficulty</td>
						<td class="diff">
							if checks.ScoreDifficulty {
								{ fmt.Sprintf("%.1f", rv.TotalTariff) }
							} else {
								—
							}
						</td>
						<td class="req"></td>
						<td class="judge"></td>
					</tr>
				</tfoot>
			</table>
		</div>
		<p class="footnote">
			Difficulty per FIG TRA Code of Points 2025-2028 §17.
			if checks.ScoreDifficulty {
				Elements marked "not counted" do not add to the total.
			} else {
				Difficulty isn't scored for this routine.
			}
		</p>
	</main>
}

// sheetRow is one element; required ticks its Req. box (it meets a required-element rule).
templ sheetRow(i int, sv skills.SkillValidation, required bool) {
	<tr class={ templ.KV("not-counted", !sv.Counted) }>
		<td class="num">{ strconv.Itoa(i + 1) }</td>
		<td class="col-name">
			{ sv.Skill.Name }
			if sv.Skill.CustomName != "" {
				<span class="custom">{ sv.Skill.CustomName }</span>
			}
		</td>
		<td class="fig">{ sv.FIGNotation }</td>
		<td class="diff">
			{ fmt.Sprintf("%.1f", sv.Skill.Tariff) }
			if reason := notCountedReason(i, sv); reason != "" {
				<span class="note">not counted ({ reason })</span>
			}
		</td>
		<td class="req"><input type="checkbox" checked?={ required } aria-label={ fmt.Sprintf("Element %d is a required element", i+1) }/></td>
		<td class="judge"></td>
	</tr>
}

// sheetFields are the fill-in details at the top of the sheet, each of which can
// be hidden. Key names the CSS classes (field-<key>, hide-field-<key>).
var sheetFields = []struct{ Key, Label string }{
	{"gymnast", "Gymnast"},
	{"club", "Club / Nation"},
	{"category", "Category"},
	{"competition", "Competition"},
	{"round", "Round / Exercise"},
	{"coach", "Coach"},
}

// sheetRows is the number of rows on the sheet: the routine, and at least a full
// exercise of RoutineLength elements.
func sheetRows(n int) int {
	return max(n, skills.RoutineLength)
}

// notCountedReason says why skill i adds nothing to the total, or "" if it counts.
func notCountedReason(i int, sv skills.SkillValidation) string {
	switch {
	case sv.Counted:
		return ""
	case i >= skills.RoutineLength:
		return "after the 10th"
	case sv.Interrupts || sv.AfterInterruption:
		return "interruption"
	case sv.IsDuplicate:
		return "repeat"
	default:
		return "see warnings"
	}
}

// sheetIssues lists the routine's problems, for the on-screen check before printing.
func sheetIssues(rv skills.RoutineValidation) []string {
	var issues []string
	if rv.InterruptedAt >= 0 {
		issues = append(issues, interruptionText(rv.InterruptedAt))
	}
	for i, m := range rv.Messages {
		if m != "" {
			issues = append(issues, fmt.Sprintf("Element %d: %s", i+1, m))
		}
	}
	if n := len(rv.Skills); n != skills.RoutineLength {
		issues = append(issues, fmt.Sprintf("The routine has %d elements; an exercise has %d.", n, skills.RoutineLength))
	}
	return issues
}
