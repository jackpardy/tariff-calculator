package views

import (
	"strconv"
	"strings"
)

// CoachApprovalForm is the dashboard's setting for approving coaches (ADR
// 0007 Decision 2).
type CoachApprovalForm struct {
	On      bool
	Levels  []CoachLevelField
	Waiting int // coaches sent and not decided yet
}

// CoachLevelField is the lowest level accepted in a discipline.
type CoachLevelField struct {
	Key, Name string
	Level     int
}

// ApprovalsPage is the organiser's page of coaches sent for approval.
type ApprovalsPage struct {
	Base        string // the admin link's path
	Competition CompetitionSummary
	Menu []MenuSection
	Notice      string
	Asked       string // the levels asked for, e.g. "Trampoline Level 2, Tumbling Level 1"
	Clubs       []ApprovalClub
	Total       int       // coaches sent, over all the clubs
	Tools       ListTools // the list's search and filters
}

// ApprovalClub is one club's coaches sent.
type ApprovalClub struct {
	Club    string
	Coaches []ApprovalRow
}

// ApprovalRow is one coach sent, to approve.
type ApprovalRow struct {
	ID, Name       string
	Anchor         string // its id on the page, to come back to after deciding
	Person         string // their page
	Action         string // where deciding posts
	Status         string // e.g. "Waiting", "Approved ✓"
	Approved       bool
	Withdrawn      bool // approved before, so approving again asks about their sign-offs
	Note           string
	Changed        bool // the club has changed their qualifications since sending them
	Qualifications []ApprovalQualification
	Meets          []string // each discipline asked for, met or not, e.g. "Trampoline ✓"
	List           ListRow  // what the list's search and filters see
}

// ApprovalQualification is a coach's qualification, with its certificate.
type ApprovalQualification struct {
	Name, Certificate string
}

// coachApprovalFields are the dashboard's setting for approving coaches.
templ coachApprovalFields(base string, f CoachApprovalForm) {
	<form method="post" action={ templ.SafeURL(base + "/approve-coaches") } class="mb-3">
		<label class="checkbox">
			<input type="checkbox" name="on" value="1" checked?={ f.On }/>
			Coaches must be approved: clubs send their coaches with their qualifications, and only those you approve can sign off
		</label>
		<div class="comp-setup-row mt-1">
			<span class="is-size-7">Lowest level accepted:</span>
			for _, l := range f.Levels {
				<label class="is-size-7" for={ "coach-level-" + l.Key }>{ l.Name }</label>
				<div class="select is-small">
					<select id={ "coach-level-" + l.Key } name={ "level-" + l.Key }>
						for n := 1; n <= 4; n++ {
							<option value={ strconv.Itoa(n) } selected?={ n == l.Level }>Level { strconv.Itoa(n) }</option>
						}
					</select>
				</div>
			}
		</div>
		<p class="help">British Gymnastics and Gymnastics Ireland coaching levels; a higher level counts.</p>
		<button class="button is-small" type="submit">Save</button>
	</form>
}

// CompetitionApprovals is the organiser's page of coaches to approve.
templ CompetitionApprovals(p ApprovalsPage) {
	@competitionLayout("Coaches · " + p.Competition.Name) {
		<h1 class="title is-4">Coaches</h1>
		<p class="subtitle is-6">{ p.Competition.Name }</p>
		@pageMenu(p.Menu)
		if p.Notice != "" {
			// Stays in sight as the page goes to the coach decided on.
			@stickyNotice(p.Notice)
		}
		<p class="mb-4">Only coaches you approve can sign off. You ask for at least { p.Asked }. Open each certificate to check it; clubs see your note.</p>
		@listSection("Coaches", p.Total) {
			if len(p.Clubs) == 0 {
				<p class="has-text-grey">No club has sent its coaches yet.</p>
			} else {
				@listTools(p.Tools)
				<div id={ p.Tools.ID }>
					for _, c := range p.Clubs {
						<div class="box" data-list-group>
							<h2 class="title is-6">{ c.Club }</h2>
							for _, k := range c.Coaches {
								<div class="mb-4 comp-target" id={ k.Anchor } { k.List.Attrs()... }>
									<p>
										<strong><a href={ templ.SafeURL(k.Person) }>{ k.Name }</a></strong>
										@StateChip(approvalState(k))
										if k.Changed {
											<span class="is-size-7 has-text-grey">· the club has changed their qualifications since, not sent yet</span>
										}
									</p>
									if len(k.Qualifications) == 0 {
										<p class="is-size-7 has-text-danger">No qualifications sent.</p>
									}
									<ul class="is-size-7">
										for _, q := range k.Qualifications {
											<li>{ q.Name } · <a href={ templ.SafeURL(q.Certificate) } target="_blank" rel="noopener">certificate</a></li>
										}
									</ul>
									<p class="is-size-7 has-text-grey">{ strings.Join(k.Meets, " · ") }</p>
									if k.Note != "" {
										<p class="is-size-7">Your note: { k.Note }</p>
									}
									<form method="post" action={ templ.SafeURL(k.Action) } class="comp-flight-actions mt-1">
										<input class="input is-small" name="note" maxlength="300" placeholder="Note for the club (optional)" aria-label={ "Note about " + k.Name }/>
										if !k.Approved {
											if k.Withdrawn {
												<button class="button is-small is-success" type="submit" name="action" value="approve">Approve, with their sign-offs before</button>
												<button class="button is-small is-success is-light" type="submit" name="action" value="afresh">Approve, sign-offs from now on</button>
											} else if len(k.Qualifications) == 0 {
												// Asks first: there's nothing to check.
												<button class="button is-small is-success" type="submit" name="action" value="approve" onclick={ confirmFirst("Approve " + k.Name + "? Their club hasn't sent any qualifications.") }>Approve</button>
											} else {
												<button class="button is-small is-success" type="submit" name="action" value="approve">Approve</button>
											}
										}
										if k.Approved {
											<button class="button is-small is-warning is-light" type="submit" name="action" value="withdraw" onclick={ confirmFirst("Withdraw " + k.Name + "'s approval? Their sign-offs stop counting.") }>Withdraw approval</button>
										} else if !k.Withdrawn && k.Status != "Not approved" {
											<button class="button is-small is-warning is-light" type="submit" name="action" value="refuse">Not approved</button>
										}
									</form>
								</div>
							}
						</div>
					}
				</div>
			}
		}
	}
}

// entryCoachBox is where an individual names their coach.
templ entryCoachBox(c EntryCoachView, open bool) {
	<div class="mt-4">
		if open {
			// A setting row: open at first until they've named one, as naming
			// them is what's left to do.
			@opens("Your coach", entryCoachNow(c), entryCoachLabel(c), c.Name == "") {
				<p class="is-size-7 mb-2">This competition approves coaches: name yours, with their coaching qualification (at least { c.Asked }) and a photo or PDF of its certificate. Once the organiser approves them, they can sign off your entry with your coach's sign-off link. Only the organiser sees the certificate, and it's deleted with the competition.</p>
				if c.Name != "" {
					<p class="is-size-7 mb-2">Changing your coach sends them to the organiser to approve again.</p>
				}
				<form method="post" action={ templ.SafeURL(c.Action) } enctype="multipart/form-data">
					<div class="field">
						<input class="input is-small" name="name" required maxlength="80" placeholder="Coach's name" aria-label="Coach's name"/>
					</div>
					<div class="field">
						<div class="select is-small">
							<select name="qualification" required aria-label="Their qualification">
								<option value="">Qualification…</option>
								for _, o := range c.Options {
									<option value={ o.ID }>{ o.Name }</option>
								}
							</select>
						</div>
					</div>
					<div class="field">
						<input class="input is-small" type="file" name="certificate" required accept="image/jpeg,image/png,image/webp,application/pdf" aria-label="Their certificate"/>
						<p class="help">A photo or PDF, up to 3 MB.</p>
					</div>
					<button class="button is-small" type="submit">Send to the organiser</button>
				</form>
			}
		} else {
			<p class="mb-2"><strong>Your coach</strong> <span class="has-text-grey">{ entryCoachNow(c) }</span></p>
		}
		if c.Name != "" {
			<p class="is-size-7 mb-3">
				@StateChip(c.State, c.Status)
				if c.Note != "" {
					<span class="has-text-grey">The organiser's note: { c.Note }</span>
				}
			</p>
		}
	</div>
}

// entryCoachNow says who an individual named as their coach.
func entryCoachNow(c EntryCoachView) string {
	if c.Name == "" {
		return "None named yet: the competition approves coaches"
	}
	return c.Name + " · " + c.Qualification
}

// entryCoachLabel is the button opening the form to name a coach.
func entryCoachLabel(c EntryCoachView) string {
	if c.Name == "" {
		return "Name your coach"
	}
	return "Change"
}

// PairView is a synchro entry as its partner's side sees it.
type PairView struct {
	Competition string
	Title       string // e.g. "Synchro BUCS L6/L7 · Ann and Bea"
	EnteredBy   string // e.g. "Ann (UCD)"
	Status      string
	Placement   *Placement
	Card        EntryCard
}

// pairEntries are synchro entries the gymnast (or their coach's or club's
// member) is the partner in, entered by the other gymnast.
templ pairEntries(list []PairView) {
	if len(list) > 0 {
		<div class="box">
			<h2 class="title is-6 mb-2">Synchro as a partner</h2>
			<p class="is-size-7 mb-2">Entries the other gymnast made and changes; they're here once the partner confirms.</p>
			for _, v := range list {
				<details class="mb-2">
					<summary>{ v.Title } <span class="has-text-grey is-size-7">· { v.Competition }</span></summary>
					<p class="is-size-7 mt-1">Entered by { v.EnteredBy } · { v.Status }</p>
					@placementLine(v.Placement)
					// The summary names the pair: no page-sized heading again.
					@entryCardChecks(v.Card)
				</details>
			}
		</div>
	}
}

// approvalState is the organiser's decision about a coach as a state chip,
// in the palette's colours: approved, not approved or withdrawn, or waiting.
func approvalState(k ApprovalRow) (State, string) {
	label := strings.TrimSuffix(k.Status, " ✓")
	switch {
	case k.Approved:
		return Done, label
	case k.Withdrawn || k.Status == "Not approved":
		return Stopped, label
	}
	return InProgress, label
}
