package views

import (
	"fmt"

	"tariffCalculator/requirements"
	"tariffCalculator/static"
)

// Page is the calculator page. The form and routine are empty placeholders that
// the page's Alpine component (static/js/app.js) fills from the server on load.
templ Page(groups []requirements.BuiltinGroup) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Trampoline Tariff Calculator</title>
			<meta name="app-version" content={ static.Version }/>
			<script defer src={ static.URL("js/version.js") }></script>
			<link rel="stylesheet" href={ static.URL("css/bulma.min.css") }/>
			<link rel="stylesheet" href={ static.URL("css/styles.css") }/>
			<script src={ static.URL("js/htmx.min.js") }></script>
			<script defer src={ static.URL("js/sortable.min.js") }></script>
			<script defer src={ static.URL("js/routines.js") }></script>
			<script defer src={ static.URL("js/sets.js") }></script>
			<script defer src={ static.URL("js/share.js") }></script>
			<script defer src={ static.URL("js/menus.js") }></script>
			// app.js defines the Alpine component, so it must run before Alpine (all deferred, in order).
			<script defer src={ static.URL("js/app.js") }></script>
			<script defer src={ static.URL("js/alpine.min.js") }></script>
			@templ.JSONScript("level-data", levelData(groups))
		</head>
		<body>
			<section class="hero is-primary">
				<div class="hero-body">
					<div class="container">
						<h1 class="title">Trampoline Tariff Calculator</h1>
						<h2 class="subtitle">Calculate difficulty scores for skills and routines</h2>
					</div>
				</div>
			</section>
			<section class="section">
				<div class="container">
					@calculator(groups)
				</div>
			</section>
			<footer class="footer">
				<div class="content has-text-centered">
					<p>Trampoline Tariff Calculator · difficulty per the FIG Trampoline Code of Points 2025–2028</p>
				</div>
			</footer>
		</body>
	</html>
}

templ calculator(groups []requirements.BuiltinGroup) {
	<div class="container" x-data="tariffCalculatorStore()">
		// "Add a skill" panel: SkillFormView, loaded by the component.
		<div class="box">
			<h3 class="title is-4" x-text="editingIndex === null ? 'Add a skill' : `Edit skill ${editingIndex + 1}` + (compareId ? ` of ${routineFor(editingSide)?.name}` : '')">Add a skill</h3>
			<div id="skill-form-wrapper" style="scroll-margin-top: 20px;" hx-sync="this:replace">
				<p>Loading form...</p>
			</div>
		</div>
		// Routine builder: routines (Routines mode), or a level's exercises (Levels mode).
		<div class="box" x-bind:class="mode === 'levels' && 'is-levels'">
			<div class="level mb-3">
				<div class="level-left">
					<h3 class="title is-4 mb-0">Routine Builder</h3>
				</div>
				<div class="level-right">
					<div class="buttons mb-0">
						<a class="button is-link is-small" href="/view" x-bind:href="viewHref()" target="_blank" rel="noopener" title="Show full screen">View</a>
						<a class="button is-primary is-small" href="/tariff-sheet" target="_blank" rel="noopener">Tariff Sheet</a>
						<a class="button is-link is-light is-small" href="/compare" target="_blank" rel="noopener" x-show="routines.length > 1">Compare</a>
					</div>
				</div>
			</div>
			<div class="tabs is-toggle is-small builder-mode">
				<ul>
					<li x-bind:class="mode === 'routines' && 'is-active'"><a x-on:click="setMode('routines')">Routines</a></li>
					<li x-bind:class="mode === 'levels' && 'is-active'"><a x-on:click="setMode('levels')">Levels</a></li>
				</ul>
			</div>
			<div x-show="mode === 'routines'">
				// Saved routines: switch between them or start a new one; the rest is under More.
				<div class="routine-switcher">
					<div class="select is-small">
						<select aria-label="Routine" x-on:change="switchRoutine($event.target.value)">
							<template x-for="r in routines" x-bind:key="r.id">
								<option x-bind:value="r.id" x-bind:selected="r.id === currentId" x-text="`${r.name} (${r.skills.length})`"></option>
							</template>
						</select>
					</div>
					<button class="button is-small" type="button" x-on:click="newRoutine()">+ New</button>
					@setRoutineStarter(groups)
					<button class="button is-small" type="button" x-on:click="Share.open('routines', [currentId])">Share</button>
					<details class="routine-menu" data-menu>
						<summary class="button is-small">More</summary>
						// Close the menu after any choice.
						<div class="routine-menu-panel" x-on:click="$el.closest('details').removeAttribute('open')">
							<button class="button is-small is-white" type="button" x-on:click="renameRoutine()">Rename</button>
							<button class="button is-small is-white" type="button" x-on:click="duplicateRoutine()">Duplicate</button>
							<button class="button is-small is-white" type="button" x-on:click="saveAsSetRoutine()" x-bind:disabled="routine.length === 0">Save as a set routine</button>
							<button class="button is-small is-white" type="button" x-on:click="expandAll()">Expand all</button>
							<button class="button is-small is-white" type="button" x-on:click="collapseAll()">Collapse all</button>
							<button class="button is-small is-white has-text-danger" type="button" x-on:click="clearRoutine()" x-bind:disabled="routine.length === 0">Clear skills</button>
							<button class="button is-small is-white has-text-danger" type="button" x-on:click="deleteRoutine()">Delete routine</button>
						</div>
					</details>
				</div>
				// A second routine to show beside this one; both columns can be edited.
				<div class="compare-with" x-show="routines.length > 1" x-cloak>
					<label class="label is-small mb-0" for="compare-with">Side by side with</label>
					<div class="select is-small">
						<select id="compare-with" x-on:change="compareWith($event.target.value)">
							<option value="" x-bind:selected="!compareId">None</option>
							<template x-for="r in routines.filter((r) => r.id !== currentId)" x-bind:key="r.id">
								<option x-bind:value="r.id" x-bind:selected="r.id === compareId" x-text="`${r.name} (${r.skills.length})`"></option>
							</template>
						</select>
					</div>
				</div>
			</div>
			@levelsBar(groups)
			// On phones the two columns are tabs, one shown at a time.
			<div class="tabs is-toggle is-small is-fullwidth compare-tabs" x-show="twoColumns()" x-cloak>
				<ul>
					<li x-bind:class="mobileTab === 'a' && 'is-active'"><a x-on:click="mobileTab = 'a'" x-text="columnTitle('a')"></a></li>
					<li x-bind:class="mobileTab === 'b' && 'is-active'"><a x-on:click="mobileTab = 'b'" x-text="columnTitle('b')"></a></li>
				</ul>
			</div>
			<div class="builder-columns" x-show="mode === 'routines' || entry()" x-bind:class="{ 'is-comparing': twoColumns(), 'shows-b': mobileTab === 'b' }">
				<div class="builder-column">
					<div class="column-head" x-show="twoColumns() && mode === 'routines'" x-cloak>
						<strong x-text="columnTitle('a')"></strong>
					</div>
					<div x-show="mode === 'routines'">
						@requirementPicker(groups, "a")
					</div>
					@levelColumnHead("a")
					// Cards and totals: Routine, re-rendered whenever the routine changes.
					<div id="routine-view" hx-sync="this:replace">
						<p class="has-text-grey">Loading routine...</p>
					</div>
				</div>
				<div class="builder-column" x-show="twoColumns()" x-cloak>
					<div class="column-head" x-show="mode === 'routines'">
						<strong x-text="columnTitle('b')"></strong>
						<div class="buttons are-small mb-0">
							<button class="button is-small" type="button" title="Swap the columns" aria-label="Swap the columns" x-on:click="swapColumns()">⇄</button>
							<button class="button is-small" type="button" title="Stop comparing" aria-label="Stop comparing" x-on:click="stopComparing()">✕</button>
						</div>
					</div>
					<div x-show="mode === 'routines'">
						@requirementPicker(groups, "b")
					</div>
					@levelColumnHead("b")
					<div id="routine-view-b" hx-sync="this:replace"></div>
				</div>
			</div>
			<p class="compare-legend" x-show="mode === 'routines' && compareId" x-cloak>Shaded skills differ from the other routine's skill at the same number.</p>
		</div>
		<div
			x-show="toast.show"
			x-transition
			class="notification is-fixed-bottom-right"
			x-bind:class="toast.type === 'error' ? 'is-danger' : 'is-info'"
		>
			<button class="delete" type="button" aria-label="Dismiss" x-on:click="toast.show = false"></button>
			<span x-text="toast.message"></span>
		</div>
	</div>
}

// requirementPicker chooses the requirements a builder column's routine is
// checked against (side is "a" or "b"): a level's voluntary requirements, or
// the user's own. Set routines aren't among them: a routine can start from one
// instead (setRoutineStarter).
templ requirementPicker(groups []requirements.BuiltinGroup, side string) {
	{{ id := map[string]string{"a": "requirement-set", "b": "requirement-set-b"}[side] }}
	<div class="requirement-picker">
		<label class="label is-small mb-1" for={ id }>Check against</label>
		<div class="requirement-picker-row">
			<div class="select is-small">
				<select id={ id } x-on:change={ fmt.Sprintf("setRequirements($event.target.value, '%s')", side) }>
					<option value="" x-bind:selected={ fmt.Sprintf("!routineFor('%s')?.requirements", side) }>No requirements</option>
					// Each level's voluntary requirements.
					for _, g := range groups {
						if options := CheckOptions(g); len(options) > 0 {
							<optgroup label={ g.Name }>
								for _, o := range options {
									<option value={ o.Ref } x-bind:selected={ fmt.Sprintf("routineFor('%s')?.requirements === '%s'", side, o.Ref) }>{ o.Label }</option>
								}
							</optgroup>
						}
					}
					<template x-if="customSets.some((s) => !isSetRoutine(s.set))">
						<optgroup label="Your requirements">
							<template x-for="s in customSets.filter((s) => !isSetRoutine(s.set))" x-bind:key="s.id">
								<option x-bind:value="s.id" x-bind:selected={ fmt.Sprintf("routineFor('%s')?.requirements === s.id", side) } x-text="s.set.name"></option>
							</template>
						</optgroup>
					</template>
				</select>
			</div>
			if side == "a" {
				<a class="button is-small is-text" href="/requirements" target="_blank" rel="noopener">Manage requirements</a>
			}
		</div>
	</div>
}

// levelsBar is the Levels mode's controls: the levels being worked on (switch,
// start one, rename or delete it), the level's tabs, and which tab to show
// beside the open one. A level with nothing yet asks which level to start.
templ levelsBar(groups []requirements.BuiltinGroup) {
	<div class="levels-bar" x-show="mode === 'levels'" x-cloak>
		<div class="routine-switcher">
			<template x-if="levelState.entries.length > 0">
				<div class="select is-small">
					<select aria-label="Level" x-on:change="switchEntry($event.target.value)">
						<template x-for="e in levelState.entries" x-bind:key="e.id">
							<option x-bind:value="e.id" x-bind:selected="e.id === levelState.current" x-text="e.name"></option>
						</template>
					</select>
				</div>
			</template>
			<div class="select is-small">
				<select aria-label="Start a level" x-on:change="newEntry($event.target.value); $event.target.value = ''">
					<option value="" selected>+ New level...</option>
					for _, g := range groups {
						if len(g.Levels) > 0 {
							<optgroup label={ g.Name }>
								for _, l := range g.Levels {
									<option value={ requirements.BuiltinLevelPrefix + l.ID }>{ l.Level.Name }</option>
								}
							</optgroup>
						}
					}
					<template x-if="customLevels.length > 0">
						<optgroup label="Your levels">
							<template x-for="l in customLevels" x-bind:key="l.id">
								<option x-bind:value="l.id" x-text="l.level.name"></option>
							</template>
						</optgroup>
					</template>
				</select>
			</div>
			<details class="routine-menu" data-menu x-show="entry()">
				<summary class="button is-small">More</summary>
				<div class="routine-menu-panel" x-on:click="$el.closest('details').removeAttribute('open')">
					<button class="button is-small is-white" type="button" x-on:click="renameEntry()">Rename</button>
					<button class="button is-small is-white has-text-danger" type="button" x-on:click="deleteEntry()">Delete level</button>
				</div>
			</details>
			<a class="button is-small is-text" href="/requirements" target="_blank" rel="noopener">Manage levels</a>
		</div>
		<p class="has-text-grey mt-3" x-show="!entry()">Choose a level under "+ New level" to see its set routines and build its voluntary.</p>
		<template x-if="entry()">
			<div class="level-tabs">
				<div class="tabs is-boxed mb-0">
					<ul>
						<template x-for="tab in entryTabs()" x-bind:key="tab.key">
							<li x-bind:class="{ 'is-active': tab.key === entry().open, 'is-beside': tab.key === entry().beside }">
								<a x-on:click="openTab(tab)" x-bind:title="(tab.exercise === 1 ? 'First' : 'Second') + ' exercise'">
									<span x-text="tab.label"></span>
									<span class="tab-chosen" x-show="isChosenTab(tab)" title="The set routine chosen for this exercise" aria-label="chosen">●</span>
								</a>
							</li>
						</template>
					</ul>
				</div>
				<div class="level-beside" x-show="entryTabs().length > 1">
					<label class="label is-small mb-0" for="level-beside">Side by side with</label>
					<div class="select is-small">
						<select id="level-beside" x-on:change="setBeside($event.target.value)">
							<option value="" x-bind:selected="!entry().beside">None</option>
							<template x-for="tab in entryTabs().filter((t) => t.key !== entry().open)" x-bind:key="tab.key">
								<option x-bind:value="tab.key" x-bind:selected="tab.key === entry().beside" x-text="tab.label"></option>
							</template>
						</select>
					</div>
				</div>
			</div>
		</template>
	</div>
}

// levelColumnHead heads a Levels mode column: the tab's name and requirements;
// for a set routine, starting the voluntary from it; for a voluntary, the
// routine doing it (a new one, one already built, or one started from a set).
templ levelColumnHead(side string) {
	<template x-if={ fmt.Sprintf("mode === 'levels' && columnTab('%s')", side) }>
		<div class="level-column-head">
			<div class="level-column-title">
				<strong x-text={ fmt.Sprintf("columnTab('%s').label", side) }></strong>
				<span class="level-column-requirements" x-text={ fmt.Sprintf("requirementName(columnTab('%s').ref)", side) }></span>
			</div>
			<template x-if={ fmt.Sprintf("columnTab('%s').set", side) }>
				<div class="level-column-actions">
					<span class="level-column-note">Set routine, as prescribed</span>
					<button class="button is-small is-light" type="button" x-show={ fmt.Sprintf("voluntaryFor('%s')", side) } x-on:click={ fmt.Sprintf("startVoluntaryFrom('%s')", side) } x-text={ fmt.Sprintf("`Start the ${voluntaryFor('%s')?.label.toLowerCase()} from this set`", side) }></button>
				</div>
			</template>
			<template x-if={ fmt.Sprintf("!columnTab('%s').set", side) }>
				<div class="level-column-actions">
					<label class="label is-small mb-0">Routine</label>
					<div class="select is-small">
						<select aria-label="The routine doing this voluntary" x-on:change={ fmt.Sprintf("linkVoluntary('%s', $event.target.value)", side) }>
							<option value="" x-bind:selected={ fmt.Sprintf("!columnRoutine('%s')", side) }>Choose...</option>
							<option value="new">+ New routine</option>
							<template x-for="r in routines" x-bind:key="r.id">
								<option x-bind:value="r.id" x-bind:selected={ fmt.Sprintf("r.id === columnRoutine('%s')?.id", side) } x-text="`${r.name} (${r.skills.length})`"></option>
							</template>
						</select>
					</div>
					<template x-for="set in entryTabs().filter((t) => t.set)" x-bind:key="set.key">
						<button class="button is-small is-light" type="button" x-on:click={ fmt.Sprintf("startVoluntaryFrom('%s', set)", side) } x-text="`Start from ${set.label}`"></button>
					</template>
				</div>
			</template>
		</div>
	</template>
}


// setRoutineStarter starts a routine from a set routine: into the routine on
// screen if it's empty, otherwise a new one. The set is a starting point, not
// requirements to check against.
templ setRoutineStarter(groups []requirements.BuiltinGroup) {
	<div class="select is-small">
		<select aria-label="Start from a set routine" x-on:change="startFromSetRoutine($event.target.value); $event.target.value = ''">
			<option value="" selected>Start from a set...</option>
			for _, g := range groups {
				if routines := g.SetRoutines(); len(routines) > 0 {
					<optgroup label={ g.Name }>
						for _, b := range routines {
							<option value={ requirements.BuiltinPrefix + b.ID }>{ b.Set.Name }</option>
						}
					</optgroup>
				}
			}
			<template x-if="customSets.some((s) => isSetRoutine(s.set))">
				<optgroup label="Your set routines">
					<template x-for="s in customSets.filter((s) => isSetRoutine(s.set))" x-bind:key="s.id">
						<option x-bind:value="s.id" x-text="s.set.name"></option>
					</template>
				</optgroup>
			</template>
		</select>
	</div>
}
