package views

import (
	"fmt"

	"tariffCalculator/requirements"
	"tariffCalculator/static"
)

// Page is the calculator page. The form and routine are empty placeholders that
// the page's Alpine component (static/js/app.js) fills from the server on load.
templ Page(groups []requirements.BuiltinGroup) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Trampoline Tariff Calculator</title>
			<meta name="app-version" content={ static.Version }/>
			<script defer src={ static.URL("js/version.js") }></script>
			<link rel="stylesheet" href={ static.URL("css/bulma.min.css") }/>
			<link rel="stylesheet" href={ static.URL("css/styles.css") }/>
			<script src={ static.URL("js/htmx.min.js") }></script>
			<script defer src={ static.URL("js/sortable.min.js") }></script>
			<script defer src={ static.URL("js/routines.js") }></script>
			<script defer src={ static.URL("js/sets.js") }></script>
			<script defer src={ static.URL("js/share.js") }></script>
			<script defer src={ static.URL("js/menus.js") }></script>
			// app.js defines the Alpine component, so it must run before Alpine (all deferred, in order).
			<script defer src={ static.URL("js/app.js") }></script>
			<script defer src={ static.URL("js/alpine.min.js") }></script>
			@templ.JSONScript("level-data", levelData(groups))
		</head>
		<body>
			<section class="hero is-primary">
				<div class="hero-body">
					<div class="container">
						<h1 class="title">Trampoline Tariff Calculator</h1>
						<h2 class="subtitle">Calculate difficulty scores for skills and routines</h2>
					</div>
				</div>
			</section>
			<section class="section">
				<div class="container">
					@calculator(groups)
				</div>
			</section>
			<footer class="footer">
				<div class="content has-text-centered">
					<p>Trampoline Tariff Calculator · difficulty per the FIG Trampoline Code of Points 2025–2028</p>
				</div>
			</footer>
		</body>
	</html>
}

templ calculator(groups []requirements.BuiltinGroup) {
	<div class="container" x-data="tariffCalculatorStore()">
		// "Add a skill" panel: SkillFormView, loaded by the component.
		<div class="box">
			<h3 class="title is-4" x-text="editingIndex === null ? 'Add a skill' : `Edit skill ${editingIndex + 1}` + (compareId ? ` of ${routineFor(editingSide)?.name}` : '')">Add a skill</h3>
			<div id="skill-form-wrapper" style="scroll-margin-top: 20px;" hx-sync="this:replace">
				<p>Loading form...</p>
			</div>
		</div>
		// Routine builder.
		<div class="box">
			<div class="level mb-3">
				<div class="level-left">
					<h3 class="title is-4 mb-0">Routine Builder</h3>
				</div>
				<div class="level-right">
					<div class="buttons mb-0">
						<a class="button is-primary is-small" href="/tariff-sheet" target="_blank" rel="noopener">Tariff Sheet</a>
						<a class="button is-link is-light is-small" href="/compare" target="_blank" rel="noopener" x-show="routines.length > 1">Compare</a>
					</div>
				</div>
			</div>
			// Saved routines: switch between them or start a new one; the rest is under More.
			<div class="routine-switcher">
				<div class="select is-small">
					<select aria-label="Routine" x-on:change="switchRoutine($event.target.value)">
						<template x-for="r in routines" x-bind:key="r.id">
							<option x-bind:value="r.id" x-bind:selected="r.id === currentId" x-text="`${r.name} (${r.skills.length})`"></option>
						</template>
					</select>
				</div>
				<button class="button is-small" type="button" x-on:click="newRoutine()">+ New</button>
				<button class="button is-small" type="button" x-on:click="Share.open('routines', [currentId, partnerOf('a')?.id].filter(Boolean))">Share</button>
				<details class="routine-menu" data-menu>
					<summary class="button is-small">More</summary>
					// Close the menu after any choice.
					<div class="routine-menu-panel" x-on:click="$el.closest('details').removeAttribute('open')">
						<button class="button is-small is-white" type="button" x-on:click="renameRoutine()">Rename</button>
						<button class="button is-small is-white" type="button" x-on:click="duplicateRoutine()">Duplicate</button>
						<button class="button is-small is-white" type="button" x-on:click="expandAll()">Expand all</button>
						<button class="button is-small is-white" type="button" x-on:click="collapseAll()">Collapse all</button>
						<button class="button is-small is-white has-text-danger" type="button" x-on:click="clearRoutine()" x-bind:disabled="routine.length === 0">Clear skills</button>
						<button class="button is-small is-white has-text-danger" type="button" x-on:click="deleteRoutine()">Delete routine</button>
					</div>
				</details>
			</div>
			// A second routine to show beside this one; both columns can be edited.
			<div class="compare-with" x-show="routines.length > 1" x-cloak>
				<label class="label is-small mb-0" for="compare-with">Side by side with</label>
				<div class="select is-small">
					<select id="compare-with" x-on:change="compareWith($event.target.value)">
						<option value="" x-bind:selected="!compareId">None</option>
						<template x-for="r in routines.filter((r) => r.id !== currentId)" x-bind:key="r.id">
							<option x-bind:value="r.id" x-bind:selected="r.id === compareId" x-text="`${r.name} (${r.skills.length})`"></option>
						</template>
					</select>
				</div>
			</div>
			// On phones the two routines are tabs, one shown at a time.
			<div class="tabs is-toggle is-small is-fullwidth compare-tabs" x-show="compareId" x-cloak>
				<ul>
					<li x-bind:class="mobileTab === 'a' && 'is-active'"><a x-on:click="mobileTab = 'a'" x-text="`${currentRoutine()?.name} (${routine.length})`"></a></li>
					<li x-bind:class="mobileTab === 'b' && 'is-active'"><a x-on:click="mobileTab = 'b'" x-text="`${compareRoutine()?.name} (${routineB.length})`"></a></li>
				</ul>
			</div>
			<div class="builder-columns" x-bind:class="{ 'is-comparing': compareId, 'shows-b': mobileTab === 'b' }">
				<div class="builder-column">
					<div class="column-head" x-show="compareId" x-cloak>
						<strong x-text="currentRoutine()?.name"></strong>
					</div>
					@requirementPicker(groups, "a")
					// Cards and totals: Routine, re-rendered whenever the routine changes.
					<div id="routine-view" hx-sync="this:replace">
						<p class="has-text-grey">Loading routine...</p>
					</div>
				</div>
				<div class="builder-column" x-show="compareId" x-cloak>
					<div class="column-head">
						<strong x-text="compareRoutine()?.name"></strong>
						<div class="buttons are-small mb-0">
							<button class="button is-small" type="button" title="Swap the columns" aria-label="Swap the columns" x-on:click="swapColumns()">⇄</button>
							<button class="button is-small" type="button" title="Stop comparing" aria-label="Stop comparing" x-on:click="stopComparing()">✕</button>
						</div>
					</div>
					@requirementPicker(groups, "b")
					<div id="routine-view-b" hx-sync="this:replace"></div>
				</div>
			</div>
			<p class="compare-legend" x-show="compareId && partnerOf('a')?.id !== compareId" x-cloak>Shaded skills differ from the other routine's skill at the same number.</p>
		</div>
		// Loading a set routine into a routine that has skills: a new routine, or replace them.
		<div class="modal" x-bind:class="setRoutineOffer && 'is-active'" x-on:keydown.escape.window="cancelSetRoutine()">
			<div class="modal-background" x-on:click="cancelSetRoutine()"></div>
			<template x-if="setRoutineOffer">
				<div class="modal-card set-routine-dialog" role="dialog" aria-modal="true" aria-labelledby="set-routine-title">
					<section class="modal-card-body">
						<p class="title is-5 mb-2" id="set-routine-title">Load the set routine</p>
						<p class="mb-4">
							<strong x-text="setRoutineOffer.name"></strong>
							<span x-text="` has ${setRoutineOffer.skills.length} skills. ${routineFor(setRoutineOffer.side).name} already has ${skillsOf(setRoutineOffer.side).length}.`"></span>
						</p>
						<div class="set-routine-choices">
							<button class="button is-primary is-fullwidth" type="button" x-on:click="newRoutineFromSetRoutine()">Add as a new routine</button>
							<button class="button is-fullwidth" type="button" x-on:click="replaceWithSetRoutine()" x-text="`Replace the skills in ${routineFor(setRoutineOffer.side).name}`"></button>
							<button class="button is-text is-fullwidth" type="button" x-on:click="cancelSetRoutine()">Cancel</button>
						</div>
					</section>
				</div>
			</template>
		</div>
		<div
			x-show="toast.show"
			x-transition
			class="notification is-fixed-bottom-right"
			x-bind:class="toast.type === 'error' ? 'is-danger' : 'is-info'"
		>
			<button class="delete" type="button" aria-label="Dismiss" x-on:click="toast.show = false"></button>
			<span x-text="toast.message"></span>
		</div>
	</div>
}

// requirementPicker chooses what a builder column's routine is checked against
// (side is "a" or "b"): a level, built-in requirements or a set routine, or the
// user's own. With a level, it also chooses which exercise the routine is, which
// of that exercise's options (e.g. set routine option 1 or 2), and the routine
// doing the other exercise.
templ requirementPicker(groups []requirements.BuiltinGroup, side string) {
	{{ id := map[string]string{"a": "requirement-set", "b": "requirement-set-b"}[side] }}
	<div class="requirement-picker">
		<label class="label is-small mb-1" for={ id }>Check against</label>
		<div class="requirement-picker-row">
			<div class="select is-small">
				<select id={ id } x-on:change={ fmt.Sprintf("chooseCheck($event.target.value, '%s')", side) }>
					<option value="" x-bind:selected={ fmt.Sprintf("!routineFor('%s')?.requirements && !routineFor('%s')?.level", side, side) }>No requirements</option>
					// Levels first: both exercises, paired.
					for _, g := range groups {
						if len(g.Levels) > 0 {
							<optgroup label={ "Levels · " + g.Name }>
								for _, l := range g.Levels {
									<option value={ "level:" + requirements.BuiltinLevelPrefix + l.ID } x-bind:selected={ fmt.Sprintf("routineFor('%s')?.level === '%s%s'", side, requirements.BuiltinLevelPrefix, l.ID) }>{ l.Level.Name }</option>
								}
							</optgroup>
						}
					}
					<template x-if="customLevels.length > 0">
						<optgroup label="Your levels">
							<template x-for="l in customLevels" x-bind:key="l.id">
								<option x-bind:value="'level:' + l.id" x-bind:selected={ fmt.Sprintf("routineFor('%s')?.level === l.id", side) } x-text="l.level.name"></option>
							</template>
						</optgroup>
					</template>
					for _, g := range groups {
						if sets := g.Requirements(); len(sets) > 0 {
							<optgroup label={ g.Name }>
								for _, b := range sets {
									@builtinOption(b, side)
								}
							</optgroup>
						}
					}
					// Set (prescribed) routines apart, by source.
					for _, g := range groups {
						if routines := g.SetRoutines(); len(routines) > 0 {
							<optgroup label={ "Set routines · " + g.Name }>
								for _, b := range routines {
									@builtinOption(b, side)
								}
							</optgroup>
						}
					}
					<template x-if="customSets.some((s) => !isSetRoutine(s.set))">
						<optgroup label="Your requirements">
							<template x-for="s in customSets.filter((s) => !isSetRoutine(s.set))" x-bind:key="s.id">
								<option x-bind:value="s.id" x-bind:selected={ fmt.Sprintf("!routineFor('%s')?.level && routineFor('%s')?.requirements === s.id", side, side) } x-text="s.set.name"></option>
							</template>
						</optgroup>
					</template>
					<template x-if="customSets.some((s) => isSetRoutine(s.set))">
						<optgroup label="Your set routines">
							<template x-for="s in customSets.filter((s) => isSetRoutine(s.set))" x-bind:key="s.id">
								<option x-bind:value="s.id" x-bind:selected={ fmt.Sprintf("!routineFor('%s')?.level && routineFor('%s')?.requirements === s.id", side, side) } x-text="s.set.name"></option>
							</template>
						</optgroup>
					</template>
				</select>
			</div>
			if side == "a" {
				<a class="button is-small is-text" href="/requirements" target="_blank" rel="noopener">Manage requirements</a>
			}
		</div>
		@levelControls(side)
	</div>
}

// levelControls are shown for a routine doing one of a level's exercises.
templ levelControls(side string) {
	<template x-if={ fmt.Sprintf("routineFor('%s')?.level", side) }>
		<div class="level-controls">
			<div class="buttons has-addons mb-0" role="group" aria-label="Exercise">
				for n, label := range []string{"First exercise", "Second exercise"} {
					<button
						class="button is-small"
						type="button"
						x-bind:class={ fmt.Sprintf("exerciseOf('%s') === %d && 'is-link is-selected'", side, n+1) }
						x-bind:aria-pressed={ fmt.Sprintf("exerciseOf('%s') === %d", side, n+1) }
						x-on:click={ fmt.Sprintf("setExercise('%s', %d)", side, n+1) }
					>{ label }</button>
				}
			</div>
			// The exercise's options, when there's a choice (e.g. set routine option 1 or 2).
			<template x-if={ fmt.Sprintf("optionsFor('%s').length > 1", side) }>
				<div class="select is-small">
					<select aria-label="Which requirements" x-on:change={ fmt.Sprintf("setOption('%s', $event.target.value)", side) }>
						<template x-for={ fmt.Sprintf("ref in optionsFor('%s')", side) } x-bind:key="ref">
							<option x-bind:value="ref" x-bind:selected={ fmt.Sprintf("ref === routineFor('%s').requirements", side) } x-text="requirementName(ref)"></option>
						</template>
					</select>
				</div>
			</template>
			<div class="level-partner">
				<span class="level-partner-label" x-text={ fmt.Sprintf("exerciseOf('%s') === 1 ? 'Second exercise' : 'First exercise'", side) }></span>
				<div class="select is-small">
					<select aria-label="The routine doing the other exercise" x-on:change={ fmt.Sprintf("pairWith('%s', $event.target.value)", side) }>
						<option value="" x-bind:selected={ fmt.Sprintf("!partnerOf('%s')", side) }>None yet</option>
						<template x-for={ fmt.Sprintf("r in routines.filter((r) => r.id !== routineFor('%s').id)", side) } x-bind:key="r.id">
							<option x-bind:value="r.id" x-bind:selected={ fmt.Sprintf("r.id === partnerOf('%s')?.id", side) } x-text="`${r.name} (${r.skills.length})`"></option>
						</template>
						<option value="new">+ New routine</option>
					</select>
				</div>
				<button
					class="button is-small"
					type="button"
					x-show={ fmt.Sprintf("partnerOf('%s') && !isShown(partnerOf('%s').id)", side, side) }
					x-on:click={ fmt.Sprintf("showPartner('%s')", side) }
				>Side by side</button>
			</div>
		</div>
	</template>
}

// builtinOption is a built-in set in a requirement picker.
templ builtinOption(b requirements.Builtin, side string) {
	<option value={ requirements.BuiltinPrefix + b.ID } x-bind:selected={ fmt.Sprintf("!routineFor('%s')?.level && routineFor('%s')?.requirements === '%s%s'", side, side, requirements.BuiltinPrefix, b.ID) }>{ b.Set.Name }</option>
}
