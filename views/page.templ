package views

import (
	"fmt"

	"tariffCalculator/requirements"
	"tariffCalculator/static"
)

// Page is the calculator page. The form and routine are empty placeholders that
// the page's Alpine component (static/js/app.js) fills from the server on load.
templ Page(groups []requirements.BuiltinGroup) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Trampoline Tariff Calculator</title>
			<link rel="stylesheet" href={ static.URL("css/bulma.min.css") }/>
			<link rel="stylesheet" href={ static.URL("css/styles.css") }/>
			<script src={ static.URL("js/htmx.min.js") }></script>
			<script defer src={ static.URL("js/sortable.min.js") }></script>
			<script defer src={ static.URL("js/routines.js") }></script>
			<script defer src={ static.URL("js/sets.js") }></script>
			// app.js defines the Alpine component, so it must run before Alpine (all deferred, in order).
			<script defer src={ static.URL("js/app.js") }></script>
			<script defer src={ static.URL("js/alpine.min.js") }></script>
		</head>
		<body>
			<section class="hero is-primary">
				<div class="hero-body">
					<div class="container">
						<h1 class="title">Trampoline Tariff Calculator</h1>
						<h2 class="subtitle">Calculate difficulty scores for skills and routines</h2>
					</div>
				</div>
			</section>
			<section class="section">
				<div class="container">
					@calculator(groups)
				</div>
			</section>
			<footer class="footer">
				<div class="content has-text-centered">
					<p>Trampoline Tariff Calculator · difficulty per the FIG Trampoline Code of Points 2025–2028</p>
				</div>
			</footer>
		</body>
	</html>
}

templ calculator(groups []requirements.BuiltinGroup) {
	<div class="container" x-data="tariffCalculatorStore()">
		// "Add a skill" panel: SkillFormView, loaded by the component.
		<div class="box">
			<h3 class="title is-4" x-text="editingIndex === null ? 'Add a skill' : `Edit skill ${editingIndex + 1}`">Add a skill</h3>
			<div id="skill-form-wrapper" style="scroll-margin-top: 20px;" hx-sync="this:replace">
				<p>Loading form...</p>
			</div>
		</div>
		// Routine builder.
		<div class="box">
			<div class="level mb-3">
				<div class="level-left">
					<h3 class="title is-4 mb-0">Routine Builder</h3>
				</div>
				<div class="level-right">
					<div class="buttons mb-0">
						<a class="button is-primary is-small" href="/tariff-sheet" target="_blank" rel="noopener">Tariff Sheet</a>
						<a class="button is-link is-light is-small" href="/compare" target="_blank" rel="noopener" x-show="routines.length > 1">Compare</a>
					</div>
				</div>
			</div>
			// Saved routines: switch between them or start a new one; the rest is under More.
			<div class="routine-switcher">
				<div class="select is-small">
					<select aria-label="Routine" x-on:change="switchRoutine($event.target.value)">
						<template x-for="r in routines" x-bind:key="r.id">
							<option x-bind:value="r.id" x-bind:selected="r.id === currentId" x-text="`${r.name} (${r.skills.length})`"></option>
						</template>
					</select>
				</div>
				<button class="button is-small" type="button" x-on:click="newRoutine()">+ New</button>
				<details class="routine-menu">
					<summary class="button is-small">More</summary>
					// Close the menu after any choice.
					<div class="routine-menu-panel" x-on:click="$el.closest('details').removeAttribute('open')">
						<button class="button is-small is-white" type="button" x-on:click="renameRoutine()">Rename</button>
						<button class="button is-small is-white" type="button" x-on:click="duplicateRoutine()">Duplicate</button>
						<button class="button is-small is-white" type="button" x-on:click="expandAll()">Expand all</button>
						<button class="button is-small is-white" type="button" x-on:click="collapseAll()">Collapse all</button>
						<button class="button is-small is-white has-text-danger" type="button" x-on:click="clearRoutine()" x-bind:disabled="routine.length === 0">Clear skills</button>
						<button class="button is-small is-white has-text-danger" type="button" x-on:click="deleteRoutine()">Delete routine</button>
					</div>
				</details>
			</div>
			// The requirement set this routine is checked against (built-in or the user's own).
			<div class="requirement-picker">
				<label class="label is-small mb-1" for="requirement-set">Check against</label>
				<div class="requirement-picker-row">
					<div class="select is-small">
						<select id="requirement-set" x-on:change="setRequirements($event.target.value)">
							<option value="" x-bind:selected="!currentRoutine()?.requirements">No requirements</option>
							for _, g := range groups {
								<optgroup label={ g.Name }>
									for _, b := range g.Sets {
										<option value={ requirements.BuiltinPrefix + b.ID } x-bind:selected={ fmt.Sprintf("currentRoutine()?.requirements === '%s%s'", requirements.BuiltinPrefix, b.ID) }>{ b.Set.Name }</option>
									}
								</optgroup>
							}
							<template x-if="customSets.length > 0">
								<optgroup label="Your sets">
									<template x-for="s in customSets" x-bind:key="s.id">
										<option x-bind:value="s.id" x-bind:selected="currentRoutine()?.requirements === s.id" x-text="s.set.name"></option>
									</template>
								</optgroup>
							</template>
						</select>
					</div>
					<a class="button is-small is-text" href="/requirements" target="_blank" rel="noopener">Manage sets</a>
				</div>
			</div>
			// Cards and totals: Routine, re-rendered whenever the routine changes.
			<div id="routine-view" hx-sync="this:replace">
				<p class="has-text-grey">Loading routine...</p>
			</div>
		</div>
		<div
			x-show="toast.show"
			x-transition
			class="notification is-fixed-bottom-right"
			x-bind:class="toast.type === 'error' ? 'is-danger' : 'is-info'"
		>
			<button class="delete" type="button" aria-label="Dismiss" x-on:click="toast.show = false"></button>
			<span x-text="toast.message"></span>
		</div>
	</div>
}
