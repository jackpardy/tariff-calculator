package views

import "strconv"

// SignoffView is an entry's coach sign-off (ADR 0004 Decision 11).
type SignoffView struct {
	Required bool   // the competition requires it
	Signed   bool   // a coach has signed off the entry as it is now
	By       string // the coach who signed it off, or said not yet
	Note     string // the coach's note
	// Unapproved is a sign-off by a coach the competition hasn't approved, at
	// one that approves coaches: it doesn't count.
	Unapproved bool
	// Link is the signing coach's page, for a link that has one (the
	// organiser's People); "" for none.
	Link string
	// Waiting says, while it waits for a coach, who signs it off, or why no
	// one can; Coaches is where the comp sec adds or changes coaches, when
	// no one can.
	Waiting, Coaches string
}

// Problem is what's missing, as the organiser counts it, or "".
func (s SignoffView) Problem() string {
	switch {
	case !s.Required || s.Signed:
		return ""
	case s.Unapproved:
		return "Signed off by " + s.By + ", who isn't an approved coach"
	}
	return "Not signed off by a coach"
}

// Status says where the sign-off stands, "" when there's nothing to say.
func (s SignoffView) Status() string {
	switch {
	case s.Signed:
		return "Signed off by " + s.By
	case s.Unapproved:
		return "Signed off by " + s.By + ", but the competition hasn't approved them as a coach"
	case s.By != "":
		return "Not yet signed off: " + s.By + " needs changes"
	case s.Required:
		return "Waiting for a coach's sign-off"
	}
	return ""
}

// signoffBox shows an entry's sign-off on its card as the comp sec's rows
// show it (signoffLine): the state chip, then "by" and the coach in small
// text, with their note.
templ signoffBox(s SignoffView) {
	if s.Status() != "" {
		<p class="mb-3">
			@signoffLine(s)
			if s.Unapproved {
				<span class="is-size-7 has-text-grey ml-1">* The competition hasn't approved them as a coach, so it doesn't count.</span>
			}
			if s.Note != "" {
				<span class="is-size-7 ml-1">{ s.Note }</span>
			}
			@signoffWaiting(s)
		</p>
	}
}

// signoffWaiting says who signs off an entry waiting for a coach, or why no
// one can and what to do.
templ signoffWaiting(s SignoffView) {
	if s.Waiting != "" {
		<span class="is-block is-size-7 mt-1">
			{ s.Waiting }
			if s.Coaches != "" {
				<a href={ templ.SafeURL(s.Coaches) }>Add a coach or let one sign off, on Coaches →</a>
			}
		</span>
	}
}

// CoachOption is a coach a member can choose.
type CoachOption struct {
	ID, Name string
}

// coachSelect chooses a member's coach, posting coach=<id> ("" for none) as
// soon as it changes.
templ coachSelect(action string, coaches []CoachOption, chosen, label string) {
	<form method="post" action={ templ.SafeURL(action) } class="is-inline">
		<div class="select is-small">
			<select name="coach" aria-label={ label } onchange="this.form.submit()">
				<option value="" selected?={ chosen == "" }>No coach chosen</option>
				for _, c := range coaches {
					<option value={ c.ID } selected?={ chosen == c.ID }>{ c.Name }</option>
				}
			</select>
		</div>
		<noscript><button class="button is-small" type="submit">Save</button></noscript>
	</form>
}

// CoachPage is a coach's own page: every entry they see, by competition.
type CoachPage struct {
	Club, Coach  string
	Link         string // their coach link, as a full URL
	Notice       string
	Menu         []MenuSection // Entries and Gymnasts
	SeesAll      bool // they see every member, not just their own and those without a coach
	SignsOff     bool // the club lets them sign off routines
	Competitions []CoachCompetition
	Pairs        []PairView // synchro entries others made with members they see
	Tools        ListTools  // search and filters on the entries, over every competition
}

// CoachDetailsPage is a coach's Your details: their link and their other
// links (ADR 0010), as a member's and an individual's are.
type CoachDetailsPage struct {
	Frame CoachFrame
	Link  string // their coach link, as a full URL
	Other *OtherLinks
}

// CoachDetails is a coach's Your details.
templ CoachDetails(p CoachDetailsPage) {
	@competitionLayout(p.Frame.Coach + " · " + p.Frame.Club) {
		@coachFrame(p.Frame)
		<div data-coach-link={ p.Link } data-coach-name={ p.Frame.Coach + " · " + p.Frame.Club }>
			@linkBox("Your coach link (keep it to yourself)", p.Link, "Open it on any phone or computer to see your members' entries. It's saved in this browser too.")
		</div>
		if p.Other != nil {
			@otherLinksBox(*p.Other)
		}
	}
}

// CoachCompetition is one competition's entries a coach sees.
type CoachCompetition struct {
	Competition CompetitionSummary
	Rows        []CoachRow
	Waiting     int    // entries not signed off
	Cannot      string // why they can't sign off for it (not approved), if they can't
	MyLinks
	Late        []CoachLate // late changes to sign off
}

// CoachRow is one member's entry, for their coach.
type CoachRow struct {
	Member, Level string
	Problems      int
	Signoff       SignoffView
	Open          string // the entry's page
	List          ListRow // what the list's search and filters see
}

// CoachHome is a coach's page.
templ CoachHome(p CoachPage) {
	@competitionLayout(p.Coach + " · " + p.Club) {
		@coachFrame(CoachFrame{Club: p.Club, Coach: p.Coach, Notice: p.Notice, Menu: p.Menu})
		if p.Link != "" {
			// Saves their link in this browser; it's shown on Your details.
			<span hidden data-coach-link={ p.Link } data-coach-name={ p.Coach + " · " + p.Club }></span>
		}
		if !p.SignsOff {
			<p class="mb-4 has-text-grey is-size-7">Your club hasn't set you to sign off routines, so you can see their entries but not sign them off.</p>
		}
		if len(p.Competitions) == 0 {
			<p class="has-text-grey">The club isn't entered in any competitions yet.</p>
		}
		if p.Tools.Total > 0 {
			@listTools(p.Tools)
		}
		<div id={ p.Tools.ID }>
		for _, c := range p.Competitions {
			<div class="box" data-list-group>
				<h2 class="title is-6 mb-1">
					{ c.Competition.Name }
					if c.Waiting > 0 && p.SignsOff && c.Cannot == "" {
						@StateChip(Attention, strconv.Itoa(c.Waiting)+" to sign off")
					}
				</h2>
				@competitionFacts(c.Competition)
				@coachLates(c.Late)
				@deskMessages(c.Desk)
				@timelineLinks("", c.Timeline, c.Notify, "", c.Calendar)
				if c.Cannot != "" && p.SignsOff {
					<p class="is-size-7 mb-2">
						@StateChip(Attention, "Can't sign off")
						<span class="has-text-grey">{ c.Cannot }</span>
					</p>
				}
				if len(c.Rows) == 0 {
					@emptyLine("None of your members has entered yet.")
				} else {
					<div class="table-container">
						<table class="table is-fullwidth is-narrow comp-table comp-stack">
							<thead>
								<tr><th>Member</th><th>Level</th><th>Problems</th><th>Sign-off</th></tr>
							</thead>
							<tbody>
								for _, r := range c.Rows {
									<tr { r.List.Attrs()... }>
										<td><a href={ templ.SafeURL(r.Open) }>{ r.Member }</a></td>
										<td data-label="Level">{ r.Level }</td>
										<td data-label="Problems">
											// Empty when there are none, so a phone's card leaves the line out.
											if r.Problems > 0 {
												@StateChip(Attention, Count(r.Problems, "problem", "problems"))
											}
										</td>
										<td data-label="Sign-off">
											// Another coach's name; not their own on every row.
											if r.Signoff.By != "" && r.Signoff.By == p.Coach && !r.Signoff.Unapproved {
												@StateChip(signoffState(r.Signoff))
											} else {
												@signoffLine(SignoffView{Signed: r.Signoff.Signed, By: r.Signoff.By, Unapproved: r.Signoff.Unapproved})
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				@tellOrganiser(c.Tell)
			</div>
		}
		</div>
		// Below the club's entries: synchro entries others made, with one of the club's members as partner.
		@pairEntries(p.Pairs)
	}
}

// SignoffPage is a coach looking at one entry to sign it off: a club's
// member's (with a coach link) or an individual's (with a sign-off link).
type SignoffPage struct {
	Frame       *CoachFrame // a club's coach's tabs; nil for an individual's coach
	Back        string // "" for an individual's coach, who has no coach page
	Late        []CoachLate // a late change to sign off, through an individual's link
	Competition CompetitionSummary
	Card        EntryCard
	Signoff     SignoffView
	Action      string
	AskName     bool   // the coach gives their name (an individual's coach)
	Name        string // as given before
	Problems    []string
	Cannot      string // why they can't sign it off, if they can't
	Notice      string // what was just done
}

// signoffForm asks the coach to sign off the entry, or say not yet.
templ signoffForm(p SignoffPage) {
	@problemList(p.Problems)
	<form method="post" action={ templ.SafeURL(p.Action) }>
		<p class="mb-2">Have you seen { p.Card.Gymnast } perform this safely and is it ready to compete?</p>
		if p.AskName {
			<div class="field">
				<label class="label is-small" for="coach-name">Your name (coach)</label>
				<input class="input is-small" id="coach-name" name="coach" required maxlength="80" value={ p.Name }/>
			</div>
		}
		<div class="field">
			<label class="label is-small" for="signoff-note">Note for the gymnast (optional)</label>
			<input class="input is-small" id="signoff-note" name="note" maxlength="300" value={ p.Signoff.Note } placeholder="e.g. Not the full-in until we've done it on the big trampoline"/>
		</div>
		<div class="buttons">
			<button class="button is-small is-primary" type="submit" name="signed" value="1">Sign off</button>
			<button class="button is-small" type="submit" name="signed" value="0">Not yet</button>
		</div>
		<p class="help">If the entry changes after you sign it off, it needs signing off again.</p>
	</form>
}

// SignoffEntry is the page where a coach signs off an entry.
templ SignoffEntry(p SignoffPage) {
	@competitionLayout("Sign off · " + p.Card.Gymnast) {
		if p.Frame != nil {
			@coachFrame(*p.Frame)
		}
		if p.Back != "" {
			@backLink(p.Back, "Entries")
		}
		// Whose entry first, then the competition's facts.
		if p.Frame != nil {
			<h2 class="title is-5 mb-2">{ p.Card.Gymnast }</h2>
			<p class="has-text-grey mb-2">{ p.Competition.Name } · { p.Card.Level }</p>
		} else {
			<h1 class="title is-4 mb-2">{ p.Card.Gymnast }</h1>
			<p class="has-text-grey mb-2">{ p.Competition.Name } · { p.Card.Club } · { p.Card.Level }</p>
		}
		@competitionFacts(p.Competition)
		if p.Notice != "" && p.Frame == nil {
			@notice(p.Notice)
		}
		@coachLates(p.Late)
		@entryCardChecks(p.Card)
		if p.Cannot != "" {
			<p class="has-text-grey mt-4">{ p.Cannot }</p>
		} else if p.Competition.SignoffsOpen && p.Signoff.Signed && len(p.Problems) == 0 {
			// Signed off: the form folds away, to change the answer.
			<div class="mt-4">
				@opens("", "", "Change the sign-off", false) {
					@signoffForm(p)
				}
			</div>
		} else if p.Competition.SignoffsOpen {
			<div class="box mt-4">
				@signoffForm(p)
			</div>
		} else {
			if p.Competition.Live {
				<p class="has-text-grey">Entries have closed, so the sign-off can't be changed.</p>
			} else {
				<p class="has-text-grey">Entries aren't open at the moment, so the sign-off can't be changed.</p>
			}
		}
	}
}
