package views

import (
	"fmt"
	"net/url"
	"strconv"
)

// The organiser's dashboard: every entry by level, filtered, removed and
// held entries, and one entry's page.

// Dashboard is the organiser's overview of every entry.
type Dashboard struct {
	Base         string // the admin link's path, which the dashboard's own links extend
	New          string // "created" just after the competition was made, to say to save the admin link
	Notice       string // what just happened
	Menu         []MenuSection
	LiveDate     string // when it's due to go live, for changing it
	LiveTime     string
	NotifyAt     string // when the changes waiting are told, e.g. "14:32"; "" for none
	Access       Access // what the link it was opened by can do (ADR 0009)
	Concerns     []ConcernView
	OpenConcerns int
	Waiting      []WaitingList // each limited event's waiting list
	Unchecked    int           // entries not checked yet
	Withdrawn    int           // entries withdrawn since their club sent them
	Competition  CompetitionSummary
	Links        CompetitionLinks
	Clubs        []string // the clubs entered, by name
	Club         string   // the club the table is filtered to ("" for all, "individual" for individuals)
	ProblemsOnly bool
	Entries      int // every entry, before filtering
	WithProblems int
	Levels       []DashboardLevel
	Removed      []RemovedRow // entries removed or held
	// The filters (roadmap 2026-10-08): as given, and each.
	Filter                                   url.Values
	Search, Coach                            string
	CheckedFilter, SignedFilter, VideoFilter string // "", yes or no; a video status
	Category, Sort                           string
	CanSplit                                 bool     // some levels rank men and women apart
	Coaches                                  []string // the coaches entries have, to filter by
	Shown                                    int      // entries the filters show
	List                                     string   // the filters and sort as a query ("?club=UCD"), for an entry's page to carry and come back to; "" for none
	All                                      []ListRow // every entry, shown or not, with its values for each filter, for the filters' counts
}

// RemovedRow is an entry the organiser removed or holds.
type RemovedRow struct {
	ID, Gymnast, Club, Level string
	Held                     bool   // on hold for changes, not removed
	Withdrawn                bool   // withdrawn by the gymnast entering on their own: only they can put it back
	Resent                   bool   // held, changed and sent again: waiting to be accepted
	Note                     string // the reason
	To                       string // who sees it, e.g. "the club"
}

// LevelOrder is one discipline's levels, easiest first, for the organiser to
// move.
type LevelOrder struct {
	Discipline, Name string
	Levels           []string
}

// DashboardLevel is one level's table.
type DashboardLevel struct {
	Name   string
	Anchor string // its id on the page, to jump to
	Total  int    // its entries, before the filters
	Places string // with a limit, e.g. "88 of 90 places"
	Rows   []DashboardRow
	// Columns no row has anything in, left out: a level only (tumbling,
	// DMT) has no routines or requirements, synchro no first exercise.
	NoFirst, NoSecond, NoRules bool
}

// DashboardRow is one entry in a level's table.
type DashboardRow struct {
	ID, Gymnast, Club string
	Exercises         [2]string // a set routine's name, or a voluntary's difficulty
	Met, Rules        int
	Problems          []string
	Sent              string
	Checked           bool
	Note              string
	Video             string // "" when not needed, else missing, provided, OK or need more
	Withdrawn         bool   // withdrawn since the club sent it
	Category          string // Men or Women, where the level splits them
	Signoff           SignoffView
	Coach             string // who coaches them: who signed off, or else their coach
	Person, Partner   string // the gymnast's page, and their partner's for a pair; "" for none (a withdrawn entry)
}

// EntryDetail is the organiser's view of one entry.
type EntryDetail struct {
	Base        string
	Menu        []MenuSection
	Access      Access
	Notice      string
	ID          string
	Competition CompetitionSummary
	Card        EntryCard
	Sent        string
	Checked     string // when it was marked checked, "" if it isn't
	Note        string
	VideoReview string // "", "ok" or "more"
	VideoNote   string
	Withdrawn   bool // withdrawn since the club sent it
	LetIn       bool   // let in from its event's waiting list, over the limit
	List        string // the entries page's filters and sort it was opened from, as a query (Dashboard.List)
}

// Dashboard is the organiser's overview: every entry, by level, with its problems.
templ CompetitionDashboard(d Dashboard) {
	@competitionLayout(d.Competition.Name) {
		<h1 class="title is-4">{ d.Competition.Name }</h1>
		@pageMenu(d.Menu)
		if d.Access.Organiser {
			// Saves the admin link in this browser whenever it's opened (static/js/competitions.js).
			<span hidden data-competition-page={ d.Base } data-competition-name={ d.Competition.Name }></span>
		}
		if d.New != "" && d.Links.Admin != "" {
			@newAdminLink(d.Competition, d.Links.Admin, d.New)
		}
		if d.Notice != "" {
			<div class="notification is-success is-light">{ d.Notice }</div>
		}
		if !d.Access.Organiser {
			<p class="is-size-7 has-text-grey mb-3">You're using the link for <strong>{ d.Access.Who }</strong>.</p>
		}
		if d.NotifyAt != "" && d.Access.NotifyNow {
			<form method="post" action={ templ.SafeURL(d.Base + "/notify-now") } class="notification is-info is-light">
				Your changes go to everyone who asked to hear about them at { d.NotifyAt }, after a wait in case anything is put back.
				<button class="button is-small ml-2" type="submit">Notify now</button>
			</form>
		}
		// The entries come first; open concerns are a line here, listed below them.
		if d.OpenConcerns > 0 {
			<p class="mb-3">
				<a href="#concerns">
					@StateChip(Attention, Count(d.OpenConcerns, "concern open", "concerns open"))
				</a>
				<span class="is-size-7 has-text-grey ml-1">Below the entries.</span>
			</p>
		}
		if d.Entries == 0 {
			<p class="has-text-grey mb-3">No entries yet. Clubs send theirs through the club link; gymnasts on their own enter through theirs.</p>
			if d.Links.Club != "" {
				@linkBox("Club link", d.Links.Club, "Give it to clubs' competition secretaries: they enter their club and send its members' entries.")
			}
			if d.Links.Individual != "" {
				@linkBox("Link for entering on their own", d.Links.Individual, "Anyone with it can enter on their own, without a club.")
			}
		} else {
			@dashboardFilters(d)
		}
		if len(d.Levels) > 0 {
			<div class="buttons mt-4 mb-0">
				<button class="button is-small" type="button" onclick="document.querySelectorAll('details.comp-dash-level').forEach(e => e.open = true)">Expand all</button>
				<button class="button is-small" type="button" onclick="document.querySelectorAll('details.comp-dash-level').forEach(e => e.open = false)">Collapse all</button>
				if d.Entries > 0 {
					@tableViewMenu("entries")
				}
			</div>
		}
		<div id="entries" data-list-carry-links>
			for _, l := range d.Levels {
				<details class="comp-dash-level" id={ l.Anchor } data-level={ l.Name } data-remember?={ !filtered(d) } open?={ levelOpen(d, l) } data-list-group>
					<summary class="title is-5 comp-dash-level-head">
						{ l.Name } <span class="has-text-grey is-size-6">(<span data-group-count={ strconv.Itoa(l.Total) }>{ shownCount(d, l) }</span>)</span>
						if l.Places != "" {
							<span class="tag is-light is-size-7 has-text-weight-normal ml-1">{ l.Places }</span>
						}
					</summary>
					if len(l.Rows) == 0 {
						<p class="has-text-grey is-size-7">None</p>
					} else {
						<div class="buttons mb-2">
							<a class="button is-small" href={ templ.SafeURL(d.Base + "/cards" + filterQuery(d, l.Name)) } data-list-carry>Print this level's cards</a>
						</div>
						<div class="table-container">
							<table class={ "table", "is-fullwidth", "is-narrow", "comp-table", "comp-entries", "comp-stack", templ.KV("has-ticks", d.Access.Remove) } data-table-view="entries" data-table-hidden="Sent">
								<thead>
									<tr>
										if d.Access.Remove {
											<th><input type="checkbox" aria-label={ "Tick all of " + l.Name } onchange="this.closest('table').querySelectorAll('input[name=entry]').forEach(c => { if (!c.closest('tr').hidden) { c.checked = this.checked; } })"/></th>
										}
										<th class="comp-stack-title">Gymnast</th>
										<th>Club</th>
										if !l.NoFirst {
											<th>1st exercise</th>
										}
										if !l.NoSecond {
											<th>2nd exercise</th>
										}
										if !l.NoRules {
											<th>Requirements</th>
										}
										<th>Problems</th>
										<th>Sent</th>
										if d.Competition.Video != "" {
											<th>Video</th>
										}
										if d.Competition.Signoff {
											<th>Coach</th>
										}
										<th>Checked</th>
									</tr>
								</thead>
								<tbody>
									if levelOpen(d, l) {
										for _, r := range l.Rows {
											@dashboardRow(d, l, r)
										}
									} else {
										// A folded level's rows wait in a template until it
										// opens, or a search needs them (static/js/competitions.js,
										// lazyRows): every level's rows at once were 16,000
										// elements for a phone to lay out.
										<template data-lazy>
											for _, r := range l.Rows {
												@dashboardRow(d, l, r)
											}
										</template>
									}
								</tbody>
							</table>
						</div>
					}
				</details>
			}
		</div>
		// Then the rest: printing and the CSV (following the search and
		// filters), removing or holding those ticked, concerns, and the
		// competition's facts and counts.
		if d.Entries > 0 || (d.Access.Sheets && !d.Access.Timetable) {
			<div class="comp-dash-actions mt-5">
				@dashboardPrint(d)
				if d.Entries > 0 {
					<a class="button is-small" href={ templ.SafeURL(d.Base + "/entries.csv" + filterQuery(d, "")) } download data-list-carry>
						if filtered(d) {
							Download CSV of those shown
						} else {
							Download CSV
						}
					</a>
				}
			</div>
		}
		if d.Entries > 0 && d.Access.Remove {
			@removeForm(d.Base, d.List)
			// Once entries are ticked, a bar on the screen says how many and
			// goes to Remove or hold, wherever the tables have got to
			// (competitions.js, tickBar).
			<div class="comp-tick-bar" id="tick-bar" hidden>
				<span class="has-text-weight-semibold" data-tick-count></span>
				<button class="button is-small is-danger is-light" type="button" data-tick-go="remove">Remove…</button>
				<button class="button is-small is-warning is-light" type="button" data-tick-go="hold">Hold for changes…</button>
				<button class="button is-small is-text" type="button" data-tick-clear>Untick all</button>
			</div>
		}
		@concernsBox(d.Base, d.Concerns, d.OpenConcerns, d.Access)
		if !d.Access.Organiser {
			@concernForm(d.Base, "", "Flag a concern for the organiser")
		}
		<section class="comp-dash-about mt-5">
			@competitionFacts(d.Competition)
			if d.Access.Settings {
				@liveBox(d.Base, d.Competition, d.LiveDate, d.LiveTime, "")
			}
			<nav class="level is-mobile comp-counts" hidden?={ d.Entries == 0 && len(d.Clubs) == 0 }>
				@count(d.Entries, "entries")
				@count(d.WithProblems, "with problems")
				@count(d.Unchecked, "not checked")
				if d.Withdrawn > 0 {
					@count(d.Withdrawn, "withdrawn")
				}
				@count(len(d.Clubs), "clubs")
			</nav>
		</section>
		@waitingBox(d.Base, d.Waiting, d.Access.Settings)
		if d.Access.Remove {
			@removedList(d.Base, d.Removed)
		}
	}
}

func hasIndividuals(d Dashboard) bool {
	for _, l := range d.Levels {
		for _, r := range l.Rows {
			if r.Club == "individual" {
				return true
			}
		}
	}
	return false
}

templ count(n int, label string) {
	<div class="level-item has-text-centered">
		<div>
			<p class="title is-4">{ strconv.Itoa(n) }</p>
			<p class="heading">{ label }</p>
		</div>
	</div>
}

templ CompetitionEntry(d EntryDetail) {
	@competitionLayout(d.Card.Gymnast + " · " + d.Competition.Name) {
		// Back, the name and the menu, in the order a person's page has them.
		// Back goes to the entries page filtered as it was, at this entry's row.
		<p class="mb-3"><a href={ templ.SafeURL(d.Base + d.List + "#entry-" + d.ID) }>← Entries</a></p>
		<h1 class="title is-4">{ d.Card.Gymnast }</h1>
		<p class="subtitle is-6">{ d.Card.Club } · { d.Card.Level }</p>
		@pageMenu(d.Menu)
		if d.Withdrawn {
			<div class="notification is-warning is-light">
				<p><strong>Withdrawn.</strong> { d.Card.Gymnast } has withdrawn this entry, or left the club, since { d.Card.Club } sent it. It goes when the club sends its entries again; until then it isn't counted or printed.</p>
			</div>
		}
		// Let in over the limit: it can go back, in its place, if that was a mistake.
		if d.LetIn {
			<div class="notification is-info is-light comp-let-in">
				<p class="mb-2">Let in from its event's waiting list, over the limit.</p>
				if d.Access.Settings {
					<form method="post" action={ templ.SafeURL(d.Base + "/entries/" + d.ID + "/let-in") }>
						<input type="hidden" name="on" value="0"/>
						<button class="button is-small" type="submit">Put it back on the waiting list</button>
					</form>
				}
			</div>
		}
		@entryCardChecks(d.Card)
		<p class="has-text-grey is-size-7 mt-4">Sent { d.Sent }.</p>
		if d.Notice != "" {
			<div class="notification is-success is-light mt-3" id="entry-notice">{ d.Notice }</div>
		}
		if !d.Access.Check {
			if d.Checked != "" {
				<p class="mt-3">@StateChip(Done, "Checked") <span class="has-text-grey is-size-7 ml-1">{ d.Checked }</span></p>
			}
			if d.Note != "" {
				<p class="is-size-7">The note for the club or gymnast: { d.Note }</p>
			}
			<p class="mt-2"><a class="button is-small" href={ templ.SafeURL(d.Base + "/cards?entry=" + d.ID) }>Print card</a></p>
		}
		if !d.Access.Organiser {
			@concernForm(d.Base, d.ID, "Flag a concern about this entry")
		}
		if d.Access.Check {
			<div class="box mt-4" id="check">
				<form method="post" action={ templ.SafeURL(d.Base + "/entries/" + d.ID + "/check" + d.List) }>
					if d.Checked != "" {
						<p class="mb-2">@StateChip(Done, "Checked") <span class="has-text-grey is-size-7 ml-1">{ d.Checked }</span></p>
					}
					<div class="field">
						<label class="label is-small" for="check-note">Note for the club or gymnast</label>
						<textarea class="textarea is-small" id="check-note" name="note" rows="2" maxlength="500" placeholder="e.g. Element 7 repeats element 3: please change it">{ d.Note }</textarea>
					</div>
					<div class="buttons">
						if d.Checked == "" {
							<button class="button is-primary is-small" type="submit" name="checked" value="1">Mark checked</button>
							// And on to the next entry still to check.
							<input type="hidden" name="next" value=""/>
							<button class="button is-primary is-light is-small" type="submit" name="checked" value="1" onclick="this.form.elements.next.value = '1'">Mark checked and next</button>
							<button class="button is-small" type="submit" name="checked" value="0">Save the note</button>
						} else {
							<button class="button is-small" type="submit" name="checked" value="1">Save the note</button>
							<button class="button is-small" type="submit" name="checked" value="0">Unmark</button>
						}
						<a class="button is-small" href={ templ.SafeURL(d.Base + "/cards?entry=" + d.ID) }>Print card</a>
					</div>
					<p class="help">If the entry changes after you check it, it needs checking again. The note stays.</p>
				</form>
			</div>
		}
		if d.Competition.Video != "" && d.Access.Check {
			<div class="box mt-4" id="video">
				<form method="post" action={ templ.SafeURL(d.Base + "/entries/" + d.ID + "/video" + d.List) }>
					<p class="mb-2">
						<strong>Video</strong>
						switch d.VideoReview {
							case "ok":
								@StateChip(Done, "OK")
							case "more":
								@StateChip(Attention, "Needs more")
						}
					</p>
					<div class="field">
						<label class="label is-small" for="video-note">What more is needed (for the club or gymnast)</label>
						<input class="input is-small" id="video-note" name="note" maxlength="300" value={ d.VideoNote } placeholder="e.g. The full-in isn't in the video"/>
					</div>
					<div class="buttons">
						// OK waits for a video to say it of.
						if hasVideo(d.Card) {
							<button class="button is-small is-success is-light" type="submit" name="review" value="ok">Video OK</button>
						} else {
							<span class="is-size-7 has-text-grey mr-2">No video yet: OK once there's one.</span>
						}
						<button class="button is-small is-warning is-light" type="submit" name="review" value="more">Need more</button>
						if d.VideoReview != "" {
							<button class="button is-small" type="submit" name="review" value="">Clear</button>
						}
					</div>
					<p class="help">Whether a video shows the gymnast performing safely is your judgement. A new link clears the review.</p>
				</form>
			</div>
		}
	}
}

// filterQuery is the dashboard's filter as a query for the cards page, for one
// level or ("") all.
func filterQuery(d Dashboard, level string) string {
	q := url.Values{}
	for k, v := range d.Filter {
		q[k] = v
	}
	if level != "" {
		q.Set("level", level)
	}
	if len(q) == 0 {
		return ""
	}
	return "?" + q.Encode()
}

// uncheckedQuery is the cards not checked yet, of those the filters show.
func uncheckedQuery(d Dashboard) string {
	q := url.Values{}
	for k, v := range d.Filter {
		q[k] = v
	}
	q.Set("unchecked", "1")
	return "?" + q.Encode()
}

// videoState is an entry's video on the dashboard (missing, provided, OK or
// need more), and its label.
func videoState(v string) (State, string) {
	switch v {
	case "OK":
		return Done, "OK"
	case "provided":
		return InProgress, "Provided"
	case "need more":
		return Attention, "Need more"
	}
	return Attention, "Missing"
}

// signoffState is where an entry's sign-off stands, and its label: signed
// off; a coach who isn't approved, or who asks for changes; or waiting.
func signoffState(s SignoffView) (State, string) {
	switch {
	case s.Signed:
		return Done, "Signed off"
	case s.Unapproved:
		return Attention, "Coach not approved"
	case s.By != "":
		return Attention, "Needs changes"
	}
	return InProgress, "Waiting for sign-off"
}

// filtered says whether any filter is on.
func filtered(d Dashboard) bool { return len(d.Filter) > 0 }

// shownCount says how many of a level's entries are shown, e.g. "12 of 96".
func shownCount(d Dashboard, l DashboardLevel) string {
	shown := 0 // withdrawn entries are listed, not counted
	for _, r := range l.Rows {
		if !r.Withdrawn {
			shown++
		}
	}
	if filtered(d) && shown != l.Total {
		return fmt.Sprintf("%d of %d", shown, l.Total)
	}
	return strconv.Itoa(l.Total)
}

// dashboardPrint is the entries' printing under one Print button: the cards,
// following the search and filters, those not checked yet, and for a link
// that prints the timetable's sheets but has no timetable page (a chair of
// judges), those sheets.
templ dashboardPrint(d Dashboard) {
	<details class="comp-popup comp-popup-left" data-menu>
		<summary class="button is-small comp-opens-button">Print</summary>
		<div class="comp-popup-panel">
			if d.Entries > 0 {
				<a href={ templ.SafeURL(d.Base + "/cards" + filterQuery(d, "")) } data-list-carry>
					if filtered(d) {
						Cards shown
					} else {
						Cards
					}
				</a>
				<a href={ templ.SafeURL(d.Base + "/cards" + uncheckedQuery(d)) } data-list-carry>
					if filtered(d) {
						Cards shown not checked
					} else {
						Cards not checked
					}
				</a>
			}
			if d.Access.Sheets && !d.Access.Timetable {
				<a href={ templ.SafeURL(d.Base + "/timetable/print?sheet=judges") }>Chair of judges sheets</a>
				<a href={ templ.SafeURL(d.Base + "/timetable/print?sheet=scores") }>Score sheets</a>
				<a href={ templ.SafeURL(d.Base + "/timetable/print?sheet=marshal") }>Marshal sheets</a>
				<a href={ templ.SafeURL(d.Base + "/timetable/print?sheet=timeline-officials") }>Panel timeline</a>
			}
		</div>
	</details>
}

// tableViewMenu is how the tables marked data-table-view={ id } show: which
// columns, and long text wrapped or clipped; dragging a heading's edge
// resizes its column. static/js/tables.js fills it in and keeps the choice in
// this browser.
templ tableViewMenu(id string) {
	<details class="comp-popup comp-popup-left" data-menu data-table-menu={ id }>
		<summary class="button is-small comp-opens-button">Columns</summary>
		<div class="comp-popup-panel comp-table-menu">
			<p class="comp-table-menu-head">Show</p>
			<div data-table-columns></div>
			<label class="checkbox comp-table-menu-row comp-table-menu-clip"><input type="checkbox" data-table-clip/> Clip long text to one line</label>
			<p class="comp-table-menu-help">Drag the edge of a heading to make a column wider or narrower.</p>
			<button class="button is-small is-text" type="button" data-table-reset>Back to how it was</button>
		</div>
	</details>
}

// removeForm removes or holds the entries ticked in the tables.
templ removeForm(base, list string) {
	@opens("", "", "Remove or hold entries", false) {
		<p class="mb-2">Tick them in the tables above (a bar at the foot of the screen says how many), then:</p>
		<form id="remove-form" method="post" action={ templ.SafeURL(base + "/remove" + list) } data-list-carry>
			<div class="field">
				<label class="radio comp-option"><input type="radio" name="action" value="remove" checked/> <span><strong>Remove</strong>: they can't be sent or changed again unless you restore them</span></label>
				<label class="radio comp-option"><input type="radio" name="action" value="hold"/> <span><strong>Hold, asking for changes</strong>: the club or gymnast changes the entry and sends it again, and you accept it back in</span></label>
			</div>
			<div class="field">
				<input class="input is-small" name="note" maxlength="300" placeholder="Reason (optional), e.g. Entry fee not paid" aria-label="Reason"/>
			</div>
			<div class="field is-size-7">
				Show the reason to
				<label class="radio ml-2"><input type="radio" name="to" value="club"/> the club</label>
				<label class="radio"><input type="radio" name="to" value="member"/> the gymnast</label>
				<label class="radio"><input type="radio" name="to" value="both" checked/> both</label>
			</div>
			<button class="button is-small is-danger is-light" type="submit">Apply to the ticked entries</button>
			<p class="help">To take a whole club, filter by the club above, then tick each table's header. Removed and held entries aren't counted, printed or timetabled.</p>
		</form>
	}
}

// removedList is the entries removed or held, to restore or accept.
templ removedList(base string, rows []RemovedRow) {
	if len(rows) > 0 {
		@listSection("Removed, withdrawn and on hold", len(rows)) {
			<ul class="comp-removed">
				for _, r := range rows {
					<li class="comp-removed-row">
						<div class="comp-removed-who">
							<a href={ templ.SafeURL(base + "/entries/" + r.ID) }>{ r.Gymnast }</a>
							<span class="is-size-7 has-text-grey">{ r.Club } · { r.Level }</span>
						</div>
						<div class="comp-removed-state">
							if r.Resent {
								@StateChip(Attention, "Changed and sent again: waiting for you")
							} else if r.Held {
								@StateChip(Attention, "On hold for changes")
							} else if r.Withdrawn {
								@StateChip(Stopped, "Withdrawn by them")
							} else {
								@StateChip(Stopped, "Removed")
							}
							if r.Note != "" {
								<span class="is-size-7 has-text-grey">{ r.Note } ({ r.To })</span>
							}
						</div>
						if !r.Withdrawn {
							<form method="post" action={ templ.SafeURL(base + "/entries/" + r.ID + "/restore") }>
								<button class="button is-small" type="submit">
									if r.Resent {
										Accept back in
									} else {
										Restore
									}
								</button>
							</form>
						}
					</li>
				}
			</ul>
		}
	}
}

// dashboardFilters are the ways to find entries: search, filters and
// sorting. The levels open and close, so there's no list of them to jump to.
templ dashboardFilters(d Dashboard) {
	@listTools(dashboardTools(d)) {
		<div class="select is-small">
			<select name="sort" aria-label="Sort by" onchange="this.form.submit()">
				<option value="" selected?={ d.Sort == "" }>By club</option>
				<option value="gymnast" selected?={ d.Sort == "gymnast" }>By gymnast</option>
				<option value="sent" selected?={ d.Sort == "sent" }>Latest sent first</option>
				if d.Competition.Signoff {
					<option value="coach" selected?={ d.Sort == "coach" }>By coach</option>
				}
			</select>
		</div>
	}
}

// dashboardTools are the entries' search and filters, sent to the server so
// printing and the CSV follow them (views/lists.templ).
func dashboardTools(d Dashboard) ListTools {
	t := ListTools{ID: "entries", Noun: "entries", Total: d.Entries, Shown: d.Shown, Form: true, Search: d.Search, Clear: d.Base, All: d.All}
	club := ListFilter{Key: "club", Label: "Club", Any: "Every club", Value: d.Club}
	for _, c := range d.Clubs {
		club.Options = append(club.Options, ListOption{Value: c, Label: c})
	}
	if d.Competition.Individuals || hasIndividuals(d) {
		club.Options = append(club.Options, ListOption{Value: "individual", Label: "On their own"})
	}
	t.Filters = append(t.Filters, club)
	if len(d.Coaches) > 0 {
		coach := ListFilter{Key: "coach", Label: "Coach", Any: "Any coach", Value: d.Coach}
		for _, c := range d.Coaches {
			coach.Options = append(coach.Options, ListOption{Value: c, Label: c})
		}
		coach.Options = append(coach.Options, ListOption{Value: "none", Label: "No coach"})
		t.Filters = append(t.Filters, coach)
	}
	t.Filters = append(t.Filters, ListFilter{Key: "problems", Label: "Problems", Any: "Problems or not", Value: problemsValue(d.ProblemsOnly), Plain: true,
		Options: []ListOption{{Value: "1", Label: "Problems only"}}})
	t.Filters = append(t.Filters, yesNo("checked", "Checked", d.CheckedFilter, "Checked or not", "Checked", "Not checked"))
	if d.Competition.Signoff {
		t.Filters = append(t.Filters, yesNo("signedoff", "Signed off", d.SignedFilter, "Signed off or not", "Signed off", "Not signed off"))
	}
	if d.Competition.Video != "" {
		t.Filters = append(t.Filters, ListFilter{Key: "video", Label: "Video", Any: "Any video", Value: d.VideoFilter, Plain: true, Options: []ListOption{
			{Value: "missing", Label: "Video missing"}, {Value: "provided", Label: "Video to review"},
			{Value: "need more", Label: "Video: need more"}, {Value: "OK", Label: "Video OK"},
		}})
	}
	if d.CanSplit {
		t.Filters = append(t.Filters, ListFilter{Key: "category", Label: "Men or women", Any: "Men and women", Value: d.Category, Plain: true, Options: []ListOption{
			{Value: "Men", Label: "Men"}, {Value: "Women", Label: "Women"},
		}})
	}
	for i, f := range t.Filters {
		t.Filters[i].Remove = withoutFilter(d, f.Key)
	}
	return t
}

// withoutFilter is the entries page's address with its filters and sort but
// the one with key.
func withoutFilter(d Dashboard, key string) string {
	q := url.Values{}
	for k, v := range d.Filter {
		if k != key {
			q[k] = v
		}
	}
	if d.Sort != "" {
		q.Set("sort", d.Sort)
	}
	if len(q) == 0 {
		return d.Base
	}
	return d.Base + "?" + q.Encode()
}

// yesNo is a dashboard filter that's on, off or either.
func yesNo(key, label, value, either, yes, no string) ListFilter {
	return ListFilter{Key: key, Label: label, Any: either, Value: value, Plain: true, Options: []ListOption{{Value: "yes", Label: yes}, {Value: "no", Label: no}}}
}

// problemsValue is the problems filter's value: "1" for problems only.
func problemsValue(only bool) string {
	if only {
		return "1"
	}
	return ""
}

// hasVideo says whether an entry has a video linked, for any exercise.
func hasVideo(c EntryCard) bool {
	for _, ex := range c.Exercises {
		if ex.Video.Link != "" {
			return true
		}
	}
	return false
}

// levelOpen says whether a level starts open: with a filter on, those with
// rows shown.
func levelOpen(d Dashboard, l DashboardLevel) bool { return filtered(d) && len(l.Rows) > 0 }

// dashboardRow is an entry's row in its level's table.
templ dashboardRow(d Dashboard, l DashboardLevel, r DashboardRow) {
	<tr class={ templ.KV("has-problems", len(r.Problems) > 0 && !r.Withdrawn), templ.KV("is-withdrawn", r.Withdrawn) } { ListRow{Name: r.Gymnast, Uncounted: r.Withdrawn}.Attrs()... }>
		if d.Access.Remove {
			<td class="comp-stack-tick"><input type="checkbox" name="entry" value={ r.ID } form="remove-form" aria-label={ "Tick " + r.Gymnast }/></td>
		}
		<td class="comp-stack-title">
			<a href={ templ.SafeURL(d.Base + "/entries/" + r.ID + d.List) }>{ r.Gymnast }</a>
			if r.Person != "" {
				<a class="is-size-7 ml-1" href={ templ.SafeURL(r.Person) } title="Everything this person is doing">person</a>
			}
			if r.Partner != "" {
				<a class="is-size-7 ml-1" href={ templ.SafeURL(r.Partner) } title="Everything the partner is doing">partner</a>
			}
			if r.Withdrawn {
				<span class="ml-1" title="Withdrawn since the club sent it; it goes when the club sends again">
					@StateChip(Stopped, "Withdrawn")
				</span>
			}
		</td>
		<td data-label="Club">
			if r.Club == "individual" {
				@WhoChip(RoleGymnast, "on their own")
			} else {
				{ r.Club }
			}
			if r.Category != "" {
				<span class="tag is-light ml-1">{ r.Category }</span>
			}
		</td>
		if !l.NoFirst {
			<td data-label="1st exercise">{ r.Exercises[0] }</td>
		}
		if !l.NoSecond {
			<td data-label="2nd exercise">{ r.Exercises[1] }</td>
		}
		if !l.NoRules {
			<td data-label="Requirements">
				if r.Rules > 0 {
					{ fmt.Sprintf("%d/%d %s", r.Met, r.Rules, markFor(r.Met == r.Rules)) }
				}
			</td>
		}
		<td class="comp-problem-cell" data-label="Problems">
			if len(r.Problems) == 0 {
				<span class="comp-none">–</span>
			} else {
				// Opens the entry, where its problems are listed.
				<a href={ templ.SafeURL(d.Base + "/entries/" + r.ID + d.List + "#problems") } title={ r.Problems[0] }>
					@StateChip(Attention, Count(len(r.Problems), "problem", "problems"))
				</a>
				// The first in words on a phone's card; on a wide screen, the chip
				// alone keeps rows one line (the first is its tooltip).
				<span class="comp-problem-first">{ r.Problems[0] }</span>
			}
		</td>
		<td data-label="Sent">{ r.Sent }</td>
		if d.Competition.Video != "" {
			<td data-label="Video">
				if r.Video == "" {
					<span class="comp-none">–</span>
				} else {
					@StateChip(videoState(r.Video))
				}
			</td>
		}
		if d.Competition.Signoff {
			<td title={ r.Signoff.Note } data-label="Coach">
				if r.Withdrawn && !r.Signoff.Signed {
					<span class="comp-none">–</span>
				} else {
					@StateChip(signoffState(r.Signoff))
					if r.Signoff.By != "" {
						@WhoLink(RoleCoach, r.Signoff.By, r.Signoff.Link)
					} else if r.Coach != "" {
						@WhoLink(RoleCoach, r.Coach, "")
					}
				}
			</td>
		}
		<td title={ r.Note } data-label="Checked">
			if r.Checked {
				@StateChip(Done, "Checked")
			} else {
				<span class="comp-none">–</span>
			}
			if r.Note != "" {
				<span class="has-text-grey" aria-label="Has a note">✎</span>
			}
		</td>
	</tr>
}
