package views

import "strconv"

// DeskPage is the organisers' desk (roadmap 2026-10-09): the form to send a
// message to a club, a flight, the officials or a group, and what was sent.
type DeskPage struct {
	Base, Notice string
	Competition  CompetitionSummary
	Menu []MenuSection
	Published    bool              // there's a timetable to pick flights and panels from
	Clubs        []DeskOption      // the clubs entered
	Flights      []DeskGroup       // the published flights, by day and area
	Panels       []DeskOption      // each day's area whose panel has officials
	People       []DeskPersonOption // every gymnast and official
	PeopleTools  ListTools          // the search and filters on People
	Sent         []DeskSent
	Screen       []DeskNotice // announcements on the venue screen now
	ScreenFor    []DeskOption // how long an announcement can show
	ScreenMax    int          // the longest announcement, in characters
}

// DeskNotice is an announcement on the venue screen.
type DeskNotice struct {
	ID, Text, Who string
	At            string // when it went up, e.g. "10:42"
	Until         string // when it comes down; "" for when someone takes it down
}

// DeskOption is a choice in a list.
type DeskOption struct {
	Value, Label string
	Selected     bool // chosen to start with: the first flight not finished
}

// DeskGroup is choices under a heading.
type DeskGroup struct {
	Label   string
	Options []DeskOption
}

// DeskPersonOption is a person to pick.
type DeskPersonOption struct {
	Key, Name, Detail string
	List              ListRow // what the list's search and filters see
}

// DeskSent is a message sent.
type DeskSent struct {
	At, Who, To, Text string
	Pushed, Emailed   int // told so far
	Failed            int // couldn't be told
	ToGo              int // still sending
}

// DeskNote is a message on a recipient's own page.
type DeskNote struct {
	Text, At string
}

// Desk is the organisers' desk.
templ Desk(p DeskPage) {
	@competitionLayout("Desk messages · " + p.Competition.Name) {
		<h1 class="title is-4">Desk messages</h1>
		<p class="subtitle is-6">{ p.Competition.Name }</p>
		@pageMenu(p.Menu)
		if p.Notice != "" {
			@notice(p.Notice)
		}
		<form method="post" action={ templ.SafeURL(p.Base + "/desk") } class="box">
			<p class="label is-small">To</p>
			<div class="field">
				<label class="radio is-block mb-2 ml-0">
					<input type="radio" name="to" value="club" checked/>
					A club: its competition secretary, coaches and members
				</label>
				// Each choice's controls show while it's the one chosen.
				<div class="select is-small mb-3 desk-to-club">
					<select name="club" aria-label="Club">
						for _, c := range p.Clubs {
							<option value={ c.Value }>{ c.Label }</option>
						}
						if len(p.Clubs) == 0 {
							<option value="">No club is entered</option>
						}
					</select>
				</div>
				<label class="radio is-block mb-2 ml-0">
					<input type="radio" name="to" value="flight" disabled?={ len(p.Flights) == 0 }/>
					A flight
					if !p.Published {
						<span class="is-size-7 has-text-grey">(publish the timetable first)</span>
					}
				</label>
				if len(p.Flights) > 0 {
					<div class="select is-small mb-3 desk-to-flight">
						<select name="flight" aria-label="Flight">
							for _, g := range p.Flights {
								<optgroup label={ g.Label }>
									for _, o := range g.Options {
										<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
									}
								</optgroup>
							}
						</select>
					</div>
					<div class="mb-3 ml-4 desk-to-flight">
						<input type="hidden" name="flightChoice" value="1"/>
						<label class="checkbox comp-check mr-3">
							<input type="checkbox" name="flightGymnasts" value="1" checked/>
							Its gymnasts
						</label>
						<label class="checkbox comp-check">
							<input type="checkbox" name="flightOfficials" value="1"/>
							Its officials
						</label>
					</div>
				}
				<label class="radio is-block mb-2 ml-0">
					<input type="radio" name="to" value="officials"/>
					All officials
				</label>
				<label class="radio is-block mb-2 ml-0">
					<input type="radio" name="to" value="panel" disabled?={ len(p.Panels) == 0 }/>
					One panel's officials, for a day
				</label>
				if len(p.Panels) > 0 {
					<div class="select is-small mb-3 desk-to-panel">
						<select name="panel" aria-label="Panel">
							for _, o := range p.Panels {
								<option value={ o.Value }>{ o.Label }</option>
							}
						</select>
					</div>
				}
				<label class="radio is-block mb-2 ml-0">
					<input type="radio" name="to" value="people"/>
					People I pick
				</label>
				if len(p.People) == 0 {
					<p class="is-size-7 has-text-grey desk-to-people">No one has entered or offered to officiate yet.</p>
				} else {
					<div class="desk-to-people">
						@listTools(p.PeopleTools)
					</div>
					<div class="comp-desk-people desk-to-people" id={ p.PeopleTools.ID } style="max-height: 14rem; overflow-y: auto">
						for _, d := range p.People {
							<label class="checkbox is-block" { d.List.Attrs()... }>
								<input type="checkbox" name="person" value={ d.Key }/>
								{ d.Name }
								if d.Detail != "" {
									<span class="is-size-7 has-text-grey">· { d.Detail }</span>
								}
							</label>
						}
					</div>
				}
			</div>
			<div class="field">
				<label class="label is-small" for="desk-text">Message</label>
				<textarea class="textarea" id="desk-text" name="text" rows="3" maxlength="500" placeholder="e.g. Panel 2 is running 15 minutes late"></textarea>
			</div>
			<div class="field">
				<label class="checkbox comp-check"><input type="checkbox" name="come" value="1"/> Ask them to come to the organisers' desk</label>
			</div>
			<button class="button is-primary" type="submit">Send now</button>
			if SandboxOf(ctx) {
				<p class="help">{ NotificationsOff } It shows on each person's own page.</p>
			} else {
				<p class="help">It goes by push and email to those who asked to hear about this competition, sent in the background, and shows on each person's own page. Reload this page to see how the sending is going.</p>
			}
		</form>
		@deskScreen(p)
		@listSection("Sent", len(p.Sent)) {
			if len(p.Sent) == 0 {
				@emptyLine("Nothing sent yet.")
			}
			for _, m := range p.Sent {
				<div class="box py-3">
					<p>
						{ m.Text }
					</p>
					<p class="is-size-7 has-text-grey">
						{ m.At } · { m.Who } · to { m.To } · told { strconv.Itoa(m.Pushed) } by push, { strconv.Itoa(m.Emailed) } by email
						if m.ToGo > 0 {
							· still sending to { strconv.Itoa(m.ToGo) }
						}
						if m.Failed > 0 {
							· { strconv.Itoa(m.Failed) } failed
						}
					</p>
				</div>
			}
		}
	}
}

// deskMessages are the messages from the organisers that reach a person,
// newest first, on their own page.
templ deskMessages(notes []DeskNote) {
	if len(notes) > 0 {
		<div class="box comp-desk-messages">
			<p class="label is-small mb-2">Messages from the organisers</p>
			for _, n := range notes {
				<div class="mb-2">
					<p>
						{ n.Text }
					</p>
					<p class="is-size-7 has-text-grey">{ n.At }</p>
				</div>
			}
		</div>
	}
}

// deskScreen puts announcements on the venue screen and takes them down.
templ deskScreen(p DeskPage) {
	<div class="box">
		<h2 class="title is-5 mb-2">On the venue screen</h2>
		<p class="help mb-3">A line across the top of every venue screen, such as "Lunch extended by 15 minutes". It shows within 30 seconds; phones aren't told.</p>
		for _, n := range p.Screen {
			<div class="notification is-warning is-light py-2 px-3 mb-2">
				<form method="post" action={ templ.SafeURL(p.Base + "/desk/screen/" + n.ID + "/remove") } class="is-pulled-right ml-2">
					<button class="button is-small" type="submit">Take down</button>
				</form>
				<strong>{ n.Text }</strong>
				<span class="is-block is-size-7 has-text-grey">
					Up since { n.At } by { n.Who }
					if n.Until != "" {
						· until { n.Until }
					} else {
						· until it's taken down
					}
				</span>
			</div>
		}
		<form method="post" action={ templ.SafeURL(p.Base + "/desk/screen") }>
			<div class="field">
				<label class="label is-small" for="screen-text">Announcement</label>
				<input class="input" id="screen-text" name="text" maxlength={ strconv.Itoa(p.ScreenMax) } required/>
			</div>
			<div class="field is-grouped is-grouped-multiline">
				<div class="control">
					<div class="select is-small">
						<select name="for" aria-label="How long it shows">
							for _, o := range p.ScreenFor {
								<option value={ o.Value }>Show { o.Label }</option>
							}
						</select>
					</div>
				</div>
				<div class="control">
					<button class="button is-small is-primary" type="submit">Put it on the screen</button>
				</div>
			</div>
		</form>
	</div>
}
