package views

import "strconv"

// ScreenUp is who's up now in the flight on an area, once the marshal has
// tapped through to them: who's on, and the next to go.
type ScreenUp struct {
	On   ScreenUpGymnast
	Next []ScreenUpGymnast // the next two at most, in order
}

// ScreenUpGymnast is a gymnast and the routine they're doing.
type ScreenUpGymnast struct {
	FlightGymnast
	Routine string // e.g. "Set", "Voluntary" or "2nd routine"
}

// screenUp is who's on now and who's next in an area's card on the venue
// screen; nothing before the marshal has tapped.
templ screenUp(u *ScreenUp) {
	if u != nil {
		<div class="screen-up">
			<p class="screen-label">On now</p>
			<p class="screen-up-name"><span class="screen-no">{ strconv.Itoa(u.On.No) }</span> { u.On.Name }</p>
			<p class="screen-up-detail">
				if u.On.Club != "" {
					{ u.On.Club } ·
				}
				{ u.On.Routine }
			</p>
			if len(u.Next) > 0 {
				<p class="screen-label">Up next</p>
				<ol class="screen-up-next">
					for _, g := range u.Next {
						<li>
							<span class="screen-no">{ strconv.Itoa(g.No) }</span>
							<span class="screen-up-next-name">{ g.Name }</span>
							<span class="screen-up-detail">
								if g.Club != "" {
									{ g.Club } ·
								}
								{ g.Routine }
							</span>
						</li>
					}
				</ol>
			}
		</div>
	}
}
