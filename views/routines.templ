package views

import (
	"fmt"
	"strconv"
	"strings"

	"tariffCalculator/static"
)

// A member's routines, kept on their page (ADR 0011 Decision 1): the member's
// Routines tab, a coach's Gymnasts, and the comp sec's view of a member's.

// RoutineView is one kept routine, checked as the routine builder checks it.
type RoutineView struct {
	ID, Name   string
	Count      int    // skills
	Difficulty string // e.g. "4.2", "" when it isn't scored
	Updated    string // when it last changed, e.g. "15 October 2026"
	Card       ExerciseCard
	Broken     string // why it couldn't be read, if it couldn't
	Note       string // a coach's note
	NoteBy     string
	NoteBefore bool   // the note was written before the routine last changed
	Open       string // the routine builder, with this routine to add
	Rename     string // where renaming posts, for the member
	Delete     string // where deleting posts, for the member
	NoteAction string // where a coach's note posts
	AddedBy    string // the coach who added it to the member's page, "" for the member's own
	NotCan     []string      // its skills no coach has marked Can do, for a coach
	SkillsLink string        // the gymnast's Skills page, for a coach
	// MarkCan is where a coach marks one of NotCan Can do, here (NotCanSkills
	// are their JSON, in the same order).
	MarkCan      string
	NotCanSkills []string
	Unmet        int // the requirements it doesn't meet, said on its closed row
	Check      *RoutineCheck // checking it against a level, for a coach
}

// RoutineCheck is a coach checking a routine against a level they choose.
type RoutineCheck struct {
	Action  string       // where the choice goes, as a GET form
	Choices []ListOption // the club's levels and the built-in ones, in groups
	Chosen  string       // the level it's checked against now; "" for its own
}

// checkedAgainst says a routine is shown checked against a level a coach chose.
func checkedAgainst(r RoutineView) bool {
	return r.Check != nil && r.Check.Chosen != ""
}

// RoutinesPart is the routines on a page, and what can be done with them.
type RoutinesPart struct {
	Routines []RoutineView
	Add      string // where the member adds routines from this browser; "" for others
	Max      int    // the most a member keeps
	Empty    string // what to say when there are none
}

// routineSummary is a routine's one-line summary.
func routineSummary(r RoutineView) string {
	s := fmt.Sprintf("%d skills", r.Count)
	if r.Count == 1 {
		s = "1 skill"
	}
	if r.Difficulty != "" {
		s += " · difficulty " + r.Difficulty
	}
	return s + " · changed " + r.Updated
}

// routinesList is the kept routines, each a row that opens to its card.
templ routinesList(p RoutinesPart) {
	if len(p.Routines) == 0 {
		<p class="has-text-grey mb-4">{ p.Empty }</p>
	}
	// The lists of levels to check against are long: searchable.
	<script defer src={ static.URL("js/selectsearch.js") }></script>
	for _, r := range p.Routines {
		<details class="box comp-routine-row" id={ "routine-" + r.ID } open?={ checkedAgainst(r) }>
			<summary>
				<strong>{ r.Name }</strong>
				<span class="is-block is-size-7 has-text-grey">
					{ routineSummary(r) }
				</span>
				if r.AddedBy != "" {
					<span class="is-block mt-1">@WhoChip(RoleCoach, r.AddedBy)<span class="is-size-7 ml-1">added it</span></span>
				}
				if r.Note != "" {
					<span class="is-block mt-1">@WhoChip(RoleCoach, r.NoteBy)<span class="is-size-7 ml-1">left a note</span></span>
				}
				if r.Unmet > 0 || len(r.NotCan) > 0 {
					<span class="is-block mt-1">
						if r.Unmet > 0 {
							@StateChip(Attention, Count(r.Unmet, "requirement not met", "requirements not met"))
						}
						if len(r.NotCan) > 0 {
							@StateChip(Attention, notCanSummary(len(r.NotCan)))
						}
					</span>
				}
			</summary>
			<div class="mt-3">
				if len(r.NotCan) > 0 {
					<p class="is-size-7 mb-3">
						No coach has marked these Can do: { strings.Join(r.NotCan, ", ") }.
						if r.SkillsLink != "" && r.MarkCan == "" {
							<a href={ templ.SafeURL(r.SkillsLink) }>Mark them on Skills</a>
						}
					</p>
					// Marked here, coming back to the routine: no trip to Skills.
					if r.MarkCan != "" && len(r.NotCanSkills) == len(r.NotCan) {
						<div class="buttons are-small mb-3 comp-mark-can">
							<span class="is-size-7 mr-2">Mark Can do:</span>
							for i, name := range r.NotCan {
								<form method="post" action={ templ.SafeURL(r.MarkCan) } class="is-inline">
									<input type="hidden" name="skill" value={ r.NotCanSkills[i] }/>
									<input type="hidden" name="state" value="can"/>
									<input type="hidden" name="back" value={ "routine-" + r.ID }/>
									<button class="button" type="submit">✓ { name }</button>
								</form>
							}
						</div>
					}
				}
				if r.Check != nil {
					<form method="get" action={ templ.SafeURL(r.Check.Action + "#routine-" + r.ID) } class="field has-addons mb-3">
						<input type="hidden" name="routine" value={ r.ID }/>
						<div class="control is-expanded">
							<div class="select is-small is-fullwidth">
								<select name="against" aria-label={ "Check " + r.Name + " against" } data-search-select="Search the levels">
									<option value="">What it was checked against</option>
									for _, group := range listGroups(r.Check.Choices) {
										<optgroup label={ group[0].Group }>
											for _, o := range group {
												<option value={ o.Value } selected?={ o.Value == r.Check.Chosen }>{ o.Label }</option>
											}
										</optgroup>
									}
								</select>
							</div>
						</div>
						<div class="control"><button class="button is-small" type="submit">Check</button></div>
					</form>
				}
				if r.Note != "" {
					<div class="notification is-light py-2 px-3 mb-3">
						<p class="is-size-7 has-text-grey mb-1">
							@WhoChip(RoleCoach, r.NoteBy)
							if r.NoteBefore {
								· written before the routine last changed
							}
						</p>
						<p>{ r.Note }</p>
					</div>
				}
				if r.Broken != "" {
					<p>@StateChip(Attention, r.Broken)</p>
				} else {
					@exerciseCard(r.Card, 3)
				}
				<div class="buttons mt-3">
					if r.Open != "" {
						<a class="button is-small" href={ templ.SafeURL(r.Open) }>Open in the Routine Builder</a>
					}
				</div>
				if r.NoteAction != "" {
					<form method="post" action={ templ.SafeURL(r.NoteAction) } class="mt-2">
						<div class="field">
							<label class="label is-small" for={ "note-" + r.ID }>Your note</label>
							<textarea class="textarea is-small" id={ "note-" + r.ID } name="note" rows="2" maxlength="500" placeholder="What to work on, for them to see">{ r.Note }</textarea>
							<p class="help">They see it on their page, with your name. Leave it empty to take it off.</p>
						</div>
						<button class="button is-small is-primary" type="submit">Save note</button>
					</form>
				}
				if r.Rename != "" {
					<form method="post" action={ templ.SafeURL(r.Rename) } class="field has-addons mt-2">
						<div class="control is-expanded">
							<input class="input is-small" name="name" value={ r.Name } maxlength="60" required aria-label={ "New name for " + r.Name }/>
						</div>
						<div class="control"><button class="button is-small" type="submit">Rename</button></div>
					</form>
				}
				if r.Delete != "" {
					<form method="post" action={ templ.SafeURL(r.Delete) }>
						<button class="button is-small is-text has-text-danger" type="submit">Delete from your page</button>
					</form>
				}
			</div>
		</details>
	}
}

// keepRoutinesForm adds routines saved in this browser to a member's page
// (button: its label), each ticked to start with unless unticked.
templ keepRoutinesForm(p RoutinesPart, button string, unticked bool) {
	if p.Add != "" {
		// Filled with the routines saved in this browser (static/js/competitions.js, keepRoutines).
		<form method="post" action={ templ.SafeURL(p.Add) } class="box comp-keep-routines" data-keep-routines data-keep-unticked?={ unticked } hidden>
			<h2 class="title is-6">Add routines from this browser</h2>
			<div class="comp-keep-list mb-3"></div>
			<input type="hidden" name="routines"/>
			<p class="help mb-2">{ fmt.Sprintf("Up to %d routines on a page. One added already from this browser is changed to match.", p.Max) }</p>
			<button class="button is-small is-primary" type="submit">{ button }</button>
		</form>
	}
}

// MemberRoutines is a member's Routines tab: their kept routines, and adding
// more from the routines saved in this browser.
templ MemberRoutines(p MemberPage) {
	@memberFrame(p) {
		<p class="mb-4 is-size-7 has-text-grey">
			Routines kept here open on any phone, and your coaches and comp sec see them. To keep one, use
			<strong>More</strong>, <strong>Save to my page</strong> in the <a href="/">Routine Builder</a>.
		</p>
		@routinesList(p.Routines)
		@keepRoutinesForm(p.Routines, "Add to my page", false)
		<p class="help mt-4">We keep each routine's name, its skills, what it's checked against and which coach added it, if one did, until you delete it or leave the club.</p>
	}
}

// CoachFrame is the top of each of a coach's pages.
type CoachFrame struct {
	Club, Coach string
	Notice      string
	Ask         *Ask // asking before a club skill or level is removed
	Menu        []MenuSection
}

templ coachFrame(f CoachFrame) {
	<p class="has-text-grey mb-1">{ f.Club } · coach</p>
	<h1 class="title is-4">{ f.Coach }</h1>
	@pageMenu(f.Menu)
	if f.Notice != "" {
		@notice(f.Notice)
	}
	@askBox(f.Ask)
}

// CoachGymnast is a gymnast a coach sees, in their Gymnasts list.
type CoachGymnast struct {
	Name      string
	Routines  int
	Can       int // skills marked Can do
	ToConfirm int // marks only the gymnast made
	Open      string
	List      ListRow
}

// CoachGymnastsPage is a coach's Gymnasts: everyone they see, or one of them
// with their routines.
type CoachGymnastsPage struct {
	Frame    CoachFrame
	SeesAll  bool
	Gymnasts []CoachGymnast
	Tools    ListTools
	Gymnast  string // the one shown, with Routines
	Skills   string // their skills
	Back     string
	Routines RoutinesPart
	Entries  []CoachGymnastEntry // the one shown's entries
}

// CoachGymnastEntry is one of a gymnast's entries, on their coach's page for
// them: where, what, its sign-off, and the entry to sign off.
type CoachGymnastEntry struct {
	Competition, Event, Open string
	Signoff                  SignoffView
}

// CoachGymnasts is a coach's list of the gymnasts they see.
templ CoachGymnasts(p CoachGymnastsPage) {
	@competitionLayout("Gymnasts · " + p.Frame.Coach) {
		@coachFrame(p.Frame)
		<p class="mb-4 has-text-grey is-size-7">
			if p.SeesAll {
				You see every member of the club.
			} else {
				You see the members who chose you, and those who haven't chosen a coach.
			}
		</p>
		if len(p.Gymnasts) == 0 {
			@emptyLine("No members yet.")
		} else {
			@listTools(p.Tools)
			<div class="table-container">
				<table class="table is-fullwidth is-narrow comp-stack" id={ p.Tools.ID }>
					<tbody>
						for _, g := range p.Gymnasts {
							<tr { g.List.Attrs()... }>
								<td><a href={ templ.SafeURL(g.Open) }>{ g.Name }</a></td>
								<td class="has-text-grey is-size-7" data-label="Kept">
									{ routineCount(g.Routines) } · can do { strconv.Itoa(g.Can) }
									if g.ToConfirm > 0 {
										@StateChip(Attention, strconv.Itoa(g.ToConfirm)+" to confirm")
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// CoachGymnastPage is one gymnast a coach sees, with their routines.
templ CoachGymnastPage(p CoachGymnastsPage) {
	@competitionLayout(p.Gymnast + " · " + p.Frame.Coach) {
		@coachFrame(p.Frame)
		@backLink(p.Back, "Gymnasts")
		<h2 class="title is-5">{ p.Gymnast }</h2>
		<p class="mb-3"><a class="button is-small" href={ templ.SafeURL(p.Skills) }>Skills: what they're learning and can do →</a></p>
		if len(p.Entries) > 0 {
			<h3 class="title is-6 mb-2">Entries</h3>
			<ul class="mb-4">
				for _, e := range p.Entries {
					<li class="mb-1">
						<a href={ templ.SafeURL(e.Open) }>{ e.Competition } · { e.Event }</a>
						if e.Signoff.Required {
							@StateChip(signoffState(e.Signoff))
						}
					</li>
				}
			</ul>
			<h3 class="title is-6 mb-2">Routines</h3>
		}
		@routinesList(p.Routines)
		@keepRoutinesForm(p.Routines, "Add to "+p.Gymnast+"'s page", true)
	}
}

// ClubMemberRoutinesPage is the comp sec's view of a member's routines.
type ClubMemberRoutinesPage struct {
	Club     ClubPage
	Member   string
	Back     string
	Routines RoutinesPart
}

// ClubMemberRoutines shows the comp sec a member's routines.
templ ClubMemberRoutines(p ClubMemberRoutinesPage) {
	@clubFrame(p.Club) {
		@backLink(p.Back, "Members")
		<h2 class="title is-5">{ p.Member }</h2>
		@routinesList(p.Routines)
	}
}

// notCanSummary says how many of a routine's skills no coach has marked Can do.
func notCanSummary(n int) string {
	if n == 1 {
		return "1 skill not marked Can do"
	}
	return strconv.Itoa(n) + " skills not marked Can do"
}

// routineCount is how many routines someone keeps, in words.
func routineCount(n int) string {
	switch n {
	case 0:
		return "No routines"
	case 1:
		return "1 routine"
	}
	return strconv.Itoa(n) + " routines"
}
