package views

import "tariffCalculator/static"

// LevelEditorPage is a club's level being written, on the coach's page: the
// requirements editor, saving straight to the club (ADR 0011 Decision 5).
type LevelEditorPage struct {
	Frame  CoachFrame
	Title  string // "New level", or the level's name
	Editor SetEditorData
}

// ClubLevelEditor is the requirements editor on the coach's page, for one of the
// club's levels. The editor posts itself to the server as it changes
// (htmx), and Save level posts it to the club.
templ ClubLevelEditor(p LevelEditorPage) {
	@competitionLayout(p.Title + " · " + p.Frame.Club) {
		<script src={ static.URL("js/htmx.min.js") }></script>
		<script defer src={ static.URL("js/selectsearch.js") }></script>
		@coachFrame(p.Frame)
		<p class="mb-1"><a href={ templ.SafeURL(p.Editor.Club.Back) }>← Levels</a></p>
		<h2 class="title is-5">{ p.Title }</h2>
		<p class="is-size-7 has-text-grey mb-4">What a gymnast has to be able to do for this level: each a skill or a kind of skill, several of a kind, a link of skills one after another, or one of your club's own skills (a handstand, a drill), each in the order you want them. Pick from the lists, your club's own skills first. Each gymnast's Skills page shows how far through it they are.</p>
		@SetEditor(p.Editor)
		@keepRulesOpen()
	}
}

// keepRulesOpen keeps the lines a coach opened open as the editor redraws
// itself (htmx swaps the whole form).
templ keepRulesOpen() {
	<script>
		(function () {
			let open = [];
			document.body.addEventListener('htmx:beforeSwap', (event) => {
				if (event.detail.target.id !== 'set-editor') { return; }
				open = [...document.querySelectorAll('#set-editor details.rule-card-body[open]')].map((d) => d.dataset.rule);
			});
			document.body.addEventListener('htmx:afterSwap', () => {
				for (const n of open) {
					const d = document.querySelector(`#set-editor details.rule-card-body[data-rule="${n}"]`);
					if (d) { d.open = true; }
				}
			});
		})();
	</script>
}
